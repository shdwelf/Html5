    {
      "id": "ZSHAOLIN-SOURCE-01",
      "title": "SSH provisioning helper serves generated client private-key material over plain HTTP",
      "status": "Confirmed source flow; not reproduced against an APK, running device or reachable service",
      "risk": "High if this legacy helper is run and its HTTP provisioning endpoint is reachable by an untrusted peer. Not a new CVE or a measured exploitation claim.",
      "evidence": [
        {
          "path": "conf/helpers/z-ssh",
          "lines": "88-115",
          "url": "https://github.com/dyne/ZShaolin/blob/9e4857a8fae42eb1e476a9a6ea26df172bf8e87e/conf/helpers/z-ssh#L88-L115"
        },
        {
          "path": "conf/etc/ssh/sshd_config",
          "lines": "41-69",
          "url": "https://github.com/dyne/ZShaolin/blob/9e4857a8fae42eb1e476a9a6ea26df172bf8e87e/conf/etc/ssh/sshd_config#L41-L69"
        }
      ],
      "observations": [
        "Creates a client RSA key with an empty passphrase when absent.",
        "Copies its public key to authorized_keys only when that file is absent.",
        "Embeds the client private key into a generated provisioning script.",
        "After starting SSHD on port 2222, invokes an HTTP server on port 2221 for the provisioning directory; this helper configures neither TLS nor HTTP authentication.",
        "A separate secure action stops the HTTP server. This is distinct from the dormant Java webserver scaffold."
      ],
      "actualPrivateKeyValuesRetrieved": false,
      "actualPrivateKeyValuesPublished": false,
      "recommendedBoundary": "Do not enable this legacy HTTP-key provisioning flow. Use a maintained SSH implementation, generate/transfer public keys through an authenticated channel, and rotate keys if this flow was used on an exposed network."
    },
    {
      "id": "ZSHAOLIN-SOURCE-02",
      "title": "The source SSH default is public-key authentication, not a universal password",
      "status": "Source configuration only",
      "evidence": [
        {
          "path": "conf/etc/ssh/sshd_config",
          "lines": "13-69",
          "url": "https://github.com/dyne/ZShaolin/blob/9e4857a8fae42eb1e476a9a6ea26df172bf8e87e/conf/etc/ssh/sshd_config#L13-L69"
        }
      ],
      "observations": [
        "Port 2222; PubkeyAuthentication yes; PasswordAuthentication no; PermitEmptyPasswords no; ChallengeResponseAuthentication no.",
        "Legacy StrictModes no and UsePrivilegeSeparation no are present; this is not a current hardening recommendation.",
        "No source evidence establishes r@@t0r as a ZShaolin or Kodachi VPN password."
