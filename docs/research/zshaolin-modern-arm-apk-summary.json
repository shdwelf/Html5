    "legacyChanges": [
      {
        "old": "gpgkeys_hkp/gpgkeys_finger/gpgkeys_curl",
        "replacement": "Current GnuPG/dirmngr",
        "reason": "GnuPG 1.x external keyserver-helper layout is obsolete."
      },
      {
        "old": "srm",
        "replacement": "coreutils shred (no secure-erasure promise)",
        "reason": "Flash wear levelling, snapshots and filesystem journalling prevent reliable per-file physical erasure."
      },
      {
        "old": "mongoose HTTP provisioning",
        "replacement": "REMOVED; z-ssh uses owner-supplied public keys and loopback-only SSH",
        "reason": "Never serve or generate a client private key for network provisioning."
      },
      {
        "old": "matanza/ctris/cryptoslam",
        "replacement": "curseofwar, vitetris (tetris command), nethack, sl and libcaca",
        "reason": "Explicit modern game substitutions, not a claim that unavailable legacy games were rebuilt."
      },
      {
        "old": "ImageMagick 6 animate/display/import X11 UI",
        "replacement": "Current ImageMagick CLI",
        "reason": "No X server is bundled or automatically launched; graphical viewers need a separately configured display."
      }
