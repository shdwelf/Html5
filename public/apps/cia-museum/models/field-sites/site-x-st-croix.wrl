#VRML V2.0 utf8
# Site-X / St. Croix — conceptual repository data index, not a claim of CIA affiliation
WorldInfo { title "Site-X St. Croix — project data observatory" }
DEF SEA Material { diffuseColor 0.17 0.40 0.52 transparency 0.08 specularColor 0.30 0.52 0.62 }
DEF ISLAND Material { diffuseColor 0.45 0.56 0.31 }
DEF RIDGE Material { diffuseColor 0.35 0.47 0.27 }
DEF STONE Material { diffuseColor 0.58 0.56 0.48 }
DEF NODE Material { diffuseColor 0.70 0.16 0.12 emissiveColor 0.08 0.01 0 }
DEF LINK Material { diffuseColor 0.76 0.64 0.26 emissiveColor 0.10 0.07 0 }
Transform { translation 0 -0.7 0 children [ Shape { appearance Appearance { material USE SEA } geometry Cylinder { radius 15 height 1.2 } } ] }
Transform { translation 0 0 0 scale 1 0.35 0.55 children [ Shape { appearance Appearance { material USE ISLAND } geometry Sphere { radius 10 } } ] }
Transform { translation -2 1.2 0 scale 1.8 0.55 0.65 children [ Shape { appearance Appearance { material USE RIDGE } geometry Sphere { radius 3.2 } } ] }
Transform { translation 4 0.8 -1 scale 1.4 0.45 0.55 children [ Shape { appearance Appearance { material USE RIDGE } geometry Sphere { radius 2.4 } } ] }
# Three nodes reference the repository's USGS, NOAA and UNIX data themes.
Transform { translation -6 1.2 -1 children [ Shape { appearance Appearance { material USE NODE } geometry Sphere { radius 0.65 } } ] }
Transform { translation 0 2.4 1 children [ Shape { appearance Appearance { material USE NODE } geometry Sphere { radius 0.65 } } ] }
Transform { translation 6 1.1 -1 children [ Shape { appearance Appearance { material USE NODE } geometry Sphere { radius 0.65 } } ] }
Transform { translation -3 1.8 0 rotation 0 0 1 -0.18 children [ Shape { appearance Appearance { material USE LINK } geometry Cylinder { radius 0.11 height 6.5 } } ] }
Transform { translation 3 1.8 0 rotation 0 0 1 0.20 children [ Shape { appearance Appearance { material USE LINK } geometry Cylinder { radius 0.11 height 6.5 } } ] }
Transform { translation 0 2.6 -4 children [ Shape { appearance Appearance { material USE STONE } geometry Box { size 5.5 4 0.7 } } Transform { translation 0 0 0.4 children [ Shape { appearance Appearance { material USE NODE } geometry Box { size 4.5 0.45 0.18 } } ] } ] }
Transform { translation 0 5.2 -4 children [ Shape { appearance Appearance { material USE LINK } geometry Cone { bottomRadius 1.1 height 1.8 } } ] }
