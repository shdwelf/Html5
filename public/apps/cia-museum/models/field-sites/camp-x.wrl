Transform { translation 3 1 -4 children [ Shape { appearance Appearance { material USE HUT } geometry Box { size 5 2 3 } } Transform { translation 0 1.45 0 rotation 0 0 1 0.785 children [ Shape { appearance Appearance { material USE ROOF } geometry Box { size 2.3 2.3 3.3 } } ] } ] }
Transform { translation -8 1 3 children [ Shape { appearance Appearance { material USE HUT } geometry Box { size 4.5 2 2.7 } } Transform { translation 0 1.4 0 rotation 0 0 1 0.785 children [ Shape { appearance Appearance { material USE ROOF } geometry Box { size 2.2 2.2 3 } } ] } ] }
