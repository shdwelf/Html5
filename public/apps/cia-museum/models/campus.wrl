#VRML V2.0 utf8
# CIA Museum Digital Campus — public-source interpretive model
# MODEL_STATUS conceptual, not surveyed, not for navigation
# COLLECTION 11 official online exhibits + publicly described campus landmarks

WorldInfo {
  title "CIA Museum Digital Campus Study"
  info [
    "Independent public-source educational visualization"
    "Massing, paths, landscape and exhibit locations are conceptual"
    "The physical CIA Museum is not open to the public"
  ]
}
