  },

  "dataset": {
    "name": "WEBU JSON and SQL Dataset",
    "version": "2025.10.28",
    "generated_on": "2025-11-29",
    "format_version": "1.0.0",
    "verse_count": 31098,
    "book_count": 66,
    "chapter_count": 1189,
    "structure": {
      "json": {
        "complete": "json/complete-bible.json",
        "per_book": "json/books/*.json"
      },
      "sql": {
        "schema": "sql/schema.sql",
        "seed": "sql/seed_webu.sql"
      }
    }
  },

  "schema": {
    "translation_table": {
      "primary_key": "id",
      "unique_fields": ["code"],
      "fields": {
        "id": "SERIAL",
        "code": "VARCHAR(10)",
        "name": "VARCHAR(255)",
        "publisher": "VARCHAR(255)",
        "year": "INTEGER",
        "copyright": "TEXT",
        "license_type": "VARCHAR(50)",
        "language": "VARCHAR(20)",
        "created_at": "TIMESTAMP"
      }
    },
    "book_table": {
      "primary_key": "id",
      "unique_fields": ["translation_id", "slug", "order_index"],
      "fields": {
        "id": "SERIAL",
        "translation_id": "INTEGER",
        "name": "VARCHAR(255)",
        "slug": "VARCHAR(50)",
        "abbrev": "VARCHAR(20)",
        "testament": "VARCHAR(10)",
        "order_index": "INTEGER",
        "chapter_count": "INTEGER"
      }
    },
    "verse_table": {
      "primary_key": "id",
      "unique_fields": ["canonical_ref"],
      "fields": {
        "id": "SERIAL",
        "translation_id": "INTEGER",
        "book_id": "INTEGER",
        "chapter": "INTEGER",
        "verse_number": "INTEGER",
        "text": "TEXT",
        "canonical_ref": "VARCHAR(100)",
        "order_index": "BIGINT",
        "created_at": "TIMESTAMP"
      }
    }
  },

  "canonical": {
