+/* Pop one item from the merge of two nondecreasing queues. Leaves win ties. */
+static unsigned huff_pop_min(const ace_hn_t *node,
+                             unsigned leaves, unsigned *leaf_head,
+                             const unsigned *internal, unsigned internal_count,
