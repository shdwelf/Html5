    <script>
        let video = null;
        let canvas = null;
        let ctx = null;
        let intervalId = null;
        let readings = [];
        let isMonitoring = false;
        
        const MAX_READINGS = 60;
        
        function init() {
            // Create hidden video and canvas elements
            video = document.createElement('video');
            video.autoplay = true;
            video.playsInline = true;
            
            canvas = document.createElement('canvas');
            canvas.width = 120;
            canvas.height = 90;
            ctx = canvas.getContext('2d', { willReadFrequently: true });
            
            // Initial UI state
            updatePredictions();
        }
        
        async function startSensor() {
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { 
                        facingMode: 'environment',
                        width: { ideal: 320 },
                        height: { ideal: 240 }
                    } 
                });
                
                video.srcObject = stream;
                
                startBtn.classList.add('hidden');
                stopBtn.classList.remove('hidden');
                
                isMonitoring = true;
                document.getElementById('sensor-text').innerHTML = 'Active';
                document.getElementById('sensor-status').classList.add('!border-emerald-900');
                
                // Start reading loop
                intervalId = setInterval(captureLightReading, 1000);
                
                // Initial reading
                setTimeout(captureLightReading, 300);
                
            } catch (err) {
                console.error(err);
                // Fallback to simulation
                simulateSensor();
            }
        }
        
        function stopSensor() {
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            
            if (intervalId) {
                clearInterval(intervalId);
                intervalId = null;
            }
            
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
                video.srcObject = null;
            }
            
            isMonitoring = false;
            startBtn.classList.remove('hidden');
            stopBtn.classList.add('hidden');
            
            document.getElementById('sensor-text').innerHTML = 'Stopped';
            document.getElementById('sensor-status').classList.remove('!border-emerald-900');
        }
        
        function captureLightReading() {
            if (!video || !isMonitoring || video.readyState !== 4) return;
            
            try {
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const data = imageData.data;
                
                let totalBrightness = 0;
                for (let i = 0; i < data.length; i += 4) {
                    const r = data[i];
                    const g = data[i + 1];
                    const b = data[i + 2];
                    // Perceived brightness
                    totalBrightness += (r * 0.299 + g * 0.587 + b * 0.114);
                }
                
                const avgBrightness = totalBrightness / (data.length / 4);
                // Map 0-255 brightness to lux approximation (0-1200)
                const lux = Math.round(Math.max(5, Math.min(1200, avgBrightness * 4.7)));
                
                addReading(lux);
                
            } catch (e) {
                console.error("Capture error:", e);
            }
        }
        
        function addReading(lux) {
            const now = Date.now();
            readings.push({ time: now, lux: lux });
            
            // Keep only last MAX_READINGS
            if (readings.length > MAX_READINGS) {
                readings.shift();
            }
            
            // Update UI
            updateLiveUI(lux);
            updateChart();
            updatePredictions();
            
            document.getElementById('reading-count').innerHTML = readings.length;
        }
        
        function updateLiveUI(lux) {
            const luxEl = document.getElementById('current-lux');
            const bar = document.getElementById('light-bar');
            const label = document.getElementById('lux-label');
            
            luxEl.innerHTML = lux;
            
            // Update progress bar (0-1200 lux)
            const percent = Math.min(100, Math.max(3, (lux / 1200) * 100));
            bar.style.width = percent + '%';
            
            // Label
            let status = '';
            if (lux < 80) status = 'Very dark';
            else if (lux < 250) status = 'Cloudy / Indoor';
            else if (lux < 550) status = 'Overcast';
            else if (lux < 900) status = 'Partly sunny';
            else status = 'Sunny / Bright';
            
            label.innerHTML = `${lux} lux • ${status}`;
            
            // Color shift
            if (lux > 700) {
                bar.style.background = 'linear-gradient(to right, #f59e0b, #eab308)';
            } else {
                bar.style.background = 'linear-gradient(to right, #6366f1, #eab308)';
            }
        }
        
        function updateChart() {
            const canvasEl = document.getElementById('history-chart');
            const ctx = canvasEl.getContext('2d');
            
            ctx.clearRect(0, 0, canvasEl.width, canvasEl.height);
            
            if (readings.length < 2) return;
            
            const padding = 20;
            const w = canvasEl.width - padding * 2;
            const h = canvasEl.height - padding * 2;
            
            const maxLux = Math.max(...readings.map(r => r.lux), 1200);
            const minLux = Math.min(...readings.map(r => r.lux), 0);
            const range = maxLux - minLux || 1;
            
            ctx.strokeStyle = '#6366f1';
            ctx.lineWidth = 2.5;
            ctx.shadowBlur = 4;
            ctx.shadowColor = 'rgba(99, 102, 241, 0.3)';
            
            ctx.beginPath();
            
            readings.forEach((reading, i) => {
                const x = padding + (i / (MAX_READINGS - 1)) * w;
                const y = padding + h - ((reading.lux - minLux) / range) * h;
                
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });
            
            ctx.stroke();
            ctx.shadowBlur = 0;
            
            // Draw dots
            ctx.fillStyle = '#6366f1';
            readings.forEach((reading, i) => {
                const x = padding + (i / (MAX_READINGS - 1)) * w;
                const y = padding + h - ((reading.lux - minLux) / range) * h;
                
                ctx.beginPath();
                ctx.arc(x, y, 2.5, 0, Math.PI * 2);
                ctx.fill();
            });
        }
        
        function updatePredictions() {
            if (readings.length < 5) {
                // Default values
                setPrediction('sunburn', 18, 'Low');
                setPrediction('rain', 42, 'Low');
                return;
            }
            
            // Calculate metrics
            const recentLux = readings.slice(-15).map(r => r.lux);
            const avgRecent = recentLux.reduce((a, b) => a + b, 0) / recentLux.length;
            
            const allLux = readings.map(r => r.lux);
            const avgAll = allLux.reduce((a, b) => a + b, 0) / allLux.length;
            
            // Variance (how stable the light is)
            const variance = allLux.reduce((sum, val) => sum + Math.pow(val - avgAll, 2), 0) / allLux.length;
            const stdDev = Math.sqrt(variance);
            
            // Trend: last 15 vs previous 15
            let trend = 0;
            if (readings.length > 30) {
                const prevAvg = readings.slice(-30, -15).reduce((a, b) => a + b.lux, 0) / 15;
                trend = avgRecent - prevAvg;
            }
            
            // Sunburn risk: high sustained light + low variance
            let sunburnProb = Math.min(95, Math.max(5, 
                (avgRecent / 12) + 
                (Math.max(0, 1 - (stdDev / 350)) * 35)
            ));
            
            // Rain risk: drops in light, high variance, recent low light
            let rainProb = Math.min(92, Math.max(8,
                (stdDev / 6) + 
                ((1200 - avgRecent) / 20) + 
                (trend < -80 ? 25 : 0)
            ));
            
            // Clamp and adjust
            sunburnProb = Math.round(Math.min(95, sunburnProb));
            rainProb = Math.round(Math.min(92, rainProb));
            
            // Labels
            let sunburnLabel = sunburnProb > 70 ? 'High' : sunburnProb > 35 ? 'Moderate' : 'Low';
            let rainLabel = rainProb > 65 ? 'High' : rainProb > 40 ? 'Moderate' : 'Low';
            
            setPrediction('sunburn', sunburnProb, sunburnLabel);
            setPrediction('rain', rainProb, rainLabel);
        }
        
        function setPrediction(type, percent, label) {
            const percentEl = document.getElementById(type + '-percent');
            const barEl = document.getElementById(type + '-bar');
            const labelEl = document.getElementById(type + '-label');
            
            percentEl.innerHTML = percent;
            barEl.style.width = percent + '%';
            labelEl.innerHTML = label;
            
            // Dynamic color
            if (type === 'sunburn') {
                if (percent > 60) {
                    barEl.style.background = 'linear-gradient(to right, #f59e0b, #ef4444)';
                    labelEl.style.color = '#fcd34d';
                } else {
                    barEl.style.background = 'linear-gradient(to right, #f59e0b, #eab308)';
                    labelEl.style.color = '#fcd34d80';
                }
            } else {
                if (percent > 60) {
                    barEl.style.background = 'linear-gradient(to right, #0ea5e9, #3b82f6)';
                    labelEl.style.color = '#bae6fd';
                } else {
                    barEl.style.background = 'linear-gradient(to right, #38bdf8, #0ea5e9)';
                    labelEl.style.color = '#bae6fd80';
                }
            }
        }
        
        // Simulation mode for browsers without camera access
        function simulateSensor() {
            const startBtn = document.getElementById('start-btn');
            const stopBtn = document.getElementById('stop-btn');
            
            startBtn.classList.add('hidden');
            stopBtn.classList.remove('hidden');
            isMonitoring = true;
            
            document.getElementById('sensor-text').innerHTML = 'Simulating';
            
            let baseLux = 420;
            
            intervalId = setInterval(() => {
                // Simulate realistic light changes
                baseLux += (Math.random() - 0.5) * 70;
                
                // Occasionally simulate cloud cover or sun
                if (Math.random() < 0.1) {
                    baseLux = baseLux > 500 ? 210 : 680;
                }
                
                baseLux = Math.max(30, Math.min(1100, baseLux));
                
                addReading(Math.round(baseLux));
            }, 1000);
            
            // Seed some initial readings
            setTimeout(() => {
                for (let i = 0; i < 12; i++) {
                    const val = Math.round(380 + Math.random() * 160);
                    addReading(val);
                }
            }, 100);
        }
        
        function updateInitialPredictions() {
            // Seed with some realistic starting values
            setTimeout(() => {
                if (readings.length === 0) {
                    setPrediction('sunburn', 24, 'Low');
                    setPrediction('rain', 67, 'Moderate');
                }
            }, 800);
        }
        
        // Boot up
        window.onload = function() {
            init();
            updateInitialPredictions();
            
            // Easter egg: click header to simulate
            document.querySelector('h1').addEventListener('click', () => {
                if (!isMonitoring) {
                    simulateSensor();
                }
            });
        }
        
        // Keyboard support
        document.addEventListener('keydown', function(e) {
            if (e.key === "?") {
                const btn = document.getElementById('start-btn');
                if (!btn.classList.contains('hidden')) {
                    btn.click();
                }
                e.preventDefault();
            }
        });

