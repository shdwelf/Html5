  L.push(HEAD);
  const P=(id,name,sex,b,d,famc,fams)=>{ L.push(`0 @${id}@ INDI`); L.push(`1 NAME ${name}`); L.push(`1 SEX ${sex}`); if(b){L.push(`1 BIRT`);L.push(`2 DATE ${b}`);L.push(`2 PLACE ${'Boston, MA'}`);} if(d){L.push(`1 DEAT`);L.push(`2 DATE ${d}`);L.push(`2 PLACE ${'Boston, MA'}`);} if(famc)L.push(`1 FAMC @${famc}@`); (fams||[]).forEach(f=>L.push(`1 FAMS @${f}@`)); };
  const F=(id,h,w,ch)=>{ L.push(`0 @${id}@ FAM`); if(h)L.push(`1 HUSB @${h}@`); if(w)L.push(`1 WIFE @${w}@`); if(h&&w){L.push(`1 MARR`);L.push(`2 DATE 1920`);} ch.forEach(c=>L.push(`1 CHIL @${c}@`)); };
  // 4 generations
  P('I1','William Hayward','M','1880','1950',null,['F1']); L.push('1 _YDNA R-M269');
  P('I2','Margaret Clark','F','1885','1955',null,['F1']); L.push('1 _MTDNA H1');
  P('I3','Arthur Bell','M','1878','1948',null,['F2']);
  P('I4','Alice Moore','F','1882','1952',null,['F2']);
  F('F1','I1','I2',['I5','I6']);
  F('F2','I3','I4',['I7']);
  P('I5','Robert Hayward','M','1910','1985','F1',['F3']);
  P('I6','Dorothy Hayward','F','1912','1990','F1',['F4']);
  P('I7','Helen Bell','F','1915','2000','F2',['F3']);
  P('I8','Frank Wright','M','1908','1982',null,['F4']);
  F('F3','I5','I7',['I9','I10']);
  F('F4','I8','I6',['I11']);
  P('I9','James Hayward','M','1940',null,'F3',['F5']);
  P('I10','Susan Hayward','F','1942',null,'F3',[]);
  P('I11','Carol Wright','F','1944',null,'F4',['F5']);
  P('I12','Patrick Stone','M','1938',null,null,['F5']);
  F('F5','I9','I11',['I13','I14']);
  P('I13','Michael Hayward','M','1968',null,'F5',[]);
  P('I14','Laura Hayward','F','1971',null,'F5',[]);
  P('I15','Wm. Hayward','M','1881','1950',null,[]); L.push('1 _YDNA R-M269'); // deliberately similar record for matching demo
  L.push('0 TRLR');
  return L.join('\n');
}

/* =========================================================
   UTILITIES
   ========================================================= */
function yearsOf(p){
  const out={};
  const by=p.birth&&p.birth.date, dy=p.death&&p.death.date;
  const yb=extractYear(by), yd=extractYear(dy);
  if(yb) out.b=yb; if(yd) out.d=yd;
  return out;
}
function extractYear(s){ if(!s) return null; const m=String(s).match(/(\d{4})/); return m? m[1]: null; }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmtSize(b){ if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(0)+' KB'; return (b/1048576).toFixed(1)+' MB'; }
function showProgress(on){ $('progress').classList.toggle('show',on); }
function setProgress(v){ $('pbar-fill').style.width=Math.max(0,Math.min(100,v))+'%'; }
function setProgressText(t){ $('pbar-txt').textContent=t; }

/* resize */
window.addEventListener('resize', ()=>{ /* keep current view */ });

})();
</script>

<script id="worker-src" type="javascript/worker">
"use strict";
/* Streaming GEDCOM parser running in a Web Worker.
   Handles arbitrarily large files off the main thread. */
self.onmessage = function(e){
  if(e.data.cmd === 'parse') parseFile(e.data.text);
};

function parseFile(text){
  const t0 = performance.now();
  const lines = text.split(/\r\n|\r|\n/);
  const total = lines.length;
  const reportEvery = Math.max(2000, Math.floor(total/120));

  const individuals = Object.create(null);
  const families    = Object.create(null);

  let cur = null, curType = null;   // current top-level record
  let subObj = null;                // current level-1 event container (BIRT/DEAT/MARR...)
  let subLevel = 0;                 // level of subObj

  for(let i=0;i<total;i++){
    const raw = lines[i];
    if(raw==='') continue;

    // parse level
    let k=0, level=0;
    while(k<raw.length && raw.charCodeAt(k)>=48 && raw.charCodeAt(k)<=57){ level=level*10+(raw.charCodeAt(k)-48); k++; }
    while(k<raw.length && raw.charCodeAt(k)===32) k++;
    const rest = raw.slice(k);

    // split into tag + value, with possible leading @XREF@
    let tag, val='', xref='';
    if(rest.charAt(0)==='@'){
      const end = rest.indexOf('@',1);
      xref = rest.slice(1,end);
      const after = rest.slice(end+1).trim();
      const sp = after.indexOf(' ');
      tag = sp===-1 ? after : after.slice(0,sp);
      val  = sp===-1 ? '' : after.slice(sp+1).trim();
    } else {
      const sp = rest.indexOf(' ');
      tag = sp===-1 ? rest : rest.slice(0,sp);
      val  = sp===-1 ? '' : rest.slice(sp+1).trim();
    }

    if(level===0){
      cur=null; curType=null; subObj=null; subLevel=0;
      if(xref){
        if(tag==='INDI'){
          cur = { xref:xref, name:'', sex:'U', birth:null, death:null, events:[], fams:[], famc:[], notes:[], genetics:[] };
          individuals[xref]=cur; curType='INDI';
        } else if(tag==='FAM'){
          cur = { xref:xref, husb:'', wife:'', children:[], events:[] };
          families[xref]=cur; curType='FAM';
        } else { cur={xref:xref}; curType='OTHER'; }
      }
      continue;
    }

    if(!cur) continue;

    // Reset subObj when we go back to level 1
    if(level===1){
      subObj=null; subLevel=0;
      if(curType==='INDI') subObj = handleIndiL1(cur, tag, val);
      else if(curType==='FAM') subObj = handleFamL1(cur, tag, val);
    } else if(level===2 && subObj){
      if(tag==='DATE') subObj.date = val.trim();
      else if(tag==='PLAC') subObj.place = val.trim();
      else if(tag==='TYPE') subObj.type = val.trim();
      else if(tag==='VALUE') subObj.value = val.trim();
      else if(tag==='NOTE') subObj.note = val.trim();
    }
    // level>=3 (e.g. source citation text) ignored for compactness

    if((i % reportEvery)===0){
      self.postMessage({type:'progress', value:Math.round(i/total*100)});
    }
  }
  self.postMessage({type:'progress', value:100});

  const indiArr = Object.keys(individuals).map(k=>{
    const p=individuals[k];
    return { xref:p.xref, name:p.name, sex:p.sex, birth:p.birth, death:p.death,
             events:p.events, fams:p.fams, famc:p.famc, notes:p.notes, genetics:p.genetics };
  });
  const famArr = Object.keys(families).map(k=>{
    const f=families[k];
    return { xref:f.xref, husb:f.husb, wife:f.wife, children:f.children, events:f.events };
  });

  self.postMessage({type:'done', individuals:indiArr, families:famArr,
    meta:{ parseMs:Math.round(performance.now()-t0), lines:total, indi:indiArr.length, fam:famArr.length }});
}

function newEvent(type){ return { type:type, date:'', place:'' }; }

function handleIndiL1(cur, tag, val){
  switch(tag){
    case 'NAME': cur.name = cleanName(val); return null;
    case 'SEX':  cur.sex = (val||'U').toUpperCase().charAt(0); return null;
    case 'BIRT': cur.birth = newEvent('Birth'); return cur.birth;
    case 'DEAT': cur.death = newEvent('Death'); return cur.death;
    case 'CHR':  case 'BAPM': { const e=newEvent(tag); cur.events.push(e); return e; }
    case 'OCCU': { const e=newEvent('Occupation'); e.date=val; cur.events.push(e); return e; }
    case 'RESI': { const e=newEvent('Residence'); e.date=val; cur.events.push(e); return e; }
    case 'FAMS': if(val) cur.fams.push(stripAt(val)); return null;
    case 'FAMC': if(val) cur.famc.push(stripAt(val)); return null;
    case 'NOTE': cur.notes.push(stripAt(val)); return null;
    case '_DNA': case 'DNA': case '_YDNA': case 'YDNA': case '_MTDNA': case 'MTDNA':
    case '_HAPLO': case '_HAPLOGROUP': case 'HAPLOGROUP': case '_AUTOSOMAL': {
      const g={tag:tag,value:val.trim(),type:'',note:''}; cur.genetics.push(g); return g;
    }
  }
  return null;
}
function handleFamL1(cur, tag, val){
  switch(tag){
    case 'HUSB': cur.husb=stripAt(val); return null;
    case 'WIFE': cur.wife=stripAt(val); return null;
    case 'CHIL': if(val) cur.children.push(stripAt(val)); return null;
    case 'MARR': { const e=newEvent('Marriage'); cur.events.push(e); return e; }
    case 'DIV':  { const e=newEvent('Divorce'); cur.events.push(e); return e; }
  }
  return null;
}

function cleanName(v){ return v? v.replace(/\//g,' ').replace(/\s+/g,' ').trim()||'Unknown' : 'Unknown'; }
function stripAt(v){ return v? v.replace(/^@|@$/g,'') : ''; }
</script>
