function doSearch(){
  const raw=searchInput.value.trim();
  if(!raw){ results.classList.remove('show'); return; }
  const q=normalizeText(raw);
  const found=[];
  for(const p of DB.byName){
    const n=normalizeText(p.name||'');
    const exact=n.includes(q);
    const score=exact?1:Math.max(jaroWinkler(q,n),tokenSimilarity(q,n));
    if(exact||score>=0.70) found.push({p,score,exact});
  }
  found.sort((a,b)=>Number(b.exact)-Number(a.exact)||b.score-a.score||(a.p.name||'').localeCompare(b.p.name||''));
  const shown=found.slice(0,40);
  if(!shown.length){ results.innerHTML='<div class="res-empty">No close matches</div>'; results.classList.add('show'); return; }
  results.innerHTML=shown.map(x=>'<div class="res-item" data-xref="'+esc(x.p.xref)+'"><div>'+esc(x.p.name||'Unknown')+'</div><div class="rl">'+esc(lifetime(x.p))+(x.exact?' · direct match':' · fuzzy '+Math.round(x.score*100)+'%')+'</div></div>').join('');
  results.classList.add('show');
  results.querySelectorAll('.res-item').forEach(it=>{
    it.onclick=()=>{ focusOn(it.dataset.xref); results.classList.remove('show'); searchInput.value=''; };
  });
}

/* =========================================================
   EXPLAINABLE FUZZY / EVIDENCE MATCHING
   ========================================================= */
function normalizeText(v){
  return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
}
function tokenSimilarity(a,b){
  const A=new Set(normalizeText(a).split(' ').filter(Boolean)), B=new Set(normalizeText(b).split(' ').filter(Boolean));
  if(!A.size||!B.size) return 0;
  let common=0; A.forEach(x=>{ if(B.has(x)) common++; });
  return (2*common)/(A.size+B.size);
}
function jaroWinkler(a,b){
  a=normalizeText(a); b=normalizeText(b); if(a===b) return a?1:0;
  const range=Math.max(0,Math.floor(Math.max(a.length,b.length)/2)-1), am=new Array(a.length).fill(false), bm=new Array(b.length).fill(false);
  let m=0;
  for(let i=0;i<a.length;i++) for(let j=Math.max(0,i-range);j<=Math.min(i+range,b.length-1);j++) if(!bm[j]&&a[i]===b[j]){am[i]=true;bm[j]=true;m++;break;}
  if(!m) return 0;
  let k=0,t=0; for(let i=0;i<a.length;i++) if(am[i]){while(!bm[k])k++;if(a[i]!==b[k])t++;k++;}
  const j=(m/a.length+m/b.length+(m-t/2)/m)/3;
  let prefix=0; while(prefix<4&&prefix<a.length&&prefix<b.length&&a[prefix]===b[prefix])prefix++;
  return j+prefix*.1*(1-j);
}
function yearEvidence(a,b,label){
  if(!a||!b) return null;
  const d=Math.abs(Number(a)-Number(b));
  if(d===0) return {score:1,reason:label+' year exact'};
  if(d<=2) return {score:.82,reason:label+' years within '+d};
  if(d<=5) return {score:.48,reason:label+' years within '+d};
  return {score:0,reason:label+' years conflict'};
}
function geneticOverlap(a,b){
  const A=new Map((a.genetics||[]).map(g=>[normalizeText(g.tag),normalizeText(g.value)]));
  const B=new Map((b.genetics||[]).map(g=>[normalizeText(g.tag),normalizeText(g.value)]));
  const shared=[...A.keys()].filter(tag=>tag&&B.has(tag)&&A.get(tag)&&B.get(tag));
  if(!shared.length) return null;
  const same=shared.filter(tag=>A.get(tag)===B.get(tag));
  return {score:same.length/shared.length,reason:same.length?'same supplied genetic marker text':'supplied genetic marker text differs'};
}
function relationshipEvidence(a,b){
  const relatives=p=>[...parentsOf(p.xref),spouseOf(p.xref),...childrenOfPerson(p.xref)].filter(Boolean).map(x=>DB.people.get(x)).filter(Boolean);
  const A=relatives(a), B=relatives(b); if(!A.length||!B.length) return null;
  let best=0; for(const x of A) for(const y of B) best=Math.max(best,jaroWinkler(x.name,y.name),tokenSimilarity(x.name,y.name));
  return {score:best,reason:best>.84?'family context overlaps':'family context differs'};
}
function comparePeople(a,b){
  const evidence=[];
  const ns=Math.max(jaroWinkler(a.name,b.name),tokenSimilarity(a.name,b.name));
  evidence.push({score:ns,weight:5,reason:(ns>.94?'name very close':ns>.78?'name similar':'name differs')});
  const ay=a._years||{}, by=b._years||{};
  const birth=yearEvidence(ay.b,by.b,'birth'), death=yearEvidence(ay.d,by.d,'death');
  if(birth)evidence.push({...birth,weight:3}); if(death)evidence.push({...death,weight:2});
  const ap=a.birth&&a.birth.place, bp=b.birth&&b.birth.place;
  if(ap&&bp){const ps=Math.max(jaroWinkler(ap,bp),tokenSimilarity(ap,bp));evidence.push({score:ps,weight:2,reason:ps>.85?'birthplace close':'birthplace differs'});}
  const ge=geneticOverlap(a,b); if(ge)evidence.push({...ge,weight:2});
  const re=relationshipEvidence(a,b); if(re)evidence.push({...re,weight:1.5});
  const total=evidence.reduce((n,e)=>n+e.weight,0), score=evidence.reduce((n,e)=>n+e.score*e.weight,0)/total;
  return {score,reasons:evidence.filter(e=>e.score>=.75||e.score===0).map(e=>e.reason),evidenceCount:evidence.length};
}
function findMatches(person,limit){
  const out=[];
  for(const candidate of DB.list){
    if(candidate.xref===person.xref) continue;
    const m=comparePeople(person,candidate);
    if(m.evidenceCount>=2&&m.score>=.62) out.push({person:candidate,...m});
  }
  return out.sort((a,b)=>b.score-a.score).slice(0,limit);
}
function geneticLabel(tag){
  return ({'_DNA':'DNA test or marker','DNA':'DNA test or marker','_YDNA':'Y-DNA evidence','YDNA':'Y-DNA evidence','_MTDNA':'Mitochondrial DNA evidence','MTDNA':'Mitochondrial DNA evidence','_HAPLO':'Recorded haplogroup','_HAPLOGROUP':'Recorded haplogroup','HAPLOGROUP':'Recorded haplogroup','_AUTOSOMAL':'Autosomal DNA evidence'})[tag]||'Genetic evidence';
}
