    left: 50%;
    margin-left: -8px;
    border-width: 8px;
    border-style: solid;
    border-color: #f4f9ff transparent transparent transparent;
    z-index: 1 !important;
}

.embedpress-popup-share-buttons::after {
    content: "";
    position: absolute;
    bottom: -16.1px;
    left: 50%;
    margin-left: -8px;
    border-width: 8px;
    border-style: solid;
    border-color: #e7eaef transparent transparent transparent;
