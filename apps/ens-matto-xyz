<style>.el_masonry_gallery_item_gutter{
	width: 5px;
}
.el_masonry_gallery_item{
	display: inline-block;
	position: relative;
}
.el_masonry_gallery_image_wrapper{
	position: relative;
}
.el_masonry_gallery_module__image{
	display: block;
	width: 100%;
	border: 0 solid #000000;
}

/* Overlay. */
.el_masonry_gallery_item .et_overlay{
	z-index: -1;
	position: absolute;
	top: 0;
	left: 0;
	display: block;
	width: 100%;
	height: 100%;
	background: hsla(0, 0%, 100%, .7);
	opacity: 0;
	pointer-events: none;
	-webkit-transition: all .3s;
	transition: all .3s;
	border: 1px solid #e5e5e5;
	-webkit-box-sizing: border-box;
	box-sizing: border-box;
	-webkit-backface-visibility: hidden;
	backface-visibility: hidden;
	-webkit-font-smoothing: antialiased;
}
.el_masonry_gallery_item:hover .et_overlay{
	opacity: 1;
	z-index: 1;
}
.el_masonry_gallery_wrapper .et_overlay{
	border: 0 solid transparent;
}
.el_masonry_gallery_item:hover .et_overlay{
	opacity: 1;
	z-index: 1;
}
.el_masonry_gallery_wrapper .el_masonry_gallery_item_title{
	padding: 10px 0 0;
}
.el_masonry_gallery_wrapper .el_masonry_gallery_item_title:last-child{
	padding: 10px 0 5px;
}
.el_masonry_gallery_wrapper .el_masonry_gallery_item_caption{
	padding: 5px 0;
}

.el_masonry_gallery .dge-overlay-with-icons:before{
	display: none;
}
.el_masonry_gallery .dge-overlay-with-icons{
	display: flex;
	align-items: center;
	justify-content: center;
	pointer-events: all;
}
.el_masonry_gallery .dge-overlay-with-icons .dge-overlay-lightbox,
.el_masonry_gallery .dge-overlay-with-icons .dge-overlay-link{
	display: flex;
	justify-content: center;
	font-family: FontAwesome;
	font-weight: 900;
	font-size: 16px;
	padding: 5px;
	margin: 3px;
	cursor: pointer;
	line-height: 1;
	text-decoration: none;
}

/* Filter. */
.el_masonry_gallery_filter_wrapper{
	margin-bottom: 35px;
}
.el_masonry_gallery_filter_wrapper .el_masonry_gallery_filter_categories{
	list-style: none;
	padding: 0;
	text-align: center;
}
.el_masonry_gallery_filter_wrapper .el_masonry_gallery_filter_categories li{
	display: inline-block;
	margin-right: 15px;
	margin-bottom: 15px;
	padding: 0.8em 1.4em;
	line-height: normal;
	background-color: #000;
	color: #fff;
	border: 0 solid transparent;
	transition: all 300ms ease;
	cursor: pointer;
}
.el_masonry_gallery_filter_wrapper .el_masonry_gallery_filter_categories .el_masonry_gallery_active_category{
	background-color: transparent;
	color: #000;
}

/* Pagination. */
.el_masonry_gallery_pagination_wrapper{
	position: relative;
	width: 100%;
	margin-top: 20px;
	text-align: center;
}
.el_masonry_gallery_pagination_wrapper .el_masonry_gallery_pagination{
	list-style: none;
	padding: 0;
	line-height: normal;
}
.el_masonry_gallery_pagination li{
	display: inline-block;
	margin-right: 10px;
}
.el_masonry_gallery_pagination li.disabled{
	display: none;
	opacity: 0.2;
}
.el_masonry_gallery_pagination li a{
	display: block;
	padding: 4px 10px;
	font-size: 16px;
	line-height: 1.5;
	text-decoration: none;
	background-color: #f7f7f7;
	color: #000;
}
.el_masonry_gallery_pagination li.active a{
	cursor: default;
	background-color: #000;
	color: #fff;
}

/* Lightbox */
.el_masonry_gallery_lightbox .mfp-img{
	padding: 0;
}
.el_masonry_gallery_lightbox .mfp-figure:after{
	display: none;
}
.el_masonry_gallery_lightbox .mfp-bottom-bar{
	position: absolute;
	padding: 10px;
	background-color: rgba( 0, 0, 0, 0.8 );
	color: #fff;
	top: auto;
	bottom: 0;
	margin-top: 0;
}
.el_masonry_gallery_lightbox .mfp-title{
	padding-right: 0;
}
.el_masonry_gallery_lightbox .mfp-title a{
	cursor: pointer;
}
.el_masonry_gallery_lightbox .el_masonry_gallery_item_title{
	color: #fff;
}
.el_masonry_gallery_lightbox .mfp-close:active{
	top: 0;
}

/* Lightbox - Zoom Effect */
.el_masonry_gallery_lightbox.dge_mfp_zoom .mfp-container,
.el_masonry_gallery_lightbox.dge_mfp_zoom.mfp-bg{
	opacity: 0;
	-webkit-backface-visibility: hidden;
	backface-visibility: hidden;
	transition: all 300ms ease-out;
}
.el_masonry_gallery_lightbox.dge_mfp_zoom.mfp-ready.mfp-bg{
	opacity: 0.8;
}
.el_masonry_gallery_lightbox.dge_mfp_zoom.mfp-ready .mfp-container{
	opacity: 1;
}
.el_masonry_gallery_lightbox.dge_mfp_zoom.mfp-removing .mfp-container,
.el_masonry_gallery_lightbox.dge_mfp_zoom.mfp-removing.mfp-bg{
	opacity: 0;
}

/* Lightbox - Fade Effect */
.el_masonry_gallery_lightbox.dge_mfp_fade .mfp-container,
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-bg{
	opacity: 0;
	-webkit-transition: all 300ms ease-out;
	-moz-transition: all 300ms ease-out;
	transition: all 300ms ease-out;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-bg.mfp-ready{
	opacity: 0.8;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-ready .mfp-container{
	opacity: 1;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-bg.mfp-removing{
	opacity: 0;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-wrap .mfp-content{
	opacity: 0;
	-webkit-transition: all 300ms ease-out;
	-moz-transition: all 300ms ease-out;
	transition: all 300ms ease-out;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-wrap.mfp-ready .mfp-content{
	opacity: 1;
}
.el_masonry_gallery_lightbox.dge_mfp_fade.mfp-wrap.mfp-removing .mfp-content{
	opacity: 0;
}
.el_masonry_gallery_lightbox .mfp-close,
.el_masonry_gallery_lightbox .mfp-arrow{
	opacity: 1;
	filter: alpha(opacity=100);
}

/* Load more button. */
.el_masonry_gallery .el-masonry-gallery-load-more{
	text-decoration: none;
}
</style>
