<script>
/* ============================================================
 *  AUDIO WORKLET — Advanced DSP Processors (object-pooled)
 *  Runs on dedicated audio rendering thread
 *  Zero allocations inside process() — all buffers pre-allocated
 * ============================================================ */
const WORKLET_CODE = `
/* ---- FxLMS Processor with momentum ---- */
class FxLMSProc extends AudioWorkletProcessor {
    constructor(opts) {
        super();
        this.N = opts.processorOptions?.taps || 128;
        this.S = 64;
        this.mu = 0.01;
        this.momentum = 0.9;
        this.w = new Float32Array(this.N);
        this.sHat = new Float32Array(this.S);
        this.xBuf = new Float32Array(this.N);
        this.yBuf = new Float32Array(this.S);
        this.xpBuf = new Float32Array(this.N);
        this.wPrev = new Float32Array(this.N); // momentum buffer (pooled)
        this.sError = 0;
        this.count = 0;
        // init secondary path as base-delayed impulse
        for (let i = 0; i < this.S; i++) this.sHat[i] = (i === 0 ? 1.0 : 0.15 * Math.exp(-i * 0.08));
        this.port.onmessage = (e) => {
            const d = e.data;
            if (d.t === 'mu') this.mu = d.v;
            else if (d.t === 'mom') this.momentum = d.v;
            else if (d.t === 'taps') { this.N = Math.min(256, Math.max(32, d.v)); this.allocBuffers(); }
            else if (d.t === 'reset') { this.w.fill(0); this.wPrev.fill(0); this.xBuf.fill(0); this.yBuf.fill(0); this.xpBuf.fill(0); }
            else if (d.t === 'delay') {
                const delay = Math.max(0, Math.min(this.S - 1, Math.round(d.v)));
                this.sHat.fill(0); this.sHat[delay] = 1.0;
                for (let i = delay + 1; i < Math.min(this.S, delay + 16); i++) this.sHat[i] = 0.2 * Math.exp(-(i - delay) * 0.12);
            }
        };
    }
    allocBuffers() {
        this.w = new Float32Array(this.N); this.xBuf = new Float32Array(this.N);
        this.xpBuf = new Float32Array(this.N); this.wPrev = new Float32Array(this.N);
    }
    process(inputs, outputs) {
        const inCh = inputs[0]?.[0], outCh = outputs[0]?.[0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            // shift x buffer
            for (let j = this.N - 1; j > 0; j--) this.xBuf[j] = this.xBuf[j - 1];
            this.xBuf[0] = x;
            // filter x through W(z) => y
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.xBuf[j];
            outCh[i] = -y;
            // shift y buffer
            for (let j = this.S - 1; j > 0; j--) this.yBuf[j] = this.yBuf[j - 1];
            this.yBuf[0] = y;
            // filtered-x reference: x' = x * S_hat
            for (let j = this.N - 1; j > 0; j--) this.xpBuf[j] = this.xpBuf[j - 1];
            let xp = 0;
            const limS = Math.min(this.S, this.N);
            for (let j = 0; j < limS; j++) xp += this.sHat[j] * this.xBuf[j];
            this.xpBuf[0] = xp;
            // y' = y * S_hat
            let yp = 0;
            for (let j = 0; j < this.S; j++) yp += this.sHat[j] * this.yBuf[j];
            const e = x - yp;
            // FxLMS with momentum
            let power = 0;
            for (let j = 0; j < this.N; j++) power += this.xpBuf[j] * this.xpBuf[j];
            const norm = 1 / (power + 1e-4);
            for (let j = 0; j < this.N; j++) {
                const dw = this.mu * e * this.xpBuf[j] * norm;
                const delta = dw + this.momentum * this.wPrev[j];
                this.w[j] += delta;
                this.wPrev[j] = delta;
                this.w[j] *= 0.99998; // weight leakage
            }
            this.sError = 0.995 * this.sError + 0.005 * Math.abs(e);
        }
        if (++this.count % 16 === 0) this.port.postMessage({ t: 'err', v: this.sError });
        return true;
    }
}
registerProcessor('fxlms-proc', FxLMSProc);

/* ---- Normalized LMS Processor ---- */
class NLMSProc extends AudioWorkletProcessor {
    constructor(opts) {
        super();
        this.N = opts.processorOptions?.taps || 128;
        this.mu = 0.02; this.momentum = 0.9;
        this.w = new Float32Array(this.N); this.buf = new Float32Array(this.N);
        this.wPrev = new Float32Array(this.N); this.sError = 0; this.count = 0;
        this.port.onmessage = (e) => {
            const d = e.data;
            if (d.t === 'mu') this.mu = d.v;
            else if (d.t === 'mom') this.momentum = d.v;
            else if (d.t === 'taps') { this.N = Math.min(256,Math.max(32,d.v)); this.w = new Float32Array(this.N); this.buf = new Float32Array(this.N); this.wPrev = new Float32Array(this.N); }
            else if (d.t === 'reset') { this.w.fill(0); this.wPrev.fill(0); this.buf.fill(0); }
        };
    }
    process(inputs, outputs) {
        const inCh = inputs[0]?.[0], outCh = outputs[0]?.[0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            for (let j = this.N - 1; j > 0; j--) this.buf[j] = this.buf[j - 1];
            this.buf[0] = x;
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.buf[j];
            outCh[i] = -y;
            const err = x - y;
            let power = 0;
            for (let j = 0; j < this.N; j++) power += this.buf[j] * this.buf[j];
            const norm = 1 / (power + 1e-4);
            for (let j = 0; j < this.N; j++) {
                const dw = this.mu * err * this.buf[j] * norm;
                const delta = dw + this.momentum * this.wPrev[j];
                this.w[j] += delta; this.wPrev[j] = delta;
            }
            this.sError = 0.99 * this.sError + 0.01 * Math.abs(err);
        }
        if (++this.count % 16 === 0) this.port.postMessage({ t: 'err', v: this.sError });
        return true;
    }
}
registerProcessor('nlms-proc', NLMSProc);
`;

