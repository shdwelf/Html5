<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ANC Studio Pro — Adaptive FxLMS + Howling Suppression</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap');
        
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(ellipse at 10% 0%, #1e1b4b 0%, transparent 55%),
                        radial-gradient(ellipse at 90% 100%, #0c4a6e 0%, transparent 55%),
                        #050a16;
            min-height: 100vh;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        
        .glass {
            backdrop-filter: blur(14px);
            background: rgba(8, 12, 30, 0.65);
            border: 1px solid rgba(148, 163, 184, 0.08);
        }
        .glass-hover:hover {
            background: rgba(8, 12, 30, 0.82);
            border-color: rgba(34, 211, 238, 0.2);
        }
        
        .glow-active {
            box-shadow: 0 0 40px rgba(34, 211, 238, 0.25),
                        0 0 80px rgba(34, 211, 238, 0.1),
                        inset 0 0 0 1px rgba(34, 211, 238, 0.15);
        }
        .pulse-ring { animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; }
        @keyframes pulse-ring {
            0% { transform: scale(0.85); opacity: 0.5; }
            80%, 100% { transform: scale(1.35); opacity: 0; }
        }
        .btn-active { animation: btn-glow 2s ease-in-out infinite; }
        @keyframes btn-glow {
            0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
            50% { box-shadow: 0 0 40px rgba(239, 68, 68, 0.7); }
        }
        .dot { width: 8px; height: 8px; border-radius: 50%; }
        .dot.live { animation: blink 1s ease-in-out infinite; }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }
        
        /* Sliders */
        input[type="range"] {
            -webkit-appearance: none; appearance: none; height: 4px;
            border-radius: 2px; background: #1e293b; outline: none; cursor: pointer;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none; width: 14px; height: 14px;
            border-radius: 50%; box-shadow: 0 0 6px currentColor;
            cursor: pointer; transition: transform .15s;
        }
        input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.15); }
        input[type="range"]::-moz-range-thumb {
            width: 14px; height: 14px; border: none; border-radius: 50%;
            background: currentColor; box-shadow: 0 0 6px currentColor;
        }
        
        .chip { transition: all .2s; }
        .chip.on {
            background: linear-gradient(135deg, rgba(8,145,178,.35), rgba(37,99,235,.35));
            border-color: rgba(34,211,238,.5); color: #e0f2fe;
        }
        
        /* Alert pulse */
        .alert-flash {
            animation: alert-flash 0.3s ease-out;
        }
        @keyframes alert-flash {
            0% { background: rgba(239,68,68,.4); }
            100% { background: transparent; }
        }
        
        .howl-indicator { transition: all .15s; }
        .howl-indicator.active {
            background: rgba(239,68,68,.3); border-color: rgba(239,68,68,.7);
            box-shadow: 0 0 12px rgba(239,68,68,.4);
        }
        
        .scrollbar-thin::-webkit-scrollbar { width: 4px; }
        .scrollbar-thin::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }
    </style>
</head>
<body class="text-white">

<div class="min-h-screen flex flex-col items-center p-3 pb-8">
    
