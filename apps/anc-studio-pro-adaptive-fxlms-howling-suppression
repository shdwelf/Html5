/* ============================================================
 *  CALIBRATION
 * ============================================================ */
async function calibrate() {
    stText.textContent = 'Calibrating...'; stText.className = 'text-amber-400 font-medium text-[11px]';
    $('calStatus').classList.remove('hidden');
    $('calStatus').textContent = 'Step 1/4: Creating audio context...';
    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        const calCtx = new AC({ latencyHint: 'interactive' });
        // Measure base latency
        const baseLat = (calCtx.baseLatency || 0);
        const outLat = (calCtx.outputLatency || 0);
        const total = Math.round((baseLat + outLat) * 1000);
        S.calibratedLatency = total;
        await calCtx.close();

        // Measure noise floor via mic
        $('calStatus').textContent = 'Step 2/4: Measuring noise floor...';
        const testStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
        const testCtx = new AC({ latencyHint: 'interactive' });
        const testSrc = testCtx.createMediaStreamSource(testStream);
        const testAnalyser = testCtx.createAnalyser();
        testAnalyser.fftSize = 2048; testAnalyser.smoothingTimeConstant = 0.9;
        testSrc.connect(testAnalyser);

        // Collect noise profile over 2 seconds
        const profile = new Float32Array(testAnalyser.frequencyBinCount);
        const temp = new Float32Array(testAnalyser.frequencyBinCount);
        let samples = 0;
        await new Promise(resolve => {
            const start = performance.now();
            const poll = () => {
                if (performance.now() - start > 2000) { resolve(); return; }
                testAnalyser.getFloatFrequencyData(temp);
                for (let i = 0; i < temp.length; i++) profile[i] += temp[i];
                samples++;
                requestAnimationFrame(poll);
            };
            poll();
        });
        for (let i = 0; i < profile.length; i++) profile[i] /= samples;
        S.noiseProfile = profile;

        testStream.getTracks().forEach(t => t.stop());
        await testCtx.close();

        $('calStatus').textContent = 'Step 3/4: Computing delay compensation...';
        // Set delay slider to calibrated value
        if (S.mode === 'fxlms') {
            const samples = Math.round((S.calibratedLatency / 1000) * 48000);
            if (S.proc) S.proc.port.postMessage({ t: 'delay', v: Math.min(63, samples) });
        }

        $('calStatus').textContent = `✔ Calibrated: ${S.calibratedLatency}ms latency, ${samples} noise samples`;
        $('calStatus').className = 'text-[9px] text-emerald-400';
        stText.textContent = 'Calibrated ✔';
        stText.className = 'text-emerald-400 font-medium text-[11px]';
        setTimeout(() => { stText.textContent = 'Ready'; stText.className = 'text-slate-400 font-medium text-[11px]'; }, 2000);
    } catch(e) {
        console.error('Calibration failed:', e);
        $('calStatus').textContent = 'Calibration failed: ' + e.message;
        $('calStatus').className = 'text-[9px] text-red-400';
        stText.textContent = 'Ready';
        stText.className = 'text-slate-400 font-medium text-[11px]';
    }
}

/* ============================================================
 *  HOWLING DETECTION (runs on main thread via analyser)
 * ============================================================ */
let howlFreqData = null;
function detectHowling() {
    if (!howlEnable.checked || !S.analyser || !S.running) return;
    if (!howlFreqData) howlFreqData = new Float32Array(S.analyser.frequencyBinCount);
    S.analyser.getFloatFrequencyData(howlFreqData);

    const bins = howlFreqData.length;
    const nyquist = S.ac.sampleRate / 2;
    const peakThresh = S.howlThresh; // dB — any bin above this is suspect

    // Look for unusually high narrowband peaks (hallmark of howling)
    for (let i = 2; i < bins - 10; i++) {
        const mag = howlFreqData[i];
        if (mag < peakThresh) continue;
        // Check if this bin is significantly louder than neighbors (narrow band = howling signature)
        const neighbors = (howlFreqData[i - 1] + howlFreqData[i + 1]) / 2;
        const farNeighbors = (howlFreqData[Math.max(0, i - 4)] + howlFreqData[Math.min(bins - 1, i + 4)]) / 2;
        if (mag - neighbors > 8 && mag - farNeighbors > 12) {
            const freq = (i / bins) * nyquist;
            addNotch(freq);
            break; // one per frame
        }
    }

    // Remove stale notches that are no longer needed (release after 3 seconds)
    const now = performance.now();
    S.howlNotches = S.howlNotches.filter(h => {
        if (now - h.time > 3000) {
            try { h.node.disconnect(); } catch(e){}
            return false;
        }
        return true;
    });
    howlCount.textContent = S.howlNotches.length;
    updateHowlUI();
}

function addNotch(freq) {
    if (!S.ac || !S.running) return;
    // Don't add duplicate frequencies
    if (S.howlNotches.some(h => Math.abs(h.freq - freq) < freq * 0.05)) {
        S.howlNotches.find(h => Math.abs(h.freq - freq) < freq * 0.05).time = performance.now();
        return;
    }
    if (S.howlNotches.length >= 6) {
        // Replace oldest
        const old = S.howlNotches.shift();
        try { old.node.disconnect(); } catch(e){}
    }
    const notch = S.ac.createBiquadFilter();
    notch.type = 'notch';
    notch.frequency.value = freq;
    notch.Q.value = 120; // ultra-narrow notch (dbx AFS-style)

    // Insert before limiter
    if (S.preGain) {
        try { S.preGain.disconnect(); } catch(e){}
        S.preGain.connect(notch);
        // reconnect rest of chain from notch
        reconnectChain(notch);
    }
    S.howlNotches.push({ freq, node: notch, time: performance.now() });
    howlCount.textContent = S.howlNotches.length;
    updateHowlUI();

    // Visual alert
    howlAlert.classList.add('alert-flash');
    setTimeout(() => howlAlert.classList.remove('alert-flash'), 400);
}

function reconnectChain(fromNode) {
    // Simple: just reconnect preFilter downstream
    if (S.preFilter) {
        fromNode.connect(S.preFilter);
    } else if (S.bands.length > 0) {
        fromNode.connect(S.xovers[0]);
    }
}

function clearNotches() {
    S.howlNotches.forEach(h => { try { h.node.disconnect(); } catch(e){} });
    S.howlNotches = [];
    howlCount.textContent = '0';
    updateHowlUI();
    // Rebuild audio graph (simplest: stop/start won't work while running, so reconnect)
    if (S.preGain && S.preFilter) {
        try { S.preGain.disconnect(); } catch(e){}
        S.preGain.connect(S.preFilter);
    }
}

function updateHowlUI() {
    const active = S.howlNotches.length > 0;
    howlAlert.classList.toggle('active', active);
    howlAlert.textContent = active ? `🛡 ${S.howlNotches.length} NOTCH` : 'HOWL OK';
    pHowl.textContent = active ? `🛡 GUARD(${S.howlNotches.length})` : (howlEnable.checked ? '🛡 GUARD' : '🟢 OPEN');
}

/* ============================================================
 *  START / STOP
 * ============================================================ */
async function start() {
    try {
        stText.textContent = 'Initializing...'; stText.className = 'text-cyan-400 font-medium text-[11px]';

        const AC = window.AudioContext || window.webkitAudioContext;
        S.ac = new AC({ latencyHint: 'interactive' });
        if (S.ac.state === 'suspended') await S.ac.resume();

        // Load worklet
        try {
            const blob = new Blob([WORKLET_CODE], { type: 'application/javascript' });
            const url = URL.createObjectURL(blob);
            await S.ac.audioWorklet.addModule(url);
            URL.revokeObjectURL(url);
        } catch(e) {
            console.warn('Worklet failed, using phase mode:', e);
            S.mode = 'phase';
        }

        // Mic
        S.stream = await navigator.mediaDevices.getUserMedia({
            audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, latency: 0, channelCount: 1 }
        });

        S.src = S.ac.createMediaStreamSource(S.stream);

        // Analyser
        S.analyser = S.ac.createAnalyser();
        S.analyser.fftSize = 2048;
        S.analyser.smoothingTimeConstant = 0.75;

        // Pre-gain
        S.preGain = S.ac.createGain(); S.preGain.gain.value = 1.0;

        // Pre-filter (allpass by default, noise profile if calibrated)
        S.preFilter = S.ac.createBiquadFilter();
        S.preFilter.type = 'allpass';

        // 4-band splitter
        const lp200 = S.ac.createBiquadFilter(); lp200.type = 'lowpass'; lp200.frequency.value = 200; lp200.Q.value = 0.707;
        const hp200 = S.ac.createBiquadFilter(); hp200.type = 'highpass'; hp200.frequency.value = 200; hp200.Q.value = 0.707;
        const lp1k = S.ac.createBiquadFilter(); lp1k.type = 'lowpass'; lp1k.frequency.value = 1000; lp1k.Q.value = 0.707;
        const hp1k = S.ac.createBiquadFilter(); hp1k.type = 'highpass'; hp1k.frequency.value = 1000; hp1k.Q.value = 0.707;
        const lp4k = S.ac.createBiquadFilter(); lp4k.type = 'lowpass'; lp4k.frequency.value = 4000; lp4k.Q.value = 0.707;
        const hp4k = S.ac.createBiquadFilter(); hp4k.type = 'highpass'; hp4k.frequency.value = 4000; hp4k.Q.value = 0.707;
        S.xovers = [lp200, hp200, lp1k, hp1k, lp4k, hp4k];

        // Band gains + inverters
        S.bands = [];
        const mixer = S.ac.createGain(); mixer.gain.value = 1.0;
        for (let i = 0; i < 4; i++) {
            const g = S.ac.createGain(); g.gain.value = S.perBandGains[i];
            const inv = S.ac.createGain(); inv.gain.value = -1.0;
            g.connect(inv); inv.connect(mixer);
            S.bands.push({ gain: g, inverter: inv });
        }

        // Limiter
        S.limiter = S.ac.createDynamicsCompressor();
        S.limiter.threshold.value = -6; S.limiter.knee.value = 0;
        S.limiter.ratio.value = 20; S.limiter.attack.value = 0.001; S.limiter.release.value = 0.03;

        // Output
        S.outGain = S.ac.createGain(); S.outGain.gain.value = 1.0;

        // Audio processing node (FxLMS/NLMS or phase)
        if ((S.mode === 'fxlms' || S.mode === 'adaptive') && S.ac.audioWorklet) {
            const ProcClass = S.mode === 'fxlms' ? 'fxlms-proc' : 'nlms-proc';
            S.proc = new AudioWorkletNode(S.ac, ProcClass, { processorOptions: { taps: S.taps } });
            S.proc.port.postMessage({ t: 'mu', v: S.mu });
            S.proc.port.postMessage({ t: 'mom', v: S.momentum });
            S.proc.port.onmessage = (e) => {
                if (e.data.t === 'err') {
                    $('sErr').textContent = e.data.v.toFixed(3);
                    $('sRed').textContent = Math.min(40, Math.round(-20 * Math.log10(Math.max(e.data.v, 0.001)))).toFixed(0) + 'dB';
                }
            };
            mixer.connect(S.proc);
            S.proc.connect(S.limiter);
        } else {
            mixer.connect(S.limiter);
        }
        S.limiter.connect(S.outGain);
        S.outGain.connect(S.ac.destination);

        // Audio graph: src → preGain → (tap: analyser, preFilter) → crossover tree → bands
        S.src.connect(S.preGain);
        S.preGain.connect(S.analyser); // monitor tap
        S.preGain.connect(S.preFilter);
        S.preFilter.connect(lp200); S.preFilter.connect(hp200);
        lp200.connect(S.bands[0].gain);
        hp200.connect(lp1k); hp200.connect(hp1k);
        lp1k.connect(S.bands[1].gain);
        hp1k.connect(lp4k); hp1k.connect(hp4k);
        lp4k.connect(S.bands[2].gain);
        hp4k.connect(S.bands[3].gain);

        // UI
        S.running = true; S.ab = false;
        btnLbl.textContent = 'Stop ANC';
        startBtn.classList.remove('from-cyan-600','to-blue-500','shadow-cyan-500/25');
        startBtn.classList.add('from-red-600','to-red-500','shadow-red-500/25','btn-active');
        const mNames = { fxlms: 'FxLMS Active', adaptive: 'NLMS Active', phase: 'Phase Inversion' };
        stText.textContent = mNames[S.mode]; stText.className = 'text-green-400 font-medium text-[11px]';
        stDot.className = 'dot bg-green-400 live';
        mainCard.classList.add('glow-active');
        pulseEffect.classList.add('pulse-ring');
        vizOverlay.style.display = 'none';
        $('sLat').textContent = ((S.ac.baseLatency||0)*1000).toFixed(1) + 'ms';

        fitCanvas(); S.spectroImg = ctx.createImageData(canvas.width, canvas.height);
        S.spectroOff = 0; howlFreqData = null;
        visualize();

    } catch(e) {
        console.error(e);
        stText.textContent = 'Error: ' + (e.name === 'NotAllowedError' ? 'Mic denied' : e.message);
        stText.className = 'text-red-400 font-medium text-[11px]'; stDot.className = 'dot bg-red-500 live';
        cleanup();
    }
}

function applyBands() {
    if (!S.running || !S.bands) return;
    S.bands.forEach((b, i) => b.gain.gain.setTargetAtTime(S.perBandGains[i], S.ac.currentTime, 0.01));
}

function stop() {
    S.running = false;
    if (S.animId) cancelAnimationFrame(S.animId);
    stopRecord();
    cleanup();
    btnLbl.textContent = 'Start ANC';
    startBtn.classList.remove('from-red-600','to-red-500','shadow-red-500/25','btn-active');
    startBtn.classList.add('from-cyan-600','to-blue-500','shadow-cyan-500/25');
    stText.textContent = 'Ready'; stText.className = 'text-slate-400 font-medium text-[11px]';
    stDot.className = 'dot bg-slate-600';
    mainCard.classList.remove('glow-active'); pulseEffect.classList.remove('pulse-ring');
    vizOverlay.style.display = 'flex';
    ['sLat','sPeak','sLvl','sErr','sRed'].forEach(id => $(id).textContent = '--');
    ctx.clearRect(0,0,canvas.width,canvas.height);
    clearNotches();
    S.howlNotches = []; howlCount.textContent = '0';
}

function cleanup() {
    if (S.stream) { S.stream.getTracks().forEach(t=>t.stop()); S.stream = null; }
    if (S.ac) { S.ac.close().catch(()=>{}); S.ac = null; }
    S.src = S.analyser = S.preGain = S.preFilter = S.proc = S.limiter = S.outGain = null;
    S.bands = []; S.xovers = [];
}

/* ============================================================
 *  RECORDING
 * ============================================================ */
function startRecord() {
    if (!S.running) return;
    const dest = S.ac.createMediaStreamDestination();
    S.outGain.connect(dest);
    S.recorder = new MediaRecorder(dest.stream, { mimeType: 'audio/webm;codecs=opus' });
    S.recChunks = [];
    S.recorder.ondataavailable = e => S.recChunks.push(e.data);
    S.recorder.onstop = () => {
        const blob = new Blob(S.recChunks, { type: 'audio/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = 'anc-recording-'+Date.now()+'.webm';
        a.click(); URL.revokeObjectURL(url);
        $('recBtn').textContent = '⏺';
    };
    S.recorder.start();
    $('recBtn').textContent = '⏹';
    $('recBtn').classList.add('text-red-400');
}

function stopRecord() {
    if (S.recorder && S.recorder.state === 'recording') {
        S.recorder.stop();
    }
    $('recBtn').classList.remove('text-red-400');
}

/* ============================================================
 *  VISUALIZER
 * ============================================================ */
function fitCanvas() {
    const r = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = r.width * dpr; canvas.height = r.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

let animId = null;
let freqData = null, floatFreq = null, timeData = null;

function visualize() {
    fitCanvas();
    if (!freqData) freqData = new Uint8Array(S.analyser.frequencyBinCount);
    if (!floatFreq) floatFreq = new Float32Array(S.analyser.frequencyBinCount);
    if (!timeData) timeData = new Float32Array(S.analyser.fftSize);
    const $lat = $('sLat'), $peak = $('sPeak'), $lvl = $('sLvl');

    function frame() {
        animId = requestAnimationFrame(frame);
        const r = canvas.getBoundingClientRect();
        const W = r.width, H = r.height;

        S.analyser.getByteFrequencyData(freqData);

        if (S.vizTab === 'spectrum') {
            ctx.fillStyle = 'rgba(6,10,24,.55)'; ctx.fillRect(0,0,W,H);
            // Grid
            ctx.strokeStyle = 'rgba(100,116,139,.06)'; ctx.lineWidth = 1;
            for (let i=1;i<4;i++) { ctx.beginPath(); ctx.moveTo(0,H*i/4); ctx.lineTo(W,H*i/4); ctx.stroke(); }
            const bars = 64; const bw = W/bars;
            const ny = S.ac.sampleRate/2;
            for (let i=0;i<bars;i++) {
                const f1 = 20*Math.pow(ny/20,i/bars);
                const f2 = 20*Math.pow(ny/20,(i+1)/bars);
                const b1 = Math.floor(f1/ny*freqData.length), b2 = Math.ceil(f2/ny*freqData.length);
                let s=0,c=0; for(let j=b1;j<b2&&j<freqData.length;j++){s+=freqData[j];c++;}
                const v = c>0?(s/c)/255:0; const bh = v*H*.82; const x=i*bw;
                const mid=(f1+f2)/2;
                const col = mid<200?'#22d3ee':mid<1000?'#3b82f6':mid<4000?'#a855f7':'#ec4899';
                const grad = ctx.createLinearGradient(0,H-bh,0,H);
                grad.addColorStop(0,col); grad.addColorStop(1,col+'18');
                ctx.fillStyle = grad; ctx.fillRect(x+1,H-bh,bw-2,bh);
                ctx.fillStyle = col; ctx.fillRect(x+1,H-bh-1.5,bw-2,1.5);
            }
            ctx.fillStyle = 'rgba(148,163,184,.4)'; ctx.font = '9px "JetBrains Mono", monospace';
            ctx.fillText('20',3,H-3); ctx.fillText('200',W*.33,H-3); ctx.fillText('1k',W*.58,H-3); ctx.fillText('8k',W-20,H-3);
        } else if (S.vizTab === 'waveform') {
            S.analyser.getFloatTimeDomainData(timeData);
            ctx.fillStyle = 'rgba(6,10,24,.4)'; ctx.fillRect(0,0,W,H);
            ctx.strokeStyle = 'rgba(100,116,139,.1)'; ctx.beginPath(); ctx.moveTo(0,H/2); ctx.lineTo(W,H/2); ctx.stroke();
            const grad = ctx.createLinearGradient(0,0,W,0);
            grad.addColorStop(0,'#22d3ee'); grad.addColorStop(.5,'#3b82f6'); grad.addColorStop(1,'#a855f7');
            ctx.strokeStyle = grad; ctx.lineWidth = 2;
            ctx.beginPath(); const sl = W/timeData.length;
            for(let i=0;i<timeData.length;i++){const x=i*sl;const y=(.5+timeData[i]/2)*H;i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}
            ctx.stroke();
            ctx.shadowColor='#22d3ee';ctx.shadowBlur=6;ctx.stroke();ctx.shadowBlur=0;
        } else if (S.vizTab === 'spectrogram') {
            const dpr = window.devicePixelRatio||1;
            const Wpx=Math.floor(W*dpr),Hpx=Math.floor(H*dpr);
            if(!S.spectroImg||S.spectroImg.width!==Wpx||S.spectroImg.height!==Hpx){
                S.spectroImg=ctx.createImageData(Wpx,Hpx);S.spectroOff=0;
            }
            S.spectroImg.data.copyWithin(Wpx*4,0,Wpx*4*(Hpx-1));
            const ny=S.ac.sampleRate/2;
            for(let x=0;x<Wpx;x++){
                const f=20*Math.pow(ny/20,x/Wpx);
                const bin=Math.floor(f/ny*freqData.length);
                const v=freqData[Math.min(bin,freqData.length-1)]/255;
                let rr,gg,bb;
                if(v<.25){rr=v*4*0;gg=v*4*10;bb=30+v*4*80;}
                else if(v<.5){const t=(v-.25)*4;rr=0+t*40;gg=10+t*110;bb=110-t*20;}
                else if(v<.75){const t=(v-.5)*4;rr=40+t*130;gg=120+t*60;bb=90-t*70;}
                else{const t=(v-.75)*4;rr=170+t*85;gg=180-t*80;bb=20+t*60;}
                const idx=x*4;
                S.spectroImg.data[idx]=Math.min(255,rr);
                S.spectroImg.data[idx+1]=Math.min(255,gg);
                S.spectroImg.data[idx+2]=Math.min(255,bb);
                S.spectroImg.data[idx+3]=255;
            }
            ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.putImageData(S.spectroImg,0,0);ctx.restore();
            ctx.fillStyle='rgba(255,255,255,.45)';ctx.font='9px "JetBrains Mono", monospace';
            ctx.fillText('20Hz',3,H-3); ctx.fillText('1kHz',W/2-10,H-3); ctx.fillText('8kHz',W-22,H-3);
            ctx.fillText('↑new',3,11);
        }

        // Stats
        let mI=0,mV=0;
        for(let i=2;i<freqData.length/2;i++){if(freqData[i]>mV){mV=freqData[i];mI=i;}}
        const ny=S.ac.sampleRate/2;
        $peak.textContent = mV>0?Math.round(mI/freqData.length*ny):'--';

        S.analyser.getFloatTimeDomainData(timeData);
        let sq=0;for(let i=0;i<timeData.length;i++)sq+=timeData[i]*timeData[i];
        const rms=Math.sqrt(sq/timeData.length);
        const db=20*Math.log10(Math.max(rms,1e-5));
        $lvl.textContent=(db>-80?db.toFixed(0):'-∞')+'dB';

        // Howling detection pass
        detectHowling();
    }
    S.animId = animId;
    frame();
}

/* ============================================================
 *  INIT
 * ============================================================ */
fitCanvas();
window.addEventListener('resize', () => { if (S.running) fitCanvas(); });
</script>
</body>
