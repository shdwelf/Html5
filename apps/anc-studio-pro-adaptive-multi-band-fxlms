<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ANC Studio Pro — Adaptive Multi-Band FxLMS</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 15% 10%, #312e81 0%, transparent 55%),
                        radial-gradient(circle at 85% 90%, #0c4a6e 0%, transparent 55%),
                        #060a17;
            min-height: 100vh;
        }
        
        .mono { font-family: 'JetBrains Mono', monospace; }
        
        .glow-active {
            box-shadow: 0 0 40px rgba(34, 211, 238, 0.35),
                        0 0 80px rgba(34, 211, 238, 0.15),
                        inset 0 0 0 1px rgba(34, 211, 238, 0.2);
        }
        
        .pulse-ring { animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; }
        @keyframes pulse-ring {
            0% { transform: scale(0.85); opacity: 0.6; }
            80%, 100% { transform: scale(1.4); opacity: 0; }
        }
        
        .btn-active { animation: btn-glow 2s ease-in-out infinite; }
        @keyframes btn-glow {
            0%, 100% { box-shadow: 0 0 25px rgba(239, 68, 68, 0.5); }
            50% { box-shadow: 0 0 45px rgba(239, 68, 68, 0.8); }
        }
        
        .status-dot {
            width: 9px; height: 9px; border-radius: 50%;
        }
        .status-dot.active { animation: blink-active 1s ease-in-out infinite; }
        @keyframes blink-active {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.25; }
        }
        
        .glass {
            backdrop-filter: blur(14px);
            background: rgba(15, 23, 42, 0.55);
        }
        
        /* Slider */
        input[type="range"] {
            -webkit-appearance: none; appearance: none;
            height: 5px; border-radius: 3px;
            background: #1e293b; outline: none; cursor: pointer;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none;
            width: 16px; height: 16px; border-radius: 50%;
            background: linear-gradient(135deg, #22d3ee, #3b82f6);
            box-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
            transition: transform 0.15s;
        }
        input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.2); }
        input[type="range"]::-moz-range-thumb {
            width: 16px; height: 16px; border: none; border-radius: 50%;
            background: linear-gradient(135deg, #22d3ee, #3b82f6);
            box-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
        }
        
        .chip {
            transition: all 0.2s ease;
        }
        .chip.active {
            background: linear-gradient(135deg, rgba(8,145,178,0.4), rgba(37,99,235,0.4));
            border-color: rgba(34,211,238,0.6);
            color: #e0f2fe;
        }
        
        .tab {
            transition: all 0.2s ease;
        }
        .tab.active {
            background: rgba(34,211,238,0.15);
            color: #67e8f9;
            border-bottom-color: #22d3ee;
        }
        
        .band-slider::-webkit-slider-thumb {
            background: linear-gradient(135deg, var(--band-color, #22d3ee), var(--band-color-2, #3b82f6));
        }
        
        .ab-btn:active, .ab-btn.held {
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            transform: scale(0.98);
        }
        
        .scroll-thin::-webkit-scrollbar { height: 4px; width: 4px; }
        .scroll-thin::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }
    </style>
</head>
<body class="text-white overflow-x-hidden">

<div class="min-h-screen flex flex-col items-center p-3 md:p-6">
    
    <!-- Header -->
    <header class="text-center mb-4 mt-2">
