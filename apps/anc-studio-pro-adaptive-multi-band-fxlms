        State.micSource.connect(State.analyser);
        State.micSource.connect(State.preFilter);

        // Update UI
        State.isRunning = true;
        btnText.textContent = 'Stop ANC';
        toggleBtn.classList.remove('from-cyan-600', 'to-blue-500', 'shadow-cyan-500/30');
        toggleBtn.classList.add('from-red-600', 'to-red-500', 'shadow-red-500/30', 'btn-active');
        const modeNames = { phase: 'Phase Inversion Active', adaptive: 'Adaptive LMS Learning', fxlms: 'FxLMS Feedback ANC' };
        statusText.textContent = modeNames[State.mode];
        statusDot.className = 'status-dot bg-green-400 status-dot active';
        mainCard.classList.add('glow-active');
        pulseEffect.classList.add('pulse-ring');
        overlay.style.display = 'none';

        // Init spectrogram image buffer
