        State.preFilter.type = State.filterType === 'allpass' ? 'allpass' : State.filterType;
        State.preFilter.frequency.value = parseFloat(cutoffSlider.value);
        State.preFilter.Q.value = 0.7;

        // Build 4-band multi-band splitter using crossover filters
        // Band 0: 20-200 Hz   (LP at 200)
        // Band 1: 200-1k Hz   (HP at 200, LP at 1000)
        // Band 2: 1k-4k Hz    (HP at 1000, LP at 4000)
        // Band 3: 4k+ Hz      (HP at 4000)
        const xoverFreqs = [200, 1000, 4000];
        State.bandSplits = [];
        State.bandFilters = [];
        
        for (let i = 0; i < 4; i++) {
            const bandGain = State.audioCtx.createGain();
            bandGain.gain.value = State.bandGains[i];
            
            const bandInverter = State.audioCtx.createGain();
            bandInverter.gain.value = -1.0;
            
            bandGain.connect(bandInverter);
            
            State.bandFilters.push({ gain: bandGain, inverter: bandInverter });
