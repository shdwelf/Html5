            // Mix inverted bands, then run through processor as an additional adaptive layer
            // Simpler: bypass phase inversion for band0 (sub) and use worklet
            // Let's do: band inverters → mixer → worklet → limiter
            for (let i = 0; i < 4; i++) {
                State.bandFilters[i].inverter.connect(State.outputMixer);
            }
            State.outputMixer.connect(State.processor);
            State.processor.connect(State.limiter);
            State.limiter.connect(State.outputGain);
            State.outputGain.connect(State.audioCtx.destination);
        }

        if (State.mode === 'phase') {
            State.outputMixer.connect(State.limiter);
            State.limiter.connect(State.outputGain);
            State.outputGain.connect(State.audioCtx.destination);
        }

