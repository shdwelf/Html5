            const ProcessorClass = State.mode === 'fxlms' ? 'fxlms-processor' : 'lms-processor';
            State.processor = new AudioWorkletNode(State.audioCtx, ProcessorClass);
            State.processor.port.postMessage({ type: 'setMu', mu: parseFloat(muSlider.value) });
            if (State.mode === 'fxlms') {
                const delayMs = parseFloat(delaySlider.value);
                const samples = (delayMs / 1000) * State.audioCtx.sampleRate;
                State.processor.port.postMessage({ type: 'setDelay', delaySamples: samples });
            }
            State.processor.port.onmessage = (e) => {
                if (e.data.type === 'error') {
                    // Update LMS error display (throttle)
                    if (!State._errThrottle || Date.now() - State._errThrottle > 100) {
                        State._errThrottle = Date.now();
                        lmsError.textContent = e.data.value.toFixed(3);
                    }
                }
