        fitCanvas();
        State.spectroImage = ctx2d.createImageData(canvas.width, canvas.height);
        State.spectroOffset = 0;

        visualize();

    } catch (err) {
        console.error('ANC Error:', err);
        let msg = err.message || 'Unknown error';
        if (err.name === 'NotAllowedError') msg = 'Microphone permission denied';
        else if (err.name === 'SecurityError') msg = 'HTTPS required';
        else if (err.name === 'NotFoundError') msg = 'No microphone found';
        statusText.textContent = 'Error: ' + msg;
        statusText.className = 'text-red-400 font-medium text-xs';
        statusDot.className = 'status-dot bg-red-500 status-dot active';
        cleanup();
    }
}

function applyBandGains() {
    if (!State.isRunning || !State.bandFilters) return;
    State.bandFilters.forEach((b, i) => {
        b.gain.gain.setTargetAtTime(State.bandGains[i], State.audioCtx.currentTime, 0.01);
    });
}

function stopSystem() {
    State.isRunning = false;
    if (State.animId) cancelAnimationFrame(State.animId);
    stopTone();
    cleanup();
    
    btnText.textContent = 'Start ANC';
    toggleBtn.classList.remove('from-red-600', 'to-red-500', 'shadow-red-500/30', 'btn-active');
    toggleBtn.classList.add('from-cyan-600', 'to-blue-500', 'shadow-cyan-500/30');
    statusText.textContent = 'System Ready';
    statusDot.className = 'status-dot bg-slate-600';
    mainCard.classList.remove('glow-active');
    pulseEffect.classList.remove('pulse-ring');
    overlay.style.display = 'flex';
    latencyValue.textContent = '--'; freqValue.textContent = '--';
    levelValue.textContent = '--'; lmsError.textContent = '--';
    const r = canvas.getBoundingClientRect();
    ctx2d.clearRect(0, 0, r.width, r.height);
}

function cleanup() {
    if (State.stream) { State.stream.getTracks().forEach(t => t.stop()); State.stream = null; }
    if (State.audioCtx) { State.audioCtx.close().catch(()=>{}); State.audioCtx = null; }
    State.micSource = State.analyser = State.preFilter = State.processor =
        State.outputMixer = State.limiter = State.outputGain = State.bandFilters = null;
}

/* ============================================================
 *  VISUALIZER
 * ============================================================ */
function fitCanvas() {
    const r = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = r.width * dpr;
    canvas.height = r.height * dpr;
    ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function visualize() {
    fitCanvas();
    const freqData = new Uint8Array(State.analyser.frequencyBinCount);
    const floatFreq = new Float32Array(State.analyser.frequencyBinCount);
    const timeData = new Float32Array(State.analyser.fftSize);
    
    function frame() {
        State.animId = requestAnimationFrame(frame);
        const r = canvas.getBoundingClientRect();
        const W = r.width, H = r.height;
        
        if (State.vizTab === 'spectrum') {
            State.analyser.getByteFrequencyData(freqData);
            ctx2d.fillStyle = 'rgba(10, 15, 30, 0.5)';
            ctx2d.fillRect(0, 0, W, H);
            
            // Draw grid
            ctx2d.strokeStyle = 'rgba(100, 116, 139, 0.1)';
            ctx2d.lineWidth = 1;
            for (let i = 1; i < 4; i++) {
                const y = H * i / 4;
                ctx2d.beginPath(); ctx2d.moveTo(0, y); ctx2d.lineTo(W, y); ctx2d.stroke();
            }
            
            // Log-scaled bars
            const bars = 64;
            const bw = W / bars;
            const nyquist = State.audioCtx.sampleRate / 2;
            for (let i = 0; i < bars; i++) {
                // Map bar to frequency (log scale)
                const f1 = 20 * Math.pow(nyquist / 20, i / bars);
                const f2 = 20 * Math.pow(nyquist / 20, (i + 1) / bars);
                const b1 = Math.floor(f1 / nyquist * freqData.length);
                const b2 = Math.ceil(f2 / nyquist * freqData.length);
                let sum = 0, cnt = 0;
                for (let j = b1; j < b2 && j < freqData.length; j++) { sum += freqData[j]; cnt++; }
                const v = cnt > 0 ? (sum / cnt) / 255 : 0;
                const bh = v * H * 0.85;
                const x = i * bw;
                
                // Color based on band
                let color;
                const mid = (f1 + f2) / 2;
                if (mid < 200) color = '#22d3ee';
                else if (mid < 1000) color = '#3b82f6';
                else if (mid < 4000) color = '#a855f7';
                else color = '#ec4899';
                
                const grad = ctx2d.createLinearGradient(0, H - bh, 0, H);
                grad.addColorStop(0, color);
                grad.addColorStop(1, color + '22');
                ctx2d.fillStyle = grad;
                ctx2d.fillRect(x + 1, H - bh, bw - 2, bh);
                
                // Top cap
                ctx2d.fillStyle = color;
                ctx2d.fillRect(x + 1, H - bh - 2, bw - 2, 2);
            }
            
            // Frequency labels
            ctx2d.fillStyle = 'rgba(148, 163, 184, 0.5)';
            ctx2d.font = '9px "JetBrains Mono", monospace';
            ctx2d.fillText('20', 4, H - 4);
            ctx2d.fillText('200', W * 0.33, H - 4);
            ctx2d.fillText('1k', W * 0.58, H - 4);
            ctx2d.fillText('8k', W - 20, H - 4);
            
        } else if (State.vizTab === 'waveform') {
            State.analyser.getFloatTimeDomainData(timeData);
            ctx2d.fillStyle = 'rgba(10, 15, 30, 0.4)';
            ctx2d.fillRect(0, 0, W, H);
            
            // Center line
            ctx2d.strokeStyle = 'rgba(100, 116, 139, 0.15)';
            ctx2d.beginPath(); ctx2d.moveTo(0, H/2); ctx2d.lineTo(W, H/2); ctx2d.stroke();
            
            // Waveform with gradient
            ctx2d.lineWidth = 2;
            const grad = ctx2d.createLinearGradient(0, 0, W, 0);
            grad.addColorStop(0, '#22d3ee');
            grad.addColorStop(0.5, '#3b82f6');
            grad.addColorStop(1, '#a855f7');
            ctx2d.strokeStyle = grad;
            ctx2d.beginPath();
            const slice = W / timeData.length;
            for (let i = 0; i < timeData.length; i++) {
                const x = i * slice;
                const y = (0.5 + timeData[i] / 2) * H;
                i === 0 ? ctx2d.moveTo(x, y) : ctx2d.lineTo(x, y);
            }
            ctx2d.stroke();
            
            // Glow
            ctx2d.shadowColor = '#22d3ee';
            ctx2d.shadowBlur = 8;
            ctx2d.stroke();
            ctx2d.shadowBlur = 0;
            
        } else if (State.vizTab === 'spectrogram') {
            // Spectrogram waterfall (scrolling heat map)
            State.analyser.getByteFrequencyData(freqData);
            const dpr = window.devicePixelRatio || 1;
            const Wpx = Math.floor(W * dpr);
            const Hpx = Math.floor(H * dpr);
            
            if (!State.spectroImage || State.spectroImage.width !== Wpx || State.spectroImage.height !== Hpx) {
                State.spectroImage = ctx2d.createImageData(Wpx, Hpx);
                State.spectroOffset = 0;
            }
            
            // Scroll existing down by 1 row
            const rowBytes = Wpx * 4;
            State.spectroImage.data.copyWithin(rowBytes, 0, rowBytes * (Hpx - 1));
            
            // Draw new row at top (index 0)
            const nyquist = State.audioCtx.sampleRate / 2;
            for (let x = 0; x < Wpx; x++) {
                // Log-scale frequency mapping
                const f = 20 * Math.pow(nyquist / 20, x / Wpx);
                const bin = Math.floor(f / nyquist * freqData.length);
                const v = freqData[Math.min(bin, freqData.length - 1)] / 255;
                
                // Viridis-inspired colormap
                let r, g, b;
                if (v < 0.25) {
                    r = v * 4 * 30; g = v * 4 * 20; b = 80 + v * 4 * 80;
                } else if (v < 0.5) {
                    const t = (v - 0.25) * 4;
                    r = 30 + t * 50; g = 20 + t * 150; b = 160 - t * 40;
                } else if (v < 0.75) {
                    const t = (v - 0.5) * 4;
                    r = 80 + t * 150; g = 170 + t * 50; b = 120 - t * 100;
                } else {
                    const t = (v - 0.75) * 4;
                    r = 230 + t * 25; g = 220 - t * 60; b = 20 + t * 50;
                }
                
                const idx = x * 4;
                State.spectroImage.data[idx] = r;
                State.spectroImage.data[idx + 1] = g;
                State.spectroImage.data[idx + 2] = b;
                State.spectroImage.data[idx + 3] = 255;
            }
            
            ctx2d.save();
            ctx2d.setTransform(1, 0, 0, 1, 0, 0);
            ctx2d.putImageData(State.spectroImage, 0, 0);
            ctx2d.restore();
            
            // Overlay frequency labels
            ctx2d.fillStyle = 'rgba(255,255,255,0.5)';
            ctx2d.font = '9px "JetBrains Mono", monospace';
            ctx2d.fillText('20Hz', 4, H - 4);
            ctx2d.fillText('1kHz', W/2 - 10, H - 4);
            ctx2d.fillText('8kHz', W - 24, H - 4);
            ctx2d.fillText('↑ time', 4, 12);
        }
        
        // Update stats (shared across tabs)
        updateStats(freqData, timeData);
    }
    frame();
}

function updateStats(freqData, timeData) {
    // Peak freq
    let maxI = 0, maxV = 0;
    for (let i = 2; i < freqData.length / 2; i++) {
        if (freqData[i] > maxV) { maxV = freqData[i]; maxI = i; }
    }
    const ny = State.audioCtx.sampleRate / 2;
    const peak = Math.round((maxI / freqData.length) * ny);
    freqValue.textContent = peak > 0 ? peak : '--';
    
    // RMS from time domain (already populated by spectrogram frame; we reuse)
    State.analyser.getFloatTimeDomainData(timeData);
    let sum = 0;
    for (let i = 0; i < timeData.length; i++) sum += timeData[i] * timeData[i];
    const rms = Math.sqrt(sum / timeData.length);
    const db = 20 * Math.log10(Math.max(rms, 1e-5));
    levelValue.textContent = (db > -80 ? db.toFixed(0) : '-∞') + 'dB';
}

/* ============================================================
 *  INIT
 * ============================================================ */
fitCanvas();
window.addEventListener('resize', () => { if (State.isRunning) fitCanvas(); });
</script>
