                <button class="tab active px-3 py-1.5 text-xs font-semibold border-b-2 border-transparent" data-tab="spectrum">Spectrum</button>
                <button class="tab px-3 py-1.5 text-xs font-semibold border-b-2 border-transparent text-slate-400" data-tab="waveform">Waveform</button>
                <button class="tab px-3 py-1.5 text-xs font-semibold border-b-2 border-transparent text-slate-400" data-tab="spectrogram">Spectrogram</button>
