                <div class="flex flex-col items-center">
                    <div class="text-[9px] text-slate-500 mb-1">LOW</div>
                    <div class="text-[9px] mono text-blue-300 mb-1.5">200–1k</div>
                    <div class="h-24 flex flex-col justify-end mb-1">
                        <input type="range" id="band1" class="band-slider w-20" style="--band-color:#3b82f6;--band-color-2:#6366f1; writing-mode: vertical-lr; direction: rtl; transform: rotate(180deg);" min="0" max="100" value="75" orient="vertical">
                    </div>
                    <div class="text-[10px] mono text-blue-400" id="band1Label">75%</div>
                </div>
                <div class="flex flex-col items-center">
                    <div class="text-[9px] text-slate-500 mb-1">MID</div>
                    <div class="text-[9px] mono text-purple-300 mb-1.5">1k–4k</div>
                    <div class="h-24 flex flex-col justify-end mb-1">
                        <input type="range" id="band2" class="band-slider w-20" style="--band-color:#8b5cf6;--band-color-2:#a855f7; writing-mode: vertical-lr; direction: rtl; transform: rotate(180deg);" min="0" max="100" value="30" orient="vertical">
                    </div>
                    <div class="text-[10px] mono text-purple-400" id="band2Label">30%</div>
                </div>
                <div class="flex flex-col items-center">
                    <div class="text-[9px] text-slate-500 mb-1">HIGH</div>
                    <div class="text-[9px] mono text-pink-300 mb-1.5">4k+</div>
                    <div class="h-24 flex flex-col justify-end mb-1">
                        <input type="range" id="band3" class="band-slider w-20" style="--band-color:#ec4899;--band-color-2:#f43f5e; writing-mode: vertical-lr; direction: rtl; transform: rotate(180deg);" min="0" max="100" value="0" orient="vertical">
                    </div>
                    <div class="text-[10px] mono text-pink-400" id="band3Label">0%</div>
                </div>
            </div>
            
            <div class="text-[10px] text-slate-500 mt-2 italic">
                Tip: ANC is most effective below 1 kHz. Disable high-band to avoid latency artifacts.
            </div>
        </div>

        <!-- Advanced Controls -->
        <div class="bg-slate-800/30 rounded-2xl p-3.5 mb-3 border border-slate-700/30">
            <div class="flex items-center justify-between mb-3">
                <label class="text-xs font-bold text-slate-200">Advanced DSP</label>
                <button id="toggleAdv" class="text-[10px] text-slate-500 hover:text-slate-300">▾ Expand</button>
            </div>
            <div id="advPanel" class="hidden space-y-2.5">
                <!-- FxLMS step size -->
                <div>
                    <div class="flex justify-between text-[10px] text-slate-400 mb-1">
                        <span>Learning Rate (μ)</span>
                        <span id="muLabel" class="text-cyan-400 mono">0.020</span>
                    </div>
                    <input type="range" id="muSlider" min="0.001" max="0.1" value="0.02" step="0.001" class="w-full">
                </div>
                <!-- Secondary path delay -->
                <div>
                    <div class="flex justify-between text-[10px] text-slate-400 mb-1">
                        <span>Secondary Path Delay</span>
                        <span id="delayLabel" class="text-cyan-400 mono">0 ms</span>
                    </div>
                    <input type="range" id="delaySlider" min="0" max="30" value="0" step="0.5" class="w-full">
                </div>
                <!-- Limiter threshold -->
                <div>
                    <div class="flex justify-between text-[10px] text-slate-400 mb-1">
                        <span>Limiter Threshold</span>
                        <span id="limLabel" class="text-cyan-400 mono">-6 dB</span>
                    </div>
                    <input type="range" id="limSlider" min="-30" max="0" value="-6" step="1" class="w-full">
                </div>
                <!-- Filter type -->
                <div>
                    <div class="text-[10px] text-slate-400 mb-1.5">Pre-filter Shape</div>
                    <div class="grid grid-cols-4 gap-1 text-[10px]">
                        <button class="filter-chip chip active py-1 rounded bg-cyan-600/20 border border-cyan-500/40" data-filter="allpass">Flat</button>
                        <button class="filter-chip chip py-1 rounded bg-slate-700/30 border border-slate-600/30" data-filter="lowpass">LP</button>
                        <button class="filter-chip chip py-1 rounded bg-slate-700/30 border border-slate-600/30" data-filter="highpass">HP</button>
                        <button class="filter-chip chip py-1 rounded bg-slate-700/30 border border-slate-600/30" data-filter="notch">Notch</button>
                    </div>
                </div>
                <!-- Filter cutoff -->
                <div>
                    <div class="flex justify-between text-[10px] text-slate-400 mb-1">
                        <span>Pre-filter Cutoff</span>
                        <span id="cutoffLabel" class="text-cyan-400 mono">1000 Hz</span>
                    </div>
                    <input type="range" id="cutoffSlider" min="20" max="8000" value="1000" step="10" class="w-full">
                </div>
                <!-- Stereo toggle -->
                <label class="flex items-center gap-2 text-[10px] text-slate-400 cursor-pointer">
                    <input type="checkbox" id="stereoCheck" class="accent-cyan-500">
                    <span>Independent L/R channel processing (stereo)</span>
                </label>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-4 gap-2 text-center mb-3">
            <div class="bg-slate-800/40 rounded-xl py-2">
                <div id="latencyValue" class="text-sm font-bold text-cyan-400 mono">--</div>
                <div class="text-[9px] text-slate-500">Latency</div>
            </div>
            <div class="bg-slate-800/40 rounded-xl py-2">
                <div id="freqValue" class="text-sm font-bold text-purple-400 mono">--</div>
                <div class="text-[9px] text-slate-500">Peak Hz</div>
            </div>
            <div class="bg-slate-800/40 rounded-xl py-2">
                <div id="levelValue" class="text-sm font-bold text-green-400 mono">--</div>
                <div class="text-[9px] text-slate-500">Input dB</div>
            </div>
            <div class="bg-slate-800/40 rounded-xl py-2">
                <div id="lmsError" class="text-sm font-bold text-amber-400 mono">--</div>
                <div class="text-[9px] text-slate-500">LMS Err</div>
            </div>
        </div>

        <!-- Start/Stop + A/B -->
        <div class="grid grid-cols-4 gap-2 mb-3">
            <div class="col-span-3 relative flex justify-center">
                <div id="pulseEffect" class="absolute w-24 h-24 rounded-full bg-cyan-500 opacity-0 pointer-events-none"></div>
                <button id="toggleBtn" class="relative z-10 w-full py-3.5 px-6 rounded-full font-bold transition-all duration-300 bg-gradient-to-r from-cyan-600 to-blue-500 hover:from-cyan-500 hover:to-blue-400 transform hover:scale-[1.02] active:scale-95 shadow-lg shadow-cyan-500/30">
                    <span id="btnText">Start ANC</span>
                </button>
            </div>
            <button id="abBtn" class="ab-btn py-3.5 rounded-full font-bold text-sm transition-all bg-slate-700 border border-slate-600 text-slate-300 select-none">
                A/B
            </button>
        </div>

        <!-- Test Tone -->
        <div class="bg-slate-800/30 rounded-xl p-2.5 mb-3 border border-slate-700/30">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
                    <span class="text-[11px] font-semibold text-slate-300">Test Tone</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <input type="number" id="toneFreq" value="440" min="20" max="8000" class="w-14 text-xs px-1.5 py-1 rounded bg-slate-900 border border-slate-700 text-cyan-400 mono">
                    <span class="text-[10px] text-slate-500">Hz</span>
                    <button id="toneBtn" class="text-[10px] font-bold px-2.5 py-1 rounded bg-amber-500/20 border border-amber-500/40 text-amber-300 hover:bg-amber-500/30 transition">Play</button>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div class="flex items-center justify-center gap-2.5">
            <div id="statusDot" class="status-dot bg-slate-600"></div>
            <span id="statusText" class="text-slate-400 font-medium text-xs">System Ready</span>
        </div>
    </div>

    <!-- Info Panels -->
    <div class="grid md:grid-cols-3 gap-2.5 mt-3 w-full max-w-xl">
        <div class="glass rounded-2xl p-3 border border-slate-700/50">
            <div class="flex items-center gap-1.5 mb-1.5">
                <div class="w-6 h-6 rounded-lg bg-cyan-500/20 flex items-center justify-center">
                    <svg class="w-3 h-3 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="font-bold text-[11px]">Phase Mode</h3>
            </div>
            <p class="text-[10px] text-slate-400 leading-relaxed">Broadband 180° signal inversion. Low-latency, best for steady drone noise.</p>
        </div>
        <div class="glass rounded-2xl p-3 border border-slate-700/50">
            <div class="flex items-center gap-1.5 mb-1.5">
                <div class="w-6 h-6 rounded-lg bg-purple-500/20 flex items-center justify-center">
                    <svg class="w-3 h-3 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="font-bold text-[11px]">Adaptive LMS</h3>
            </div>
            <p class="text-[10px] text-slate-400 leading-relaxed">Self-learning filter converges on repeating noise patterns over time.</p>
        </div>
        <div class="glass rounded-2xl p-3 border border-slate-700/50">
            <div class="flex items-center gap-1.5 mb-1.5">
                <div class="w-6 h-6 rounded-lg bg-amber-500/20 flex items-center justify-center">
                    <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
                </div>
                <h3 class="font-bold text-[11px]">FxLMS</h3>
            </div>
            <p class="text-[10px] text-slate-400 leading-relaxed">Filtered-x LMS models the speaker→mic secondary path. Most advanced.</p>
        </div>
    </div>

    <!-- Safety -->
    <div class="mt-3 p-3 rounded-2xl bg-amber-500/10 border border-amber-500/20 max-w-xl w-full">
        <div class="flex gap-2">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-[10px] text-amber-200/80 leading-relaxed">
                <span class="font-bold text-amber-400">Hearing Safety:</span> Web-based ANC is not a substitute for certified earplugs. Use hardware ANC or passive protection at loud events. Limiter enabled by default to prevent feedback oscillation.
            </p>
        </div>
    </div>

    <p class="text-[10px] text-slate-600 mt-4 text-center max-w-md">
        HTTPS required · Microphone permission · Wired headphones recommended · Latency varies by device
    </p>
</div>

<script>
/* ============================================================
 *  AUDIO WORKLET CODE - Adaptive LMS & FxLMS processors
 *  Runs on dedicated audio thread (not main thread)
 * ============================================================ */
const WORKLET_CODE = `
/* ---------- Standard LMS adaptive filter ---------- */
class LMSProcessor extends AudioWorkletProcessor {
    constructor() {
        super();
        this.N = 128;                  // filter length (taps)
        this.mu = 0.02;                // learning rate
        this.w = new Float32Array(this.N);
        this.buf = new Float32Array(this.N);
        this.smoothError = 0;
        this.port.onmessage = (e) => {
            if (e.data.type === 'setMu') this.mu = e.data.mu;
            else if (e.data.type === 'reset') { this.w.fill(0); this.buf.fill(0); }
        };
    }
    process(inputs, outputs) {
        const inCh = inputs[0] && inputs[0][0];
        const outCh = outputs[0] && outputs[0][0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            // shift buffer
            for (let j = this.N - 1; j > 0; j--) this.buf[j] = this.buf[j-1];
            this.buf[0] = x;
            // compute estimate (dot product)
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.buf[j];
            // output inverted estimate (anti-noise)
            outCh[i] = -y;
            // LMS update: error = desired - output estimate; desired is the input itself
            const err = x - y;
            // Power-normalized update (NLMS-style, more stable)
            let power = 0;
            for (let j = 0; j < this.N; j++) power += this.buf[j] * this.buf[j];
            const norm = 1 / (power + 1e-4);
            for (let j = 0; j < this.N; j++) {
                this.w[j] += this.mu * err * this.buf[j] * norm;
            }
            this.smoothError = 0.99 * this.smoothError + 0.01 * Math.abs(err);
        }
        // report error back to main thread occasionally
        this.port.postMessage({ type: 'error', value: this.smoothError });
        return true;
    }
}
registerProcessor('lms-processor', LMSProcessor);

/* ---------- FxLMS: Filtered-x LMS with secondary path estimate ---------- */
class FxLMSProcessor extends AudioWorkletProcessor {
    constructor() {
        super();
        this.N = 128;              // control filter length
        this.S = 64;               // secondary path estimate length
        this.mu = 0.01;            // learning rate (smaller for FxLMS stability)
        this.w = new Float32Array(this.N);    // control filter W(z)
        this.sHat = new Float32Array(this.S); // secondary path estimate S^(z)
        this.xBuf = new Float32Array(this.N); // reference x buffer
        this.yBuf = new Float32Array(this.S); // output y buffer (for secondary path)
        this.xPrimeBuf = new Float32Array(this.N); // x' = x filtered by S^(z)
        this.smoothError = 0;

        // Initialize secondary path estimate as simple decaying impulse
        // (models a delay + slight resonance — the speaker-to-mic path)
        for (let i = 0; i < this.S; i++) {
            this.sHat[i] = 0.5 * Math.exp(-i * 0.05) * (i % 2 === 0 ? 1 : -0.3);
        }

        this.port.onmessage = (e) => {
            if (e.data.type === 'setMu') this.mu = e.data.mu;
            else if (e.data.type === 'reset') { this.w.fill(0); this.xBuf.fill(0); this.yBuf.fill(0); this.xPrimeBuf.fill(0); }
            else if (e.data.type === 'setDelay') {
                // re-init secondary path as delayed impulse
                const d = Math.max(0, Math.min(this.S - 1, Math.round(e.data.delaySamples)));
                this.sHat.fill(0);
                this.sHat[d] = 1.0;
                // add slight ring
                for (let i = d + 1; i < Math.min(this.S, d + 20); i++) {
                    this.sHat[i] = 0.3 * Math.exp(-(i - d) * 0.1);
                }
            }
        };
    }
    process(inputs, outputs) {
        const inCh = inputs[0] && inputs[0][0];
        const outCh = outputs[0] && outputs[0][0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            // 1) Shift reference buffer
            for (let j = this.N - 1; j > 0; j--) this.xBuf[j] = this.xBuf[j-1];
            this.xBuf[0] = x;
            // 2) Filter x through W(z) to produce y (anti-noise)
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.xBuf[j];
            // 3) Output -y (destructive)
            outCh[i] = -y;
            // 4) Shift y through secondary path buffer
            for (let j = this.S - 1; j > 0; j--) this.yBuf[j] = this.yBuf[j-1];
            this.yBuf[0] = y;
            // 5) Compute x' = x filtered by S^(z) (the "filtered-x" reference)
            for (let j = this.N - 1; j > 0; j--) this.xPrimeBuf[j] = this.xPrimeBuf[j-1];
            let xp = 0;
            const maxS = Math.min(this.S, this.N);
            for (let j = 0; j < maxS; j++) {
                xp += this.sHat[j] * this.xBuf[j];
            }
            this.xPrimeBuf[0] = xp;
            // 6) Compute error: e(n) = d(n) - y'(n), where y' is y filtered by S
            // In a pure software ANC without error mic, we approximate e(n) ~ x(n)
            // because the goal is to drive the input itself toward zero (noise estimate).
            let yp = 0;
            for (let j = 0; j < this.S; j++) yp += this.sHat[j] * this.yBuf[j];
            const e = x - yp;
            // 7) FxLMS update: w += mu * e * x'
            let power = 0;
            for (let j = 0; j < this.N; j++) power += this.xPrimeBuf[j] * this.xPrimeBuf[j];
            const norm = 1 / (power + 1e-4);
            for (let j = 0; j < this.N; j++) {
                this.w[j] += this.mu * e * this.xPrimeBuf[j] * norm;
                // weight leakage to prevent divergence
                this.w[j] *= 0.99995;
            }
            this.smoothError = 0.995 * this.smoothError + 0.005 * Math.abs(e);
        }
        this.port.postMessage({ type: 'error', value: this.smoothError });
        return true;
    }
}
registerProcessor('fxlms-processor', FxLMSProcessor);
