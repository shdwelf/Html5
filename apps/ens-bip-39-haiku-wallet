<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ensō × BIP-39 Haiku Wallet</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Serif+JP:wght@300;700&display=swap');

  :root {
    --bg: #0a0a0f;
    --bg2: #12121a;
    --bg3: #1a1a28;
    --fg: #c8c8d4;
    --fg-bright: #e8e8f0;
    --accent: #00e5a0;
    --accent2: #00bcd4;
    --error: #ff4466;
    --warn: #ffaa22;
    --cyan: #00ddcc;
    --border: #2a2a3a;
    --radius: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
    background: var(--bg);
    color: var(--fg);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* TAB NAV */
  .tab-nav {
    display: flex;
    background: var(--bg2);
    border-bottom: 2px solid var(--border);
    padding: 0 1rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .tab-btn {
    padding: 0.75rem 1.5rem;
    background: none;
    border: none;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .tab-btn:hover { color: var(--accent); }
  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* TAB PANELS */
  .tab-panel { display: none; padding: 1.5rem; max-width: 1400px; margin: 0 auto; }
  .tab-panel.active { display: block; }

  /* ENSŌ TAB */
  .enso-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    min-height: calc(100vh - 60px);
  }
  @media (max-width: 900px) {
    .enso-layout { grid-template-columns: 1fr; }
  }

  .canvas-wrap {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 500px;
  }
  .canvas-wrap canvas {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius);
  }

  .enso-controls {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-y: auto;
    max-height: calc(100vh - 90px);
  }

  .seed-display {
    background: var(--bg3);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.75rem;
    margin-bottom: 1rem;
    text-align: center;
  }
  .seed-display .label { font-size: 0.7rem; color: var(--accent2); text-transform: uppercase; letter-spacing: 0.1em; }
  .seed-display .value { font-size: 1.4rem; color: var(--accent); font-weight: 700; word-break: break-all; }

  .ctrl-group {
    margin-bottom: 0.75rem;
  }
  .ctrl-group label {
    display: block;
    font-size: 0.75rem;
    color: var(--fg);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ctrl-group input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    background: var(--bg3);
    height: 6px;
    -webkit-appearance: none;
    border-radius: 3px;
  }
  .ctrl-group input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px;
    background: var(--accent);
    border-radius: 50%;
    cursor: pointer;
  }
  .ctrl-group select {
    width: 100%;
    background: var(--bg3);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.4rem;
    font-family: inherit;
    font-size: 0.85rem;
  }
  .ctrl-group .val-display {
    float: right;
    color: var(--accent);
    font-size: 0.75rem;
  }

  .btn-row { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
  .btn {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg3);
    color: var(--fg);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
    font-weight: 700;
  }
  .btn-primary:hover { background: #00ffaa; }
  .btn-danger { border-color: var(--error); color: var(--error); }
  .btn-danger:hover { background: var(--error); color: #fff; }

  /* WALLET TAB */
  .wallet-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    min-height: calc(100vh - 60px);
  }
  @media (max-width: 900px) {
    .wallet-layout { grid-template-columns: 1fr; }
  }

  .haiku-display {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    overflow-y: auto;
    max-height: calc(100vh - 90px);
  }

  .haiku-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-bottom: 1rem;
    position: relative;
    transition: border-color 0.2s;
  }
  .haiku-card:hover { border-color: var(--accent); }

  .haiku-card .wallet-type {
    font-size: 0.65rem;
    color: var(--accent2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .haiku-card .haiku-lines {
    margin-bottom: 0.75rem;
  }
  .haiku-card .haiku-line {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--fg-bright);
  }
  .haiku-card .haiku-line .syllable-count {
    color: var(--accent);
    font-size: 0.7rem;
    margin-left: 0.5rem;
  }

  .haiku-card .mnemonic-raw {
    font-size: 0.7rem;
    color: var(--fg);
    opacity: 0.6;
    word-break: break-all;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .haiku-card .card-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .haiku-card .card-actions .btn { font-size: 0.75rem; padding: 0.3rem 0.7rem; }

  .wallet-controls {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-y: auto;
    max-height: calc(100vh - 90px);
  }

  .mining-status {
    background: var(--bg3);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.75rem;
    margin-bottom: 1rem;
    text-align: center;
  }
  .mining-status .label { font-size: 0.7rem; color: var(--accent2); text-transform: uppercase; letter-spacing: 0.1em; }
  .mining-status .counter { font-size: 1.6rem; color: var(--accent); font-weight: 700; }

  .saved-list {
    margin-top: 1rem;
  }
  .saved-list h3 {
    font-size: 0.75rem;
    color: var(--accent2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .saved-item {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }
  .saved-item .saved-preview {
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  .saved-item .btn { font-size: 0.65rem; padding: 0.2rem 0.5rem; }

  /* TERMINAL TAB */
  .terminal-wrap {
    background: #000;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: calc(100vh - 90px);
    display: flex;
    flex-direction: column;
  }
  .terminal-output {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .terminal-output .sys { color: var(--cyan); }
  .terminal-output .err { color: var(--error); }
  .terminal-output .usr { color: var(--fg-bright); }
  .terminal-output .notice { color: var(--warn); }

  .terminal-input-row {
    display: flex;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .terminal-input-row .prompt {
    padding: 0.75rem 0.5rem 0.75rem 1rem;
    color: var(--accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .terminal-input-row input {
    flex: 1;
    background: none;
    border: none;
    color: var(--fg-bright);
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.75rem 1rem 0.75rem 0;

  /* IRC SIDEBAR */
  .irc-win-item {
    padding: 0.35rem 0.6rem;
    font-size: 0.8rem;
    color: var(--fg);
    cursor: pointer;
    border-left: 2px solid transparent;
    transition: all 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .irc-win-item:hover { background: var(--bg3); }
  .irc-win-item.active {
    background: var(--bg3);
    border-left-color: var(--accent);
    color: var(--accent);
  }
  .irc-win-item .unread-badge {
    background: var(--error);
    color: #fff;
    font-size: 0.6rem;
    padding: 0 0.3rem;
    border-radius: 8px;
    min-width: 14px;
    text-align: center;
    display: none;
  }
  .irc-win-item .unread-badge.has-unread { display: inline-block; }
    outline: none;
  }

  /* ENCRYPT MODAL */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.active { display: flex; }
  .modal-box {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    max-width: 400px;
    width: 90%;
  }
  .modal-box h2 { font-size: 1rem; color: var(--accent); margin-bottom: 1rem; }
  .modal-box input[type="password"],
  .modal-box input[type="text"] {
    width: 100%;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .modal-box input:focus { border-color: var(--accent); outline: none; }
  .modal-box .btn-row { justify-content: flex-end; }

  /* TOAST */
  .toast-container {
    position: fixed;
    top: 70px;
    right: 1rem;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .toast {
    background: var(--bg3);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    font-size: 0.8rem;
    color: var(--accent);
    animation: fadeIn 0.2s, fadeOut 0.3s 2.7s;
    max-width: 300px;
  }
  .toast.error { border-color: var(--error); color: var(--error); }
  @keyframes fadeIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
</style>
</head>
<body>

<nav class="tab-nav">
  <button class="tab-btn active" data-tab="enso">🖌️ Ensō</button>
  <button class="tab-btn" data-tab="wallet">🔐 Wallet Haiku</button>
  <button class="tab-btn" data-tab="terminal">💻 Terminal</button>
</nav>

<!-- ═══════════════════ ENSŌ TAB ═══════════════════ -->
<div class="tab-panel active" id="tab-enso">
  <div class="enso-layout">
    <div class="canvas-wrap">
      <canvas id="enso-canvas" width="700" height="700"></canvas>
    </div>
    <div class="enso-controls">
      <div class="seed-display">
        <div class="label">Ensō Seed ID</div>
        <div class="value" id="enso-seed-display">—</div>
      </div>

      <div class="btn-row" style="margin-top:0;margin-bottom:1rem;">
        <button class="btn btn-primary" id="btn-random-seed">🎲 Random Seed</button>
        <button class="btn" id="btn-download-png">📥 Download PNG</button>
      </div>

      <div class="ctrl-group">
        <label>Ink Load <span class="val-display" id="val-inkLoad">4</span></label>
        <input type="range" id="ctrl-inkLoad" min="1" max="10" value="4">
      </div>
      <div class="ctrl-group">
        <label>Direction</label>
        <select id="ctrl-direction">
          <option value="clockwise" selected>Clockwise</option>
          <option value="counter">Counter-Clockwise</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Paper Hue</label>
        <select id="ctrl-paperHue">
          <option value="cyan" selected>Cyan</option>
          <option value="warm">Warm Cream</option>
          <option value="white">White</option>
          <option value="dark">Dark</option>
          <option value="sage">Sage</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Brush Size <span class="val-display" id="val-brushSize">6</span></label>
        <input type="range" id="ctrl-brushSize" min="1" max="20" value="6">
      </div>
      <div class="ctrl-group">
        <label>Ink Density <span class="val-display" id="val-inkDensity">3</span></label>
        <input type="range" id="ctrl-inkDensity" min="1" max="10" value="3">
      </div>
      <div class="ctrl-group">
        <label>X/Y Stretch</label>
        <select id="ctrl-xyStretch">
          <option value="equal">Equal</option>
          <option value="unequal" selected>Unequal</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Paper Texture <span class="val-display" id="val-paperTexture">4</span></label>
        <input type="range" id="ctrl-paperTexture" min="0" max="10" value="4">
      </div>
      <div class="ctrl-group">
        <label>Bristle Density <span class="val-display" id="val-bristleDensity">5</span></label>
        <input type="range" id="ctrl-bristleDensity" min="1" max="20" value="5">
      </div>
      <div class="ctrl-group">
        <label>Signature Style</label>
        <select id="ctrl-signatureStyle">
          <option value="dark" selected>Dark</option>
          <option value="light">Light</option>
          <option value="red">Red Seal</option>
          <option value="none">None</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Brushstroke Size</label>
        <select id="ctrl-brushstrokeSize">
          <option value="small">Small</option>
          <option value="medium" selected>Medium</option>
          <option value="large">Large</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Brushstroke Start <span class="val-display" id="val-brushStart">216°</span></label>
        <input type="range" id="ctrl-brushStart" min="0" max="359" value="216">
      </div>

      <button class="btn btn-primary" id="btn-regenerate" style="width:100%;margin-top:0.5rem;"> ⟳ Regenerate Ensō</button>
    </div>
  </div>
</div>

<!-- ═══════════════════ WALLET TAB ═══════════════════ -->
<div class="tab-panel" id="tab-wallet">
  <div class="wallet-layout">
    <div class="haiku-display" id="haiku-display">
      <div style="text-align:center;color:var(--fg);opacity:0.4;padding:4rem 1rem;">
        <div style="font-size:3rem;margin-bottom:1rem;">🎋</div>
        <div>Mine a BIP-39 Haiku Wallet to begin</div>
        <div style="font-size:0.75rem;margin-top:0.5rem;">A valid 12-word mnemonic where the syllables form a 5-7-5 haiku</div>
      </div>
    </div>
    <div class="wallet-controls">
      <div class="mining-status">
        <div class="label">Wallets Mined</div>
        <div class="counter" id="mined-counter">0</div>
      </div>

      <div class="ctrl-group">
        <label>Wallet Type</label>
        <select id="ctrl-walletType">
          <option value="bitcoin">Bitcoin (BIP-44)</option>
          <option value="ethereum">Ethereum (BIP-44)</option>
          <option value="litecoin">Litecoin (BIP-44)</option>
        </select>
      </div>
      <div class="ctrl-group">
        <label>Mine Count <span class="val-display" id="val-mineCount">1</span></label>
        <input type="range" id="ctrl-mineCount" min="1" max="20" value="1">
      </div>
      <div class="ctrl-group">
        <label>Grammar Check</label>
        <select id="ctrl-grammarCheck">
          <option value="off">Off (any valid checksum)</option>
          <option value="on">On (skip non-grammatical)</option>
        </select>
      </div>

      <div class="btn-row">
        <button class="btn btn-primary" id="btn-mine" style="flex:1;">⛏️ Mine Haiku Wallet</button>
      </div>
      <div class="btn-row">
        <button class="btn" id="btn-stop-mine" style="flex:1;display:none;">⏹ Stop</button>
      </div>

      <hr style="border:none;border-top:1px solid var(--border);margin:1rem 0;">

      <div class="btn-row">
        <button class="btn" id="btn-export-txt">🔒 Export Encrypted</button>
        <button class="btn" id="btn-export-plain">📄 Export Plain</button>
        <button class="btn btn-danger" id="btn-clear-all">🗑️ Clear All</button>
      </div>

      <div class="saved-list" id="saved-list">
        <h3>Saved Wallets</h3>
        <div id="saved-items"><em style="color:var(--fg);opacity:0.3;font-size:0.8rem;">No wallets saved yet</em></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════ TERMINAL TAB ═══════════════════ -->
<div class="tab-panel" id="tab-terminal">
  <div style="display:flex;height:calc(100vh - 90px);">
    <!-- IRC Window Sidebar -->
    <div id="irc-sidebar" style="width:180px;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius) 0 0 var(--radius);overflow-y:auto;flex-shrink:0;display:flex;flex-direction:column;">
      <div style="padding:0.5rem;font-size:0.65rem;color:var(--accent2);text-transform:uppercase;letter-spacing:0.1em;border-bottom:1px solid var(--border);">Chat Windows</div>
      <div id="irc-window-list" style="flex:1;overflow-y:auto;">
        <div style="padding:0.5rem;font-size:0.75rem;color:var(--fg);opacity:0.3;text-align:center;">No windows</div>
      </div>
      <div style="padding:0.5rem;border-top:1px solid var(--border);">
        <div style="font-size:0.6rem;color:var(--accent2);margin-bottom:0.2rem;">STATUS</div>
        <div id="irc-status" style="font-size:0.75rem;color:var(--fg);">Disconnected</div>
        <div id="irc-nick-display" style="font-size:0.7rem;color:var(--accent);margin-top:0.2rem;"></div>
      </div>
    </div>
    <!-- Terminal -->
    <div class="terminal-wrap" style="border-radius:0 var(--radius) var(--radius) 0;flex:1;">
      <div class="terminal-output" id="term-output">
<span class="sys">═══════════════════════════════════════════════════</span>
<span class="sys">  PIM — Peer Instant Messaging (Web IRC Client)</span>
<span class="sys">  Converted from Java source (sgreeran/pim)</span>
<span class="sys">  Original CLI restored • GUI (Swing) commented out</span>
<span class="sys">  Type <span style="color:var(--accent)">/help</span> for commands</span>
<span class="sys">  Quick start: <span style="color:var(--accent)">/connect irc.libera.chat YourNick</span></span>
<span class="sys">═══════════════════════════════════════════════════</span>
</div>
      <div class="terminal-input-row">
        <span class="prompt" id="term-prompt">❯</span>
        <input type="text" id="term-input" placeholder="Type a command or message..." autocomplete="off">
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════ MODALS ═══════════════════ -->
<div class="modal-overlay" id="modal-export">
  <div class="modal-box">
    <h2>🔐 Encrypt Export</h2>
    <p style="font-size:0.8rem;color:var(--fg);margin-bottom:0.75rem;">Set a password to AES-256 encrypt your wallet list export.</p>
    <input type="password" id="export-password" placeholder="Password">
    <input type="password" id="export-password2" placeholder="Confirm password">
    <div class="btn-row">
      <button class="btn" id="btn-export-cancel">Cancel</button>
      <button class="btn btn-primary" id="btn-export-confirm">Export Encrypted</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-password">
  <div class="modal-box">
    <h2>🔑 Storage Password</h2>
    <p style="font-size:0.8rem;color:var(--fg);margin-bottom:0.75rem;" id="modal-password-msg">Enter password to decrypt saved wallets.</p>
    <input type="password" id="storage-password" placeholder="Password">
    <div class="btn-row">
      <button class="btn" id="btn-pw-cancel">Cancel</button>
      <button class="btn btn-primary" id="btn-pw-confirm">Confirm</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toast-container"></div>

<script src="js/wordlist.js"></script>
<script>
// Pre-flight checks
(function() {
  if (typeof BIP39_WORDLIST === 'undefined') {
    document.body.innerHTML = '<div style="color:red;padding:2rem;font-family:monospace">Error: BIP-39 wordlist failed to load. Make sure js/wordlist.js exists.</div>';
    return;
  }
  if (BIP39_WORDLIST.length !== 2048) {
    document.body.innerHTML = '<div style="color:red;padding:2rem;font-family:monospace">Error: BIP-39 wordlist has ' + BIP39_WORDLIST.length + ' words (expected 2048).</div>';
    return;
  }
  if (!window.crypto || !window.crypto.subtle) {
    document.body.innerHTML = '<div style="color:red;padding:2rem;font-family:monospace">Error: Web Crypto API not available. Use HTTPS, localhost, or a modern browser.</div>';
    return;
  }
})();
</script>
