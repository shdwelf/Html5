<meta name="application-name" content="Purple Team Lab">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Purple Team Lab">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-512.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #070a12;
  --bg2: #0d1220;
  --panel: #121a2b;
  --panel2: #18223a;
  --line: #263250;
  --text: #d7e2f5;
  --muted: #8a9ab8;
  --red: #ff4d5a;
  --red-glow: rgba(255,77,90,0.25);
  --blue: #3b9cff;
  --blue-glow: rgba(59,156,255,0.22);
  --purple: #a76bff;
  --green: #22d3a8;
  --amber: #ffbf3c;
  --cyan: #3ee7ff;
}
* { box-sizing: border-box; margin:0; padding:0; }
html, body { height:100%; }
body {
  font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  background: radial-gradient(1200px 800px at 80% -10%, #142040 0%, transparent 60%), var(--bg);
  color: var(--text);
  overflow-x: hidden;
}

a { color: var(--cyan); }

/* Top bar */
.topbar {
  position: sticky; top:0; z-index: 50;
  background: rgba(7,10,18,0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  padding: 12px 24px;
  display:flex; align-items:center; gap:24px; flex-wrap:wrap;
}
.logo { font-family: 'JetBrains Mono', monospace; font-weight:700; font-size:16px; letter-spacing: 0.5px; }
.logo span.red { color: var(--red); }
.logo span.blue { color: var(--blue); }
.logo span.purple { color: var(--purple); }
.topbar nav { display:flex; gap:18px; flex-wrap:wrap; font-size:13px; }
.topbar nav button {
  background:none; border:none; color:var(--muted); cursor:pointer; font-family:inherit; font-size:13px; font-weight:600;
  padding: 6px 10px; border-radius: 6px; transition: .15s;
}
.topbar nav button.active, .topbar nav button:hover { color: var(--text); background: #1a2338; }

.status-pills { margin-left:auto; display:flex; gap:10px; align-items:center; flex-wrap:wrap; font-size:11px; font-family:'JetBrains Mono', monospace; }
.pill { border:1px solid var(--line); background:#101828; padding:5px 10px; border-radius:999px; color: var(--muted); }
.pill.live { color: var(--green); border-color: rgba(34,211,168,.35); }
.pill.warn { color: var(--amber); border-color: rgba(255,191,60,.35); }

/* Banner */
.auth-banner {
  background: linear-gradient(90deg, rgba(167,107,255,.12), rgba(59,156,255,.12));
  border-bottom: 1px solid var(--line);
  text-align:center; padding:9px 16px;
  font-size:12px; color:#c4ceea; font-weight:600;
}
.auth-banner strong { color: var(--amber); }

/* Layout */
.wrap { max-width: 1280px; margin: 28px auto; padding: 0 22px 80px; }
.grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 18px; }
.card {
  background: linear-gradient(180deg, var(--panel) 0%, #0f1627 100%);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 18px 18px;
  box-shadow: 0 10px 40px rgba(0,0,0,.28);
  position: relative;
  overflow: hidden;
}
.card h3 {
  font-size: 12px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted);
  margin-bottom: 12px; display:flex; align-items:center; gap:8px;
}
.card h3 .dot { width:7px; height:7px; border-radius:50%; display:inline-block; }
h2.section-title { font-size: 22px; margin: 8px 0 18px; font-weight: 800; letter-spacing: -.015em; }

.col-4 { grid-column: span 4; }
.col-5 { grid-column: span 5; }
.col-6 { grid-column: span 6; }
.col-7 { grid-column: span 7; }
.col-8 { grid-column: span 8; }
.col-12 { grid-column: span 12; }

@media(max-width: 980px){
  .col-4,.col-5,.col-6,.col-7,.col-8 { grid-column: span 12; }
  .topbar nav { gap:8px; }
}

/* Red vs Blue scoreboard */
.scoreboard { display:grid; grid-template-columns: 1fr auto 1fr; gap:16px; align-items:center; }
.team-block { padding:14px; border-radius: 12px; }
.team-red { background: linear-gradient(180deg, rgba(255,77,90,.08), transparent); border:1px solid rgba(255,77,90,.25); }
.team-blue { background: linear-gradient(180deg, rgba(59,156,255,.08), transparent); border:1px solid rgba(59,156,255,.25); }
.team-block .label { font-size: 11px; text-transform:uppercase; letter-spacing:.1em; color: var(--muted); }
.team-block .score { font-size: 34px; font-weight: 800; font-family:'JetBrains Mono', monospace;}
.vs { font-family:'JetBrains Mono', monospace; color: var(--purple); font-weight:700; }
.kpi-row { display:flex; gap:14px; flex-wrap:wrap; margin-top:10px; font-size:12px; color: var(--muted); }
.kpi-row b { color: var(--text); font-family:'JetBrains Mono', monospace; }

/* Attack chain */
.chain { display:flex; gap:10px; flex-wrap:wrap; }
.chain-step {
  flex:1 1 120px;
  background:#0e1526; border:1px solid var(--line); border-radius:10px; padding:10px;
  font-size:12px; color: var(--muted); min-width:120px;
  cursor:pointer; transition:.15s;
}
.chain-step:hover { border-color: #3a4a6b; }
.chain-step.active { border-color: var(--purple); box-shadow: 0 0 18px rgba(167,107,255,.15); color: var(--text); }
.chain-step strong { display:block; color: var(--text); font-size:13px; margin-bottom:3px; }

/* Network canvas */
#netCanvas { width:100%; height: 310px; background: radial-gradient(600px 260px at 50% 0%, rgba(59,156,255,.06), transparent 70%), #0a1020; border-radius:10px; border:1px solid var(--line); display:block; }

/* Tables */
.table { width:100%; border-collapse: collapse; font-size: 12.5px; font-family:'JetBrains Mono', monospace;}
.table th { text-align:left; color: var(--muted); font-weight:600; padding: 8px 10px; border-bottom:1px solid var(--line); font-family:'Inter', sans-serif; font-size:11px; text-transform:uppercase; letter-spacing:.07em; }
.table td { padding: 9px 10px; border-bottom:1px solid #1a2338; }
.table tr:hover td { background: rgba(255,255,255,.02); }
.tag { font-size:10.5px; padding:3px 7px; border-radius:999px; border:1px solid var(--line); color: var(--muted); }
.tag.red { color: var(--red); border-color: rgba(255,77,90,.35); background: rgba(255,77,90,.07); }
.tag.blue { color: var(--blue); border-color: rgba(59,156,255,.35); background: rgba(59,156,255,.07); }
.tag.green { color: var(--green); border-color: rgba(34,211,168,.35); background: rgba(34,211,168,.07); }
.tag.amber { color: var(--amber); border-color: rgba(255,191,60,.35); background: rgba(255,191,60,.07); }

/* Packet console */
.console {
  background: #070d1a;
  border:1px solid var(--line);
  border-radius: 10px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  height: 285px;
  overflow:auto;
  padding: 12px;
  color: #b9c9e8;
}
.console .p { opacity:.95; white-space:pre; line-height:1.65; }
.console .dim { color: #6a7a98; }

/* RF Spectrum */
.spectrum-wrap { background:#090f1c; border:1px solid var(--line); border-radius:10px; padding:12px; }
#spectrumCanvas { width:100%; height: 150px; display:block; }
.spectrum-legend { display:flex; gap:16px; font-size:11px; color: var(--muted); margin-top:8px; flex-wrap:wrap;}
.legend-dot { width:9px; height:9px; border-radius:3px; display:inline-block; margin-right:5px; vertical-align:middle;}

/* Buttons */
.btn {
  background:#1b2642; color:var(--text); border:1px solid #2d3b5e;
  padding:8px 12px; border-radius:9px; cursor:pointer; font-weight:600; font-size:12.5px;
  transition:.15s;
}
.btn:hover { background:#223054; }
.btn.primary { background: linear-gradient(180deg, #3b73ff, #2d5bcf); border-color: #4a7fff; }
.btn.red { background: rgba(255,77,90,.09); border-color: rgba(255,77,90,.35); color: #ff9ba3;}
.btn.ghost { background: transparent; }
.btn-sm { padding:5px 9px; font-size:12px; border-radius:7px; }
.toolbar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px; }

/* Traceroute */
.trace-map { position:relative; background: radial-gradient(700px 300px at 20% 0%, rgba(34,211,168,.06), transparent), #0b1222; border:1px solid var(--line); border-radius:10px; height: 270px; overflow:hidden; }
.trace-nodes { position:absolute; inset:0; }
.tnode {
  position:absolute; background:#141f35; border:1px solid #2b3a5c; border-radius:10px; padding:7px 10px; font-size:11px;
  font-family:'JetBrains Mono', monospace; color:#c9d8f3; box-shadow: 0 4px 14px rgba(0,0,0,.3);
}
.tnode.hop { border-color: rgba(62,231,255,.4);}
.trace-svg { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }

input[type="text"], select {
  background:#0a1222; border:1px solid #2a3654; color: var(--text);
  padding:9px 11px; border-radius:9px; font-family:'JetBrains Mono', monospace; font-size:12.5px;
  outline:none; width:100%;
}
input[type="text"]:focus { border-color: #3b6cff; box-shadow: 0 0 0 3px rgba(59,108,255,.15); }
label.small { font-size:11px; color:var(--muted); display:block; margin-bottom:5px; }

.view { display:none; }
.view.active { display:block; animation: fade .22s ease; }
@keyframes fade { from{opacity:.4; transform: translateY(4px);} to{opacity:1; transform:none;} }

.list-tight { font-size:13px; color:#b8c7e3; line-height:1.75; }
.list-tight li { margin-left: 16px; }

.footer-note {
  color:#6d7c9b; font-size:12px; text-align:center; margin-top:34px; line-height:1.7;
  border-top:1px solid var(--line); padding-top:18px;
}
hr.soft { border:none; border-top:1px solid var(--line); margin:14px 0; }
.mono { font-family:'JetBrains Mono', monospace; }
.right { text-align:right; }
.small-muted { font-size:12px; color: var(--muted); }
.scroll-y { max-height: 310px; overflow:auto; }

/* PWA Install UI */
.install-banner {
  display:none;
  background: linear-gradient(90deg, rgba(167,107,255,.14), rgba(59,156,255,.14));
  border-bottom:1px solid var(--line);
  padding:10px 22px;
  align-items:center; justify-content: center; gap:14px;
  font-size:13px; font-weight:600;
  color:#d6e2ff;
}
.install-banner.show { display:flex; flex-wrap:wrap;}
.install-banner .btn-install {
  background: linear-gradient(180deg, #a76bff, #7a45d6);
  border-color: #b981ff; color: white;
  padding:7px 14px; border-radius: 999px; font-weight:700; cursor:pointer;
}
.btn-install-top {
  background: linear-gradient(180deg, #a76bff, #7a45d6);
  border:1px solid #b981ff; color:white;
  padding:6px 12px; border-radius:999px; font-weight:700; cursor:pointer; font-size:12px;
}
.btn-install-top:hover { filter: brightness(1.08); }
#installBtnTop { display:none; }

</style>
</head>
<body>

<div class="topbar">
