  if(deferredPrompt) installBtn.click();
  else downloadStandalone();
});
dismissInstallBtn?.addEventListener('click', ()=>{
  showInstallUI(false);
  localStorage.setItem('ptl_install_dismissed', Date.now());
});

// Service Worker
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=> {
    navigator.serviceWorker.register('./sw.js').catch(console.error);
  });
}

// Already installed? hide
window.addEventListener('appinstalled', ()=>{ showInstallUI(false); });

// Offer banner on first visit after 2.5s if not installed
if(!window.matchMedia('(display-mode: standalone)').matches){
  const dismissed = localStorage.getItem('ptl_install_dismissed');
  if(!dismissed || Date.now() - Number(dismissed) > 86400000*7){
    setTimeout(()=>{ if(!deferredPrompt) showInstallUI(true); }, 2500);
  }
}

// --- Download Standalone HTML ---
async function downloadStandalone(){
  try {
    const resp = await fetch(location.href, {cache:'no-cache'});
    let fullHtml = await resp.text();
    // Inline the manifest as a data URL so the standalone file is truly single-file
    fullHtml = fullHtml.replace('<link rel="manifest" href="manifest.webmanifest">',
      '<!-- manifest removed in standalone build -->');
    const blob = new Blob([fullHtml], {type: 'text/html'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'purple-team-lab-standalone.html';
    document.body.appendChild(a);
    a.click();
    setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  } catch(e){
    // Fallback: serialize current document
    const blob = new Blob([document.documentElement.outerHTML], {type: 'text/html'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'purple-team-lab-standalone.html';
    a.click();
    setTimeout(()=>{ URL.revokeObjectURL(a.href); }, 1000);
  }
}
document.getElementById('downloadStandaloneBtn')?.addEventListener('click', downloadStandalone);

// Keyboard: Ctrl/Cmd+S to download standalone
window.addEventListener('keydown', e=>{
  if((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='s'){
    e.preventDefault();
    downloadStandalone();
  }
});

</script>
