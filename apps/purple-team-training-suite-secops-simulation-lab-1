const nodes = [
  {x:120,y:150,label:'FW\nEDGE', c:'#3b9cff'},
  {x:280,y:90,label:'SOC\nSIEM', c:'#a76bff'},
  {x:280,y:210,label:'EDR\nServer', c:'#22d3a8'},
