];
const links = [[0,1],[0,2],[1,3],[1,4],[2,4],[2,5],[3,4],[4,5],[4,6],[5,6]];
let dragN = null;
netCanvas.addEventListener('mousedown', e=>{
  const rect = netCanvas.getBoundingClientRect();
  const mx = e.clientX-rect.left, my = e.clientY-rect.top;
  dragN = nodes.find(n=>Math.hypot(n.x-mx, n.y-my)<32) || null;
});
window.addEventListener('mouseup', ()=>dragN=null);
netCanvas.addEventListener('mousemove', e=>{
  if(!dragN) return;
  const rect = netCanvas.getBoundingClientRect();
  dragN.x = e.clientX-rect.left; dragN.y = e.clientY-rect.top;
});

function drawNet(){
  const w = netCanvas.getBoundingClientRect().width;
  nctx.clearRect(0,0,w,310);
  // links
  nctx.strokeStyle = '#2a385a'; nctx.lineWidth = 1.5;
  links.forEach(([a,b])=>{
    nctx.beginPath(); nctx.moveTo(nodes[a].x, nodes[a].y); nctx.lineTo(nodes[b].x, nodes[b].y); nctx.stroke();
  });
  // nodes
  nodes.forEach(n=>{
    nctx.beginPath(); nctx.arc(n.x, n.y, 30, 0, Math.PI*2);
    nctx.fillStyle = '#131d32'; nctx.fill();
    nctx.strokeStyle = n.c; nctx.lineWidth = 1.8; nctx.stroke();
    nctx.fillStyle = '#cfe0ff';
    nctx.font = '11px JetBrains Mono';
    nctx.textAlign='center';
    n.label.split('\n').forEach((ln,i)=> nctx.fillText(ln, n.x, n.y-4 + i*13));
  });
  requestAnimationFrame(drawNet);
}
