// --- RF Spectrum ---
const spec = document.getElementById('spectrumCanvas');
const sctx = spec.getContext('2d');
let rfRunning = true, rfNoiseLevel = 0;
function resizeSpec(){
  const r = spec.getBoundingClientRect();
  spec.width = r.width * (window.devicePixelRatio||1);
  spec.height = 150 * (window.devicePixelRatio||1);
  sctx.setTransform(window.devicePixelRatio||1,0,0,window.devicePixelRatio||1,0,0);
}
resizeSpec(); window.addEventListener('resize', resizeSpec);
document.getElementById('rfPause').onclick = (e)=>{
  rfRunning = !rfRunning;
  e.target.textContent = rfRunning ? 'Pause' : 'Resume';
};
function rfNoise(){ rfNoiseLevel = Math.min(1, rfNoiseLevel + 0.35); setTimeout(()=>rfNoiseLevel*=0.6, 1800); }

let specT = 0;
function drawSpec(){
  const w = spec.getBoundingClientRect().width;
  const h = 150;
  sctx.clearRect(0,0,w,h);
  // grid
  sctx.strokeStyle = '#1c2842'; sctx.lineWidth=1;
  for(let i=0;i<6;i++){ sctx.beginPath(); sctx.moveTo(0, i*h/5); sctx.lineTo(w, i*h/5); sctx.stroke(); }
  // wifi 2.4GHz humps
  function hump(cx, amp, col){
    sctx.beginPath();
    sctx.moveTo(0,h-10);
    for(let x=0;x<=w;x+=2){
      const dx = (x - cx)/55;
      const y = amp * Math.exp(-dx*dx) * (0.82 + 0.18*Math.sin(specT*0.06 + x*0.03));
      sctx.lineTo(x, h-18 - y*85);
    }
    sctx.lineTo(w,h-10);
    sctx.fillStyle = col;
    sctx.fill();
  }
  if(rfRunning) specT++;
  hump(w*0.18, 0.9, 'rgba(62,231,255,0.23)');
  hump(w*0.38, 0.78, 'rgba(62,231,255,0.18)');
  hump(w*0.62, 0.65, 'rgba(62,231,255,0.17)');
  // BT LE spikes
  sctx.strokeStyle = 'rgba(167,107,255,0.9)'; sctx.lineWidth=1.4;
  for(let i=0;i<18;i++){
    const x = (i/18 * w + specT*1.7) % w;
    const ht = 18 + Math.random()*45;
    sctx.beginPath(); sctx.moveTo(x, h-18); sctx.lineTo(x, h-18-ht); sctx.stroke();
  }
  // noise
  if(rfNoiseLevel>0.01){
    sctx.fillStyle = `rgba(255,191,60,${0.07+rfNoiseLevel*0.12})`;
    sctx.fillRect(0, h-80, w, 70);
    rfNoiseLevel *= 0.985;
  }
  // labels
  sctx.fillStyle = '#7a8aad'; sctx.font='11px JetBrains Mono';
  sctx.fillText('2.412 GHz  Ch 1', 14, 18);
  sctx.fillText('2.437 GHz  Ch 6', w*0.36, 18);
  sctx.fillText('2.462 GHz  Ch 11', w*0.62, 18);
  sctx.fillText('5 GHz →', w-78, 18);
  requestAnimationFrame(drawSpec);
}
