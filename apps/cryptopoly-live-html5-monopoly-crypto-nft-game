<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cryptopoly Live - HTML5 Monopoly Crypto NFT Game</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        :root {
            --ink: #e5eefb;
            --muted: #94a3b8;
            --panel: #101827;
            --panel-2: #172033;
            --line: #26344d;
            --board: #dbeafe;
            --paper: #f8fafc;
            --dark: #07111f;
        }

        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            background: radial-gradient(circle at 30% 10%, #1e3a8a 0, transparent 34%), #07111f;
            color: var(--ink);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            overflow: hidden;
        }

        .shell {
            display: grid;
            grid-template-columns: 370px minmax(680px, 1fr);
            gap: 18px;
            height: 100vh;
            padding: 18px;
        }

        .panel {
            background: rgba(16, 24, 39, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 18px;
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.28);
        }

        .left-rail {
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .brand {
            padding: 18px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.28), rgba(20, 184, 166, 0.12));
            border: 1px solid rgba(96, 165, 250, 0.35);
        }

        .section { padding: 14px; }
        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            color: #cbd5e1;
            font-size: 0.83rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .btn {
            width: 100%;
            border: 0;
            border-radius: 12px;
            padding: 12px 14px;
            color: white;
            background: #2563eb;
            font-weight: 900;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            cursor: pointer;
            transition: transform 180ms ease, filter 180ms ease, opacity 180ms ease;
        }

        .btn:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.12); }
        .btn:disabled { cursor: not-allowed; opacity: 0.45; }
        .btn.buy { background: #059669; }
        .btn.skip { background: #475569; }

        .board-wrap {
            display: grid;
            place-items: center;
            min-width: 0;
            background: rgba(7, 17, 31, 0.68);
            border-radius: 24px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            position: relative;
            overflow: hidden;
        }

        .board-wrap::before {
            content: "";
            position: absolute;
            inset: -20%;
            background: conic-gradient(from 90deg, transparent, rgba(20, 184, 166, 0.18), transparent, rgba(59, 130, 246, 0.24), transparent);
            animation: slowSpin 22s linear infinite;
        }

        #board {
            width: min(88vh, calc(100vw - 440px));
            height: min(88vh, calc(100vw - 440px));
            min-width: 650px;
            min-height: 650px;
            display: grid;
            grid-template-columns: repeat(11, 1fr);
            grid-template-rows: repeat(11, 1fr);
            gap: 2px;
            padding: 4px;
            background: #07111f;
            border: 4px solid #07111f;
            border-radius: 8px;
            position: relative;
            z-index: 1;
            animation: boardIn 700ms cubic-bezier(.2,.8,.2,1) both;
        }

        .space {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            gap: 2px;
            padding: 4px 3px;
            background: var(--paper);
            color: #0f172a;
            font-size: 0.58rem;
            line-height: 1.05;
            text-align: center;
            font-weight: 900;
        }

        .space.corner {
            justify-content: center;
            background: #bfdbfe;
            font-size: 0.72rem;
            letter-spacing: 0.02em;
        }

        .band {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 12px;
            border-bottom: 1px solid rgba(15, 23, 42, 0.25);
        }

        .space-name { margin-top: 13px; max-width: 100%; }
        .space.special .space-name { margin-top: 0; }
        .price { color: #334155; font-size: 0.55rem; font-weight: 800; }
        .owner-mark { width: 42%; height: 4px; border-radius: 999px; background: transparent; margin-bottom: 1px; }
        .owner-p1 { background: #e11d48; }
        .owner-p2 { background: #2563eb; }
        .coin-logo { width: 20px; height: 20px; object-fit: contain; margin: 2px auto; display: block; background: white; border-radius: 50%; padding: 1px; }
        .ticker-logo { width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; border-radius: 50%; background: white; padding: 1px; }

        .side-left .inner { transform: rotate(90deg); width: 72px; }
        .side-right .inner { transform: rotate(-90deg); width: 72px; }
        .top-row .inner { transform: rotate(180deg); }

        #center {
            grid-column: 2 / 11;
            grid-row: 2 / 11;
            background:
                linear-gradient(135deg, rgba(248, 250, 252, 0.88), rgba(219, 234, 254, 0.9)),
                radial-gradient(circle at 50% 35%, rgba(20, 184, 166, 0.25), transparent 38%);
            color: #0f172a;
            position: relative;
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .watermark {
            position: absolute;
            transform: rotate(-35deg);
            font-size: clamp(2.6rem, 7vw, 5.8rem);
            font-weight: 1000;
            letter-spacing: 0.06em;
            color: rgba(15, 23, 42, 0.1);
            animation: breathe 4.8s ease-in-out infinite;
        }

        .center-card {
            width: min(72%, 420px);
            padding: 28px;
            border: 1px solid rgba(15, 23, 42, 0.14);
            background: rgba(255, 255, 255, 0.72);
            backdrop-filter: blur(14px);
            border-radius: 24px;
            position: relative;
            z-index: 2;
            text-align: center;
            box-shadow: 0 20px 60px rgba(15, 23, 42, 0.15);
        }

        .dice-row { display: flex; justify-content: center; gap: 12px; margin: 16px 0; }
        .die {
            width: 56px;
            height: 56px;
            display: grid;
            place-items: center;
            background: white;
            color: #0f172a;
            border: 2px solid #0f172a;
            border-radius: 14px;
            font-size: 1.6rem;
            font-weight: 1000;
            box-shadow: 0 8px 0 #cbd5e1;
        }

        .die.roll { animation: diceRoll 480ms ease; }

        .token {
            width: 16px;
            height: 16px;
            border-radius: 999px;
            border: 2px solid white;
            position: absolute;
            bottom: 4px;
            z-index: 8;
            box-shadow: 0 4px 10px rgba(0,0,0,0.35);
            transition: all 420ms cubic-bezier(.2,1.4,.4,1);
        }

        #token-1 { background: #e11d48; left: 4px; }
        #token-2 { background: #2563eb; right: 4px; }

        .ticker-row, .player-row, .log-line {
            border-top: 1px solid rgba(148, 163, 184, 0.12);
            padding-top: 8px;
            margin-top: 8px;
        }

        .ticker-row {
            display: grid;
            grid-template-columns: 54px 1fr auto;
            gap: 8px;
            align-items: center;
            font-size: 0.78rem;
        }

        .change-up { color: #34d399; }
        .change-down { color: #fb7185; }
        .muted { color: var(--muted); }
        .nft-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 6px; margin-top: 8px; }
        .nft { width: 100%; aspect-ratio: 1; border-radius: 10px; border: 1px solid rgba(148,163,184,0.38); animation: mintIn 500ms ease both; overflow: hidden; background: #020617; }
        .nft svg { display: block; width: 100%; height: 100%; }
        #log { max-height: 160px; overflow-y: auto; font-size: 0.78rem; line-height: 1.35; color: #cbd5e1; }

        @keyframes slowSpin { to { transform: rotate(360deg); } }
        @keyframes boardIn { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
        @keyframes breathe { 0%, 100% { opacity: 0.65; } 50% { opacity: 1; } }
        @keyframes diceRoll { 0% { transform: translateY(0) rotate(0); } 40% { transform: translateY(-14px) rotate(18deg); } 100% { transform: translateY(0) rotate(0); } }
        @keyframes mintIn { from { opacity: 0; transform: scale(0.55) rotate(-10deg); } to { opacity: 1; transform: scale(1) rotate(0); } }

        @media (max-width: 1120px) {
            body { overflow: auto; }
            .shell { height: auto; min-height: 100vh; grid-template-columns: 1fr; }
            .left-rail { order: 2; overflow: visible; }
            .board-wrap { order: 1; min-height: 720px; }
            #board { width: 680px; height: 680px; min-width: 680px; min-height: 680px; }
        }

        @media (max-width: 760px) {
            .shell { padding: 10px; gap: 10px; }
            .board-wrap { min-height: calc(100vw - 20px); overflow-x: auto; }
            #board { width: calc(100vw - 28px); height: calc(100vw - 28px); min-width: 0; min-height: 0; }
            .space { font-size: 0.45rem; padding: 2px 1px; }
            .price { font-size: 0.42rem; }
            .center-card { width: 78%; padding: 14px; }
            .die { width: 40px; height: 40px; font-size: 1.15rem; border-radius: 10px; }
            .token { width: 12px; height: 12px; }
        }
    </style>
</head>
<body>
    <main class="shell">
        <aside class="left-rail">
            <section class="panel brand">
                <p class="text-xs uppercase tracking-[0.35em] text-cyan-200 font-black">HTML5 Board Game</p>
                <h1 class="text-4xl font-black mt-2 leading-none">Cryptopoly Live</h1>
                <p class="mt-3 text-sm text-slate-300">A Monopoly-style crypto property game. Purchase prices scale from the original board values using live market movement from the start of this session.</p>
            </section>

            <section class="panel section">
                <div class="section-title"><span id="turnTitle">Player 1 Turn</span><span id="turnState" class="muted">Roll</span></div>
                <div class="grid grid-cols-2 gap-2">
                    <button class="btn" id="rollBtn">Roll Dice</button>
                    <button class="btn buy" id="buyBtn" disabled>Buy</button>
                </div>
                <button class="btn skip mt-2" id="skipBtn" disabled>Skip Purchase</button>
            </section>

            <section class="panel section">
                <div class="section-title"><span>Live Market Feed</span><span id="feedStatus" class="muted">Connecting</span></div>
                <div id="ticker"></div>
            </section>

            <section class="panel section">
                <div class="section-title"><span>Player Ledgers</span><span class="muted">Assets + NFTs</span></div>
                <div id="ledgers"></div>
            </section>

            <section class="panel section">
                <div class="section-title"><span>Action Log</span><span class="muted">Rules Engine</span></div>
                <div id="log"></div>
            </section>
        </aside>

        <section class="board-wrap">
            <div id="board">
                <div id="center">
                    <div class="watermark">CRYPTOPOLY</div>
                    <div class="center-card">
                        <div class="text-xs uppercase tracking-[0.28em] font-black text-blue-700">Live Market Edition</div>
                        <div class="dice-row">
                            <div class="die" id="die1">1</div>
                            <div class="die" id="die2">1</div>
                        </div>
                        <div id="centerStatus" class="font-black text-lg">Roll to start the chain.</div>
                        <div id="centerHint" class="mt-2 text-xs font-bold text-slate-600">Community Chest mints a generative NFT into your ledger.</div>
                    </div>
                </div>
                <div class="token" id="token-1" title="Player 1"></div>
                <div class="token" id="token-2" title="Player 2"></div>
            </div>
        </section>
    </main>

