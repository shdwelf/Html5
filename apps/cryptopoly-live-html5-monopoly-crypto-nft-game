            ETC: "ethereum-classic", XLM: "stellar", NEAR: "near", ICP: "internet-computer", APT: "aptos", FIL: "filecoin", ARB: "arbitrum", OP: "optimism",
            AAVE: "aave", MKR: "maker", SUI: "sui", INJ: "injective-protocol"
        };

        const coinLogos = {
