// --- Playback ---
async function playTxQueue(startIdx=0){
  if(!txQueue.length) return;
  if(txActx) try{ txActx.close(); }catch(e){}
  txActx = new (window.AudioContext||window.webkitAudioContext)({sampleRate:SR});
  let idx = startIdx;
  const vol = (parseInt(document.getElementById('sstvVol')?.value||'72',10)/100);
  async function playOne(){
    if(idx >= txQueue.length){ stopTx(); return; }
    const item = txQueue[idx];
    const buf = txActx.createBuffer(1, item.audio.length, SR);
    buf.copyToChannel(item.audio, 0);
    txSource = txActx.createBufferSource();
    txSource.buffer = buf;
    const gain = txActx.createGain(); gain.gain.value = vol;
    txSource.connect(gain).connect(txActx.destination);
    const analyser = txActx.createAnalyser(); analyser.fftSize = 2048;
    gain.connect(analyser);
    txSource.start();
    const tfi=document.getElementById('sstvTxFrameInfo'); if(tfi) tfi.textContent = `Frame ${idx+1}/${txQueue.length}`;
    sstvLog(`TX playing frame ${idx+1}/${txQueue.length}`);
    const duration = item.audio.length / SR;
    const start = performance.now();
    return new Promise(res=>{
      let raf;
      function tick(){
        const elapsed = (performance.now()-start)/1000;
        const pct = Math.min(100, elapsed/duration*100);
        const pb=document.getElementById('sstvTxProgress'); if(pb) pb.style.width = pct+'%';
        const tt=document.getElementById('sstvTxTime'); if(tt) tt.textContent = `${elapsed.toFixed(1)} / ${duration.toFixed(1)}s`;
        if(specCtx){
          const data = new Uint8Array(analyser.frequencyBinCount);
          analyser.getByteFrequencyData(data);
          const cw = specCanvas.width = specCanvas.clientWidth;
          const ch = 170; specCanvas.height = ch;
          specCtx.fillStyle='rgba(5,9,18,0.22)'; specCtx.fillRect(0,0,cw,ch);
          specCtx.fillStyle='#3ee7ff';
          for(let x=0;x<cw;x++){
            const bin = Math.floor((1100 + x/cw*1400) / (txActx.sampleRate/2) * data.length);
            const v = data[bin]||0;
            specCtx.fillRect(x, ch - v*ch/255, 1.5, 2);
          }
        }
        if(elapsed < duration + 0.15) raf = requestAnimationFrame(tick);
        else { cancelAnimationFrame(raf); res(); }
      }
      tick();
      txSource.onended = ()=>{ cancelAnimationFrame(raf); res(); };
      window._stopCurrent = ()=>{ try{txSource.stop();}catch(e){} cancelAnimationFrame(raf); res('stop'); };
    });
  }
  const pb=document.getElementById('sstvPlayBtn'); if(pb) pb.disabled=true;
  const sb=document.getElementById('sstvStopBtn'); if(sb) sb.disabled=false;
  const pab=document.getElementById('sstvPauseBtn'); if(pab) pab.disabled=false;
  while(idx < txQueue.length){
    const r = await playOne();
    if(r==='stop') break;
    idx++; txQueuePos = idx;
    const gap = parseInt(document.getElementById('faxGapSel')?.value || '5',10);
    if(idx < txQueue.length && gap>0){
      sstvLog(`Inter-frame gap ${gap}s…`);
      await new Promise(res=>setTimeout(res, gap*1000));
    }
  }
  stopTx();
}

function stopTx(){
  try{ window._stopCurrent?.(); }catch(e){}
  try{ txActx?.close(); }catch(e){}
  const pb=document.getElementById('sstvPlayBtn'); if(pb) pb.disabled=false;
  const sb=document.getElementById('sstvStopBtn'); if(sb) sb.disabled=true;
  const pab=document.getElementById('sstvPauseBtn'); if(pab) pab.disabled=true;
  const pbar=document.getElementById('sstvTxProgress'); if(pbar) pbar.style.width='0%';
  const dur = txAudioBuffer ? (txAudioBuffer.length/SR).toFixed(1) : getMode().total_s.toFixed(1);
  const tt=document.getElementById('sstvTxTime'); if(tt) tt.textContent = `0.0 / ${dur}s`;
}

