  const q = (document.getElementById('pktFilter')?.value || '').toLowerCase().trim();
  if(!q){ filteredPackets = parsedPackets.slice(); }
  else {
    const terms = q.split(/\s+/);
    filteredPackets = parsedPackets.filter(p=>{
      const hay = `${p.proto} ${p.src} ${p.dst} ${p.sport||''} ${p.dport||''} ${p.info}`.toLowerCase();
      return terms.every(t=> hay.includes(t));
    });
