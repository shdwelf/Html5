function drawWaterfallPreview(audio){
  if(!wfCtx) return;
  const w = wfCanvas.width = wfCanvas.clientWidth;
  const h = 160; wfCanvas.height = h;
  wfCtx.fillStyle='#050912'; wfCtx.fillRect(0,0,w,h);
  wfCtx.strokeStyle='#5fd3ff'; wfCtx.beginPath();
  const step = Math.floor(audio.length / w);
  for(let x=0; x<w; x++){
    let z=0, last=0;
    const base = x*step;
    for(let i=1;i<480;i++){ const s = audio[base+i]||0; if(last<0 && s>=0) z++; last=s; }
    const freq = z * SR/480 /2;
    const y = h - 20 - ((Math.max(1100,Math.min(2400,freq))-1100)/1300)*(h-40);
    if(x===0) wfCtx.moveTo(x,y); else wfCtx.lineTo(x,y);
  }
  wfCtx.stroke();
  wfCtx.fillStyle='#6b7b9a'; wfCtx.font='11px JetBrains Mono, monospace';
  [1200,1500,1900,2300].forEach(f=>{
    const y = h - 20 - ((f-1100)/1300)*(h-40);
    wfCtx.fillText(f+' Hz', 6, y-2);
    wfCtx.fillRect(0,y,w,1);
  });
}

