function buildFlowTable(list){
  const tbody = document.querySelector('#flowTable tbody');
  const map = new Map();
  list.forEach(p=>{
    const key = `${p.src}:${p.sport||''} → ${p.dst}:${p.dport||''} ${p.proto}`;
    const rev = `${p.dst}:${p.dport||''} → ${p.src}:${p.sport||''} ${p.proto}`;
    const k = map.has(rev) ? rev : key;
    const e = map.get(k) || {flow: k, proto:p.proto, pkts:0, bytes:0};
    e.pkts++; e.bytes += p.len;
    map.set(k, e);
  });
  const flows = [...map.values()].sort((a,b)=>b.bytes-a.bytes).slice(0,32);
  if(!flows.length){ tbody.innerHTML='<tr><td colspan="4" class="small-muted">No flows</td></tr>'; return;}
  tbody.innerHTML = flows.map(f=>`<tr><td>${escapeHtml(f.flow)}</td><td>${escapeHtml(f.proto)}</td><td>${f.pkts}</td><td>${f.bytes}</td></tr>`).join('');
}

function buildProtoHierarchy(list){
  const counts = {};
  list.forEach(p=>{ counts[p.proto] = (counts[p.proto]||0)+1; });
  const total = list.length || 1;
  const parts = Object.entries(counts).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`${k}: ${v} (${(v/total*100).toFixed(1)}%)`);
  document.getElementById('protoHierarchy').textContent = parts.join(' · ') || '—';
}

