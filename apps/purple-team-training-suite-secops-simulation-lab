function showPacketDetail(p){
  const raw = p.raw || new Uint8Array();
  let hex = '';
  for(let i=0;i<Math.min(raw.length, 512); i+=16){
    const slice = raw.slice(i, i+16);
    const hx = Array.from(slice).map(b=>b.toString(16).padStart(2,'0')).join(' ');
    const asc = Array.from(slice).map(b=> (b>=32&&b<127)?String.fromCharCode(b):'.').join('');
    hex += `${i.toString(16).padStart(4,'0')}  ${hx.padEnd(47,' ')}  ${asc}\n`;
  }
  pktDetailEl.innerHTML = `<div><b>Packet #${p.no}</b>  ts=${p.ts.toFixed(6)}  len=${p.len}<br>
${escapeHtml(p.src)} → ${escapeHtml(p.dst)}  <b>${escapeHtml(p.proto)}</b><br>
