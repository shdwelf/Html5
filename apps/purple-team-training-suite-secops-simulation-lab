}

// --- TCP/IP Bridge with ARQ ---
let bridgeQueue = [];
let bridgeSeq = 0;

// ARQ state
const arq = {
  enabled: true,
  mode: 'sr', // 'gbn' or 'sr'
  window: 8,
  rtt: 900, // ms simulated
  loss: 0.05,
  txNext: 0,
  txBase: 0,
  rxExpected: 0,
  unacked: new Map(),
  rxBuffer: new Map(),
  retransmits: 0,
  acks: 0,
};

function arqUpdateUI(){
  const el = document.getElementById('arqStats');
  if(!el) return;
  el.textContent = `ARQ ${arq.enabled ? arq.mode.toUpperCase() : 'OFF'} | W=${arq.window} | RTT~${arq.rtt}ms | loss ${(arq.loss*100).toFixed(1)}% | RTX ${arq.retransmits} | ACKs ${arq.acks}`;
}

function arqWrapPacket(payloadBytes, seq){
  // Header: 0xAA55 | seq u32 | ack u32 | flags u8 | len u16 | crc32
  const h = new Uint8Array(16);
  const dv = new DataView(h.buffer);
  dv.setUint16(0, 0xAA55, true);
  dv.setUint32(2, seq>>>0, true);
  dv.setUint32(6, arq.rxExpected>>>0, true);
  dv.setUint8(10, 0x01); // data
  dv.setUint16(11, payloadBytes.length, true);
  dv.setUint32(13, crc32(payloadBytes), true);
  const out = new Uint8Array(h.length + payloadBytes.length);
  out.set(h,0); out.set(payloadBytes, h.length);
  return out;
}
function arqUnwrap(frame){
  if(frame.length < 16) return null;
  const dv = new DataView(frame.buffer, frame.byteOffset, frame.byteLength);
  if(dv.getUint16(0,true) !== 0xAA55) return null;
  const seq = dv.getUint32(2,true);
  const ack = dv.getUint32(6,true);
  const flags = dv.getUint8(10);
  const len = dv.getUint16(11,true);
  const crc = dv.getUint32(13,true);
  const payload = frame.slice(16, 16+len);
  if(crc32(payload) !== crc) return {bad:true, seq};
  return {seq, ack, flags, payload};
}

