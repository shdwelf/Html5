async function runDecode(blob){
  const rxStatus=document.getElementById('sstvRxStatus'); if(rxStatus) rxStatus.textContent = 'Decoding…';
  try{
    const arrayBuf = await blob.arrayBuffer();
    const actx = new (window.AudioContext||window.webkitAudioContext)();
    const audioBuf = await actx.decodeAudioData(arrayBuf.slice(0));
    const ch = audioBuf.getChannelData(0);
    const result = await decodeSSTVFromAudioBuffer(ch, audioBuf.sampleRate);
    if(rxStatus) rxStatus.textContent = 'Decoded OK';
    const rxi=document.getElementById('sstvRxInfo');
    if(rxi) rxi.textContent = `${SSTV_MODES[result.mode].name} ${result.imgData.width}×${result.imgData.height} — slant ${result.slant||0}px`;
    sstvLog(`SSTV decode: ${SSTV_MODES[result.mode].name} OK, slant ${(result.slant||0).toFixed(1)}px`);
    tryFaxOrBridgeReassemble(result);
    actx.close();
    updateStats(1, true, 0);
  } catch(e){
    if(rxStatus) rxStatus.textContent = 'Decode failed';
    sstvLog('Decode error: '+e.message);
    updateStats(1, false, 0);
  }
}

document.getElementById('sstvDecodeBtn')?.addEventListener('click', async ()=>{
