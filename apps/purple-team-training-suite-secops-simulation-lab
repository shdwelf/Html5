document.getElementById('bridgePullPcapBtn')?.addEventListener('click', ()=>{
  const pkts = window.parsedPackets || [];
  if(!pkts.length){ sstvLog('Bridge: no packets in PCAP parser.'); return; }
  let count=0;
  pkts.slice(0, 128).forEach(p=>{
    let blob;
    if(p.raw && p.raw.length){ blob = p.raw; }
    else { const txt = `${p.src} → ${p.dst} ${p.proto} ${p.info}`; blob = new TextEncoder().encode(txt); }
    // SLIP encode
    const slip = [0xC0];
    for(const b of blob){ if(b===0xC0){ slip.push(0xDB,0xDC);} else if(b===0xDB){ slip.push(0xDB,0xDD);} else slip.push(b); }
    slip.push(0xC0);
    const slipBytes = new Uint8Array(slip);
    // ARQ wrap
    const arqFrame = arq.enabled ? arqWrapPacket(slipBytes, bridgeSeq) : slipBytes;
    bridgeQueue.push({seq: bridgeSeq++, proto: p.proto, bytes: arqFrame, retries:0, acked:false});
    count++;
  });
  sstvLog(`Bridge: queued ${count} packets from PCAP parser → SSTV (ARQ ${arq.enabled? 'ON '+arq.mode.toUpperCase() : 'OFF'})`);
  updateBridgeQueueInfo();
  updateFaxQueueUI();
  arqUpdateUI();
});

