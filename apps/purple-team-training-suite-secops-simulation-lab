  try{
    micStream = await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false, noiseSuppression:false, autoGainControl:false}});
    micCtx = new AudioContext();
    const src = micCtx.createMediaStreamSource(micStream);
    const analyser = micCtx.createAnalyser(); analyser.fftSize=2048;
    src.connect(analyser);
    btn.textContent='■ Stop Mic';
    sstvLog('Mic listening — spectrum + live waterfall active.');
    const freqData = new Uint8Array(analyser.frequencyBinCount);
    function drawMic(){
      if(!micStream) return;
      analyser.getByteFrequencyData(freqData);
      if(specCtx){
        const cw = specCanvas.width = specCanvas.clientWidth;
        const ch = 170; specCanvas.height = ch;
        specCtx.fillStyle='rgba(5,9,18,0.22)'; specCtx.fillRect(0,0,cw,ch);
        specCtx.fillStyle='#ffbf3c';
        for(let x=0;x<cw;x++){
          const bin = Math.floor((1100 + x/cw*1400) / (micCtx.sampleRate/2) * freqData.length);
          const v = freqData[bin]||0;
          specCtx.fillRect(x, ch - v*ch/255, 1.5, 2);
        }
      }
      if(liveWfCtx){
        const w = liveWfCanvas.width = liveWfCanvas.clientWidth;
        const h = 140; liveWfCanvas.height = h;
        const img = liveWfCtx.getImageData(0,0,w,h);
        liveWfCtx.putImageData(img, 0, 1);
        liveWfCtx.fillStyle='#050912'; liveWfCtx.fillRect(0,0,w,1);
        for(let x=0;x<w;x++){
          const bin = Math.floor((1100 + x/w*1400) / (micCtx.sampleRate/2) * freqData.length);
          const v = freqData[bin]||0;
          const c = Math.min(255, v*2);
          liveWfCtx.fillStyle = `rgb(${c},${c},${c})`;
          liveWfCtx.fillRect(x,0,1,1);
        }
      }
      requestAnimationFrame(drawMic);
    }
    drawMic();
  } catch(err){ sstvLog('Mic access denied: '+err.message); }
});

// --- Live mic SSTV decoder ---
let liveDecodeOn = false;
let liveAudioBuffer = [];
let liveDecodeTimer = null;

async function startLiveDecode(){
  if(liveDecodeOn) return;
  try{
    if(!micStream){
      micStream = await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false, noiseSuppression:false, autoGainControl:false}});
    }
    if(!micCtx || micCtx.state==='closed') micCtx = new AudioContext({sampleRate:48000});
    const src = micCtx.createMediaStreamSource(micStream);
    const processor = micCtx.createScriptProcessor(4096,1,1);
    src.connect(processor); processor.connect(micCtx.destination);
    liveAudioBuffer = [];
    let visDetected = false;
    let lastDecode = 0;
    processor.onaudioprocess = e=>{
      const input = e.inputBuffer.getChannelData(0);
      liveAudioBuffer.push(new Float32Array(input));
      // keep last ~30 sec max for Robot36, longer for PD
      const maxSamples = 48000 * 300;
      let total = liveAudioBuffer.reduce((a,b)=>a+b.length,0);
      while(total > maxSamples && liveAudioBuffer.length>1){ total -= liveAudioBuffer.shift().length; }
      // simple VIS detector every 2 sec
      const now = performance.now();
      if(now - lastDecode > 2000){
        lastDecode = now;
        // flatten
        const flatLen = liveAudioBuffer.reduce((a,b)=>a+b.length,0);
        const flat = new Float32Array(flatLen);
        let o=0; liveAudioBuffer.forEach(b=>{ flat.set(b,o); o+=b.length; });
        // quick freq scan for VIS pattern 1900-1200-1900
        // if found and not yet decoded, run full decode on last ~40s
        decodeSSTVFromAudioBuffer(flat.slice(Math.max(0,flat.length-48000*300)), 48000).then(res=>{
          sstvLog(`Live decode: ${SSTV_MODES[res.mode].name} frame updated (slant ${res.slant||0})`);
          tryFaxOrBridgeReassemble(res);
        }).catch(()=>{});
      }
    };
    liveDecodeOn = true;
    sstvLog('Live SSTV decoder started — listening for VIS / sync. Image draws live.');
    document.getElementById('sstvLiveDecodeBtn').textContent = '■ Stop Live';
  } catch(e){
    sstvLog('Live decode failed: '+e.message);
  }
}
function stopLiveDecode(){
  liveDecodeOn = false;
  if(micStream){ micStream.getTracks().forEach(t=>t.stop()); micStream=null; }
  try{ micCtx?.close(); }catch(e){}
  const btn=document.getElementById('sstvLiveDecodeBtn');
  if(btn) btn.textContent = '🎙 Live Decode';
  sstvLog('Live decode stopped.');
}
document.getElementById('sstvLiveDecodeBtn')?.addEventListener('click', ()=>{
  if(liveDecodeOn){ stopLiveDecode(); } else { startLiveDecode(); }
});

// --- Fax / Bridge reassemble ---
let faxRxFrames = new Map();
let faxRxMeta = null;
let bridgeRxFrames = new Map();
let stats = {frames:0, crcOk:0, rsFix:0, bytes:0, pkts:0, ber:0};

function updateStats(frameDelta, crcOk, rsFixed){
  stats.frames += frameDelta;
  if(crcOk) stats.crcOk++;
  stats.rsFix += rsFixed||0;
  const set=(id,v)=>{ const el=document.getElementById(id); if(el) el.textContent=v; };
  set('sstvFramesRx', stats.frames);
  set('sstvCrcOk', `${stats.crcOk} / ${stats.frames}`);
  set('sstvRsFix', stats.rsFix);
  set('sstvBytesRx', stats.bytes);
  set('sstvPktsRx', stats.pkts);
  set('sstvSnr', '~18 dB');
  const sl=document.getElementById('sstvLock'); if(sl) sl.textContent='Yes';
  set('sstvBer', stats.frames ? ((stats.frames-stats.crcOk)/stats.frames*100).toFixed(1)+'%' : '—');
}

function tryFaxOrBridgeReassemble(result){
  const mode = SSTV_MODES[result.mode];
  const w = mode.w, h = mode.h;
  const Y = result.Y;
  const magic5 = String.fromCharCode(Y[120],Y[121],Y[122],Y[123],Y[124]);
  let handled = false;
  if(magic5 === 'FAXS2'){
    const dv = new DataView(Y.buffer, Y.byteOffset, Y.byteLength);
    const fileSize = dv.getUint32(48, true);
    const fileCrc = dv.getUint32(52, true);
    const frameIdx = dv.getUint16(56, true);
    const frameTotal = dv.getUint16(58, true);
    const frameCrc = dv.getUint32(60, true);
    const payloadLen = dv.getUint32(64, true);
    const fecOn = dv.getUint8(68);
    const payload = Y.slice(128, 128+payloadLen);
    const calcCrc = crc32(payload);
    const ok = calcCrc === frameCrc;
    if(!faxRxMeta) faxRxMeta = {size:fileSize, crc:fileCrc, total:frameTotal, name:'fax_receive.bin', fec:fecOn};
    faxRxFrames.set(frameIdx, payload);
    stats.bytes += payload.length;
    updateStats(1, ok, 0);
    sstvLog(`FAX RX frame ${frameIdx+1}/${frameTotal} — ${payload.length} B — CRC ${ok?'OK':'FAIL'} — RS ${fecOn?'on':'off'}`);
    handled = true;
  } else if(magic5 === 'BRDG2' || String.fromCharCode(Y[120],Y[121],Y[122],Y[123]) === 'BRDG'){
    const dv = new DataView(Y.buffer, Y.byteOffset, Y.byteLength);
    const frameIdx = dv.getUint16(0, true);
    const frameTotal = dv.getUint16(2, true);
    const payloadLen = dv.getUint32(4, true);
    const frameCrc = dv.getUint32(8, true);
    const payload = Y.slice(128, 128+payloadLen);
    const ok = crc32(payload) === frameCrc;
    bridgeRxFrames.set(frameIdx, payload);
    stats.bytes += payload.length;
    // ARQ ACK sim
    if(arq.enabled){ arq.acks++; }
    updateStats(1, ok, 0);
    sstvLog(`BRIDGE RX frame ${frameIdx+1}/${frameTotal} — ${payload.length} B — CRC ${ok?'OK':'FAIL'} — ARQ ACK sent`);
    handled = true;
  }
  if(!handled){
    stats.bytes += w*h;
    updateStats(1, true, 0);
  }
  refreshFaxRxUI();
  arqUpdateUI();
}

function refreshFaxRxUI(){
  const faxCount = faxRxFrames.size;
  const bridgeCount = bridgeRxFrames.size;
  const infoEl = document.getElementById('faxRxInfo');
  if(!infoEl) return;
  if(faxCount>0){
    const total = faxRxMeta?.total || '?';
    const bytes = [...faxRxFrames.values()].reduce((a,b)=>a+b.length,0);
    infoEl.textContent = `FAX frames: ${faxCount}/${total} — ${bytes} bytes — RS FEC ${faxRxMeta?.fec?'ON':'OFF'}`;
    const db=document.getElementById('faxDownloadBtn'); if(db) db.disabled = false;
    const ib=document.getElementById('faxInjectPcapBtn'); if(ib) ib.disabled = true;
    let map = '';
    for(let i=0;i<(faxRxMeta?.total||faxCount);i++) map += faxRxFrames.has(i) ? '█' : '░';
    const ffm=document.getElementById('faxFrameMap'); if(ffm) ffm.textContent = map;
  } else if(bridgeCount>0){
    const bytes = [...bridgeRxFrames.values()].reduce((a,b)=>a+b.length,0);
    infoEl.textContent = `BRIDGE frames: ${bridgeCount} — ${bytes} bytes — SLIP packets inside — ARQ ${arq.enabled? arq.mode.toUpperCase():'OFF'}`;
    const db=document.getElementById('faxDownloadBtn'); if(db) db.disabled = false;
    const ib=document.getElementById('faxInjectPcapBtn'); if(ib) ib.disabled = false;
    let map = ''; for(let i=0;i<bridgeCount+2;i++) map += bridgeRxFrames.has(i) ? '█' : '░';
    const ffm=document.getElementById('faxFrameMap'); if(ffm) ffm.textContent = map;
  } else {
    infoEl.textContent = 'Waiting for frames…';
  }
}

document.getElementById('faxDownloadBtn')?.addEventListener('click', ()=>{
  let out, name='sstv_rx.bin';
  if(faxRxFrames.size){
    const keys = [...faxRxFrames.keys()].sort((a,b)=>a-b);
    const total = keys.reduce((a,k)=>a + faxRxFrames.get(k).length, 0);
    out = new Uint8Array(total);
    let o=0; keys.forEach(k=>{ out.set(faxRxFrames.get(k), o); o+=faxRxFrames.get(k).length; });
    if(faxRxMeta?.fec){
      const dec = rs_decode_bytes(out);
      out = dec.bytes;
      sstvLog(`RS-FEC decode: ${dec.errors} blocks with errors, corrected ${dec.corrected}`);
      stats.rsFix += dec.errors;
      updateStats(0,true,dec.errors);
    }
    name = 'sstv_fax_reassembled.bin';
  } else if(bridgeRxFrames.size){
    const keys = [...bridgeRxFrames.keys()].sort((a,b)=>a-b);
    const total = keys.reduce((a,k)=>a + bridgeRxFrames.get(k).length, 0);
    out = new Uint8Array(total);
    let o=0; keys.forEach(k=>{ out.set(bridgeRxFrames.get(k), o); o+=bridgeRxFrames.get(k).length; });
    name = 'sstv_bridge_reassembled.bin';
  } else return;
  const blob = new Blob([out], {type:'application/octet-stream'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name;
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
  sstvLog(`Downloaded reassembled: ${out.length} bytes → ${name}`);
});

document.getElementById('faxInjectPcapBtn')?.addEventListener('click', ()=>{
  if(!bridgeRxFrames.size){ sstvLog('No bridge data.'); return; }
  const keys = [...bridgeRxFrames.keys()].sort((a,b)=>a-b);
  let total = 0; keys.forEach(k=> total += bridgeRxFrames.get(k).length);
  const blob = new Uint8Array(total);
  let o=0; keys.forEach(k=>{ blob.set(bridgeRxFrames.get(k), o); o+=bridgeRxFrames.get(k).length; });
  const packets = [];
  let pkt = [];
  let esc=false;
  for(const b of blob){
    if(b===0xC0){ if(pkt.length){ packets.push(new Uint8Array(pkt)); pkt=[]; } esc=false; continue; }
    if(esc){ pkt.push(b===0xDC ? 0xC0 : b===0xDD ? 0xDB : b); esc=false; }
    else if(b===0xDB){ esc=true; }
    else pkt.push(b);
  }
  if(pkt.length) packets.push(new Uint8Array(pkt));
  stats.pkts += packets.length;
  updateStats(0, true, 0);
  if(window.parsedPackets){
    let no = window.parsedPackets.length + 1;
    packets.forEach((raw,i)=>{
      window.parsedPackets.push({
        no: no++, ts: Date.now()/1000 + i*0.001,
        src:'SSTV-BRIDGE', dst:'PCAP',
        sport:null, dport:null,
        proto:'SSTV/TCP', l4:'',
        info:`Reassembled ${raw.length} bytes from SSTV bridge (ARQ ${arq.enabled? 'ON':'OFF'})`,
        len: raw.length,
        raw: raw
      });
    });
    if(typeof window.applyPacketFilter === 'function') window.applyPacketFilter();
    sstvLog(`Injected ${packets.length} packets into PCAP Parser — switch to Packet Forensics tab.`);
    alert(`Injected ${packets.length} reassembled packets into the PCAP Parser.\nOpen the Packet Forensics tab to view them.`);
  } else {
    sstvLog(`Bridge decoded ${packets.length} SLIP packets (${total} bytes) — PCAP parser not open.`);
  }
});

document.getElementById('faxClearBtn')?.addEventListener('click', ()=>{
  faxRxFrames.clear(); bridgeRxFrames.clear(); faxRxMeta=null;
  stats = {frames:0, crcOk:0, rsFix:0, bytes:0, pkts:0, ber:0};
  arq.retransmits=0; arq.acks=0;
  updateStats(0, false, 0);
  arqUpdateUI();
  const fri=document.getElementById('faxRxInfo'); if(fri) fri.textContent = 'Waiting for frames…';
  const ffm=document.getElementById('faxFrameMap'); if(ffm) ffm.textContent = '';
  const db=document.getElementById('faxDownloadBtn'); if(db) db.disabled = true;
  const ib=document.getElementById('faxInjectPcapBtn'); if(ib) ib.disabled = true;
  const vr=document.getElementById('sstvVisRead'); if(vr) vr.textContent = '—';
  sstvLog('RX buffers cleared.');
});

sstvLog('SSTV Lab v4.7 ready — Robot36 / Martin M1/M2 / Scottie DX / PD120/180/240 — RS-FEC, Auto VIS, Auto Slant, Live Mic Decoder, TCP/IP ARQ Bridge.');
arqUpdateUI();
})();
