}

// --- ENCODERS ---
const SR = 48000;
function freqFor(v){ return 1500 + v/255*800; }
function tonePush(out, freq, ms){
  const n = Math.floor(SR*ms/1000);
  for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*freq*i/SR) * 0.82);
}
function visEncode(out, vis){
  tonePush(out,1900,300); tonePush(out,1200,10); tonePush(out,1900,300);
  tonePush(out,1200,30);
  tonePush(out,1200,30);
  for(let b=0;b<7;b++) tonePush(out, ((vis>>b)&1)?1100:1300, 30);
  let parity=0; for(let b=0;b<7;b++) parity ^= (vis>>b)&1;
  tonePush(out, parity?1100:1300, 30);
  tonePush(out,1200,30);
}

function encodeRobot36(imageData){
  const w=320, h=240;
  const data = imageData.data;
  const Y = new Uint8Array(w*h), V = new Int8Array(w*h), U = new Int8Array(w*h);
  for(let i=0,p=0;i<data.length;i+=4,p++){
    const r=data[i], g=data[i+1], b=data[i+2];
    Y[p] = 0.299*r + 0.587*g + 0.114*b;
    V[p] =  (0.5*r - 0.419*g - 0.081*b);
    U[p] = (-0.169*r - 0.331*g + 0.5*b);
  }
  const out=[];
  visEncode(out, 8);
  for(let y=0;y<h;y++){
    tonePush(out,1200,9); tonePush(out,1500,3);
    for(let x=0;x<w;x++){
      const f = freqFor(Y[y*w+x]);
      const n = Math.floor(SR * 0.088 / w);
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
    tonePush(out,1500,1.5);
    for(let x=0;x<w;x+=2){
      const v = 128 + V[y*w+x];
      const f = freqFor(Math.max(0,Math.min(255,v)));
      const n = Math.floor(SR * 0.044 / (w/2));
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
    for(let x=0;x<w;x+=2){
      const v = 128 + U[y*w+x];
      const f = freqFor(Math.max(0,Math.min(255,v)));
      const n = Math.floor(SR * 0.044 / (w/2));
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
  }
  return new Float32Array(out);
}

function encodeMartinScottie(imageData, modeKey){
  const m = SSTV_MODES[modeKey];
  const w=m.w, h=m.h;
  const data = imageData.data;
  const R = new Uint8Array(w*h), G = new Uint8Array(w*h), B = new Uint8Array(w*h);
  for(let i=0,p=0;i<data.length;i+=4,p++){ R[p]=data[i]; G[p]=data[i+1]; B[p]=data[i+2]; }
  const out=[];
  visEncode(out, m.vis);
  const g_ms = m.g_ms, b_ms = m.b_ms, r_ms = m.r_ms;
  const sync_ms = 4.862, porch_ms = 0.572, sep_ms = 0.572;
  for(let y=0; y<h; y++){
    tonePush(out,1200,sync_ms); tonePush(out,1500,porch_ms);
    for(let x=0;x<w;x++){ const f = freqFor(G[y*w+x]); const n = Math.floor(SR * g_ms/1000 / w); for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78); }
    tonePush(out,1500, sep_ms);
    for(let x=0;x<w;x++){ const f = freqFor(B[y*w+x]); const n = Math.floor(SR * b_ms/1000 / w); for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78); }
    tonePush(out,1500, sep_ms);
    for(let x=0;x<w;x++){ const f = freqFor(R[y*w+x]); const n = Math.floor(SR * r_ms/1000 / w); for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78); }
    tonePush(out,1500, sep_ms);
  }
  return new Float32Array(out);
}

function encodePD(imageData, modeKey){
  const m = SSTV_MODES[modeKey];
  const w=m.w, h=m.h;
  const data = imageData.data;
  const Y = new Uint8Array(w*h);
  const RY = new Int8Array(w*h);
  const BY = new Int8Array(w*h);
  for(let i=0,p=0;i<data.length;i+=4,p++){
    const r=data[i], g=data[i+1], b=data[i+2];
    const y = 0.299*r + 0.587*g + 0.114*b;
    Y[p]=y;
    RY[p]= (r-y)*0.713;
    BY[p]= (b-y)*0.564;
  }
  const out=[];
  visEncode(out, m.vis);
  const pix_ms = m.pix_ms;
  const sync_ms = 20, porch_ms = 2.08;
  for(let y=0; y<h; y++){
    tonePush(out,1200,sync_ms); tonePush(out,1500,porch_ms);
    for(let x=0;x<w;x++){
      const f = freqFor(Y[y*w+x]);
      const n = Math.floor(SR * pix_ms/1000);
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
    for(let x=0;x<w;x+=2){
      const v = 128 + ((RY[y*w+x] + RY[y*w+Math.min(w-1,x+1)])/2);
      const f = freqFor(Math.max(0,Math.min(255,v)));
      const n = Math.floor(SR * pix_ms/1000 * 2);
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
    for(let x=0;x<w;x+=2){
      const v = 128 + ((BY[y*w+x] + BY[y*w+Math.min(w-1,x+1)])/2);
      const f = freqFor(Math.max(0,Math.min(255,v)));
      const n = Math.floor(SR * pix_ms/1000 * 2);
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
    for(let x=0;x<w;x++){
      const f = freqFor(Y[y*w+x]);
      const n = Math.floor(SR * pix_ms/1000);
      for(let i=0;i<n;i++) out.push(Math.sin(2*Math.PI*f*i/SR)*0.78);
    }
  }
  return new Float32Array(out);
}

function encodeCurrentCanvas(){
  const m = getMode();
  const imgData = srcCtx.getImageData(0,0,m.w,m.h);
  if(sstvModeKey === 'robot36') return encodeRobot36(imgData);
  if(['martin1','martin2','scottieDX'].includes(sstvModeKey)) return encodeMartinScottie(imgData, sstvModeKey);
  if(['pd120','pd180','pd240'].includes(sstvModeKey)) return encodePD(imgData, sstvModeKey);
  return encodeRobot36(imgData);
}

function floatToWav(f32, sampleRate){
  const len = f32.length;
  const buf = new ArrayBuffer(44 + len*2);
  const v = new DataView(buf);
  const w = (o,s)=>{ for(let i=0;i<s.length;i++) v.setUint8(o+i, s.charCodeAt(i)); };
  w(0,'RIFF'); v.setUint32(4, 36+len*2, true); w(8,'WAVEfmt ');
  v.setUint32(16,16,true); v.setUint16(20,1,true); v.setUint16(22,1,true);
  v.setUint32(24,sampleRate,true); v.setUint32(28,sampleRate*2,true);
  v.setUint16(32,2,true); v.setUint16(34,16,true); w(36,'data');
  v.setUint32(40,len*2,true);
  let p=44;
  for(let i=0;i<len;i++){ let s=Math.max(-1,Math.min(1,f32[i])); v.setInt16(p, s*0x7FFF, true); p+=2; }
  return new Blob([v], {type:'audio/wav'});
}

