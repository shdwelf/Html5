async function parsePcapFile(file){
  const buf = await file.arrayBuffer();
  const dv = new DataView(buf);
  let packets = [];
  let meta = {file: file.name, size: file.size, linktype: 1, endian:'be'};
  try {
    // Detect PCAPNG: 0x0A0D0D0A
    if (dv.getUint32(0,false) === 0x0A0D0D0A || dv.getUint32(0,true) === 0x0A0D0D0A) {
      ({packets, meta} = parsePcapNg(buf, file.name));
    } else {
      // PCAP global header
      const magic = dv.getUint32(0, false);
      let le = false;
      if (magic === 0xA1B2C3D4) le = false;
      else if (magic === 0xD4C3B2A1) le = true;
      else if (magic === 0xA1B23C4D || magic === 0x4D3CB2A1) le = (magic === 0x4D3CB2A1); // nanosecond
      else throw new Error('Not a pcap file (bad magic 0x'+magic.toString(16)+')');
      const linktype = dv.getUint32(20, le);
      meta.linktype = linktype;
      meta.endian = le ? 'le':'be';
      let off = 24;
      let pktNo = 1;
      const totalLen = buf.byteLength;
      while (off + 16 <= totalLen && pktNo < 120000) { // hard cap
        const ts_sec = dv.getUint32(off, le);
        const ts_usec = dv.getUint32(off+4, le);
        const incl_len = dv.getUint32(off+8, le);
        const orig_len = dv.getUint32(off+12, le);
        off += 16;
        if (off + incl_len > totalLen) break;
        const pktBytes = new Uint8Array(buf, off, incl_len);
        const parsed = dissectPacket(pktBytes, pktNo, ts_sec + ts_usec/1e6, linktype);
        if(parsed) packets.push(parsed);
        off += incl_len;
        pktNo++;
        if (pktNo % 5000 === 0) await new Promise(r=>setTimeout(r,0)); // yield
      }
    }
  } catch(err){
    consoleEl.innerHTML = `<div class="p" style="color:#ff7b87">Parse error: ${escapeHtml(err.message)}</div>`;
    return;
  }
  parsedPackets = packets;
  window.parsedPackets = packets;
  currentPcapMeta = meta;
  updatePcapStats(meta, packets.length, false);
  (window.applyPacketFilter||applyPacketFilter)();
}

function parsePcapNg(buf, filename){
  const dv = new DataView(buf);
  let off = 0;
  let le = true;
  const total = buf.byteLength;
  const packets = [];
  let linktype = 1;
  let pktNo = 1;
  // find section header
  const sh_magic = dv.getUint32(0,false);
  if (sh_magic === 0x0A0D0D0A) {
    const bom = dv.getUint32(8,false);
    le = (bom === 0x1A2B3C4D);
  }
  const interfaces = new Map();
  while(off + 8 <= total && pktNo < 120000){
    if(off+8 > total) break;
    const blockType = dv.getUint32(off, le);
    const blockLen = dv.getUint32(off+4, le);
    if(blockLen < 12 || off + blockLen > total) break;
    if(blockType === 0x00000001){ // Interface Description
      const if_linktype = dv.getUint16(off+8, le);
      const if_id = interfaces.size;
      interfaces.set(if_id, if_linktype);
      if(interfaces.size===1) linktype = if_linktype;
    } else if(blockType === 0x00000006){ // Enhanced Packet Block
      const if_id = dv.getUint32(off+8, le);
      const ts_high = dv.getUint32(off+12, le);
      const ts_low  = dv.getUint32(off+16, le);
      const cap_len = dv.getUint32(off+20, le);
      // const orig_len = dv.getUint32(off+24, le);
      const pkt_off = off + 28;
      if (pkt_off + cap_len <= off + blockLen) {
        const pktBytes = new Uint8Array(buf, pkt_off, cap_len);
        const lt = interfaces.get(if_id) ?? linktype;
        const ts = (ts_high * 4294967296 + ts_low) / 1e6;
        const parsed = dissectPacket(pktBytes, pktNo, ts, lt);
        if(parsed) { packets.push(parsed); pktNo++; }
      }
    } else if(blockType === 0x00000003){ // Simple Packet Block
      const orig_len = dv.getUint32(off+8, le);
      const pkt_off = off + 12;
      const cap_len = blockLen - 16;
      if(cap_len >0 && pkt_off + cap_len <= total){
        const pktBytes = new Uint8Array(buf, pkt_off, cap_len);
        const parsed = dissectPacket(pktBytes, pktNo, pktNo/1000, linktype);
        if(parsed) { packets.push(parsed); pktNo++; }
      }
    }
    off += blockLen;
  }
  return {packets, meta:{file:filename, size:buf.byteLength, linktype, endian: le?'le':'be', format:'pcapng', interfaces: interfaces.size}};
}

// ---- Dissector ----
function dissectPacket(bytes, no, ts, linktype){
  let off = 0;
  // DLT: 1 = EN10MB, 101 = RAW, 12 = RAW (alt), 113 = LINUX_SLL, 0 = NULL/loopback
  try {
    if (linktype === 1) { // Ethernet
      if(bytes.length < 14) return null;
      off = 14;
      var ethType = (bytes[12]<<8)|bytes[13];
    } else if (linktype === 101 || linktype === 12 || linktype === 228) { // RAW IP
      ethType = 0x0800;
      off = 0;
    } else if (linktype === 113) { // LINUX_SLL
      if(bytes.length < 16) return null;
      ethType = (bytes[14]<<8)|bytes[15];
      off = 16;
    } else if (linktype === 0) { // NULL / loopback BSD
      if(bytes.length < 4) return null;
      const fam = bytes[0]|bytes[1]<<8|bytes[2]<<16|bytes[3]<<24;
      ethType = (fam===2)?0x0800:0x86DD;
      off = 4;
    } else {
      // try raw IP
      if(bytes[0]>>4 === 4){ ethType=0x0800; off=0;}
      else if(bytes[0]>>4 === 6){ ethType=0x86DD; off=0;}
      else return {no, ts, src:'?', dst:'?', proto:'LINKTYPE '+linktype, info:'Unsupported linktype', len:bytes.length, raw:bytes};
    }

    let src='?', dst='?', proto='?', sport=null, dport=null, info='', l4='';

    if (ethType === 0x0800 && bytes.length >= off+20) { // IPv4
      const ihl = (bytes[off] & 0x0f)*4;
      const ipProto = bytes[off+9];
      src = [...bytes.slice(off+12, off+16)].join('.');
      dst = [...bytes.slice(off+16, off+20)].join('.');
      off += ihl;
      if (ipProto === 6 && bytes.length >= off+20) { // TCP
        sport = (bytes[off]<<8)|bytes[off+1];
        dport = (bytes[off+2]<<8)|bytes[off+3];
        const flags = bytes[off+13];
        const syn = flags & 0x02, ack = flags & 0x10, fin = flags & 0x01, rst = flags & 0x04, psh = flags & 0x08;
        l4='TCP'; proto='TCP';
        info = `${sport} → ${dport} [${(syn?'S':'')+(ack?'A':'')+(fin?'F':'')+(rst?'R':'')+(psh?'P':'')||'·'}] Seq=?`;
        const tcpHdrLen = (bytes[off+12]>>4)*4;
        const payloadOff = off + tcpHdrLen;
        // quick app detect
        if (dport===443 || sport===443) { proto='TLS'; info = 'TLS Application Data / Handshake'; }
        else if (dport===80 || sport===80) proto='HTTP';
      } else if (ipProto === 17 && bytes.length >= off+8) { // UDP
        sport = (bytes[off]<<8)|bytes[off+1];
        dport = (bytes[off+2]<<8)|bytes[off+3];
        l4='UDP'; proto='UDP';
        info = `${sport} → ${dport} Len=${(bytes[off+4]<<8)|bytes[off+5]}`;
        const payloadOff = off + 8;
        // DNS
        if (sport===53 || dport===53) {
          proto='DNS';
          const dns = parseDns(bytes, payloadOff);
          info = dns || info;
        }
      } else if (ipProto === 1) { l4='ICMP'; proto='ICMP'; info='Echo / Control'; }
      else { proto = 'IPv4/'+ipProto; info = src+' → '+dst; }
    } else if (ethType === 0x86DD && bytes.length >= off+40) { // IPv6
      const ipProto = bytes[off+6];
      src = ipv6Str(bytes, off+8);
      dst = ipv6Str(bytes, off+24);
      off += 40;
      if (ipProto === 6) { sport=(bytes[off]<<8)|bytes[off+1]; dport=(bytes[off+2]<<8)|bytes[off+3]; proto='TCPv6'; info=`${sport} → ${dport}`; }
      else if (ipProto === 17) { sport=(bytes[off]<<8)|bytes[off+1]; dport=(bytes[off+2]<<8)|bytes[off+3]; proto='UDPv6'; info=`${sport} → ${dport}`; if(sport===53||dport===53){ proto='DNS'; const dns=parseDns(bytes, off+8); if(dns) info=dns; } }
      else proto='IPv6/'+ipProto;
    } else if (ethType === 0x0806) { proto='ARP'; info='ARP'; }
    else { proto = 'Eth 0x'+ethType.toString(16); }

    return {no, ts, src, dst, sport, dport, proto, l4, info, len: bytes.length, raw: bytes.slice(0)};
  } catch(e){ return {no, ts, src:'?', dst:'?', proto:'ERR', info: e.message, len:bytes.length, raw:bytes}; }
}

function ipv6Str(b, o){ const parts=[]; for(let i=0;i<8;i++) parts.push(((b[o+i*2]<<8)|b[o+i*2+1]).toString(16)); return parts.join(':').replace(/(^|:)0(:0)+/ , '$1::'); }

function parseDns(bytes, off){
  try{
    if(bytes.length < off+12) return null;
    const qd = (bytes[off+4]<<8)|bytes[off+5];
    if(qd < 1) return null;
    let p = off+12, labels=[], jumps=0;
    while(p < bytes.length && bytes[p] !== 0 && jumps < 20){
      const len = bytes[p++];
      if(len > 63) break;
      if(p+len > bytes.length) break;
      labels.push(String.fromCharCode.apply(null, bytes.slice(p, p+len)));
      p+=len; jumps++;
    }
    const name = labels.join('.') || '(root)';
    const qtype = (bytes[p+1]<<8)|bytes[p+2]||1;
    const types = {1:'A',28:'AAAA',15:'MX',2:'NS',5:'CNAME',16:'TXT',12:'PTR'};
    return `Query ${types[qtype]||qtype} ${name}`;
  } catch(e){ return null; }
}

