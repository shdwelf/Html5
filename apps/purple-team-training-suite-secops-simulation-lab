// --- DECODER ---
async function decodeSSTVFromAudioBuffer(abuf, sampleRate, liveDrawCb=null){
  let samples;
  if(sampleRate !== SR){
    const ratio = SR / sampleRate;
    const outLen = Math.floor(abuf.length * ratio);
    samples = new Float32Array(outLen);
    for(let i=0;i<outLen;i++) samples[i] = abuf[Math.floor(i/ratio)]||0;
  } else samples = abuf;
  const hop = Math.floor(SR * 0.002);
  const freqs = [];
  for(let i=0; i+512 < samples.length; i+=hop){
    let z=0, last=samples[i];
    for(let k=1;k<512;k++){ const s=samples[i+k]; if(last<0 && s>=0) z++; last=s; }
    freqs.push(z * SR / 512 / 2);
  }
  const freqToVal = f => Math.max(0, Math.min(255, Math.round((Math.max(1500,Math.min(2300,f))-1500)/800*255)));

  // Auto VIS
  let detectedMode = sstvModeKey;
  if(document.getElementById('sstvVisAutoChk')?.checked){
    const visDet = detectVIS(freqs, 0);
    if(visDet){
      detectedMode = visDet.mode;
      const vr=document.getElementById('sstvVisRead'); if(vr) vr.textContent = `${visDet.vis} → ${SSTV_MODES[detectedMode].name}`;
      sstvLog(`Auto VIS detected: ${visDet.vis} → ${SSTV_MODES[detectedMode].name}`);
      if(detectedMode !== sstvModeKey){
        sstvModeKey = detectedMode;
        const sel=document.getElementById('sstvModeSel'); if(sel) sel.value = detectedMode;
        applyModeUI();
      }
    }
  }

  const mode = SSTV_MODES[detectedMode];
  const w = mode.w, h = mode.h;
  rxCanvas.width = w; rxCanvas.height = h;
  const R = new Uint8Array(w*h), G = new Uint8Array(w*h), B = new Uint8Array(w*h);
  const Y = new Uint8Array(w*h);
  const U = new Int8Array(w*h), V = new Int8Array(w*h);

  let ptr = 0;
  for(let t=50; t<600 && t < freqs.length-50; t++){ if(freqs[t] < 1250){ ptr = t; break; } }
  ptr += 380;

  // Auto slant?
  let slant = parseInt(document.getElementById('sstvSlant')?.value||'0',10);
  if(document.getElementById('sstvAutoSlantChk')?.checked){
    const est = estimateSlant(freqs, detectedMode, ptr);
    slant = Math.round(est);
    const sld=document.getElementById('sstvSlant'); if(sld) sld.value = slant;
    const sv=document.getElementById('sstvSlantVal'); if(sv) sv.textContent = slant;
    const sr=document.getElementById('sstvSlantRead'); if(sr) sr.textContent = slant+' px (auto)';
    sstvLog(`Auto-slant: ${slant.toFixed(1)} px`);
  }
  document.getElementById('sstvSlantRead')?.replaceChildren(document.createTextNode(slant+' px'));

  const liveDraw = document.getElementById('sstvLiveDrawChk')?.checked;

  function putPixel(x,y,r,g,b){
    if(x<0||x>=w||y<0||y>=h) return;
    const i = y*w+x;
    R[i]=r; G[i]=g; B[i]=b;
    Y[i] = Math.round(0.299*r + 0.587*g + 0.114*b);
    if(liveDraw && rxCtx){
      rxCtx.fillStyle = `rgb(${r},${g},${b})`;
      rxCtx.fillRect(x,y,1,1);
    }
    if(liveDrawCb) liveDrawCb(x,y,r,g,b);
  }

  if(mode.type === 'robot'){
    const yFrames = Math.max(38, Math.round(0.088/0.002));
    const cFrames = Math.max(18, Math.round(0.044/0.002));
    for(let y=0; y<h && ptr < freqs.length - 120; y++){
      while(ptr < freqs.length && freqs[ptr] < 1300) ptr++;
      ptr += 2;
      const lineShift = Math.floor(slant * y / h);
      for(let x=0; x<w; x++){ const fIdx = ptr + Math.floor(x / w * yFrames); Y[y*w+x] = freqToVal(freqs[fIdx]||1500); }
      ptr += yFrames;
      for(let x=0; x<w; x+=2){ const fIdx = ptr + Math.floor((x/2) / (w/2) * cFrames); const vv=freqToVal(freqs[fIdx]||1500)-128; V[y*w+x] = vv; if(x+1<w) V[y*w+x+1]=vv; }
      ptr += cFrames;
      for(let x=0; x<w; x+=2){ const fIdx = ptr + Math.floor((x/2) / (w/2) * cFrames); const uv=freqToVal(freqs[fIdx]||1500)-128; U[y*w+x] = uv; if(x+1<w) U[y*w+x+1]=uv; }
      ptr += cFrames;
      for(let x=0;x<w;x++){
        const i = y*w+x;
        const yv=Y[i], u=U[i], v=V[i];
        let r = yv + 1.402 * v;
        let g = yv - 0.344136*u - 0.714136*v;
        let bl = yv + 1.772*u;
        putPixel(x+lineShift, y, Math.max(0,Math.min(255,r)), Math.max(0,Math.min(255,g)), Math.max(0,Math.min(255,bl)));
      }
    }
  } else if(mode.type === 'martin' || mode.type === 'scottie'){
    const g_ms = mode.g_ms, b_ms = mode.b_ms, r_ms = mode.r_ms;
    const gFrames = Math.round(g_ms/2), bFrames = Math.round(b_ms/2), rFrames = Math.round(r_ms/2);
    for(let y=0; y<h && ptr < freqs.length - 200; y++){
      while(ptr < freqs.length && freqs[ptr] < 1300) ptr++; ptr += 2;
      const lineShift = Math.floor(slant * y / h);
      for(let x=0; x<w; x++){ const fIdx = ptr + Math.floor(x/w * gFrames); G[y*w+x] = freqToVal(freqs[fIdx]||1500); }
      ptr += gFrames + 1;
      for(let x=0; x<w; x++){ const fIdx = ptr + Math.floor(x/w * bFrames); B[y*w+x] = freqToVal(freqs[fIdx]||1500); }
      ptr += bFrames + 1;
      for(let x=0; x<w; x++){ const fIdx = ptr + Math.floor(x/w * rFrames); R[y*w+x] = freqToVal(freqs[fIdx]||1500); }
      ptr += rFrames + 1;
      if(liveDraw){ for(let x=0;x<w;x++){ putPixel(x+lineShift,y,R[y*w+x],G[y*w+x],B[y*w+x]); }}
    }
  } else if(mode.type === 'pd'){
    const pix_frames = Math.round((mode.pix_ms/1000)/0.002);
    for(let y=0; y<h && ptr < freqs.length-200; y++){
      while(ptr < freqs.length && freqs[ptr] < 1300) ptr++; ptr += 10;
      const lineShift = Math.floor(slant * y / h);
      for(let x=0;x<w;x++){ const fIdx = ptr + x*pix_frames; Y[y*w+x] = freqToVal(freqs[fIdx]||1500); }
      ptr += w*pix_frames;
      for(let x=0;x<w;x+=2){ const fIdx = ptr + Math.floor(x/2)*pix_frames*2; const v=freqToVal(freqs[fIdx]||1500)-128; V[y*w+x]=v; if(x+1<w) V[y*w+x+1]=v; }
      ptr += (w/2)*pix_frames*2;
      for(let x=0;x<w;x+=2){ const fIdx = ptr + Math.floor(x/2)*pix_frames*2; const v=freqToVal(freqs[fIdx]||1500)-128; U[y*w+x]=v; if(x+1<w) U[y*w+x+1]=v; }
      ptr += (w/2)*pix_frames*2;
      for(let x=0;x<w;x++){ const fIdx = ptr + x*pix_frames; const yv2 = freqToVal(freqs[fIdx]||1500); Y[y*w+x] = (Y[y*w+x] + yv2)>>1; }
      ptr += w*pix_frames;
      if(liveDraw){
        for(let x=0;x<w;x++){
          const i=y*w+x, yv=Y[i], u=U[i], v=V[i];
          let r = yv + 1.402*v, g = yv - 0.344136*u - 0.714136*v, bl = yv + 1.772*u;
          putPixel(x+lineShift,y, Math.max(0,Math.min(255,r)), Math.max(0,Math.min(255,g)), Math.max(0,Math.min(255,bl)));
        }
      }
    }
    for(let i=0;i<w*h;i++){
      const yv=Y[i], u=U[i], v=V[i];
      R[i] = Math.max(0,Math.min(255, yv + 1.402*v));
      G[i] = Math.max(0,Math.min(255, yv - 0.344136*u - 0.714136*v));
      B[i] = Math.max(0,Math.min(255, yv + 1.772*u));
    }
  }

  const imgData = rxCtx.createImageData(w,h);
  for(let i=0;i<w*h;i++){ imgData.data[i*4]=R[i]; imgData.data[i*4+1]=G[i]; imgData.data[i*4+2]=B[i]; imgData.data[i*4+3]=255; }
  rxCtx.putImageData(imgData,0,0);
  return {R,G,B,Y, imgData, mode: detectedMode, slant};
}

