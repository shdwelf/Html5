  hump(w*0.38, 0.78, 'rgba(62,231,255,0.18)');
  hump(w*0.62, 0.65, 'rgba(62,231,255,0.17)');
  // BT LE spikes
  sctx.strokeStyle = 'rgba(167,107,255,0.9)'; sctx.lineWidth=1.4;
  for(let i=0;i<18;i++){
    const x = (i/18 * w + specT*1.7) % w;
    const ht = 18 + Math.random()*45;
    sctx.beginPath(); sctx.moveTo(x, h-18); sctx.lineTo(x, h-18-ht); sctx.stroke();
  }
  // noise
  if(rfNoiseLevel>0.01){
    sctx.fillStyle = `rgba(255,191,60,${0.07+rfNoiseLevel*0.12})`;
    sctx.fillRect(0, h-80, w, 70);
    rfNoiseLevel *= 0.985;
  }
  // labels
  sctx.fillStyle = '#7a8aad'; sctx.font='11px JetBrains Mono';
  sctx.fillText('2.412 GHz  Ch 1', 14, 18);
  sctx.fillText('2.437 GHz  Ch 6', w*0.36, 18);
  sctx.fillText('2.462 GHz  Ch 11', w*0.62, 18);
  sctx.fillText('5 GHz →', w-78, 18);
  requestAnimationFrame(drawSpec);
}
