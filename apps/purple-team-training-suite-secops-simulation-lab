document.getElementById('sstvDownloadAllBtn')?.addEventListener('click', async ()=>{
  if(!txQueue.length) return;
  let offset=0; const parts=[]; const central=[];
  for(const f of txQueue){
    const buf = await f.wav.arrayBuffer();
    const data = new Uint8Array(buf);
    const nameBytes = new TextEncoder().encode(f.name);
    const localHeader = new Uint8Array(30 + nameBytes.length);
    const dv = new DataView(localHeader.buffer);
    dv.setUint32(0, 0x04034b50, true);
    dv.setUint16(4, 20, true);
    const crc = crc32(data); dv.setUint32(14, crc, true);
    dv.setUint32(18, data.length, true); dv.setUint32(22, data.length, true);
    dv.setUint16(26, nameBytes.length, true);
    localHeader.set(nameBytes, 30);
    parts.push(localHeader, data);
    central.push({crc, size:data.length, offset, name:nameBytes});
    offset += localHeader.length + data.length;
  }
  let centralSize=0; const centralParts=[];
  for(const c of central){
    const h = new Uint8Array(46 + c.name.length);
    const dv = new DataView(h.buffer);
    dv.setUint32(0, 0x02014b50, true);
    dv.setUint32(16, c.crc, true);
    dv.setUint32(20, c.size, true); dv.setUint32(24, c.size, true);
    dv.setUint16(28, c.name.length, true);
    dv.setUint32(42, c.offset, true);
    h.set(c.name, 46);
    centralParts.push(h);
    centralSize += h.length;
  }
  const end = new Uint8Array(22);
  const ev = new DataView(end.buffer);
  ev.setUint32(0, 0x06054b50, true);
  ev.setUint16(8, central.length, true); ev.setUint16(10, central.length, true);
  ev.setUint32(12, centralSize, true);
  ev.setUint32(16, offset, true);
  const blob = new Blob([...parts, ...centralParts, end], {type:'application/zip'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `sstv_${sstvModeKey}_frames.zip`;
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 1500);
  sstvLog(`ZIP downloaded: ${txQueue.length} WAVs`);
});

// --- VIS AUTO-DETECT ---
const VIS_MAP = {8:'robot36', 44:'martin1', 40:'martin2', 76:'scottieDX', 95:'pd120', 96:'pd180', 97:'pd240'};
function detectVIS(freqs, startIdx){
  for(let i=startIdx; i< startIdx+600 && i+60 < freqs.length; i++){
    if(freqs[i] > 1850 && freqs[i+15] < 1250){
      let ptr = i+20;
      ptr += 15;
      let vis=0;
      for(let b=0;b<7;b++){
        const f = freqs[ptr + b*15] || 1200;
        if(f < 1200) vis |= (1<<b);
      }
      if(VIS_MAP[vis]) return {vis, idx:i, mode: VIS_MAP[vis]};
    }
  }
  return null;
}

// --- Slant auto-detect (MMSSTV style) ---
function estimateSlant(freqs, modeKey, syncPtr){
  const mode = SSTV_MODES[modeKey] || SSTV_MODES.robot36;
  const h = mode.h;
  const lineFrames = mode.type==='robot' ? Math.round(0.176/0.002) : Math.round(0.440/0.002);
  const syncs = [];
  let p = syncPtr;
  for(let y=0; y<h && p < freqs.length-20; y++){
    // find sync dip
    let best = p, bestV = 9999;
    for(let k=-2;k<=4;k++){ const fv = freqs[p+k]||9999; if(fv < bestV){ bestV=fv; best=p+k; } }
    syncs.push(best);
    p += lineFrames;
  }
  if(syncs.length < 10) return 0;
  // linear regression: sync_pos = a*y + b
  let n = syncs.length, sx=0, sy=0, sxy=0, sxx=0;
  for(let y=0;y<n;y++){ sx+=y; sy+=syncs[y]; sxy+=y*syncs[y]; sxx+=y*y; }
  const slope = (n*sxy - sx*sy) / (n*sxx - sx*sx);
  // slope is freq-frames per image line; convert to pixels
  const pxPerFrame = mode.w / (lineFrames - 6);
  const slant_px = slope * pxPerFrame;
  return Math.max(-30, Math.min(30, Math.round(slant_px*10)/10));
}

