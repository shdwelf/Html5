function buildFaxFrames(){
  if(!faxFileBytes) return;
  const m = getMode();
  const payloadPerFrame = m.w * m.h - 128;
  const useFec = document.getElementById('faxFecChk')?.checked;
  let data = faxFileBytes;
  let fecUsed = false;
  if(useFec){
    data = rs_encode_bytes(data);
    fecUsed = true;
  }
  const totalFrames = Math.ceil(data.length / payloadPerFrame);
  faxFrames = [];
  for(let i=0;i<totalFrames;i++){
    const chunk = data.slice(i*payloadPerFrame, (i+1)*payloadPerFrame);
    faxFrames.push({idx:i, total:totalFrames, bytes:chunk, crc: crc32(chunk)});
  }
  const infoEl = document.getElementById('faxFileInfo');
  if(infoEl) infoEl.innerHTML =
    `Name: ${escapeHtml(faxFileMeta.name)}<br>`+
    `Size: ${faxFileMeta.size} bytes<br>`+
    `CRC32: ${faxFileMeta.crc.toString(16).padStart(8,'0')}<br>`+
    `FEC: ${fecUsed ? 'RS(255,223) ON' : 'OFF'}<br>`+
    `Payload/frame: ${payloadPerFrame} B<br>`+
    `Frames: <b>${totalFrames}</b> @ ${m.name}<br>`+
    `Airtime: <b>${(totalFrames * m.total_s).toFixed(0)}s</b> (~${(totalFrames*m.total_s/60).toFixed(1)} min)`;
  sstvLog(`Fax file: ${faxFileMeta.name}, ${faxFileMeta.size} B → ${data.length} B (FEC ${fecUsed?'on':'off'}), ${totalFrames} frames`);
