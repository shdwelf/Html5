// --- CRC32 ---
function crc32(u8){
  let c = ~0;
  for(let i=0;i<u8.length;i++){ c ^= u8[i]; for(let k=0;k<8;k++) c = c & 1 ? 0xEDB88320 ^ (c>>>1) : c>>>1; }
  return (~c)>>>0;
}

// --- Reed-Solomon RS(255,223) ---
const RS_GF_EXP = new Uint8Array(512);
const RS_GF_LOG = new Uint8Array(256);
(function init_rs(){
  let x=1;
  for(let i=0;i<255;i++){ RS_GF_EXP[i]=x; RS_GF_LOG[x]=i; x = (x<<1) ^ ((x & 0x80)?0x1d:0); }
  for(let i=255;i<512;i++) RS_GF_EXP[i]=RS_GF_EXP[i-255];
})();
function rs_gf_mul(a,b){ return (a===0||b===0)?0:RS_GF_EXP[RS_GF_LOG[a]+RS_GF_LOG[b]]; }
function rs_gen_poly(nsym){
  let g=[1];
  for(let i=0;i<nsym;i++){
    const next = new Array(g.length+1).fill(0);
    for(let j=0;j<g.length;j++){
      next[j] ^= rs_gf_mul(g[j], RS_GF_EXP[i]);
      next[j+1] ^= g[j];
    }
    g = next;
  }
  return g;
}
const RS_NSYM = 32;
const RS_GEN = rs_gen_poly(RS_NSYM);
function rs_encode_msg(msg){
  const out = new Uint8Array(msg.length + RS_NSYM);
  out.set(msg,0);
  for(let i=0;i<msg.length;i++){
    const coef = out[i];
    if(coef !== 0){
      for(let j=0;j<RS_GEN.length;j++){
        out[i+j] ^= rs_gf_mul(RS_GEN[j], coef);
      }
    }
  }
  const res = new Uint8Array(msg.length + RS_NSYM);
  res.set(msg,0);
  res.set(out.slice(msg.length, msg.length+RS_NSYM), msg.length);
  return res;
}
function rs_decode_msg(code){
  let synd = new Array(RS_NSYM).fill(0);
  let has_err = false;
  for(let i=0;i<RS_NSYM;i++){
    let s=0, x=RS_GF_EXP[i];
    let pow=1;
    for(let j=code.length-1;j>=0;j--){
      s ^= rs_gf_mul(code[j], pow);
      pow = rs_gf_mul(pow, x);
    }
    synd[i]=s;
    if(s!==0) has_err=true;
  }
  return {ok: !has_err, corrected: has_err ? -1 : 0, data: code.slice(0, code.length-RS_NSYM)};
}
function rs_encode_bytes(data){
  const out=[];
  for(let i=0;i<data.length;i+=223){
    const chunk = data.slice(i, i+223);
    const padded = new Uint8Array(223); padded.set(chunk);
    const enc = rs_encode_msg(padded);
    out.push(...enc.slice(0, chunk.length + RS_NSYM));
  }
  return new Uint8Array(out);
}
function rs_decode_bytes(data){
  const out=[];
  let corrected=0;
  let errors=0;
  for(let i=0;i<data.length;){
    const remaining = data.length - i;
    const take = remaining >= 255 ? 255 : remaining;
    const chunk = data.slice(i, i+take);
    i += take;
    if(chunk.length <= RS_NSYM){ out.push(...chunk); continue; }
    const full = new Uint8Array(255); full.set(chunk);
    const dec = rs_decode_msg(full);
    if(!dec.ok) errors++;
    const datalen = Math.min(223, chunk.length - RS_NSYM);
    out.push(...dec.data.slice(0, datalen));
  }
  return {bytes: new Uint8Array(out), corrected, errors};
}

