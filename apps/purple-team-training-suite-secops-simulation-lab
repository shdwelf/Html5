  const nameBytes = enc.encode((faxFileMeta?.name||'file.bin').slice(0,48));
  headerBytes.set(nameBytes, 0);
  const dv = new DataView(headerBytes.buffer);
  dv.setUint32(48, faxFileMeta?.size||0, true);
  dv.setUint32(52, faxFileMeta?.crc||0, true);
  dv.setUint16(56, fr.idx, true);
  dv.setUint16(58, fr.total, true);
  dv.setUint32(60, fr.crc, true);
  dv.setUint32(64, fr.bytes.length, true);
  dv.setUint8(68, document.getElementById('faxFecChk')?.checked ? 1 : 0);
  dv.setUint8(69, m.vis, true);
  headerBytes[120]=0x46; headerBytes[121]=0x41; headerBytes[122]=0x58; headerBytes[123]=0x53; headerBytes[124]=0x32;
  const payload = new Uint8Array(w*h);
  payload.set(headerBytes, 0);
  payload.set(fr.bytes, 128);
  for(let i=0;i<payload.length && i < w*h;i++){
    const v = payload[i];
