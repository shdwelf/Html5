<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SSTV Lab — Robot36 / Martin / Scottie / PD — Fax & TCP Bridge</title>
<meta name="theme-color" content="#070a12">
<meta name="application-name" content="SSTV Lab">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SSTV Lab">
<meta name="mobile-web-app-capable" content="yes">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="72x72" href="icons/icon-72.png">
<link rel="icon" type="image/png" sizes="96x96" href="icons/icon-96.png">
<link rel="icon" type="image/png" sizes="128x128" href="icons/icon-128.png">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="icons/icon-512.png">
<link rel="apple-touch-icon" sizes="192x192" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/icon-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #070a12;
  --panel: #121a2b;
  --panel2: #18223a;
  --line: #263250;
  --text: #d7e2f5;
  --muted: #8a9ab8;
  --red: #ff4d5a;
  --blue: #3b9cff;
  --purple: #a76bff;
  --green: #22d3a8;
  --amber: #ffbf3c;
  --cyan: #3ee7ff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:radial-gradient(1200px 800px at 80% -10%, #142040 0%, transparent 60%),var(--bg);color:var(--text);min-height:100vh}
a{color:var(--cyan)}
.topbar{position:sticky;top:0;z-index:50;background:rgba(7,10,18,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:12px 22px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.logo{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:15px}
.logo span.cyan{color:var(--cyan)}
.logo span.purple{color:var(--purple)}
.topbar .right{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pill{border:1px solid var(--line);background:#101828;padding:5px 10px;border-radius:999px;color:var(--muted);font-size:11px;font-family:'JetBrains Mono',monospace}
.pill.live{color:var(--green);border-color:rgba(34,211,168,.35)}
.install-banner{display:none;background:linear-gradient(90deg, rgba(62,231,255,.13), rgba(167,107,255,.13));border-bottom:1px solid var(--line);padding:10px 22px;align-items:center;justify-content:center;gap:14px;font-size:13px;font-weight:600;color:#d6e2ff}
.install-banner.show{display:flex;flex-wrap:wrap}
.btn-install{background:linear-gradient(180deg,#3ee7ff,#2bbfd6);border:1px solid #5feaff;color:#052430;padding:7px 14px;border-radius:999px;font-weight:800;cursor:pointer}
.btn-install-top{background:linear-gradient(180deg,#3ee7ff,#2bbfd6);border:1px solid #5feaff;color:#052430;padding:6px 12px;border-radius:999px;font-weight:800;cursor:pointer;font-size:12px}
.wrap{max-width:1280px;margin:26px auto;padding:0 20px 80px}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.card{background:linear-gradient(180deg, var(--panel) 0%, #0f1627 100%);border:1px solid var(--line);border-radius:14px;padding:16px 16px;box-shadow:0 10px 40px rgba(0,0,0,.28)}
.card h3{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block}
.col-4{grid-column:span 4}.col-5{grid-column:span 5}.col-6{grid-column:span 6}.col-7{grid-column:span 7}.col-8{grid-column:span 8}.col-12{grid-column:span 12}
@media(max-width:980px){.col-4,.col-5,.col-6,.col-7,.col-8{grid-column:span 12}}
.btn{background:#1b2642;color:var(--text);border:1px solid #2d3b5e;padding:7px 12px;border-radius:9px;cursor:pointer;font-weight:600;font-size:12.5px;transition:.15s}
.btn:hover{background:#223054}
.btn.primary{background:linear-gradient(180deg,#3b73ff,#2d5bcf);border-color:#4a7fff}
.btn.ghost{background:transparent}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn-sm{padding:5px 9px;font-size:12px;border-radius:7px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;align-items:center}
input[type="text"], select, input[type="number"], textarea{background:#0a1222;border:1px solid #2a3654;color:var(--text);padding:8px 10px;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:12.5px;outline:none}
input[type="text"]:focus,select:focus,textarea:focus{border-color:#3b6cff;box-shadow:0 0 0 3px rgba(59,108,255,.14)}
label.small{font-size:11px;color:var(--muted);display:block;margin-bottom:5px}
.small-muted{font-size:12px;color:var(--muted)}
hr.soft{border:none;border-top:1px solid var(--line);margin:12px 0}
.mono{font-family:'JetBrains Mono',monospace}
.list-tight{font-size:13px;color:#b8c7e3;line-height:1.75}
.list-tight li{margin-left:16px}
.footer-note{color:#6d7c9b;font-size:12px;text-align:center;margin-top:30px;border-top:1px solid var(--line);padding-top:16px;line-height:1.7}

/* Selfie modal */
#selfieModal{position:fixed;inset:0;background:rgba(3,6,12,.72);backdrop-filter:blur(6px);z-index:200;display:none;align-items:center;justify-content:center}
#selfieModal.show{display:flex}
.selfie-box{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;max-width:560px;width:92%;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.selfie-box h3{margin-bottom:10px;font-size:16px}
.selfie-log{font-family:'JetBrains Mono',monospace;font-size:11.5px;background:#070d1a;border:1px solid var(--line);border-radius:8px;padding:10px;height:190px;overflow:auto;color:#9ab3d8;margin:10px 0}
.ok{color:var(--green)} .bad{color:var(--red)} .warn{color:var(--amber)}
</style>
</head>
<body>

<div class="topbar">
  <div class="logo">SSTV<span class="cyan">LAB</span> <span style="color:#556785">/ v4.7.4</span></div>
  <div style="font-size:12px;color:var(--muted)">Robot36 · Martin M1/M2 · Scottie DX · PD120/180/240 · Fax + TCP/IP ARQ Bridge</div>
  <div class="right">
    <button class="btn-install-top" id="installBtnTop" style="display:none">⬇ Install</button>
    <button class="btn btn-sm" id="selfieBtn" title="Verify app integrity / download standalone">📸 Selfie / Save</button>
    <span class="pill live">● AUDIO LAB</span>
    <span class="pill">OFFLINE READY</span>
  </div>
</div>

<div class="install-banner" id="installBanner" role="region" aria-label="Install app">
  <span>📲 Install SSTV Lab as a desktop / mobile app — works fully offline</span>
  <button class="btn-install" id="installBtn">Install App</button>
  <button class="btn btn-sm ghost" id="dismissInstallBtn" style="border-radius:999px">Not now</button>
  <button class="btn btn-sm ghost" id="downloadStandaloneBtn" style="border-radius:999px">Download Standalone .html</button>
  <button class="btn btn-sm ghost" id="openSelfieBtn" style="border-radius:999px">📸 Selfie / Verify</button>
</div>

<div class="wrap">

  <div class="card col-12" style="padding:12px 16px">
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:12px;color:var(--amber)">
      <strong>📻 TRAINING / LAB RF ONLY</strong>
      <span style="color:var(--muted)">SSTV audio stays in your browser / soundcard. Never transmit on licensed amateur / commercial frequencies without a valid license. Audio output is line-level only — no RF transmitter is included.</span>
    </div>
  </div>

  <div class="grid">
    <div class="card col-4">
      <h3><span class="dot" style="background:var(--green)"></span> TX Source</h3>
      <div style="display:flex; gap:6px; margin-bottom:8px; flex-wrap:wrap; font-size:12px">
        <label><input type="radio" name="sstvMode" value="image" checked> Image</label>
        <label><input type="radio" name="sstvMode" value="fax"> File Fax</label>
        <label><input type="radio" name="sstvMode" value="bridge"> TCP/IP Bridge</label>
      </div>

      <label class="small">SSTV Mode</label>
      <select id="sstvModeSel" style="margin-bottom:8px; width:100%">
        <option value="robot36">Robot36 — 320×240, 36s, VIS 8</option>
        <option value="martin1">Martin M1 — 320×256, 114s, VIS 44</option>
        <option value="martin2">Martin M2 — 320×256, 58s, VIS 40</option>
        <option value="scottieDX">Scottie DX — 320×256, 269s, VIS 76</option>
        <option value="pd120">PD120 — 640×496, 121s, VIS 95</option>
        <option value="pd180">PD180 — 640×496, 181s, VIS 96</option>
        <option value="pd240">PD240 — 640×496, 240s, VIS 97</option>
      </select>
      <div class="small-muted" id="sstvModeInfo" style="margin-bottom:10px">320×240 • 36.0s • ~76 KB/frame</div>

      <!-- Image TX -->
      <div id="sstvImageBox">
        <label class="small">Source image</label>
        <input type="file" id="sstvImgFile" accept="image/*" style="font-size:12px;color:var(--muted);margin-bottom:8px">
        <canvas id="sstvSrcCanvas" width="320" height="256" style="width:100%; background:#050912; border:1px solid var(--line); border-radius:8px; image-rendering: pixelated;"></canvas>
        <div class="toolbar" style="margin-top:8px">
          <button class="btn btn-sm ghost" id="sstvTestPattern">Test Pattern</button>
          <button class="btn btn-sm ghost" id="sstvClearImg">Clear</button>
          <button class="btn btn-sm ghost" id="sstvResizeBtn">Fit</button>
        </div>
      </div>

      <!-- Fax TX -->
      <div id="sstvFaxBox" style="display:none">
        <label class="small">File to send via SSTV Fax</label>
        <input type="file" id="sstvFaxFile" style="font-size:12px;color:var(--muted);margin-bottom:8px">
        <div id="faxFileInfo" class="small-muted" style="font-family:'JetBrains Mono',monospace; font-size:11.5px; background:#090f1c; border:1px solid var(--line); border-radius:8px; padding:10px; min-height:80px">No file selected.</div>
        <hr class="soft">
        <div style="font-size:12px; color:var(--muted); display:grid; grid-template-columns:1fr 1fr; gap:6px">
          <label><input type="checkbox" id="faxFecChk" checked> RS(255,223) FEC</label>
          <label><input type="checkbox" id="faxCrcChk" checked> CRC32/frame</label>
          <label>Repeat: <select id="faxRepeatSel" style="width:70px; padding:3px; font-size:11px"><option value="1">1×</option><option value="2">2×</option><option value="3">3×</option></select></label>
          <label>Gap: <select id="faxGapSel" style="width:70px; padding:3px; font-size:11px"><option value="0">0s</option><option value="2">2s</option><option value="5" selected>5s</option></select></label>
        </div>
        <div class="small-muted" style="margin-top:6px">Reed-Solomon RS(255,223) — corrects up to 16 byte errors per 255-byte block.</div>
      </div>

      <!-- Bridge TX -->
      <div id="sstvBridgeBox" style="display:none">
        <label class="small">TCP/IP over SSTV — Bridge + ARQ</label>
        <div class="small-muted" style="background:#090f1c; border:1px solid var(--line); border-radius:8px; padding:10px; font-size:12px; line-height:1.7">
          Encapsulates data into SSTV fax frames (SLIP + CRC + RS).<br>
          • MTU: 1200 bytes/packet<br>
          • ARQ: Go-Back-N / Selective Repeat<br>
          • Bridge: data → SSTV → decode → file<br><br>
          <span id="bridgePcapInfo">Load a file in Fax mode, or paste text below.</span>
          <textarea id="bridgeTextInput" placeholder="Type / paste text to bridge over SSTV…" style="width:100%;height:70px;margin-top:8px;background:#070d1a;border:1px solid var(--line);border-radius:6px;color:var(--text);padding:8px;font-family:'JetBrains Mono',monospace;font-size:11.5px;resize:vertical"></textarea>
          <div style="margin-top:6px"><button class="btn btn-sm" id="bridgeTextQueueBtn">Queue Text → Bridge</button></div>
        </div>
        <div style="background:#090f1c; border:1px solid var(--line); border-radius:8px; padding:10px; margin-top:8px; font-size:12px">
          <b style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted)">ARQ Link Control</b>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px; color:var(--muted)">
            <label><input type="checkbox" id="arqEnableChk" checked> ARQ Enable</label>
            <label>Mode: <select id="arqModeSel" style="width:90px; padding:3px; font-size:11px"><option value="sr" selected>SR</option><option value="gbn">Go-Back-N</option></select></label>
            <label>Window: <input type="number" id="arqWindow" value="8" min="1" max="64" style="width:55px; padding:3px; font-size:11px"></label>
            <label>RTT ms: <input type="number" id="arqRtt" value="900" min="50" max="5000" step="50" style="width:65px; padding:3px; font-size:11px"></label>
            <label>Loss %: <input type="number" id="arqLoss" value="5" min="0" max="50" style="width:55px; padding:3px; font-size:11px"></label>
            <span class="mono" id="arqStats" style="grid-column:1/-1; font-size:11px; color:#8a9ab8">ARQ ON | W=8 | RTT~900ms</span>
          </div>
        </div>
        <div class="toolbar" style="margin-top:8px">
          <button class="btn btn-sm ghost" id="bridgeClearBtn">Clear Queue</button>
        </div>
        <div id="bridgeQueueInfo" class="small-muted mono" style="margin-top:6px">Queue: 0 packets / 0 frames</div>
      </div>

      <hr class="soft">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12px; color:var(--muted)">
        <div>Mode: <b id="sstvModeLabel" style="color:var(--text)">Robot36</b></div>
        <div>Size: <b id="sstvSizeLabel" style="color:var(--text)">320×240</b></div>
        <div>Time: <b id="sstvTimeLabel" style="color:var(--text)">36.0 s</b></div>
        <div>Rate: <b id="sstvRateLabel" style="color:var(--text)">~2.1 KB/s</b></div>
      </div>
    </div>

    <div class="card col-8">
      <h3><span class="dot" style="background:var(--cyan)"></span> SSTV Modulator — TX Audio / Waterfall</h3>
      <div class="toolbar">
        <button class="btn primary btn-sm" id="sstvEncodeBtn">1. Encode → WAV</button>
        <button class="btn btn-sm" id="sstvEncodeAllBtn" title="Encode entire fax/bridge queue">Encode All</button>
        <button class="btn btn-sm" id="sstvPlayBtn" disabled>▶ Play</button>
        <button class="btn btn-sm" id="sstvStopBtn" disabled>■ Stop</button>
        <button class="btn btn-sm ghost" id="sstvPauseBtn" disabled>⏸ Pause</button>
        <button class="btn btn-sm" id="sstvDownloadBtn" disabled>Download .wav</button>
        <button class="btn btn-sm ghost" id="sstvDownloadAllBtn" disabled>Download ZIP</button>
        <span class="small-muted" style="margin-left:auto" id="sstvTxStatus">Ready</span>
      </div>
      <canvas id="sstvWaterfall" width="900" height="160" style="width:100%; height:160px; background:#050912; border-radius:8px; border:1px solid var(--line); display:block;"></canvas>
      <div style="display:flex; align-items:center; gap:12px; margin-top:8px">
        <div style="flex:1; height:8px; background:#0a1222; border-radius:99px; border:1px solid var(--line); overflow:hidden">
          <div id="sstvTxProgress" style="height:100%; width:0%; background: linear-gradient(90deg, #3b9cff, #a76bff); transition: width .08s linear;"></div>
        </div>
        <span class="mono small-muted" id="sstvTxTime">0.0 / 36.0s</span>
        <span class="mono small-muted" id="sstvTxFrameInfo"></span>
      </div>
      <div style="display:flex; gap:14px; margin-top:8px; font-size:11.5px; color:var(--muted); flex-wrap:wrap; align-items:center">
        <span>1500–2300 Hz FM</span>
        <span>1200 Hz Sync</span>
        <span id="sstvTxDetail">Robot36: Y 88ms, R-Y 44ms, B-Y 44ms</span>
        <span style="margin-left:auto">Vol: <input type="range" id="sstvVol" min="0" max="100" value="72" style="width:90px;vertical-align:middle"></span>
      </div>
      <div id="sstvTxQueueWrap" style="display:none; margin-top:10px; background:#090f1c; border:1px solid var(--line); border-radius:8px; padding:10px; max-height:120px; overflow:auto; font-family:'JetBrains Mono',monospace; font-size:11px; color:#9ab3d8">
        <b style="color:var(--text); font-family:Inter,sans-serif">TX Frame Queue</b>
        <div id="sstvTxQueue"></div>
      </div>
    </div>

    <div class="card col-6">
      <h3><span class="dot" style="background:var(--purple)"></span> SSTV Demodulator — RX / Live Sync</h3>
      <div class="toolbar">
        <button class="btn btn-sm" id="sstvDecodeBtn">Decode WAV</button>
        <button class="btn btn-sm primary" id="sstvLiveDecodeBtn">🎙 Live Decode</button>
        <button class="btn btn-sm ghost" id="sstvAutoDecodeChkBtn">Auto-decode: Off</button>
        <button class="btn btn-sm ghost" id="sstvMicBtn">🎤 Mic</button>
        <input type="file" id="sstvWavFile" accept=".wav,audio/*" multiple style="display:none">
        <button class="btn btn-sm ghost" onclick="document.getElementById('sstvWavFile').click()">Load WAV…</button>
        <span class="small-muted" id="sstvRxStatus" style="margin-left:auto">Idle</span>
      </div>
      <canvas id="sstvRxCanvas" width="320" height="256" style="width:100%; max-width:520px; background:#050912; border:1px solid var(--line); border-radius:8px; image-rendering: pixelated;"></canvas>
      <div style="display:flex; gap:14px; align-items:center; margin-top:8px; font-size:11.5px; color:var(--muted); flex-wrap:wrap">
        <span>Slant: <input type="range" id="sstvSlant" min="-30" max="30" value="0" style="width:120px; vertical-align:middle"> <span id="sstvSlantVal" class="mono">0</span></span>
        <label><input type="checkbox" id="sstvAutoSlantChk" checked> Auto Slant</label>
        <button class="btn btn-sm ghost" id="sstvAutoSlantBtn" style="padding:3px 8px; font-size:11px">Detect</button>
        <label><input type="checkbox" id="sstvLiveDrawChk" checked> Live draw</label>
        <span id="sstvRxInfo" class="mono small-muted" style="margin-left:auto">No decode yet.</span>
      </div>
      <div style="margin-top:10px">
        <label class="small">Live SSTV Waterfall / Sync Viewer</label>
        <canvas id="sstvLiveWaterfall" width="640" height="140" style="width:100%; height:140px; background:#050912; border:1px solid var(--line); border-radius:8px; display:block;"></canvas>
        <div class="small-muted" style="font-size:11px; margin-top:4px">X: 1100–2400 Hz • Y: time (scrolling) • Red = sync • Green = VIS</div>
      </div>
      
      <div id="sstvFaxRxBox" style="margin-top:10px; padding:10px; background:#0a1222; border:1px solid var(--line); border-radius:8px">
        <b style="font-size:12px">Fax / Bridge File Reassembly</b>
        <div id="faxRxInfo" class="small-muted mono" style="margin-top:6px">Waiting for frames…</div>
        <div style="margin-top:8px; display:flex; gap:8px; flex-wrap:wrap">
          <button class="btn btn-sm" id="faxDownloadBtn" disabled>Download File</button>
          <button class="btn btn-sm ghost" id="faxClearBtn">Clear</button>
        </div>
        <div id="faxFrameMap" style="margin-top:8px; font-size:11px; font-family:'JetBrains Mono',monospace; color:#7a8dad; word-break:break-all"></div>
      </div>
    </div>

    <div class="card col-6">
      <h3><span class="dot" style="background:var(--amber)"></span> Spectrum / Link Stats</h3>
      <canvas id="sstvSpectrum" width="520" height="170" style="width:100%; background:#050912; border:1px solid var(--line); border-radius:8px;"></canvas>
      <div style="font-size:11px; color:var(--muted); margin-top:6px; display:flex; gap:16px; flex-wrap:wrap">
        <span>1500 Hz Black</span><span>1900 Hz Mid</span><span>2300 Hz White</span><span>1200 Hz Sync</span>
        <span style="margin-left:auto" id="sstvFreqReadout" class="mono">— Hz</span>
      </div>
      <hr class="soft">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:12px; color:var(--muted)">
        <div>RX SNR: <b id="sstvSnr" class="mono" style="color:var(--text)">— dB</b></div>
        <div>Sync lock: <b id="sstvLock" style="color:var(--text)">—</b></div>
        <div>VIS: <b id="sstvVisRead" class="mono" style="color:var(--text)">—</b></div>
        <div>Slant: <b id="sstvSlantRead" class="mono" style="color:var(--text)">0 px</b></div>
        <div>Frames RX: <b id="sstvFramesRx" class="mono" style="color:var(--text)">0</b></div>
        <div>CRC OK: <b id="sstvCrcOk" class="mono" style="color:var(--green)">0 / 0</b></div>
        <div>RS corrected: <b id="sstvRsFix" class="mono" style="color:var(--amber)">0</b></div>
        <div>Bytes RX: <b id="sstvBytesRx" class="mono" style="color:var(--text)">0</b></div>
        <div>Packets: <b id="sstvPktsRx" class="mono" style="color:var(--text)">0</b></div>
        <div>BER: <b id="sstvBer" class="mono" style="color:var(--text)">—</b></div>
      </div>
      <hr class="soft">
      <ul class="list-tight" style="font-size:12.5px">
        <li><b>Robot36</b> — 320×240, 36s</li>
        <li><b>Martin M1/M2</b> — 320×256, 114s / 58s</li>
        <li><b>Scottie DX</b> — 320×256, 269s</li>
        <li><b>PD120 / PD180 / PD240</b> — 640×496</li>
