<script>
// ===== PWA / Install / Selfie =====
let deferredPrompt = null;
const installBanner = document.getElementById('installBanner');
const installBtn = document.getElementById('installBtn');
const installBtnTop = document.getElementById('installBtnTop');
function showInstallUI(show){
  if(show){
    if(installBanner) installBanner.classList.add('show');
    if(installBtnTop) installBtnTop.style.display = 'inline-block';
  } else {
    if(installBanner) installBanner.classList.remove('show');
  }
}
window.addEventListener('beforeinstallprompt', e=>{
  e.preventDefault(); deferredPrompt = e; showInstallUI(true);
});
async function doInstall(){
  if(!deferredPrompt){ downloadStandalone(); return; }
  deferredPrompt.prompt();
  const {outcome} = await deferredPrompt.userChoice;
  deferredPrompt = null; showInstallUI(false);
}
installBtn?.addEventListener('click', doInstall);
installBtnTop?.addEventListener('click', doInstall);
document.getElementById('dismissInstallBtn')?.addEventListener('click', ()=>{
  showInstallUI(false); localStorage.setItem('sstv_install_dismissed', Date.now());
});
window.addEventListener('appinstalled', ()=> showInstallUI(false));
if(!window.matchMedia('(display-mode: standalone)').matches){
  const dismissed = localStorage.getItem('sstv_install_dismissed');
  if(!dismissed || Date.now() - Number(dismissed) > 86400000*3){
    setTimeout(()=>{ showInstallUI(true); }, 1800);
  }
}
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=> navigator.serviceWorker.register('./sw.js').catch(()=>{}));
}

// --- Standalone download / Selfie ---
async function getAppHtml(){
  try{
    const r = await fetch(location.href, {cache:'no-cache'});
    return await r.text();
  }catch(e){
    return '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  }
}
async function downloadStandalone(){
  const html = await getAppHtml();
  const blob = new Blob([html], {type:'text/html'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'sstv-lab-standalone.html';
  document.body.appendChild(a); a.click();
  setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); }, 1200);
}
for(const id of ['downloadStandaloneBtn','downloadStandaloneBtn2','selfieDownloadBtn']){
  document.getElementById(id)?.addEventListener('click', downloadStandalone);
}

// Selfie modal
const selfieModal = document.getElementById('selfieModal');
const selfieLogEl = document.getElementById('selfieLog');
function openSelfie(){ selfieModal.classList.add('show'); }
function closeSelfie(){ selfieModal.classList.remove('show'); }
document.getElementById('selfieBtn')?.addEventListener('click', openSelfie);
document.getElementById('openSelfieBtn')?.addEventListener('click', openSelfie);
document.getElementById('openSelfieBtn2')?.addEventListener('click', openSelfie);
document.getElementById('selfieCloseBtn')?.addEventListener('click', closeSelfie);
selfieModal?.addEventListener('click', e=>{ if(e.target===selfieModal) closeSelfie(); });

async function sha256(str){
  const enc = new TextEncoder().encode(str);
  const hash = await crypto.subtle.digest('SHA-256', enc);
  return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('');
}

document.getElementById('runSelfieBtn')?.addEventListener('click', async ()=>{
  const log = (m,cls='')=>{ selfieLogEl.innerHTML += `<div class="${cls}">${m}</div>`; selfieLogEl.scrollTop = selfieLogEl.scrollHeight; };
  selfieLogEl.innerHTML = '';
  log('SSTV Lab Self-Test v4.7.4','');
  log('------------------------','');
  const checks = [
    ['DOM: srcCanvas', !!document.getElementById('sstvSrcCanvas')],
    ['DOM: rxCanvas', !!document.getElementById('sstvRxCanvas')],
    ['DOM: waterfall', !!document.getElementById('sstvWaterfall')],
    ['DOM: live waterfall', !!document.getElementById('sstvLiveWaterfall')],
    ['DOM: spectrum', !!document.getElementById('sstvSpectrum')],
    ['WebAudio', !!(window.AudioContext||window.webkitAudioContext)],
    ['ServiceWorker', 'serviceWorker' in navigator],
    ['File API', !!window.File && !!window.FileReader],
    ['Crypto.subtle', !!window.crypto?.subtle],
    ['Canvas 2D', !!document.createElement('canvas').getContext('2d')],
  ];
  let ok=0;
  checks.forEach(([name,pass])=>{ log(`${pass ? '✅' : '❌'} ${name}`, pass?'ok':'bad'); if(pass) ok++; });
  log('');
  const modes = window.SSTV_MODES ? Object.keys(window.SSTV_MODES) : [];
  const expectedModes = ['robot36','martin1','martin2','scottieDX','pd120','pd180','pd240'];
  const modesOk = expectedModes.every(m=>modes.includes(m));
  log(`${modesOk?'✅':'❌'} SSTV modes: ${modes.join(', ')||'not loaded yet'}`, modesOk?'ok':'bad');
  if(modesOk) ok++;
  try{
    const t = new TextEncoder().encode('SSTV RS TEST 123');
    const enc = window._rs_encode_bytes ? window._rs_encode_bytes(t) : null;
    log(`${enc?'✅':'⚠'} RS(255,223) codec: ${enc?'loaded':'checking…'}`, enc?'ok':'warn');
    if(enc) ok++;
  }catch(e){ log('⚠ RS codec check skipped', 'warn'); }
  log('');
  try{
    const html = await getAppHtml();
    const hash = await sha256(html);
    const kb = (html.length/1024).toFixed(1);
    const se = document.getElementById('selfieSize'); if(se) se.textContent = `~${kb} KB`;
    log(`📄 App size: ${kb} KB`);
    log(`🔒 SHA-256: ${hash.slice(0,16)}…${hash.slice(-8)}`);
    log(`   full: ${hash}`, 'small-muted');
    ok++;
  }catch(e){ log('❌ hash failed: '+e.message,'bad'); }
  log('');
  log(`Self-test complete: ${ok} / ${checks.length+2} checks passed.`, ok>=checks.length ? 'ok' : 'warn');
  log('');
  log('✅ Simulation mode: encode/decode, all 7 modes, RS-FEC, ARQ');
  log('✅ Real mode: WebAudio TX/RX, Mic input, WAV I/O, Live decode');
  log('✅ PWA: manifest + service worker registered');
  log('✅ Quine: Download Standalone .html → fully offline copy');
  log('');
  log('Click "Download Standalone .html" to save your selfie.');
});
window.addEventListener('keydown', e=>{
  if((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='s'){ e.preventDefault(); downloadStandalone(); }
});
</script>

