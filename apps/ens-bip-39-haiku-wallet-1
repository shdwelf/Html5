/**
 * wallet.js — BIP-39 Haiku Wallet Miner
 * Generates valid BIP-39 mnemonics whose syllables form 5-7-5 haiku
 * Features: SHA-256 checksum, AES-256-GCM encryption, localStorage persistence
 */

var WalletMiner = (() => {

  // ═══════════════════════════════════════════════════════
  //  SYLLABLE COUNTING — Real English syllable counter
  // ═══════════════════════════════════════════════════════

  const SYLLABLE_EXCEPTIONS = {
    'the':1,'be':1,'she':1,'he':1,'me':1,'we':1,'ye':1,
    'eye':1,'aye':1,'queue':1,'league':1,'tongue':1,
    'every':3,'everywhere':4,'different':3,'family':3,
    'chocolate':3,'vegetable':4,'restaurant':3,'idea':3,
    'poem':2,'poet':2,'genuine':3,'certain':2,'special':2,
    'social':2,'natural':3,'casual':2,'visual':3,'usual':3,
    'actual':3,'nature':2,'culture':2,'future':2,'measure':2,
    'treasure':2,'pleasure':2,'capture':2,'feature':2,
    'picture':2,'mixture':2,'furniture':3,'village':2,
    'message':2,'damage':2,'manage':2,'language':3,
    'orange':2,'average':3,'leverage':3,'advantage':3,
    'square':1,'fire':1,'wire':1,'tire':1,'hire':1,
    'our':1,'your':1,'their':1,'are':1,'were':1,
    'acquire':2,'require':2,'retire':2,'admire':2,'inspire':2,
    'entire':2,'desire':2,'empire':2,'conspire':2,'expire':2,
    'science':2,'quiet':2,'client':2,'ancient':2,'sufficient':3,
    'efficient':3,'experience':4,'blue':1,'true':1,'clue':1,
    'avenue':3,'continue':3,'value':2,'issue':2,'tissue':2,
  };

  function countSyllables(word) {
    word = word.toLowerCase().trim();
    if (SYLLABLE_EXCEPTIONS[word] !== undefined) return SYLLABLE_EXCEPTIONS[word];
    if (word.length <= 2) return 1;

    let w = word;
    // Handle -le at end after consonant (ta-ble, lit-tle)
    if (w.length > 2 && w.endsWith('le') && !/[aeiouy]/.test(w[w.length-3])) {
      // keep 'le' — it adds a syllable
    } else {
      // Remove silent trailing e
      w = w.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
    }
    // Remove leading y (acts as consonant)
    w = w.replace(/^y/, '');

    // Count vowel groups
    const matches = w.match(/[aeiouy]{1,2}/g);
    return matches ? Math.max(1, matches.length) : 1;
  }

  // Pre-compute syllable map for all BIP-39 words
  let syllableMap = null;
  function getSyllableMap() {
    if (!syllableMap) {
      syllableMap = new Map();
      for (const w of BIP39_WORDLIST) {
        syllableMap.set(w, countSyllables(w));
      }
    }
    return syllableMap;
  }

  // ═══════════════════════════════════════════════════════
  //  BIP-39 CRYPTO — Entropy, checksum, mnemonic
  // ═══════════════════════════════════════════════════════

  function bytesToBits(bytes) {
    const bits = [];
    for (const byte of bytes) {
      for (let i = 7; i >= 0; i--) bits.push((byte >> i) & 1);
    }
    return bits;
  }

  function bitsToNumber(bits, start, len) {
    let n = 0;
    for (let i = 0; i < len; i++) n = (n << 1) | bits[start + i];
    return n;
  }

  async function sha256(data) {
    const hash = await crypto.subtle.digest('SHA-256', data);
    return new Uint8Array(hash);
  }

  // Generate 12-word BIP-39 mnemonic with valid checksum
  async function generateMnemonic() {
    const entropy = crypto.getRandomValues(new Uint8Array(16)); // 128 bits
    const hash = await sha256(entropy);

    // Extract first 4 bits of hash as checksum
    const checksumBits = [];
    for (let i = 0; i < 4; i++) checksumBits.push((hash[0] >> (7 - i)) & 1);

    // Combine entropy bits + checksum bits = 132 bits
    const entropyBits = bytesToBits(entropy);
    const combined = [...entropyBits, ...checksumBits];

    // Map 11-bit groups to words
    const words = [];
    for (let i = 0; i < 12; i++) {
      const idx = bitsToNumber(combined, i * 11, 11);
      words.push(BIP39_WORDLIST[idx]);
    }
    return words;
  }

  // Validate a mnemonic's checksum
  async function validateMnemonic(words) {
    if (words.length !== 12) return false;
    const indices = words.map(w => BIP39_WORDLIST.indexOf(w.toLowerCase()));
    if (indices.some(i => i === -1)) return false;

    // Convert to bits
    const bits = [];
    for (const idx of indices) {
      for (let i = 10; i >= 0; i--) bits.push((idx >> i) & 1);
    }
    // 132 bits: 128 entropy + 4 checksum

    // Reconstruct entropy bytes
    const entropy = new Uint8Array(16);
    for (let i = 0; i < 16; i++) {
      let byte = 0;
      for (let j = 0; j < 8; j++) byte = (byte << 1) | bits[i * 8 + j];
      entropy[i] = byte;
    }

    // Verify checksum
    const hash = await sha256(entropy);
    const expectedChecksum = [];
    for (let i = 0; i < 4; i++) expectedChecksum.push((hash[0] >> (7 - i)) & 1);
    const actualChecksum = bits.slice(128, 132);

    return expectedChecksum.every((v, i) => v === actualChecksum[i]);
  }

  // ═══════════════════════════════════════════════════════
  //  HAIKU LOGIC — 5-7-5 syllable pattern detection
  // ═══════════════════════════════════════════════════════

  function findHaikuSplit(syllableCounts) {
    if (syllableCounts.reduce((a, b) => a + b, 0) !== 17) return null;

    let s1 = 0, line1End = -1;
    for (let i = 0; i < syllableCounts.length; i++) {
      s1 += syllableCounts[i];
      if (s1 === 5) { line1End = i + 1; break; }
      if (s1 > 5) return null;
    }
    if (line1End === -1) return null;

    let s2 = 0, line2End = -1;
    for (let i = line1End; i < syllableCounts.length; i++) {
      s2 += syllableCounts[i];
      if (s2 === 7) { line2End = i + 1; break; }
      if (s2 > 7) return null;
    }
    if (line2End === -1) return null;

    let s3 = 0;
    for (let i = line2End; i < syllableCounts.length; i++) s3 += syllableCounts[i];
    if (s3 !== 5) return null;

    return { line1End, line2End };
  }

  // Grammar heuristic: skip haiku that "don't read well"
  function passesGrammarCheck(words, split) {
    const SKIP_STARTS = new Set([
      'the','a','an','and','or','but','is','am','are','was','were',
      'be','been','being','have','has','had','do','does','did',
      'will','would','shall','should','may','might','must','can','could',
      'not','no','nor','so','if','as','at','by','in','of','on','to','up',
      'into','onto','upon','with','from','than','then','that','this'
    ]);

    const line1 = words.slice(0, split.line1End);
    const line2 = words.slice(split.line1End, split.line2End);
    const line3 = words.slice(split.line2End);

    // First word shouldn't be a function word
    if (SKIP_STARTS.has(line1[0])) return false;

    // No excessive duplication
    const counts = {};
    for (const w of words) counts[w] = (counts[w] || 0) + 1;
    if (Object.values(counts).some(c => c >= 3)) return false;

    // Each line should be non-empty and have variety
    if (line1.length < 1 || line2.length < 1 || line3.length < 1) return false;

    // At least one "content-bearing" word per line (not all function words)
    const hasContent = (line) => line.some(w => !SKIP_STARTS.has(w));
    return hasContent(line1) && hasContent(line2) && hasContent(line3);
  }

  // ═══════════════════════════════════════════════════════
  //  AES-256-GCM ENCRYPTION — Web Crypto API
  // ═══════════════════════════════════════════════════════

  async function deriveKey(password, salt) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      'raw', enc.encode(password), 'PBKDF2', false, ['deriveKey']
    );
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 100000, hash: 'SHA-256' },
      keyMaterial,
      { name: 'AES-GCM', length: 256 },
      false,
      ['encrypt', 'decrypt']
    );
  }

  async function encryptAES256(plaintext, password) {
    const enc = new TextEncoder();
    const salt = crypto.getRandomValues(new Uint8Array(16));
    const key = await deriveKey(password, salt);
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const encrypted = await crypto.subtle.encrypt(
      { name: 'AES-GCM', iv }, key, enc.encode(plaintext)
    );
    const result = new Uint8Array(16 + 12 + new Uint8Array(encrypted).length);
    result.set(salt, 0);
    result.set(iv, 16);
    result.set(new Uint8Array(encrypted), 28);
    return btoa(String.fromCharCode(...result));
  }

  async function decryptAES256(base64, password) {
    const raw = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
    const salt = raw.slice(0, 16);
    const iv = raw.slice(16, 28);
    const ciphertext = raw.slice(28);
    const key = await deriveKey(password, salt);
    const decrypted = await crypto.subtle.decrypt(
      { name: 'AES-GCM', iv }, key, ciphertext
    );
    return new TextDecoder().decode(decrypted);
  }

  // ═══════════════════════════════════════════════════════
  //  PERSISTENT STORAGE — Encrypted localStorage
  // ═══════════════════════════════════════════════════════

  const STORAGE_KEY = 'enso_haiku_wallets';
  let sessionPassword = null;
  let walletList = []; // In-memory decrypted list

  function saveToStorage() {
    if (!sessionPassword) return;
    const json = JSON.stringify(walletList);
    const encrypted = encryptAES256(json, sessionPassword);
    encrypted.then(enc => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        encrypted: enc,
        version: 1,
        timestamp: Date.now()
      }));
    });
  }

  async function loadFromStorage(password) {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return false;
    try {
      const data = JSON.parse(raw);
      const decrypted = await decryptAES256(data.encrypted, password);
      walletList = JSON.parse(decrypted);
      sessionPassword = password;
      return true;
    } catch {
      return false;
    }
  }

  function hasStoredWallets() {
    return !!localStorage.getItem(STORAGE_KEY);
  }

  function clearStorage() {
    localStorage.removeItem(STORAGE_KEY);
    walletList = [];
    sessionPassword = null;
  }

  // ═══════════════════════════════════════════════════════
  //  MINING ENGINE — Async haiku search with UI yielding
  // ═══════════════════════════════════════════════════════

  let miningActive = false;
  let totalMined = 0;

  async function mineHaiku(walletType, count, grammarCheck, onFound, onProgress) {
    miningActive = true;
    let found = 0;
    let attempts = 0;
    const batchSize = 50;
    const smap = getSyllableMap();

    while (found < count && miningActive) {
      for (let b = 0; b < batchSize && found < count && miningActive; b++) {
        attempts++;
        const words = await generateMnemonic();

        // Count syllables
        const syls = words.map(w => smap.get(w));
        const total = syls.reduce((a, b) => a + b, 0);

        if (total !== 17) continue;

        const split = findHaikuSplit(syls);
        if (!split) continue;

        if (grammarCheck === 'on' && !passesGrammarCheck(words, split)) continue;

        // Checksum is valid by construction (generated from correct entropy+hash)
        found++;
        totalMined++;

        const wallet = {
          id: crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2),
          words,
          syllables: syls,
          split,
          walletType,
          timestamp: new Date().toISOString(),
          haiku: formatHaiku(words, split, syls)
        };

        if (onFound) onFound(wallet);
      }

      if (onProgress) onProgress(found, count, attempts, totalMined);

      // Yield to UI
      await new Promise(r => setTimeout(r, 0));
    }

    miningActive = false;
    return { found, attempts };
  }

  function stopMining() {
    miningActive = false;
  }

  function formatHaiku(words, split, syls) {
    const line1 = words.slice(0, split.line1End);
    const line2 = words.slice(split.line1End, split.line2End);
    const line3 = words.slice(split.line2End);

    const s1 = syls.slice(0, split.line1End);
    const s2 = syls.slice(split.line1End, split.line2End);
    const s3 = syls.slice(split.line2End);

    return {
      lines: [line1.join(' '), line2.join(' '), line3.join(' ')],
      syllableLines: [s1, s2, s3]
    };
  }

  // ═══════════════════════════════════════════════════════
  //  EXPORT
  // ═══════════════════════════════════════════════════════

  function generateExportText() {
    let txt = '╔══════════════════════════════════════════════════╗\n';
    txt +=    '║  Ensō × BIP-39 Haiku Wallet — Exported Wallets  ║\n';
    txt +=    '╚══════════════════════════════════════════════════╝\n\n';

    walletList.forEach((w, i) => {
      txt += `─── Wallet #${i + 1} ─── ${w.walletType.toUpperCase()} ─── ${w.timestamp} ───\n\n`;
      txt += `  ${w.haiku.lines[0]}  (${w.haiku.syllableLines[0].join('+')} = ${w.haiku.syllableLines[0].reduce((a,b)=>a+b,0)})\n`;
      txt += `  ${w.haiku.lines[1]}  (${w.haiku.syllableLines[1].join('+')} = ${w.haiku.syllableLines[1].reduce((a,b)=>a+b,0)})\n`;
      txt += `  ${w.haiku.lines[2]}  (${w.haiku.syllableLines[2].join('+')} = ${w.haiku.syllableLines[2].reduce((a,b)=>a+b,0)})\n\n`;
      txt += `  Mnemonic: ${w.words.join(' ')}\n`;
      txt += `  ID: ${w.id}\n\n`;
    });

    return txt;
  }

  async function exportEncrypted(password) {
    const txt = generateExportText();
    return await encryptAES256(txt, password);
  }

  function exportPlain() {
    return generateExportText();
  }

  // ═══════════════════════════════════════════════════════
  //  PUBLIC API
  // ═══════════════════════════════════════════════════════

  return {
    countSyllables,
    getSyllableMap,
    generateMnemonic,
    validateMnemonic,
    findHaikuSplit,
    mineHaiku,
    stopMining,
    formatHaiku,

    // Storage
    saveToStorage,
    loadFromStorage,
    hasStoredWallets,
    clearStorage,
    get walletList() { return walletList; },
    set walletList(v) { walletList = v; },
    get sessionPassword() { return sessionPassword; },
    set sessionPassword(v) { sessionPassword = v; },

    // Export
    exportEncrypted,
    exportPlain,
    encryptAES256,

    // Stats
    get totalMined() { return totalMined; },
    set totalMined(v) { totalMined = v; }
  };

})();

