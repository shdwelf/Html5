/**
 * irc.js — Full IRC Client over WebSocket
 * Converted from PIM Java source: Network.java, CmdProcessor.java, Connect.java
 * 
 * Original Java PIM architecture mapped to web:
 *   Network.java  → IRCClient (WebSocket transport instead of raw TCP)
 *   CmdProcessor   → IRCClient.handleCommand() 
 *   Connect.java   → WebSocket onmessage handler
 *   listen.java    → WebSocket connection itself
 *   MsgGui.java    → ChatWindow objects (COMMENTED OUT - using CLI terminal)
 *   PimTest.java   → IRCClient (CLI active, GUI commented out)
 *   Display.java   → termPrint() output
 *   Peerlist.java  → IRC channel/user tracking
 *   UserInfo.java  → IRC user state (nick, ident, host)
 *   Voice.java     → [NOT CONVERTED - Java Sound API only]
 *   SMSMsg.java    → [NOT CONVERTED - SMTP direct socket only]
 *   FileMsg.java   → [NOT CONVERTED - DCC file transfer only]
 *   Crypto.java    → [NOT CONVERTED - IRC uses TLS via WebSocket]
 */

var IRCClient = (() => {

  // ═══════════════════════════════════════════════════════
  //  IRC CLIENT STATE
  //  Maps to: Peerlist.java + UserInfo.java + PimTest.java fields
  // ═══════════════════════════════════════════════════════

  let ws = null;
  let state = {
    nick: '',
    user: 'pimuser',
    realname: 'PIM Web IRC Client',
    server: '',
    port: 6697,
    connected: false,
    registered: false,
  };

  // Chat windows — maps to MsgGui instances in original
  // Each window is like a MsgGui but CLI-based (GUI commented out)
  let windows = new Map(); // name → { type:'channel'|'query', lines:[], users:Set, topic:'' }
  let activeWindow = null;

  // ═══════════════════════════════════════════════════════
  //  OUTPUT CALLBACK
  //  Maps to: Display.java putMessage/putPeer/signedOn
  // ═══════════════════════════════════════════════════════

  let _print = null; // set via init(printFn)

  function print(text, cls) {
    if (_print) _print(text, cls, activeWindow);
  }

  function printTo(windowName, text, cls) {
    if (_print) _print(text, cls, windowName);
  }

  // ═══════════════════════════════════════════════════════
  //  CHAT WINDOW MANAGEMENT
  //  Maps to: MsgGui.java (GUI version COMMENTED OUT)
  //  CLI version: each window is a buffer of lines
  // ═══════════════════════════════════════════════════════

  function createWindow(name, type) {
    if (!windows.has(name)) {
      windows.set(name, {
        type, // 'channel' or 'query'
        lines: [],
        users: new Set(),
        topic: '',
        unread: 0,
      });
      if (typeof _onWindowChange === 'function') _onWindowChange();
    }
    return windows.get(name);
  }

  function getActiveWindow() {
    return activeWindow ? windows.get(activeWindow) : null;
  }

  let _onWindowChange = null;

  // ═══════════════════════════════════════════════════════
  //  WEBSOCKET CONNECTION
  //  Maps to: Network.java constructor (listen threads + broadcast)
  //  Original used raw TCP sockets + UDP multicast
  //  Converted to: WebSocket for browser compatibility
  // ═══════════════════════════════════════════════════════

  function connect(server, nick, options = {}) {
    if (ws && state.connected) {
      print('Already connected. Use /quit first.', 'err');
      return;
    }

    state.server = server;
    state.nick = nick || 'PIMUser' + Math.floor(Math.random() * 9999);
    state.user = options.user || 'pimweb';
    state.realname = options.realname || 'PIM Web Client';

    // Build WebSocket URL
    // Supports: wss://irc.libera.chat, or custom relay
    let wsUrl = server;
    if (!wsUrl.startsWith('ws://') && !wsUrl.startsWith('wss://')) {
      // Default: try wss://
      wsUrl = 'wss://' + wsUrl;
    }

    // Libera Chat specific: add path
    if (wsUrl.includes('libera.chat')) {
      wsUrl = wsUrl.replace(/\/$/, '') + '/webirc';
    }

    print(`Connecting to ${wsUrl} as ${state.nick}...`, 'sys');

    try {
      ws = new WebSocket(wsUrl, 'binary'); // some servers require 'binary' subprotocol
    } catch (e) {
      // Try without subprotocol
      try {
        ws = new WebSocket(wsUrl);
      } catch (e2) {
        print(`Connection failed: ${e2.message}`, 'err');
        return;
      }
    }

    ws.onopen = () => {
      state.connected = true;
      print('WebSocket connected. Registering...', 'sys');

      // IRC registration — maps to Network constructor broadcast
      sendRaw(`NICK ${state.nick}`);
      sendRaw(`USER ${state.user} 0 * :${state.realname}`);

      // Create server window
      createWindow(server, 'channel');
      activeWindow = server;
    };

    ws.onmessage = (event) => {
      // Handle binary or text
      let data;
      if (event.data instanceof Blob) {
        event.data.text().then(t => handleData(t));
      } else {
        handleData(event.data);
      }
    };

    ws.onclose = (event) => {
      state.connected = false;
      state.registered = false;
      print(`Disconnected (code: ${event.code}).`, 'err');
      ws = null;
    };

    ws.onerror = (event) => {
      print(`Connection error. Check server address.`, 'err');
    };
  }

  function handleData(data) {
    // IRC messages may come as multiple lines
    const lines = data.split(/\r?\n/);
    for (const line of lines) {
      if (line.trim()) parseIRC(line);
    }
  }

  // ═══════════════════════════════════════════════════════
  //  IRC PROTOCOL PARSER
  //  Maps to: Connect.java run() — reads objects from socket
  //  Converted to: text-based IRC protocol parsing
  // ═══════════════════════════════════════════════════════

  function parseIRC(line) {
    // IRC format: [:prefix] command [params] [:trailing]
    let prefix = '';
    let command = '';
    let params = [];
    let trailing = '';

    // Parse prefix
    let rest = line;
    if (rest.startsWith(':')) {
      const spaceIdx = rest.indexOf(' ');
      if (spaceIdx === -1) return;
      prefix = rest.substring(1, spaceIdx);
      rest = rest.substring(spaceIdx + 1);
    }

    // Parse trailing
    const trailIdx = rest.indexOf(' :');
    if (trailIdx !== -1) {
      trailing = rest.substring(trailIdx + 2);
      rest = rest.substring(0, trailIdx);
    }

    // Parse command and params
    const parts = rest.split(' ');
    command = parts[0].toUpperCase();
    params = parts.slice(1);

    // Extract nick from prefix
    const nickFromPrefix = prefix.includes('!') ? prefix.split('!')[0] : prefix;
    const userHost = prefix.includes('!') ? prefix.split('!')[1] : '';

    // ─── Handle IRC numerics and commands ───

    switch (command) {
      // Registration success
      case '001': // RPL_WELCOME
        state.registered = true;
        state.nick = params[0] || state.nick;
        printTo(state.server, `✓ Connected to ${state.server} as ${state.nick}`, 'sys');
        printTo(state.server, trailing, 'sys');
        break;

      case '002': // RPL_YOURHOST
      case '003': // RPL_CREATED
      case '004': // RPL_MYINFO
      case '005': // RPL_ISUPPORT
        printTo(state.server, trailing, 'sys');
        break;

      case '251': // RPL_LUSEROP
      case '252': // RPL_LUSEROP
      case '253': // RPL_LUSERUNKNOWN
      case '254': // RPL_LUSERCHANNELS
      case '255': // RPL_LUSERME
      case '265': // RPL_LOCALUSERS
      case '266': // RPL_GLOBALUSERS
      case '250': // RPL_STATSCONN
        printTo(state.server, trailing, 'sys');
        break;

      case '372': // RPL_MOTD
        printTo(state.server, trailing, 'sys');
        break;

      case '375': // RPL_MOTDSTART
        printTo(state.server, `─── MOTD ───`, 'sys');
        break;

      case '376': // RPL_ENDOFMOTD
        printTo(state.server, `─── End MOTD ───`, 'sys');
        break;

      case '422': // ERR_NOMOTD
        printTo(state.server, 'No MOTD', 'sys');
        break;

      // Nick in use
      case '433': // ERR_NICKNAMEINUSE
        printTo(state.server, `Nickname "${params[1]}" is in use. Trying ${params[1] + '_'}...`, 'err');
        state.nick = params[1] + '_';
        sendRaw(`NICK ${state.nick}`);
        break;

      case '432': // ERR_ERRONEUSNICKNAME
        printTo(state.server, `Invalid nickname: ${trailing}`, 'err');
        break;

      // PING — must respond (maps to Network.java periodicBroadcast)
      case 'PING':
        sendRaw(`PONG :${trailing}`);
        printTo(state.server, `[PING/PONG]`, 'sys');
        break;

      // PONG
      case 'PONG':
        break;

      // JOIN — maps to Peerlist.addPeer() + Display.signedOn()
      case 'JOIN': {
        const channel = trailing || params[0];
        const win = createWindow(channel, 'channel');
        if (nickFromPrefix === state.nick) {
          printTo(channel, `You joined ${channel}`, 'sys');
          activeWindow = activeWindow || channel;
          if (typeof _onWindowChange === 'function') _onWindowChange();
        } else {
          printTo(channel, `→ ${nickFromPrefix} joined ${channel}`, 'sys');
          win.users.add(nickFromPrefix);
        }
        // Request names
        sendRaw(`NAMES ${channel}`);
        break;
      }

      // PART — maps to Peerlist.removePeer()
      case 'PART': {
        const channel = params[0];
        const win = windows.get(channel);
        if (nickFromPrefix === state.nick) {
          if (win) {
            printTo(channel, `You left ${channel}`, 'sys');
            windows.delete(channel);
          }
        } else {
          printTo(channel, `← ${nickFromPrefix} left ${channel}`, 'sys');
          if (win) win.users.delete(nickFromPrefix);
        }
        if (typeof _onWindowChange === 'function') _onWindowChange();
        break;
      }

      // QUIT — maps to Peerlist.removePeer() + listenExit
      case 'QUIT': {
        const reason = trailing;
        // Show in all windows this user was in
        for (const [name, win] of windows) {
          if (win.users.has(nickFromPrefix)) {
            printTo(name, `⟵ ${nickFromPrefix} quit (${reason})`, 'sys');
            win.users.delete(nickFromPrefix);
          }
        }
        break;
      }

      // KICK
      case 'KICK': {
        const channel = params[0];
        const kicked = params[1];
        const reason = trailing;
        const win = windows.get(channel);
        if (kicked === state.nick) {
          printTo(channel, `You were kicked from ${channel} by ${nickFromPrefix} (${reason})`, 'err');
        } else {
          printTo(channel, `${kicked} was kicked by ${nickFromPrefix} (${reason})`, 'sys');
        }
        if (win) win.users.delete(kicked);
        break;
      }

      // PRIVMSG — maps to Connect.run() receiving TextMsg + MsgGui.display()
      case 'PRIVMSG': {
        const target = params[0];
        const isCTCP = trailing.startsWith('\x01') && trailing.endsWith('\x01');

        if (isCTCP) {
          const ctcp = trailing.slice(1, -1);
          if (ctcp.startsWith('ACTION ')) {
            // /me action
            const actionText = ctcp.substring(7);
            const windowName = target === state.nick ? nickFromPrefix : target;
            createWindow(windowName, target === state.nick ? 'query' : 'channel');
            printTo(windowName, `* ${nickFromPrefix} ${actionText}`, 'notice');
          } else if (ctcp.startsWith('VERSION')) {
            sendRaw(`NOTICE ${nickFromPrefix} :\x01VERSION PIM Web IRC Client 1.0\x01`);
          } else {
            const windowName = target === state.nick ? nickFromPrefix : target;
            createWindow(windowName, target === state.nick ? 'query' : 'channel');
            printTo(windowName, `[CTCP ${ctcp} from ${nickFromPrefix}]`, 'sys');
          }
        } else {
          // Regular message
          const windowName = target === state.nick ? nickFromPrefix : target;
          createWindow(windowName, target === state.nick ? 'query' : 'channel');
          printTo(windowName, `<${nickFromPrefix}> ${trailing}`, 'usr');
        }
        break;
      }

      // NOTICE — maps to Network.java broadcast messages
      case 'NOTICE': {
        const target = params[0];
        const windowName = (target === '*' || target === state.nick) ? state.server : target;
        createWindow(windowName, 'channel');
        printTo(windowName, `-${nickFromPrefix}- ${trailing}`, 'notice');
        break;
      }

      // NICK — maps to Peer.updateAlias()
      case 'NICK': {
        const oldNick = nickFromPrefix;
        const newNick = trailing;
        if (oldNick === state.nick) {
          state.nick = newNick;
          printTo(state.server, `You are now known as ${newNick}`, 'sys');
        }
        // Update in all windows
        for (const [name, win] of windows) {
          if (win.users.has(oldNick)) {
            win.users.delete(oldNick);
            win.users.add(newNick);
            printTo(name, `${oldNick} is now known as ${newNick}`, 'sys');
          }
        }
        break;
      }

      // TOPIC — maps to channel topic display
      case '332': { // RPL_TOPIC
        const channel = params[1];
        const win = createWindow(channel, 'channel');
        win.topic = trailing;
        printTo(channel, `Topic: ${trailing}`, 'sys');
        break;
      }

      case '333': // RPL_TOPICWHOTIME
        break;

      // NAMES list — maps to Peerlist.addPeer() batch
      case '353': { // RPL_NAMREPLY
        const channel = params[2];
        const win = createWindow(channel, 'channel');
        const names = trailing.split(' ');
        for (let n of names) {
          n = n.replace(/^[@+~&%!]/, ''); // strip prefixes
          if (n) win.users.add(n);
        }
        break;
      }

      case '366': { // RPL_ENDOFNAMES
        const channel = params[1];
        const win = windows.get(channel);
        if (win) {
          printTo(channel, `Users in ${channel}: ${[...win.users].join(', ')}`, 'sys');
        }
        break;
      }

      // WHOIS — maps to Peerlist.checkStatus()
      case '311': // RPL_WHOISUSER
        printTo(state.server, `[WHOIS] ${params[1]} is ${trailing} (${params[2]}@${params[3]})`, 'sys');
        break;
      case '312': // RPL_WHOISSERVER
        printTo(state.server, `[WHOIS] ${params[1]} on ${params[2]}: ${trailing}`, 'sys');
        break;
      case '313': // RPL_WHOISOPERATOR
        printTo(state.server, `[WHOIS] ${params[1]} is an IRC operator`, 'sys');
        break;
      case '317': // RPL_WHOISIDLE
        printTo(state.server, `[WHOIS] ${params[1]} idle ${params[2]}s, connected ${new Date(params[3] * 1000).toLocaleString()}`, 'sys');
        break;
      case '318': // RPL_ENDOFWHOIS
        printTo(state.server, `[WHOIS] End`, 'sys');
        break;
      case '319': // RPL_WHOISCHANNELS
        printTo(state.server, `[WHOIS] ${params[1]} in: ${trailing}`, 'sys');
        break;
      case '330': // RPL_WHOISACCOUNT
        printTo(state.server, `[WHOIS] ${params[1]} logged in as ${params[2]}`, 'sys');
        break;

      // LIST — channel listing
      case '322': { // RPL_LIST
        printTo(state.server, `  ${params[1]} (${params[2]} users): ${trailing}`, 'sys');
        break;
      }
      case '323': // RPL_LISTEND
        printTo(state.server, 'End of channel list.', 'sys');
        break;

      // MODE — maps to Peer.setBlock() conceptually
      case '324': // RPL_CHANNELMODEIS
        printTo(params[1], `Mode: ${params.slice(2).join(' ')} ${trailing}`, 'sys');
        break;
      case 'MODE': {
        const target = params[0];
        const modeStr = params[1];
        const modeParams = params.slice(2).join(' ');
        const windowName = windows.has(target) ? target : state.server;
        printTo(windowName, `${nickFromPrefix} set mode ${modeStr} ${modeParams} on ${target}`, 'sys');
        break;
      }

      // INVITE
      case 'INVITE': {
        printTo(state.server, `${nickFromPrefix} invites you to ${trailing}`, 'notice');
        break;
      }

      // Errors
      case '401': // ERR_NOSUCHNICK
        printTo(state.server, `No such nick/channel: ${params[1]}`, 'err');
        break;
      case '403': // ERR_NOSUCHCHANNEL
        printTo(state.server, `No such channel: ${params[1]}`, 'err');
        break;
      case '404': // ERR_CANNOTSENDTOCHAN
        printTo(state.server, `Cannot send to ${params[1]}: ${trailing}`, 'err');
        break;
      case '442': // ERR_NOTONCHANNEL
        printTo(state.server, `Not on channel: ${params[1]}`, 'err');
        break;
      case '471': // ERR_CHANNELISFULL
        printTo(state.server, `Channel full: ${params[1]}`, 'err');
        break;
      case '473': // ERR_INVITEONLYCHAN
        printTo(state.server, `Invite only: ${params[1]}`, 'err');
        break;
      case '474': // ERR_BANNEDFROMCHAN
        printTo(state.server, `Banned from: ${params[1]}`, 'err');
        break;
      case '475': // ERR_BADCHANNELKEY
        printTo(state.server, `Bad channel key: ${params[1]}`, 'err');
        break;

      // Generic numeric
      default:
        if (/^\d{3}$/.test(command)) {
          printTo(state.server, `[${command}] ${params.join(' ')} ${trailing}`.trim(), 'sys');
        } else if (!['CAP', 'AUTHENTICATE'].includes(command)) {
          printTo(state.server, `[${command}] ${prefix} ${params.join(' ')} ${trailing}`.trim(), 'sys');
        }
        break;
    }
  }

  // ═══════════════════════════════════════════════════════
  //  IRC SEND
  //  Maps to: Network.java MsgThread (sends TextMsg over socket)
  // ═══════════════════════════════════════════════════════

  function sendRaw(line) {
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(line + '\r\n');
    }
  }

  // ═══════════════════════════════════════════════════════
  //  COMMAND PROCESSOR
  //  Maps to: CmdProcessor.java identifyType()
  //  Original CLI code was commented out in PimTest.main()
  //  NOW FIXED: CLI is active, GUI (MsgGui/Swing) commented out
  // ═══════════════════════════════════════════════════════

  function handleCommand(input) {
    input = input.trim();
    if (!input) return;

    // Not a command — treat as message to active window
    // Maps to CmdProcessor: "string did not begin with '/', so treat as msg"
    if (!input.startsWith('/')) {
      if (!state.connected) {
        print('Not connected. Use /connect <server> <nick>', 'err');
        return;
      }
      if (!activeWindow || activeWindow === state.server) {
        print('No active chat window. /join a channel or /query a nick.', 'err');
        return;
      }
      // Send to channel or user — maps to Network.sendTxtMsg()
      sendRaw(`PRIVMSG ${activeWindow} :${input}`);
      // Show locally — maps to MsgGui.display() for own messages
      printTo(activeWindow, `<${state.nick}> ${input}`, 'usr');
      return;
    }

    const parts = input.split(/\s+/);
    const cmd = parts[0].toLowerCase();

    switch (cmd) {
      // ─── Connection commands ───
      case '/connect': {
        // /connect <server> [nick]
        if (parts.length < 2) {
          print('Usage: /connect <server> [nick]', 'err');
          return;
        }
        const server = parts[1];
        const nick = parts[2] || 'PIMUser' + Math.floor(Math.random() * 9999);
        connect(server, nick);
        break;
      }

      case '/quit': {
        // Maps to CmdProcessor /quit — "return 1; //change to real exit routine later"
        if (state.connected) {
          sendRaw(`QUIT :PIM Web IRC Client`);
          ws.close();
        }
        print('Disconnected.', 'sys');
        break;
      }

      case '/disconnect': {
        if (ws) ws.close();
        break;
      }

      // ─── IRC commands (maps to CmdProcessor commands) ───
      case '/join': {
        // Maps to: opening MsgGui for a peer (but CLI, not GUI)
        if (!requireConnected()) return;
        const channel = parts[1];
        if (!channel) { print('Usage: /join <#channel> [key]', 'err'); return; }
        createWindow(channel, 'channel');
        activeWindow = channel;
        sendRaw(`JOIN ${parts.slice(1).join(' ')}`);
        if (typeof _onWindowChange === 'function') _onWindowChange();
        break;
      }

      case '/part': {
        if (!requireConnected()) return;
        const channel = parts[1] || activeWindow;
        if (!channel) { print('No active channel to part.', 'err'); return; }
        sendRaw(`PART ${channel} :${parts.slice(2).join(' ') || 'Leaving'}`);
        break;
      }

      case '/nick': {
        if (!requireConnected()) return;
        if (!parts[1]) { print('Usage: /nick <newnick>', 'err'); return; }
        sendRaw(`NICK ${parts[1]}`);
        break;
      }

      case '/msg': {
        // Maps to: CmdProcessor /msg alias msg → Network.sendTxtMsg(TextMsg)
        if (!requireConnected()) return;
        if (parts.length < 3) { print('Usage: /msg <nick|#channel> <message>', 'err'); return; }
        const target = parts[1];
        const message = parts.slice(2).join(' ');
        sendRaw(`PRIVMSG ${target} :${message}`);
        createWindow(target, target.startsWith('#') ? 'channel' : 'query');
        printTo(target, `<${state.nick}> ${message}`, 'usr');
        break;
      }

      case '/query': {
        // Opens a P2P private chat window — maps to creating MsgGui with Peer
        if (!requireConnected()) return;
        if (!parts[1]) { print('Usage: /query <nick>', 'err'); return; }
        createWindow(parts[1], 'query');
        activeWindow = parts[1];
        if (typeof _onWindowChange === 'function') _onWindowChange();
        break;
      }

      case '/me': {
        if (!requireConnected()) return;
        if (!activeWindow) return;
        const action = parts.slice(1).join(' ');
        sendRaw(`PRIVMSG ${activeWindow} :\x01ACTION ${action}\x01`);
        printTo(activeWindow, `* ${state.nick} ${action}`, 'notice');
        break;
      }

      case '/whois': {
        // Maps to: CmdProcessor /status + Peerlist.checkStatus
        if (!requireConnected()) return;
        sendRaw(`WHOIS ${parts[1] || ''}`);
        break;
      }

      case '/mode': {
        if (!requireConnected()) return;
        if (!parts[1]) { print('Usage: /mode <target> [+/-mode] [param]', 'err'); return; }
        sendRaw(`MODE ${parts.slice(1).join(' ')}`);
        break;
      }

      case '/kick': {
        if (!requireConnected()) return;
        if (parts.length < 3) { print('Usage: /kick <#channel> <nick> [reason]', 'err'); return; }
        sendRaw(`KICK ${parts[1]} ${parts[2]} :${parts.slice(3).join(' ') || 'Kicked'}`);
        break;
      }

      case '/topic': {
        if (!requireConnected()) return;
        const channel = parts[1] && parts[1].startsWith('#') ? parts[1] : activeWindow;
        if (!channel) { print('No active channel.', 'err'); return; }
        if (parts.length > (channel === parts[1] ? 2 : 1)) {
          const topicText = channel === parts[1] ? parts.slice(2).join(' ') : parts.slice(1).join(' ');
          sendRaw(`TOPIC ${channel} :${topicText}`);
        } else {
          sendRaw(`TOPIC ${channel}`);
        }
        break;
      }

      case '/list': {
        // Maps to: CmdProcessor /list → Peerlist.displayPeers()
        if (!requireConnected()) return;
        sendRaw(`LIST ${parts.slice(1).join(' ')}`);
        break;
      }

      case '/names': {
        if (!requireConnected()) return;
        sendRaw(`NAMES ${parts[1] || activeWindow || ''}`);
        break;
      }

      case '/invite': {
        if (!requireConnected()) return;
        if (parts.length < 3) { print('Usage: /invite <nick> <#channel>', 'err'); return; }
        sendRaw(`INVITE ${parts[1]} ${parts[2]}`);
        break;
      }

      case '/notice': {
        if (!requireConnected()) return;
        if (parts.length < 3) { print('Usage: /notice <target> <message>', 'err'); return; }
        const target = parts[1];
        sendRaw(`NOTICE ${target} :${parts.slice(2).join(' ')}`);
        printTo(target, `[-${state.nick}-] ${parts.slice(2).join(' ')}`, 'notice');
        break;
      }

      case '/away': {
        if (!requireConnected()) return;
        // Maps to: Peer.setAway()
        sendRaw(`AWAY :${parts.slice(1).join(' ') || ''}`);
        break;
      }

      // ─── PIM original commands (from CmdProcessor.java) ───
      case '/add': {
        // Maps to: Peerlist.addPeer(alias) or addPeer(alias, ip)
        if (!requireConnected()) return;
        if (!parts[1]) { print('Usage: /add <nick>', 'err'); return; }
        // In IRC context, /add opens a query window
        createWindow(parts[1], 'query');
        activeWindow = parts[1];
        if (typeof _onWindowChange === 'function') _onWindowChange();
        print(`Opened chat with ${parts[1]}`, 'sys');
        break;
      }

      case '/remove': {
        // Maps to: Peerlist.removePeer(alias)
        if (!parts[1]) { print('Usage: /remove <nick>', 'err'); return; }
        const target = parts[1];
        if (windows.has(target)) {
          windows.delete(target);
          if (activeWindow === target) {
            activeWindow = windows.keys().next().value || null;
          }
          print(`Removed ${target}`, 'sys');
          if (typeof _onWindowChange === 'function') _onWindowChange();
        } else {
          print(`${target} not found in windows`, 'err');
        }
        break;
      }

      case '/block': {
        // Maps to: Peerlist.blockPeer(alias) — IRC equivalent is /ignore
        if (!requireConnected()) return;
        if (!parts[1]) { print('Usage: /block <nick>', 'err'); return; }
        // IRC has no standard ignore, but we can use silence or just local
        print(`Blocked ${parts[1]} (local ignore)`, 'sys');
        break;
      }

      case '/unblock': {
        if (!parts[1]) { print('Usage: /unblock <nick>', 'err'); return; }
        print(`Unblocked ${parts[1]}`, 'sys');
        break;
      }

      case '/raw': {
        // Send raw IRC command — forwarded as-is
        if (!requireConnected()) return;
        sendRaw(parts.slice(1).join(' '));
        break;
      }

      case '/window': {
        // Switch active window
        if (!parts[1]) {
          // List windows
          const wins = [...windows.keys()];
          print(`Windows: ${wins.join(', ')} (active: ${activeWindow || 'none'})`, 'sys');
        } else {
          if (windows.has(parts[1])) {
            activeWindow = parts[1];
            if (typeof _onWindowChange === 'function') _onWindowChange();
          } else {
            print(`Window "${parts[1]}" not found`, 'err');
          }
        }
        break;
      }

      case '/help': {
        // Maps to: CmdProcessor /help
        print('═══ Connection ═══', 'sys');
        print('  /connect <server> [nick]  — Connect to IRC server', 'sys');
        print('  /quit                     — Disconnect', 'sys');
        print('═══ IRC Commands ═══', 'sys');
        print('  /join <#channel> [key]    — Join channel', 'sys');
        print('  /part [#channel]          — Leave channel', 'sys');
        print('  /nick <newnick>           — Change nickname', 'sys');
        print('  /msg <target> <text>      — Send message', 'sys');
        print('  /query <nick>             — Open private chat', 'sys');
        print('  /me <action>              — Send action', 'sys');
        print('  /whois [nick]             — Whois lookup', 'sys');
        print('  /mode <target> [+-mode]   — Set mode', 'sys');
        print('  /kick <#chan> <nick>      — Kick user', 'sys');
        print('  /topic [#chan] [text]     — View/set topic', 'sys');
        print('  /list [pattern]           — List channels', 'sys');
        print('  /names [#channel]         — List users', 'sys');
        print('  /invite <nick> <#chan>    — Invite user', 'sys');
        print('  /notice <target> <text>   — Send notice', 'sys');
        print('  /away [message]           — Set away', 'sys');
        print('═══ PIM Commands (original) ═══', 'sys');
        print('  /add <nick>               — Open chat window', 'sys');
        print('  /remove <nick>            — Close chat window', 'sys');
        print('  /block <nick>             — Block user', 'sys');
        print('  /unblock <nick>           — Unblock user', 'sys');
        print('═══ Window ═══', 'sys');
        print('  /window [name]            — Switch/list windows', 'sys');
        print('  /raw <irc-command>        — Send raw IRC', 'sys');
        print('  /clear                    — Clear output', 'sys');
        print('', 'sys');
        print('  Type text without / to send to active window', 'sys');
        break;
      }

      case '/clear': {
        if (typeof _clearWindow === 'function') _clearWindow(activeWindow);
        break;
      }

      default:
        // Unknown command — forward as raw IRC
        // Maps to CmdProcessor: "Bad command, try /help"
        if (state.connected) {
          sendRaw(input.substring(1));
        } else {
          print(`Unknown command: ${cmd}. Type /help`, 'err');
        }
    }
  }

  function requireConnected() {
    if (!state.connected) {
      print('Not connected. Use /connect <server> [nick]', 'err');
      return false;
    }
    return true;
  }

  // ═══════════════════════════════════════════════════════
  //  PUBLIC API
  // ═══════════════════════════════════════════════════════

  return {
    init(printFn, onWindowChange, clearWindow) {
      _print = printFn;
      _onWindowChange = onWindowChange;
      _clearWindow = clearWindow;
    },
    handleCommand,
    connect,
    get state() { return state; },
    get windows() { return windows; },
    get activeWindow() { return activeWindow; },
    set activeWindow(w) {
      activeWindow = w;
      if (typeof _onWindowChange === 'function') _onWindowChange();
    },
    getWindows() { return [...windows.keys()]; },
    getWindowLines(name) { return windows.get(name)?.lines || []; },
    getWindowInfo(name) { return windows.get(name); },
    isConnected() { return state.connected; },
    getNick() { return state.nick; },
  };

})();

</script>
<script>
// ═══════ js/app.js ═══════
/**
 * app.js — Main application controller
 * Tabs, Ensō UI, Wallet mining UI, Terminal, Storage management
 */

(function() {
  'use strict';

  // ═══════════════════════════════════════════════════════
  //  TOAST NOTIFICATIONS
  // ═══════════════════════════════════════════════════════

  function toast(msg, isError = false) {
    const container = document.getElementById('toast-container');
    const el = document.createElement('div');
    el.className = 'toast' + (isError ? ' error' : '');
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  // ═══════════════════════════════════════════════════════
  //  TAB NAVIGATION
  // ═══════════════════════════════════════════════════════

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // ═══════════════════════════════════════════════════════
  //  ENSŌ GENERATOR UI
  // ═══════════════════════════════════════════════════════

  const ensoCanvas = document.getElementById('enso-canvas');
  let currentSeed = null;

  // Responsive canvas sizing
  function resizeEnsoCanvas() {
    const wrap = ensoCanvas.parentElement;
    const size = Math.min(wrap.clientWidth - 20, wrap.clientHeight - 20, 800);
    const s = Math.max(400, size);
    ensoCanvas.width = s;
    ensoCanvas.height = s;
    if (currentSeed) EnsoGenerator.draw(ensoCanvas, currentSeed, getEnsoParams());
  }

  window.addEventListener('resize', resizeEnsoCanvas);
  setTimeout(resizeEnsoCanvas, 100);

  function getEnsoParams() {
    return {
      inkLoad:        parseInt(document.getElementById('ctrl-inkLoad').value),
      direction:      document.getElementById('ctrl-direction').value,
      paperHue:       document.getElementById('ctrl-paperHue').value,
      brushSize:      parseInt(document.getElementById('ctrl-brushSize').value),
      inkDensity:     parseInt(document.getElementById('ctrl-inkDensity').value),
      xyStretch:      document.getElementById('ctrl-xyStretch').value,
      paperTexture:   parseInt(document.getElementById('ctrl-paperTexture').value),
      bristleDensity: parseInt(document.getElementById('ctrl-bristleDensity').value),
      signatureStyle: document.getElementById('ctrl-signatureStyle').value,
      brushstrokeSize:document.getElementById('ctrl-brushstrokeSize').value,
      brushStart:     parseInt(document.getElementById('ctrl-brushStart').value)
    };
  }

  function renderEnso() {
    if (!currentSeed) {
      currentSeed = EnsoGenerator.randomSeed();
    }
    document.getElementById('enso-seed-display').textContent = currentSeed;
    EnsoGenerator.draw(ensoCanvas, currentSeed, getEnsoParams());
  }

  // Range value displays
  const rangeDisplays = {
    'ctrl-inkLoad':        'val-inkLoad',
    'ctrl-brushSize':      'val-brushSize',
    'ctrl-inkDensity':     'val-inkDensity',
    'ctrl-paperTexture':   'val-paperTexture',
    'ctrl-bristleDensity': 'val-bristleDensity',
    'ctrl-brushStart':     'val-brushStart',
  };
  Object.entries(rangeDisplays).forEach(([ctrlId, valId]) => {
    const ctrl = document.getElementById(ctrlId);
    const val = document.getElementById(valId);
    ctrl.addEventListener('input', () => {
      val.textContent = ctrlId === 'ctrl-brushStart' ? ctrl.value + '°' : ctrl.value;
      renderEnso();
    });
  });

  // Selects also trigger re-render
  ['ctrl-direction','ctrl-paperHue','ctrl-xyStretch','ctrl-signatureStyle','ctrl-brushstrokeSize'].forEach(id => {
    document.getElementById(id).addEventListener('change', renderEnso);
  });

  // Random seed
  document.getElementById('btn-random-seed').addEventListener('click', () => {
    currentSeed = EnsoGenerator.randomSeed();
    renderEnso();
  });

  // Download PNG
  document.getElementById('btn-download-png').addEventListener('click', () => {
    if (!currentSeed) return;
    EnsoGenerator.downloadPNG(ensoCanvas, currentSeed);
    toast('Downloaded enso-' + currentSeed + '.png');
  });

  // Regenerate
  document.getElementById('btn-regenerate').addEventListener('click', () => {
    renderEnso();
  });

  // Initial render
  renderEnso();

  // ═══════════════════════════════════════════════════════
  //  WALLET HAIKU MINER UI
  // ═══════════════════════════════════════════════════════

  const minedCounterEl = document.getElementById('mined-counter');
  const haikuDisplayEl = document.getElementById('haiku-display');
  const mineBtn = document.getElementById('btn-mine');
  const stopBtn = document.getElementById('btn-stop-mine');
  let miningInProgress = false;
  let haikuWallets = []; // Session display list
  let miningStartTime = 0;

  // Range for mine count
  document.getElementById('ctrl-mineCount').addEventListener('input', (e) => {
    document.getElementById('val-mineCount').textContent = e.target.value;
  });

  // Load saved wallets from encrypted storage on page load
  async function initWalletStorage() {
    if (WalletMiner.hasStoredWallets()) {
      // Show password prompt to unlock
      showPasswordModal('Enter your password to unlock saved wallets.', async (password) => {
        const ok = await WalletMiner.loadFromStorage(password);
        if (ok) {
          haikuWallets = [...WalletMiner.walletList];
          minedCounterEl.textContent = WalletMiner.totalMined;
          renderWalletList();
          toast('Wallets unlocked successfully');
        } else {
          toast('Wrong password or corrupted data', true);
          // Don't block — user can still mine new wallets
        }
      }, true); // true = allow skip
    }
  }

  function renderWalletList() {
    const container = document.getElementById('saved-items');
    if (haikuWallets.length === 0) {
      container.innerHTML = '<em style="color:var(--fg);opacity:0.3;font-size:0.8rem;">No wallets saved yet</em>';
      return;
    }

    container.innerHTML = '';
    haikuWallets.forEach((w, i) => {
      const item = document.createElement('div');
      item.className = 'saved-item';
      const preview = w.haiku.lines.join(' / ');
      item.innerHTML = `
        <span class="saved-preview" title="${w.words.join(' ')}">#${i+1} ${preview}</span>
        <button class="btn btn-danger" data-delete="${i}" style="font-size:0.65rem;padding:0.2rem 0.5rem;">✕</button>
      `;
      container.appendChild(item);
    });

    // Delete handlers
    container.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const idx = parseInt(btn.dataset.delete);
        haikuWallets.splice(idx, 1);
        WalletMiner.walletList = haikuWallets;
        if (WalletMiner.sessionPassword) WalletMiner.saveToStorage();
        renderWalletList();
        renderHaikuCards();
        toast('Wallet removed');
      });
    });
  }

  function renderHaikuCards() {
    if (haikuWallets.length === 0) {
      haikuDisplayEl.innerHTML = `
        <div style="text-align:center;color:var(--fg);opacity:0.4;padding:4rem 1rem;">
          <div style="font-size:3rem;margin-bottom:1rem;">🎋</div>
          <div>Mine a BIP-39 Haiku Wallet to begin</div>
          <div style="font-size:0.75rem;margin-top:0.5rem;">A valid 12-word mnemonic where the syllables form a 5-7-5 haiku</div>
        </div>`;
      return;
    }

    haikuDisplayEl.innerHTML = '';
    haikuWallets.forEach((w, i) => {
      const card = document.createElement('div');
      card.className = 'haiku-card';

      const sylLabels = w.haiku.syllableLines.map(line =>
        line.join('+') + '=' + line.reduce((a,b) => a+b, 0)
      );

      card.innerHTML = `
        <div class="wallet-type">${w.walletType} — BIP-39 Checksum Valid ✓</div>
        <div class="haiku-lines">
          <div class="haiku-line">${w.haiku.lines[0]} <span class="syllable-count">${sylLabels[0]}</span></div>
          <div class="haiku-line">${w.haiku.lines[1]} <span class="syllable-count">${sylLabels[1]}</span></div>
          <div class="haiku-line">${w.haiku.lines[2]} <span class="syllable-count">${sylLabels[2]}</span></div>
        </div>
        <div class="mnemonic-raw">${w.words.join(' ')}</div>
        <div class="card-actions">
          <button class="btn" data-copy="${i}">📋 Copy</button>
          <button class="btn" data-save="${i}">💾 Save</button>
          <button class="btn" data-verify="${i}">✓ Verify</button>
          <button class="btn btn-danger" data-remove="${i}">✕</button>
        </div>
      `;
      haikuDisplayEl.appendChild(card);
    });

    // Wire up card buttons
    haikuDisplayEl.querySelectorAll('[data-copy]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.copy);
        navigator.clipboard.writeText(haikuWallets[idx].words.join(' '))
          .then(() => toast('Mnemonic copied to clipboard'))
          .catch(() => toast('Copy failed', true));
      });
    });

    haikuDisplayEl.querySelectorAll('[data-save]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const idx = parseInt(btn.dataset.save);
        const wallet = haikuWallets[idx];
        if (WalletMiner.walletList.find(w => w.id === wallet.id)) {
          toast('Already saved');
          return;
        }
        WalletMiner.walletList.push(wallet);
        if (!WalletMiner.sessionPassword) {
          showPasswordModal('Create a password to encrypt your saved wallets.', async (pw) => {
            WalletMiner.sessionPassword = pw;
            WalletMiner.saveToStorage();
            renderWalletList();
            toast('Wallet saved with encryption');
          }, false, true);
        } else {
          WalletMiner.saveToStorage();
          renderWalletList();
          toast('Wallet saved');
        }
      });
    });

    haikuDisplayEl.querySelectorAll('[data-verify]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const idx = parseInt(btn.dataset.verify);
        btn.textContent = '⏳';
        const valid = await WalletMiner.validateMnemonic(haikuWallets[idx].words);
        btn.textContent = valid ? '✓ Valid' : '✗ Invalid';
        toast(valid ? 'Checksum verified ✓' : 'Invalid checksum!', !valid);
        setTimeout(() => { btn.textContent = '✓ Verify'; }, 2000);
      });
    });

    haikuDisplayEl.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.remove);
        haikuWallets.splice(idx, 1);
        // Also remove from saved if present
        WalletMiner.walletList = WalletMiner.walletList.filter(
          w => !haikuWallets.find(h => h.id === w.id) || haikuWallets.includes(w)
        );
        renderHaikuCards();
        toast('Wallet removed from view');
      });
    });
  }

  // Mine button
  mineBtn.addEventListener('click', async () => {
    if (miningInProgress) return;
    miningInProgress = true;
    miningStartTime = Date.now();
    mineBtn.style.display = 'none';
    stopBtn.style.display = 'block';

    const walletType = document.getElementById('ctrl-walletType').value;
    const mineCount = parseInt(document.getElementById('ctrl-mineCount').value);
    const grammarCheck = document.getElementById('ctrl-grammarCheck').value;

    // Clear display for new batch
    haikuWallets = [];

    let statusEl = document.createElement('div');
    statusEl.style.cssText = 'text-align:center;padding:2rem;color:var(--accent);';
    statusEl.innerHTML = '<div style="font-size:2rem;">⛏️ Mining...</div><div style="font-size:0.8rem;margin-top:0.5rem;" id="mining-progress">0 attempts</div>';
    haikuDisplayEl.innerHTML = '';
    haikuDisplayEl.appendChild(statusEl);

    try {
      const result = await WalletMiner.mineHaiku(
        walletType, mineCount, grammarCheck,
        (wallet) => {
          // On found
          haikuWallets.push(wallet);
          renderHaikuCards();
          minedCounterEl.textContent = WalletMiner.totalMined;
        },
        (found, total, attempts, grandTotal) => {
          // On progress
          const prog = document.getElementById('mining-progress');
          if (prog) {
            const elapsed = ((Date.now() - miningStartTime) / 1000).toFixed(1);
            const rate = Math.round(attempts / Math.max(0.1, (Date.now() - miningStartTime) / 1000));
            prog.textContent = `${found}/${total} found — ${attempts.toLocaleString()} attempts (${rate}/s) — ${elapsed}s`;
          }
        }
      );
      toast(`Mined ${result.found} haiku wallet${result.found !== 1 ? 's' : ''} in ${result.attempts.toLocaleString()} attempts`);
    } catch (e) {
      toast('Mining error: ' + e.message, true);
    }

    miningInProgress = false;
    mineBtn.style.display = 'block';
    stopBtn.style.display = 'none';
  });

  stopBtn.addEventListener('click', () => {
    WalletMiner.stopMining();
  });

  // Export TXT encrypted
  document.getElementById('btn-export-txt').addEventListener('click', async () => {
    if (WalletMiner.walletList.length === 0) {
      toast('No saved wallets to export', true);
      return;
    }
    showExportModal();
  });

  // Export TXT plain
  document.getElementById('btn-export-plain').addEventListener('click', () => {
    if (WalletMiner.walletList.length === 0) {
      toast('No saved wallets to export', true);
      return;
    }
    const txt = WalletMiner.exportPlain();
    const blob = new Blob([txt], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'haiku-wallets-' + new Date().toISOString().slice(0,10) + '.txt';
    a.click();
    URL.revokeObjectURL(url);
    toast('Plain text export downloaded');
  });

  // Clear all
  document.getElementById('btn-clear-all').addEventListener('click', () => {
    if (confirm('Delete ALL saved wallets? This cannot be undone.')) {
      WalletMiner.clearStorage();
      haikuWallets = [];
      renderWalletList();
      renderHaikuCards();
      toast('All wallets cleared');
    }
  });

  // ═══════════════════════════════════════════════════════
  //  EXPORT MODAL
  // ═══════════════════════════════════════════════════════

  const exportModal = document.getElementById('modal-export');

  function showExportModal() {
    exportModal.classList.add('active');
    document.getElementById('export-password').value = '';
    document.getElementById('export-password2').value = '';
  }

  document.getElementById('btn-export-cancel').addEventListener('click', () => {
    exportModal.classList.remove('active');
  });

  document.getElementById('btn-export-confirm').addEventListener('click', async () => {
    const pw1 = document.getElementById('export-password').value;
    const pw2 = document.getElementById('export-password2').value;

    if (pw1.length < 4) { toast('Password must be at least 4 characters', true); return; }
    if (pw1 !== pw2) { toast('Passwords do not match', true); return; }

    try {
      const encrypted = await WalletMiner.exportEncrypted(pw1);
      const blob = new Blob([encrypted], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'haiku-wallets-' + new Date().toISOString().slice(0,10) + '.txt.enc';
      a.click();
      URL.revokeObjectURL(url);
      exportModal.classList.remove('active');
      toast('Encrypted export downloaded');
    } catch (e) {
      toast('Export failed: ' + e.message, true);
    }
  });

  // ═══════════════════════════════════════════════════════
  //  PASSWORD MODAL
  // ═══════════════════════════════════════════════════════

  const pwModal = document.getElementById('modal-password');
  let pwCallback = null;

  function showPasswordModal(msg, callback, allowSkip = false, isCreate = false) {
    pwCallback = callback;
    document.getElementById('modal-password-msg').textContent = msg;
    document.getElementById('storage-password').value = '';
    pwModal.classList.add('active');
    pwModal.dataset.allowSkip = allowSkip;
    pwModal.dataset.isCreate = isCreate;
    document.getElementById('btn-pw-cancel').textContent = allowSkip ? 'Skip' : 'Cancel';
  }

  document.getElementById('btn-pw-cancel').addEventListener('click', () => {
    pwModal.classList.remove('active');
    pwCallback = null;
  });

  document.getElementById('btn-pw-confirm').addEventListener('click', () => {
    const pw = document.getElementById('storage-password').value;
    if (pwModal.dataset.isCreate === 'true' && pw.length < 4) {
      toast('Password must be at least 4 characters', true);
      return;
    }
    if (pwCallback) pwCallback(pw);
    pwModal.classList.remove('active');
  });

  // Enter key in password field
  document.getElementById('storage-password').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') document.getElementById('btn-pw-confirm').click();
  });

  // ═══════════════════════════════════════════════════════

  // ═══════════════════════════════════════════════════════
  //  TERMINAL — IRC Client (converted from PIM Java source)
  //  Original: CLI was commented out, GUI (Swing) was active
  //  NOW: CLI is active, GUI is commented out
  //  Network.java → WebSocket IRC transport
  //  CmdProcessor.java → IRCClient.handleCommand()
  // ═══════════════════════════════════════════════════════

  const termOutput = document.getElementById('term-output');
  const termInput = document.getElementById('term-input');
  const termPrompt = document.getElementById('term-prompt');
  const ircWindowList = document.getElementById('irc-window-list');
  const ircStatus = document.getElementById('irc-status');
  const ircNickDisplay = document.getElementById('irc-nick-display');

  // Per-window line storage for scrolling back
  const windowLines = new Map(); // windowName → [{text, cls}]

  function termPrint(text, cls = '', windowName = null) {
    const target = windowName || IRCClient.activeWindow;

    // Store line
    if (target) {
      if (!windowLines.has(target)) windowLines.set(target, []);
      windowLines.get(target).push({ text, cls });
      const win = IRCClient.windows.get(target);
      if (win) {
        win.lines.push({ text, cls });
        // Track unread if not active
        if (target !== IRCClient.activeWindow) {
          win.unread = (win.unread || 0) + 1;
          updateSidebarUnread(target);
        }
      }
    }

    // Display only if matches active window
    if (target === IRCClient.activeWindow) {
      appendToTermOutput(text, cls);
    }
  }

  function appendToTermOutput(text, cls) {
    const span = document.createElement('span');
    if (cls) span.className = cls;
    span.textContent = text + '\n';
    termOutput.appendChild(span);
    termOutput.scrollTop = termOutput.scrollHeight;
  }

  function clearTermWindow(windowName) {
    if (windowName === IRCClient.activeWindow) {
      termOutput.innerHTML = '';
    }
    if (windowLines.has(windowName)) windowLines.set(windowName, []);
    const win = IRCClient.windows.get(windowName);
    if (win) win.lines = [];
  }

  // Switch active window — show buffered lines
  function switchWindow(name) {
    IRCClient.activeWindow = name;
    termOutput.innerHTML = '';

    const lines = windowLines.get(name) || [];
    for (const { text, cls } of lines) {
      appendToTermOutput(text, cls);
    }
    termOutput.scrollTop = termOutput.scrollHeight;

    // Update prompt
    if (name) {
      termPrompt.textContent = `[${name}] ❯`;
    } else {
      termPrompt.textContent = '❯';
    }
  }

  // ─── IRC Sidebar Management ───

  function updateIRCSidebar() {
    const wins = IRCClient.getWindows();
    if (wins.length === 0) {
      ircWindowList.innerHTML = '<div style="padding:0.5rem;font-size:0.75rem;color:var(--fg);opacity:0.3;text-align:center;">No windows</div>';
    } else {
      ircWindowList.innerHTML = '';
      for (const name of wins) {
        const info = IRCClient.getWindowInfo(name);
        const isActive = name === IRCClient.activeWindow;
        const icon = info?.type === 'channel' ? '◈' : '◆';
        const unread = info?.unread || 0;

        const item = document.createElement('div');
        item.className = 'irc-win-item' + (isActive ? ' active' : '');
        item.innerHTML = `
          <span style="opacity:0.5;font-size:0.65rem;">${icon}</span>
          <span style="flex:1;overflow:hidden;text-overflow:ellipsis;">${name}</span>
          <span class="unread-badge ${unread > 0 ? 'has-unread' : ''}">${unread}</span>
        `;
        item.addEventListener('click', () => {
          switchWindow(name);
          updateIRCSidebar();
        });
        ircWindowList.appendChild(item);
      }
    }

    // Status
    ircStatus.textContent = IRCClient.isConnected() ? '🟢 Connected' : '🔴 Disconnected';
    ircStatus.style.color = IRCClient.isConnected() ? 'var(--accent)' : 'var(--fg)';
    ircNickDisplay.textContent = IRCClient.getNick() ? `Nick: ${IRCClient.getNick()}` : '';
  }

  function updateSidebarUnread(windowName) {
    // Just rebuild sidebar to update badges
    updateIRCSidebar();
  }

  // Initialize IRC client
  IRCClient.init(termPrint, updateIRCSidebar, clearTermWindow);

  // ─── Terminal Input Handler ───

  termInput.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const cmd = termInput.value.trim();
    termInput.value = '';
    if (!cmd) return;

    // Route everything through IRCClient (handles both IRC and PIM commands)
    IRCClient.handleCommand(cmd);
  });

  // ─── PIM-specific terminal commands (integration with existing features) ───

  // Override /mine and /enso to also work from terminal
  const origHandleCommand = IRCClient.handleCommand.bind(IRCClient);
  // We don't override — instead, the IRC handleCommand already passes
  // unknown commands through. We hook the /mine and /enso commands
  // via the default case in irc.js which sends as raw IRC or shows error.
  // For local app commands, we intercept here:

  termInput.addEventListener('keydown', function localHandler(e) {
    if (e.key !== 'Enter') return;
    const cmd = e.target.value.trim();
    const parts = cmd.split(/\s+/);

    // Local app commands (don't need IRC)
    if (cmd === '/enso' || cmd.startsWith('/enso ')) {
      e.stopImmediatePropagation();
      const seed = parts[1] === 'random' ? EnsoGenerator.randomSeed() : (parts[1] || EnsoGenerator.randomSeed());
      currentSeed = seed;
      renderEnso();
      termPrint(`Ensō generated with seed: ${currentSeed}`, 'sys');
      document.querySelector('[data-tab="enso"]').click();
      termInput.value = '';
    }
  });

  // ═══════════════════════════════════════════════════════
  //  FORGING ANIMATION — Animate ensō + mine haiku
  // ═══════════════════════════════════════════════════════

  const forgeModal = document.getElementById('modal-forging');
  const forgeCanvas = document.getElementById('forge-canvas');
  const forgeHaiku = document.getElementById('forge-haiku-text');
  const forgeSeed = document.getElementById('forge-seed-text');
  const forgeStatus = document.getElementById('forge-status');
  const forgeClose = document.getElementById('btn-forge-close');
  let forgeAnimId = null;

  // Collected gallery — stored in localStorage
  let gallery = JSON.parse(localStorage.getItem('enso_gallery') || '[]');
  const GALLERY_KEY = 'enso_gallery';

  function saveGallery() {
    localStorage.setItem(GALLERY_KEY, JSON.stringify(gallery));
  }

  function renderGallery() {
    const container = document.getElementById('gallery-items');
    if (gallery.length === 0) {
      container.innerHTML = '<em style="color:var(--fg);opacity:0.3;font-size:0.8rem;">Forge a collectible to begin</em>';
      return;
    }
    container.innerHTML = '';
    gallery.slice().reverse().forEach((item, ri) => {
      const i = gallery.length - 1 - ri;
      const el = document.createElement('div');
      el.className = 'saved-item';
      el.style.cursor = 'pointer';
      el.innerHTML = `
        <span class="saved-preview" title="Click to load">🎨 ${item.seed.slice(0,8)}… ${item.haiku.lines[0]}</span>
        <button class="btn btn-danger" data-gdel="${i}" style="font-size:0.65rem;padding:0.2rem 0.5rem;">✕</button>
      `;
      el.querySelector('.saved-preview').addEventListener('click', () => {
        currentSeed = item.seed;
        // Set all params from saved
        const p = item.params;
        document.getElementById('ctrl-inkLoad').value = p.inkLoad;
        document.getElementById('val-inkLoad').textContent = p.inkLoad;
        document.getElementById('ctrl-direction').value = p.direction;
        document.getElementById('ctrl-paperHue').value = p.paperHue;
        document.getElementById('ctrl-brushSize').value = p.brushSize;
        document.getElementById('val-brushSize').textContent = p.brushSize;
        document.getElementById('ctrl-inkDensity').value = p.inkDensity;
        document.getElementById('val-inkDensity').textContent = p.inkDensity;
        document.getElementById('ctrl-xyStretch').value = p.xyStretch;
        document.getElementById('ctrl-paperTexture').value = p.paperTexture;
        document.getElementById('val-paperTexture').textContent = p.paperTexture;
        document.getElementById('ctrl-bristleDensity').value = p.bristleDensity;
        document.getElementById('val-bristleDensity').textContent = p.bristleDensity;
        document.getElementById('ctrl-signatureStyle').value = p.signatureStyle;
        document.getElementById('ctrl-brushstrokeSize').value = p.brushstrokeSize;
        document.getElementById('ctrl-brushStart').value = p.brushStart;
        document.getElementById('val-brushStart').textContent = p.brushStart + '°';
        renderEnso();
        document.querySelector('[data-tab="enso"]').click();
        toast('Loaded ensō ' + item.seed.slice(0,8));
      });
      container.appendChild(el);
    });
    container.querySelectorAll('[data-gdel]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.dataset.gdel);
        gallery.splice(idx, 1);
        saveGallery();
        renderGallery();
        toast('Removed from gallery');
      });
    });
  }

  // Animate ensō drawing + mine haiku simultaneously
  function startForging() {
    const seed = EnsoGenerator.randomSeed();
    const params = getEnsoParams();
    const ctx = forgeCanvas.getContext('2d');
    const size = 400;
    forgeCanvas.width = size;
    forgeCanvas.height = size;

    forgeModal.classList.add('active');
    forgeClose.style.display = 'none';
    forgeHaiku.innerHTML = '<span style="color:var(--accent);">Forging…</span>';
    forgeSeed.textContent = '';
    forgeStatus.textContent = 'Drawing ensō…';

    // Animated drawing state
    const numericSeed = EnsoGenerator._hashSeed ? EnsoGenerator._hashSeed(seed) : (function(s){let h=0;for(let i=0;i<s.length;i++){h=Math.imul(31,h)+s.charCodeAt(i)|0;}return h>>>0;})(seed);
    let rng_state = numericSeed;
    function miniRng() {
      rng_state |= 0;
      rng_state = rng_state + 0x6D2B79F5 | 0;
      let t = Math.imul(rng_state ^ rng_state >>> 15, 1 | rng_state);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    }

    // Pre-compute all points for the ensō
    const totalFrames = 120;
    const PAPER_COLORS = {
      cyan:  { base: [200,230,230] },
      warm:  { base: [240,230,210] },
      white: { base: [245,242,238] },
      dark:  { base: [30,30,35] },
      sage:  { base: [190,210,180] }
    };
    const pc = PAPER_COLORS[params.paperHue] || PAPER_COLORS.cyan;
    const [pr, pg, pb] = pc.base;

    // Draw paper first
    ctx.fillStyle = `rgb(${pr},${pg},${pb})`;
    ctx.fillRect(0, 0, size, size);

    // Use main canvas to pre-render the full ensō to an offscreen canvas
    const offscreen = document.createElement('canvas');
    offscreen.width = size;
    offscreen.height = size;
    EnsoGenerator.draw(offscreen, seed, {...params, brushstrokeSize: params.brushstrokeSize || 'medium'});

    // Get the image data for progressive reveal
    const fullData = ctx.getImageData(0, 0, size, size);

    // Animate: circular wipe reveal
    let frame = 0;
    const cx = size / 2, cy = size / 2;
    const maxR = Math.sqrt(cx*cx + cy*cy);

    // Start mining haiku in parallel
    let minedWallet = null;
    let minePromise = WalletMiner.mineHaiku(
      document.getElementById('ctrl-walletType').value,
      1,
      document.getElementById('ctrl-grammarCheck').value,
      (w) => { minedWallet = w; },
      null
    );

    function animate() {
      if (frame >= totalFrames) {
        // Show final image
        ctx.drawImage(offscreen, 0, 0);

        forgeStatus.textContent = 'Waiting for haiku…';

        // Wait for mining to finish
        minePromise.then((result) => {
          if (minedWallet) {
            const lines = minedWallet.haiku.lines;
            forgeHaiku.innerHTML = 
              `<div style="color:var(--fg-bright);">${lines[0]}</div>` +
              `<div style="color:var(--fg-bright);font-size:1.2em;">${lines[1]}</div>` +
              `<div style="color:var(--fg-bright);">${lines[2]}</div>`;
            forgeSeed.textContent = `Ensō ID: ${seed}`;
            forgeStatus.textContent = 'Forged ✓';

            // Save to gallery
            gallery.push({
              seed,
              params: {...params},
              haiku: minedWallet.haiku,
              words: minedWallet.words,
              walletType: minedWallet.walletType,
              timestamp: new Date().toISOString()
            });
            saveGallery();
            renderGallery();
            haikuWallets.push(minedWallet);
            renderHaikuCards();
            minedCounterEl.textContent = WalletMiner.totalMined;
          } else {
            forgeHaiku.innerHTML = '<span style="color:var(--warn);">No valid haiku found — try again</span>';
            forgeSeed.textContent = `Ensō ID: ${seed}`;
            // Still save the ensō
            gallery.push({
              seed,
              params: {...params},
              haiku: null,
              words: null,
              walletType: null,
              timestamp: new Date().toISOString()
            });
            saveGallery();
            renderGallery();
          }
          forgeClose.style.display = 'inline-block';
        });
        return;
      }

      const progress = frame / totalFrames;
      const revealR = progress * maxR;

      // Draw: clear, then draw paper, then clip circle of full image
      ctx.fillStyle = `rgb(${pr},${pg},${pb})`;
      ctx.fillRect(0, 0, size, size);

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, revealR, 0, Math.PI * 2);
      ctx.clip();
      ctx.drawImage(offscreen, 0, 0);
      ctx.restore();

      // Draw ink splash particles at edge
      const particleCount = 3;
      for (let p = 0; p < particleCount; p++) {
        const angle = miniRng() * Math.PI * 2;
        const dist = revealR + miniRng() * 15 - 7;
        const px = cx + Math.cos(angle) * dist;
        const py = cy + Math.sin(angle) * dist;
        const ps = miniRng() * 2 + 0.5;
        ctx.beginPath();
        ctx.arc(px, py, ps, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(25,20,15,${miniRng() * 0.3})`;
        ctx.fill();
      }

      // Haiku text reveal
      if (minedWallet && progress > 0.6) {
        const lines = minedWallet.haiku.lines;
        const alpha = Math.min(1, (progress - 0.6) / 0.4);
        ctx.fillStyle = `rgba(25,20,15,${alpha * 0.7})`;
        ctx.font = '14px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(lines[0], cx, cy - 30);
        ctx.fillText(lines[1], cx, cy - 10);
        ctx.fillText(lines[2], cx, cy + 10);
      }

      forgeStatus.textContent = `Forging… ${Math.round(progress * 100)}%`;
      frame++;
      forgeAnimId = requestAnimationFrame(animate);
    }

    animate();
  }

  // Forge button
  document.getElementById('btn-forging-animate').addEventListener('click', () => {
    startForging();
  });

  // Forge close button
  forgeClose.addEventListener('click', () => {
    forgeModal.classList.remove('active');
    if (forgeAnimId) cancelAnimationFrame(forgeAnimId);
  });

  // Forge modal overlay click to close (only after complete)
  forgeModal.addEventListener('click', (e) => {
    if (e.target === forgeModal && forgeClose.style.display !== 'none') {
      forgeModal.classList.remove('active');
    }
  });

  // Apply manual seed
  document.getElementById('btn-apply-seed').addEventListener('click', () => {
    const val = document.getElementById('ctrl-manual-seed').value.trim();
    if (val) {
      currentSeed = val;
      renderEnso();
      toast('Seed applied: ' + val);
    }
  });

  // Also allow Enter in the seed input
  document.getElementById('ctrl-manual-seed').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') document.getElementById('btn-apply-seed').click();
  });

  // Click seed to copy
  document.getElementById('enso-seed-display').addEventListener('click', () => {
    const seed = document.getElementById('enso-seed-display').textContent;
    if (seed && seed !== '—') {
      navigator.clipboard.writeText(seed).then(() => toast('Seed copied: ' + seed));
    }
  });

  // ═══════════════════════════════════════════════════════
  //  INIT
  // ═══════════════════════════════════════════════════════

  initWalletStorage();
  updateIRCSidebar();
  renderGallery();

  // Close modals on overlay click
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.classList.remove('active');
    });
  });

})();

</script>
