// ═══════ js/enso.js ═══════
/**
 * ensō.js — Seeded Ensō Circle Generator
 * Uses a deterministic PRNG (mulberry32) for reproducible "terrain seed" style generation
 */

var EnsoGenerator = (() => {

  // ─── Seeded PRNG: mulberry32 ───
  function mulberry32(seed) {
    return function() {
      seed |= 0;
      seed = seed + 0x6D2B79F5 | 0;
      let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }

  // Convert any string seed to a numeric hash
  function hashSeed(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) {
      h = Math.imul(31, h) + str.charCodeAt(i) | 0;
    }
    return h >>> 0;
  }

  // Generate a random seed string (hex)
  function randomSeed() {
    const arr = new Uint8Array(8);
    crypto.getRandomValues(arr);
    return Array.from(arr, b => b.toString(16).padStart(2, '0')).join('');
  }

  // ─── Paper Colors ───
  const PAPER_COLORS = {
    cyan:   { base: [200, 230, 230], variance: 15 },
    warm:   { base: [240, 230, 210], variance: 10 },
    white:  { base: [245, 242, 238], variance: 8 },
    dark:   { base: [30, 30, 35], variance: 5 },
    sage:   { base: [190, 210, 180], variance: 12 }
  };

  // ─── Drawing Functions ───

  function drawPaper(ctx, w, h, rng, params) {
    const hueData = PAPER_COLORS[params.paperHue] || PAPER_COLORS.cyan;
    const [r, g, b] = hueData.base;
    const v = hueData.variance;
    const texture = params.paperTexture;

    // Base fill
    ctx.fillStyle = `rgb(${r},${g},${b})`;
    ctx.fillRect(0, 0, w, h);

    // Texture grain
    if (texture > 0) {
      const imgData = ctx.getImageData(0, 0, w, h);
      const data = imgData.data;
      for (let i = 0; i < data.length; i += 4) {
        const noise = (rng() - 0.5) * texture * 3;
        data[i]   = Math.min(255, Math.max(0, data[i] + noise));
        data[i+1] = Math.min(255, Math.max(0, data[i+1] + noise));
        data[i+2] = Math.min(255, Math.max(0, data[i+2] + noise));
      }
      ctx.putImageData(imgData, 0, 0);
    }

    // Subtle vignette
    const grad = ctx.createRadialGradient(w/2, h/2, w*0.2, w/2, h/2, w*0.7);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(1, 'rgba(0,0,0,0.08)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);
  }

  function drawEnso(ctx, w, h, seedStr, params) {
    const numericSeed = hashSeed(seedStr);
    const rng = mulberry32(numericSeed);

    // Clear & draw paper
    ctx.clearRect(0, 0, w, h);
    drawPaper(ctx, w, h, rng, params);

    const cx = w / 2;
    const cy = h / 2;
    const sizeMultiplier = params.brushstrokeSize === 'small' ? 0.55 : params.brushstrokeSize === 'large' ? 0.82 : 0.68;
    const baseRadius = Math.min(cx, cy) * sizeMultiplier;

    // X/Y Stretch
    let stretchX = 1, stretchY = 1;
    if (params.xyStretch === 'unequal') {
      stretchX = 1 + (rng() - 0.5) * 0.12;
      stretchY = 1 + (rng() - 0.5) * 0.08;
    }

    const startAngleDeg = params.brushStart;
    const startAngle = startAngleDeg * Math.PI / 180;
    const clockwise = params.direction === 'clockwise';
    const dir = clockwise ? 1 : -1;

    // Gap size (traditional ensō has a gap)
    const gapAngle = 0.15 + rng() * 0.2;
    const totalAngle = Math.PI * 2 - gapAngle;

    // Generate circle path points with terrain-like noise
    const numPoints = 300;
    const pathPoints = [];

    // Generate noise layer (like terrain generation)
    const noiseOctaves = 4;
    const noiseTable = [];
    for (let o = 0; o < noiseOctaves; o++) {
      const tableSize = 8 * Math.pow(2, o);
      const table = [];
      for (let i = 0; i < tableSize; i++) {
        table.push((rng() - 0.5) * 2);
      }
      noiseTable.push(table);
    }

    function getNoise(t) {
      let val = 0, amp = 1, freq = 1;
      for (let o = 0; o < noiseOctaves; o++) {
        const table = noiseTable[o];
        const idx = t * (table.length - 1);
        const i0 = Math.floor(idx) % table.length;
        const i1 = (i0 + 1) % table.length;
        const frac = idx - Math.floor(idx);
        const smooth = frac * frac * (3 - 2 * frac);
        val += (table[i0] * (1 - smooth) + table[i1] * smooth) * amp;
        amp *= 0.5;
        freq *= 2;
      }
      return val;
    }

    for (let i = 0; i < numPoints; i++) {
      const t = i / (numPoints - 1);
      const angle = startAngle + dir * t * totalAngle;

      // Terrain-like radius variation
      const noiseVal = getNoise(t);
      const radiusNoise = noiseVal * 6 * (params.brushSize / 10);
      const r = baseRadius + radiusNoise;

      const x = cx + r * stretchX * Math.cos(angle);
      const y = cy + r * stretchY * Math.sin(angle);

      // Stroke width varies: thin at start, thick in middle, thin at end with possible taper
      const envelope = Math.sin(Math.PI * t);
      const brushWidth = params.brushSize * 1.5 * (0.3 + 0.7 * envelope);

      pathPoints.push({ x, y, t, angle, brushWidth });
    }

    // ─── Draw brush strokes with bristles ───
    const inkLoad = params.inkLoad / 10;
    const inkDensity = params.inkDensity / 10;
    const bristleDensity = params.bristleDensity;

    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    for (let i = 0; i < pathPoints.length - 1; i++) {
      const p = pathPoints[i];
      const pNext = pathPoints[i + 1];

      // Perpendicular direction for bristle spread
      const dx = pNext.x - p.x;
      const dy = pNext.y - p.y;
      const len = Math.sqrt(dx * dx + dy * dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;

      const halfWidth = p.brushWidth * 1.5;

      // Draw bristles
      for (let b = 0; b < bristleDensity; b++) {
        const spreadT = (b / (bristleDensity - 1)) - 0.5; // -0.5 to 0.5
        const offset = spreadT * halfWidth * 2;

        const bx = p.x + nx * offset + (rng() - 0.5) * 0.5;
        const by = p.y + ny * offset + (rng() - 0.5) * 0.5;
        const bxN = pNext.x + nx * offset + (rng() - 0.5) * 0.5;
        const byN = pNext.y + ny * offset + (rng() - 0.5) * 0.5;

        // Opacity: center bristles more opaque, edges less
        const centerDist = Math.abs(spreadT) * 2;
        let alpha = inkLoad * inkDensity * (1 - centerDist * 0.7);
        // Add randomness to ink distribution
        alpha *= (0.5 + rng() * 0.5);
        // Dry brush effect near the gap
        const gapProximity = Math.max(0, 1 - p.t * 4); // near start
        const gapProximityEnd = Math.max(0, (p.t - 0.85) * 6.67); // near end
        alpha *= (1 - gapProximity * 0.5) * (1 - gapProximityEnd * 0.7);
        alpha = Math.max(0, Math.min(1, alpha));

        if (alpha < 0.01) continue;

        const inkColor = `rgba(25, 20, 15, ${alpha})`;
        ctx.beginPath();
        ctx.moveTo(bx, by);
        ctx.lineTo(bxN, byN);
        ctx.strokeStyle = inkColor;
        ctx.lineWidth = 0.8 + rng() * 0.8;
        ctx.stroke();
      }

      // Occasional ink splash
      if (rng() < 0.008 * inkDensity) {
        const splashX = p.x + (rng() - 0.5) * halfWidth * 3;
        const splashY = p.y + (rng() - 0.5) * halfWidth * 3;
        const splashR = rng() * 2 + 0.5;
        ctx.beginPath();
        ctx.arc(splashX, splashY, splashR, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(25, 20, 15, ${rng() * 0.3 * inkLoad})`;
        ctx.fill();
      }
    }

    // ─── Ink bleed effect ───
    // Draw a second pass with lower opacity for ink bleeding
    for (let i = 0; i < pathPoints.length - 1; i += 3) {
      const p = pathPoints[i];
      const pNext = pathPoints[Math.min(i + 3, pathPoints.length - 1)];
      const bleedAlpha = inkLoad * 0.05;
      const bleedWidth = p.brushWidth * 2.5;

      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(pNext.x, pNext.y);
      ctx.strokeStyle = `rgba(25, 20, 15, ${bleedAlpha})`;
      ctx.lineWidth = bleedWidth;
      ctx.stroke();
    }

    // ─── Signature ───
    if (params.signatureStyle !== 'none') {
      drawSignature(ctx, cx, cy, baseRadius, rng, params);
    }
  }

  function drawSignature(ctx, cx, cy, radius, rng, params) {
    // Position signature bottom-right of the ensō
    const sx = cx + radius * 0.5;
    const sy = cy + radius * 0.85;

    let color;
    switch (params.signatureStyle) {
      case 'dark': color = 'rgba(30, 25, 20, 0.6)'; break;
      case 'light': color = 'rgba(200, 195, 190, 0.5)'; break;
      case 'red': color = 'rgba(180, 40, 30, 0.7)'; break;
      default: return;
    }

    ctx.save();
    ctx.translate(sx, sy);
    ctx.rotate(-0.1 + rng() * 0.2);

    // Simple calligraphic mark
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(8 + rng() * 4, -15);
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(3, -3);
    ctx.quadraticCurveTo(10, -8, 5 + rng() * 3, -18);
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    ctx.stroke();

    // Red seal stamp
    if (params.signatureStyle === 'red') {
      ctx.beginPath();
      ctx.arc(18, -10, 6, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(180, 40, 30, 0.3)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(180, 40, 30, 0.5)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    ctx.restore();
  }

  // ─── Public API ───
  return {
    randomSeed,
    draw(canvas, seedStr, params) {
      const ctx = canvas.getContext('2d');
      drawEnso(ctx, canvas.width, canvas.height, seedStr, params);
    },
    downloadPNG(canvas, seedStr) {
      const link = document.createElement('a');
      link.download = `enso-${seedStr}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    }
  };

})();

</script>
