<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Monopoly - NFT Edition</title>
  <link rel="stylesheet" href="style.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&family=Oswald:wght@500&display=swap" rel="stylesheet">
</head>
<body>
  <div id="game-container">
    <div id="board-container">
      <div id="board">
        <!-- Center area for dice, logs, buttons -->
        <div id="center-board">
           <h1>CRYPTO MONOPOLY</h1>
           <h3 class="subtitle">NFT & Live Market Edition</h3>
           
           <div id="live-ticker-container">
             <div id="live-ticker">Loading live market data...</div>
           </div>

           <div id="dice-display">
             <span id="die1">🎲</span>
             <span id="die2">🎲</span>
           </div>

           <div id="action-area">
              <p>Welcome! Click Roll Dice to begin.</p>
           </div>
           
           <div id="controls">
              <button id="roll-btn">Roll Dice</button>
              <button id="end-turn-btn" disabled>End Turn</button>
           </div>
        </div>
        <!-- Spaces will be generated by JS -->
      </div>
    </div>
    <div id="side-panel">
      <h2>PLAYERS</h2>
      <div id="players-info">
        <!-- Player info injected by JS -->
      </div>
      
      <div id="log-panel">
         <h3>Game Log</h3>
         <ul id="log-list"></ul>
      </div>
    </div>
  </div>
  
  <script src="script.js"></script>
</body>
</html>