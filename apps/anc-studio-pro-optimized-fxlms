<script>
/* ============================================================
 *  OPTIMIZED AUDIO WORKLET - Pre-allocated buffers, no GC
 * ============================================================ */
const WORKLET_CODE = `
class BaseLMSProcessor extends AudioWorkletProcessor {
    constructor() {
        super();
        // PRE-ALLOCATED: All buffers allocated once at construction
        this.N = 128;
        this.w = new Float32Array(this.N);
        this.buf = new Float32Array(this.N);
        this.errFilt = new Float32Array(this.N);
        this.mu = 0.02;
        this.err = 0;
        this.port.onmessage = (e) => {
            if (e.data.type === 'setMu') this.mu = Math.max(0.001, Math.min(0.2, e.data.mu));
            else if (e.data.type === 'reset') { this.w.fill(0); this.buf.fill(0); }
        };
    }
    process(inputs, outputs) {
        const inCh = inputs[0] && inputs[0][0];
        const outCh = outputs[0] && outputs[0][0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            // Shift buffer (pre-allocated)
            for (let j = this.N - 1; j > 0; j--) this.buf[j] = this.buf[j-1];
            this.buf[0] = x;
            // Dot product (no allocation)
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.buf[j];
            outCh[i] = -y;
            // NLMS update with power normalization
            const err = x - y;
