class FxLMSProcessor extends AudioWorkletProcessor {
    constructor() {
        super();
        this.N = 128; this.M = 64;
        this.w = new Float32Array(this.N);
        this.s = new Float32Array(this.M);
        this.xBuf = new Float32Array(this.N);
        this.yBuf = new Float32Array(this.M);
        this.xp = new Float32Array(this.N);
        this.mu = 0.01;
        this.err = 0;
        // Init secondary path as delayed impulse with decay
        this.s[16] = 1.0; // 16-sample delay
        for (let i = 17; i < this.M; i++) this.s[i] = 0.5 * Math.exp(-(i-16) * 0.1);
        this.port.onmessage = (e) => {
            if (e.data.type === 'setMu') this.mu = e.data.mu;
            else if (e.data.type === 'setDelay') {
                const d = Math.max(0, Math.min(this.M-1, Math.round(e.data.samples)));
                this.s.fill(0); this.s[d] = 1.0;
                for (let i = d+1; i < Math.min(this.M, d+20); i++) this.s[i] = 0.3 * Math.exp(-(i-d)*0.1);
            }
        };
    }
    process(inputs, outputs) {
        const inCh = inputs[0] && inputs[0][0];
        const outCh = outputs[0] && outputs[0][0];
        if (!inCh || !outCh) return true;
        for (let i = 0; i < inCh.length; i++) {
            const x = inCh[i];
            // Shift buffers
            for (let j = this.N - 1; j > 0; j--) this.xBuf[j] = this.xBuf[j-1];
            this.xBuf[0] = x;
            // Filter x by W
            let y = 0;
            for (let j = 0; j < this.N; j++) y += this.w[j] * this.xBuf[j];
            outCh[i] = -y;
            // Shift y through secondary path
            for (let j = this.M - 1; j > 0; j--) this.yBuf[j] = this.yBuf[j-1];
            this.yBuf[0] = y;
            // Compute filtered-x
            for (let j = 0; j < this.N; j++) this.xp[j] = 0;
            for (let j = 0; j < this.M && j < this.N; j++) {
                for (let k = 0; k < this.N; k++) this.xp[k] += this.s[j] * this.xBuf[k+j < this.N ? k+j : this.N-1];
            }
            // Compute y' through secondary path
            let yp = 0;
            for (let j = 0; j < this.M; j++) yp += this.s[j] * this.yBuf[j];
            const e = x - yp;
            // FxLMS update
            let pwr = 0; for (let j = 0; j < this.N; j++) pwr += this.xp[j] * this.xp[j];
            const norm = 1 / (pwr + 1e-8);
            for (let j = 0; j < this.N; j++) {
                this.w[j] += this.mu * e * this.xp[j] * norm;
                this.w[j] *= 0.9999;
            }
            this.err = 0.995 * this.err + 0.005 * Math.abs(e);
        }
        this.port.postMessage({ type: 'err', v: this.err });
        return true;
    }
