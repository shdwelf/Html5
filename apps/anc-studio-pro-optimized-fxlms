                const f1 = 20 * Math.pow(nyquist / 20, i / bars);
                const f2 = 20 * Math.pow(nyquist / 20, (i + 1) / bars);
                const b1 = Math.floor(f1 / nyquist * freqData.length);
                const b2 = Math.ceil(f2 / nyquist * freqData.length);
                let sum = 0, cnt = 0;
                for (let j = b1; j < b2 && j < freqData.length; j++) { sum += freqData[j]; cnt++; }
                const v = cnt > 0 ? (sum / cnt) / 255 : 0;
                const bh = v * HH * 0.85;
                const x = i * bw;
                
                let color;
                const mid = (f1 + f2) / 2;
                if (mid < 200) color = '#22d3ee';
                else if (mid < 1000) color = '#3b82f6';
                else if (mid < 4000) color = '#a855f7';
                else color = '#ec4899';
                
                ctx2d.fillStyle = color;
                ctx2d.fillRect(x + 1, HH - bh, bw - 2, bh);
                ctx2d.fillStyle = color;
                ctx2d.fillRect(x + 1, HH - bh - 2, bw - 2, 2);
            }
            
            ctx2d.fillStyle = 'rgba(148, 163, 184, 0.5)';
            ctx2d.font = '9px "JetBrains Mono", monospace';
            ctx2d.fillText('20', 4, HH - 4);
            ctx2d.fillText('200', WW * 0.33, HH - 4);
            ctx2d.fillText('1k', WW * 0.58, HH - 4);
            ctx2d.fillText('8k', WW - 20, HH - 4);
            
        } else if (State.vizTab === 'waveform') {
            // Center line
            ctx2d.strokeStyle = 'rgba(100, 116, 139, 0.15)';
            ctx2d.beginPath(); ctx2d.moveTo(0, HH/2); ctx2d.lineTo(WW, HH/2); ctx2d.stroke();
            
            // Waveform
            ctx2d.lineWidth = 2;
            const grad = ctx2d.createLinearGradient(0, 0, WW, 0);
            grad.addColorStop(0, '#22d3ee');
            grad.addColorStop(0.5, '#3b82f6');
            grad.addColorStop(1, '#a855f7');
            ctx2d.strokeStyle = grad;
            ctx2d.beginPath();
            const slice = WW / timeData.length;
            for (let i = 0; i < timeData.length; i++) {
                const x = i * slice;
                const y = (0.5 + timeData[i] / 2) * HH;
                i === 0 ? ctx2d.moveTo(x, y) : ctx2d.lineTo(x, y);
            }
            ctx2d.stroke();
            ctx2d.shadowColor = '#22d3ee';
            ctx2d.shadowBlur = 8;
            ctx2d.stroke();
            ctx2d.shadowBlur = 0;
        }
        
        // Stats
        updateStats();
    }
    frame();
}

// Spectrogram state
let spectroImgData = null;
function visualizeSpectrogram() {
    fitCanvas();
    const r = canvas.getBoundingClientRect();
    const WW = r.width, HH = r.height;
    const dpr = window.devicePixelRatio || 1;
    const Wpx = Math.floor(WW * dpr), Hpx = Math.floor(HH * dpr);
    
    if (!spectroImgData || spectroImgData.width !== Wpx || spectroImgData.height !== Hpx) {
        spectroImgData = new ImageData(Wpx, Hpx);
    }
    
    const anim = function() {
        State.animId = requestAnimationFrame(anim);
        State.analyser.getByteFrequencyData(State.freqData);
        
        // Scroll down
        spectroImgData.data.set(spectroImgData.data.subarray(Wpx * 4));
        
        const nyquist = State.audioCtx.sampleRate / 2;
        for (let x = 0; x < Wpx; x++) {
            const f = 20 * Math.pow(nyquist / 20, x / Wpx);
            const bin = Math.min(Math.floor(f / nyquist * State.freqData.length), State.freqData.length - 1);
            const v = State.freqData[bin] / 255;
            let r, g, b;
            if (v < 0.25) { r = v * 4 * 30; g = v * 4 * 20; b = 80 + v * 4 * 80; }
            else if (v < 0.5) { const t = (v - 0.25) * 4; r = 30 + t * 50; g = 20 + t * 150; b = 160 - t * 40; }
            else if (v < 0.75) { const t = (v - 0.5) * 4; r = 80 + t * 150; g = 170 + t * 50; b = 120 - t * 100; }
            else { const t = (v - 0.75) * 4; r = 230 + t * 25; g = 220 - t * 60; b = 20 + t * 50; }
            const idx = (x * 4); spectroImgData.data[idx] = r; spectroImgData.data[idx+1] = g; spectroImgData.data[idx+2] = b; spectroImgData.data[idx+3] = 255;
        }
        ctx2d.putImageData(spectroImgData, 0, 0);
        updateStats();
    };
    anim();
}

function updateStats() {
    const { freqData } = State;
    let maxI = 0, maxV = 0;
    for (let i = 2; i < freqData.length / 2; i++) {
        if (freqData[i] > maxV) { maxV = freqData[i]; maxI = i; }
    }
    const ny = State.audioCtx.sampleRate / 2;
    const peak = Math.round((maxI / freqData.length) * ny);
    freqValue.textContent = peak > 0 ? peak : '--';
    
    State.analyser.getFloatTimeDomainData(State.timeData);
    let sum = 0;
    for (let i = 0; i < State.timeData.length; i++) sum += State.timeData[i] * State.timeData[i];
    const rms = Math.sqrt(sum / State.timeData.length);
    const db = 20 * Math.log10(Math.max(rms, 1e-5));
    levelValue.textContent = (db > -80 ? db.toFixed(0) : '-∞') + 'dB';
}

/* ============================================================
 *  INIT
 * ============================================================ */
function fitCanvas() {
    const r = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = r.width * dpr;
    canvas.height = r.height * dpr;
    ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
}
fitCanvas();
window.addEventListener('resize', () => { if (State.isRunning) fitCanvas(); });
</script>
