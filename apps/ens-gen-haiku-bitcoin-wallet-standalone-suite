        function bech32_hrp_expand(hrp) {
            let ret = [];
            for (let p = 0; p < hrp.length; ++p) ret.push(hrp.charCodeAt(p) >> 5);
            ret.push(0);
            for (let p = 0; p < hrp.length; ++p) ret.push(hrp.charCodeAt(p) & 31);
            return ret;
        }

        function bech32_create_checksum(hrp, data) {
            let values = bech32_hrp_expand(hrp).concat(data).concat([0, 0, 0, 0, 0, 0]);
            let polymod = bech32_polymod(values) ^ 1;
            let ret = [];
            for (let p = 0; p < 6; ++p) ret.push((polymod >> (5 * (5 - p))) & 31);
            return ret;
        }

        function bech32_verify_checksum(hrp, data) {
            return bech32_polymod(bech32_hrp_expand(hrp).concat(data)) === 1;
        }

        function bech32_decode(bechString) {
            let has_lower = false;
            let has_upper = false;
            for (let p = 0; p < bechString.length; ++p) {
                if (bechString.charCodeAt(p) >= 97 && bechString.charCodeAt(p) <= 122) has_lower = true;
                if (bechString.charCodeAt(p) >= 65 && bechString.charCodeAt(p) <= 90) has_upper = true;
            }
            if (has_lower && has_upper) return null;
            bechString = bechString.toLowerCase();
            let pos = bechString.lastIndexOf("1");
            if (pos < 1 || pos + 7 > bechString.length || bechString.length > 90) return null;
            let hrp = bechString.substring(0, pos);
            let data = [];
            for (let p = pos + 1; p < bechString.length; ++p) {
                let d = BECH32_ALPHABET.indexOf(bechString[p]);
                if (d === -1) return null;
                data.push(d);
            }
            if (!bech32_verify_checksum(hrp, data)) return null;
            return { hrp: hrp, data: data.slice(0, data.length - 6) };
        }

        function convertbits(data, frombits, tobits, pad) {
            let acc = 0; let bits = 0; let ret = [];
            let maxv = (1 << tobits) - 1;
            for (let p = 0; p < data.length; ++p) {
                let value = data[p];
                acc = (acc << frombits) | value;
                bits += frombits;
                while (bits >= tobits) {
                    bits -= tobits;
                    ret.push((acc >> bits) & maxv);
                }
            }
            if (pad) {
                if (bits > 0) ret.push((acc << (tobits - bits)) & maxv);
            }
            return ret;
        }

        function bech32_encode(hrp, data) {
            let checksum = bech32_create_checksum(hrp, data);
            let combined = data.concat(checksum);
            let ret = hrp + "1";
            for (let p = 0; p < combined.length; ++p) ret += BECH32_ALPHABET[combined[p]];
            return ret;
        }

        // Elliptic Curve secp256k1 Point Math
        function modInverse(a, m) {
            let m0 = m;
            let y = 0n, x = 1n;
            if (m === 1n) return 0n;
            while (a > 1n) {
                let q = a / m;
                let t = m;
                m = a % m; a = t; t = y; y = x - q * y; x = t;
            }
            if (x < 0n) x += m0;
            return x;
        }

        function point_add(p1, p2) {
            if (!p1) return p2;
            if (!p2) return p1;
            let x1 = p1.x, y1 = p1.y;
            let x2 = p2.x, y2 = p2.y;
            if (x1 === x2) {
                if ((y1 + y2) % p === 0n) return null;
                return point_double(p1);
            }
            let lam = ((y2 - y1) * modInverse((x2 - x1) % p + p, p)) % p;
            let x3 = (lam*lam - x1 - x2) % p;
            let y3 = (lam*(x1 - x3) - y1) % p;
            return { x: (x3 + p) % p, y: (y3 + p) % p };
        }

        function point_double(p1) {
            if (!p1) return null;
            let x1 = p1.x, y1 = p1.y;
            if (y1 === 0n) return null;
            let lam = ((3n * x1 * x1) * modInverse((2n * y1) % p, p)) % p;
            let x3 = (lam*lam - 2n*x1) % p;
            let y3 = (lam*(x1 - x3) - y1) % p;
            return { x: (x3 + p) % p, y: (y3 + p) % p };
        }

        function point_mul(k, point) {
            let result = null;
            let addend = point;
            let temp_k = BigInt(k);
            while (temp_k > 0n) {
                if (temp_k & 1n) {
                    result = point_add(result, addend);
                }
                addend = point_double(addend);
                temp_k >>= 1n;
            }
            return result;
        }

        // BIP32 Hierarchical Deterministic Derivation
        async function hmacSha512(key, data) {
            const cryptoKey = await crypto.subtle.importKey(
                "raw",
                key,
                { name: "HMAC", hash: "SHA-512" },
                false,
                ["sign"]
            );
            const signature = await crypto.subtle.sign("HMAC", cryptoKey, data);
            return new Uint8Array(signature);
        }

        function bytesToBigInt(bytes) {
            let val = 0n;
            for (let b of bytes) {
                val = (val << 8n) | BigInt(b);
            }
            return val;
        }

        function bigIntToBytes(val, size) {
            let bytes = new Uint8Array(size);
            let temp = val;
            for (let i = size - 1; i >= 0; i--) {
                bytes[i] = Number(temp & 255n);
                temp >>= 8n;
            }
            return bytes;
        }

        function bytesToHex(bytes) {
            return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
        }

        function compressPublicKey(point) {
            const xBytes = bigIntToBytes(point.x, 32);
            const header = (point.y & 1n) === 0n ? 0x02 : 0x03;
            const res = new Uint8Array(33);
            res[0] = header;
            res.set(xBytes, 1);
            return res;
        }

        async function deriveChild(parentPrivKey, parentChainCode, index) {
            const isHardened = index >= 0x80000000;
            let data = new Uint8Array(37);
            if (isHardened) {
                data[0] = 0x00;
                data.set(parentPrivKey, 1);
            } else {
                const parentPrivBig = bytesToBigInt(parentPrivKey);
                const pubKey = point_mul(parentPrivBig, G);
                const compPub = compressPublicKey(pubKey);
                data.set(compPub, 0);
            }
            const indexBytes = new Uint8Array(4);
            const view = new DataView(indexBytes.buffer);
            view.setUint32(0, index);
            data.set(indexBytes, 33);
            
            const I = await hmacSha512(parentChainCode, data);
            const IL = I.slice(0, 32);
            const IR = I.slice(32, 64);
            
            const ILBig = bytesToBigInt(IL);
            const parentBig = bytesToBigInt(parentPrivKey);
            const childBig = (ILBig + parentBig) % n;
            
            const childPrivKey = bigIntToBytes(childBig, 32);
            return { privKey: childPrivKey, chainCode: IR };
        }

        async function deriveBIP44Addresses(mnemonic, passphrase = "") {
            // 1. Generate BIP39 Seed from mnemonic
            const encoder = new TextEncoder();
            const passwordBuffer = encoder.encode(mnemonic.normalize("NFKD"));
            const saltBuffer = encoder.encode("mnemonic" + passphrase.normalize("NFKD"));

            const baseKey = await crypto.subtle.importKey(
                "raw",
                passwordBuffer,
                { name: "PBKDF2" },
                false,
                ["deriveBits"]
            );

            const seedBuffer = await crypto.subtle.deriveBits(
                {
                    name: "PBKDF2",
                    salt: saltBuffer,
                    iterations: 2048,
                    hash: "SHA-512"
                },
                baseKey,
                512
            );
            const seed = new Uint8Array(seedBuffer);

            // 2. Master node derivation
            const hmacKey = encoder.encode("Bitcoin seed");
            const I = await hmacSha512(hmacKey, seed);
            const masterPriv = I.slice(0, 32);
            const masterChain = I.slice(32, 64);

            // Paths mapping: m/44'/coin_type'/0'/0/0
            // Coin types: BTC: 0, ETH: 60, LTC: 2, DOGE: 3
            const paths = {
                btc: [44 + 0x80000000, 0x80000000, 0x80000000, 0, 0],
                eth: [44 + 0x80000000, 60 + 0x80000000, 0x80000000, 0, 0],
                ltc: [44 + 0x80000000, 2 + 0x80000000, 0x80000000, 0, 0],
                doge: [44 + 0x80000000, 3 + 0x80000000, 0x80000000, 0, 0]
            };

            const derived = {};

            for (let coin of Object.keys(paths)) {
                let current = { privKey: masterPriv, chainCode: masterChain };
                for (let index of paths[coin]) {
                    current = await deriveChild(current.privKey, current.chainCode, index);
                }
                
                // Get public key
                const privBig = bytesToBigInt(current.privKey);
                const pubKeyPoint = point_mul(privBig, G);
                const compPubKey = compressPublicKey(pubKeyPoint);
                
                // HASH160
                const sha256_pub = sha256_sync(compPubKey);
                const hash160_pub = hash160(sha256_pub);

                if (coin === 'btc') {
                    derived.btc_legacy = b58check_encode(hash160_pub, 0x00);
                    // SegWit Native Bech32 P2WPKH
                    const bits5 = convertbits(hash160_pub, 8, 5, true);
                    const segwitData = [0].concat(bits5);
                    derived.btc_segwit = bech32_encode("bc", segwitData);
                } else if (coin === 'ltc') {
                    derived.ltc = b58check_encode(hash160_pub, 0x30);
                } else if (coin === 'doge') {
                    derived.doge = b58check_encode(hash160_pub, 0x1E);
                } else if (coin === 'eth') {
                    // Ethereum uncompressed pubkey (excluding 0x04 header)
                    const xBytes = bigIntToBytes(pubKeyPoint.x, 32);
                    const yBytes = bigIntToBytes(pubKeyPoint.y, 32);
                    const ethPub = new Uint8Array(64);
                    ethPub.set(xBytes, 0);
                    ethPub.set(yBytes, 32);
                    
                    const ethHash = keccak256.array(ethPub);
                    const ethAddrBytes = ethHash.slice(12, 32);
                    const ethAddrHex = bytesToHex(ethAddrBytes);
                    
                    // Apply EIP-55 checksum
                    const lowercaseHex = ethAddrHex.toLowerCase();
                    const eip55Hash = keccak256(lowercaseHex);
                    let finalEth = "0x";
                    for (let i = 0; i < lowercaseHex.length; i++) {
                        if (parseInt(eip55Hash[i], 16) >= 8) {
                            finalEth += lowercaseHex[i].toUpperCase();
                        } else {
                            finalEth += lowercaseHex[i];
                        }
                    }
                    derived.eth = finalEth;
                }
            }

            return derived;
        }

        // Syllable Picker Utility
        function pickRandomWordsSummingTo(count, targetSyllables) {
            // Find random combinations that satisfy targetSyllables with exactly count words
            for (let attempt = 0; attempt < 5000; attempt++) {
                let selected = [];
                let currentSum = 0;
                for (let i = 0; i < count; i++) {
                    const remainingWords = count - 1 - i;
                    const minPossible = remainingWords * 1;
                    const maxPossible = remainingWords * 4;
                    const minSyl = Math.max(1, targetSyllables - currentSum - maxPossible);
                    const maxSyl = Math.min(4, targetSyllables - currentSum - minPossible);
                    if (minSyl > maxSyl) break;
                    
                    const s = Math.floor(Math.random() * (maxSyl - minSyl + 1)) + minSyl;
                    const wordList = wordsBySyl[s];
                    const randomWord = wordList[Math.floor(Math.random() * wordList.length)];
                    selected.push(randomWord);
                    currentSum += s;
                }
                if (selected.length === count && currentSum === targetSyllables) {
                    return selected;
                }
            }
            return null;
        }

        // Poetic POS Grammar rule verification
        function rateGrammarPoetics(mnemonic) {
            const words = mnemonic.split(' ');
            if (words.length !== 12) return 0;
            
            // Assign POS tags to each word
            const tags = words.map(w => {
                const idx = BIP39_WORDS.indexOf(w);
                return idx !== -1 ? POS_TAGS[idx] : 'o';
            });

            let score = 0;
            
            // Analyze line structures (4 words per line)
            const lines = [
                tags.slice(0, 4),
                tags.slice(4, 8),
                tags.slice(8, 12)
            ];

            for (let i = 0; i < 3; i++) {
                const l = lines[i];
                // Has noun (n)
                const hasNoun = l.includes('n');
                // Has verb (v)
                const hasVerb = l.includes('v');
                // Has adjective (a)
                const hasAdj = l.includes('a');
                
                if (hasNoun && hasAdj) score += 3;
                if (hasNoun && hasVerb) score += 3;
                if (hasVerb && hasAdj) score += 2;
                if (hasNoun && !hasVerb && !hasAdj) score -= 1;
                
                // Avoid adjacent identical tags
                for (let j = 0; j < 3; j++) {
                    if (l[j] === l[j+1] && (l[j] === 'v' || l[j] === 'o' || l[j] === 'r')) {
                        score -= 5; // Highly unnatural double verb/preposition/adverb
                    }
                }
            }
            return score;
        }

        // Standard BIP-39 checksum search with 5-7-5 Syllables
        function generateHaikuBIP39Mnemonic(strictPoetic = false) {
            for (let mainAttempt = 0; mainAttempt < 1000; mainAttempt++) {
                // 1. Choose a syllable count for the 12th word (the checksum word)
                const target12Syl = Math.floor(Math.random() * 2) + 1; // 1 or 2 syllables (common for last word)
                const target9to11Syl = 5 - target12Syl;

                // 2. Select first 11 words
                const line1 = pickRandomWordsSummingTo(4, 5);
                const line2 = pickRandomWordsSummingTo(4, 7);
                const line3Part = pickRandomWordsSummingTo(3, target9to11Syl);

                if (!line1 || !line2 || !line3Part) continue;

                const selectedWords = [...line1, ...line2, ...line3Part];
                const indices = selectedWords.map(w => w.index);

                // 3. Search for a 12th word matching checksum AND required syllable count
                // First 11 words = 121 bits of entropy. We have 7 bits of entropy left (128 total).
                // Let's iterate all 128 possibilities for these 7 bits
                let matchWord = null;
                for (let entropy7 = 0; entropy7 < 128; entropy7++) {
                    // Build 128-bit array
                    let bits = 0n;
                    for (let idx of indices) {
                        bits = (bits << 11n) | BigInt(idx);
                    }
                    bits = (bits << 7n) | BigInt(entropy7);

                    const entropyBytes = bigIntToBytes(bits, 16);
                    // Compute SHA256
                    const hash = sha256_sync(entropyBytes);
                    const checksum = hash[0] >> 4; // first 4 bits

                    const idx12 = (entropy7 << 4) | checksum;
                    if (Number(SYLLABLE_COUNTS[idx12]) === target12Syl) {
                        matchWord = BIP39_WORDS[idx12];
                        break;
                    }
                }

                if (matchWord) {
                    const mnemonicList = selectedWords.map(w => w.word).concat([matchWord]);
                    const mnemonicString = mnemonicList.join(' ');
                    
                    if (strictPoetic) {
                        const score = rateGrammarPoetics(mnemonicString);
                        if (score >= 5) {
                            return { mnemonic: mnemonicString, score };
                        }
                    } else {
                        return { mnemonic: mnemonicString, score: rateGrammarPoetics(mnemonicString) };
                    }
                }
            }
            // Fallback (non-strict) if strict is too hard
            return generateHaikuBIP39Mnemonic(false);
        }

        // App State Management
