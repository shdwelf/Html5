        // Verify manual mnemonic input and check syllables
        async function validateManualMnemonic() {
            const inputVal = document.getElementById("manual-mnemonic-input").value.trim().toLowerCase().replace(/\s+/g, ' ');
            const words = inputVal.split(' ');

            if (words.length !== 12) {
                showToast("Mnemonic must be exactly 12 words!", true);
                return;
            }

            // Validate words against BIP-39 wordlist
            let syllables = [];
            let invalidWords = [];
            let wordIndices = [];

            for (let w of words) {
                const idx = BIP39_WORDS.indexOf(w);
                if (idx === -1) {
                    invalidWords.push(w);
                } else {
                    syllables.push(Number(SYLLABLE_COUNTS[idx]));
                    wordIndices.push(idx);
                }
            }

            if (invalidWords.length > 0) {
                showToast("Invalid BIP-39 wordlist entries: " + invalidWords.join(', '), true);
                return;
            }

            // Validate BIP-39 Checksum
            let bits = 0n;
            for (let i = 0; i < 11; i++) {
                bits = (bits << 11n) | BigInt(wordIndices[i]);
            }
            const entropy7 = wordIndices[11] >> 4;
            bits = (bits << 7n) | BigInt(entropy7);

            const entropyBytes = bigIntToBytes(bits, 16);
            const hash = sha256_sync(entropyBytes);
            const expectedChecksum = hash[0] >> 4;
            const actualChecksum = wordIndices[11] & 15;

            if (expectedChecksum !== actualChecksum) {
                showToast("Mnemonic BIP-39 checksum is invalid!", true);
                return;
            }

            // Analyze syllable structure
            const s1 = syllables.slice(0, 4).reduce((a, b) => a + b, 0);
            const s2 = syllables.slice(4, 8).reduce((a, b) => a + b, 0);
            const s3 = syllables.slice(8, 12).reduce((a, b) => a + b, 0);

            document.getElementById("manual-check-status").innerText = "Syllables: Line1=" + s1 + " (needed 5), Line2=" + s2 + " (needed 7), Line3=" + s3 + " (needed 5)";

            if (s1 !== 5 || s2 !== 7 || s3 !== 5) {
                showToast("Syllables don't match 5-7-5 haiku format!", true);
            } else {
                showToast("Valid 5-7-5 Haiku Mnemonic verified successfully!");
            }

            // Form dynamic Ensogen ID from manual seed
            const finalBits = (bits << 4n) | BigInt(actualChecksum);
            const hashedSeed = bytesToBigInt(sha256_sync(bigIntToBytes(finalBits, 16))) & ((1n << 38n) - 1n);
            const idStr = getEnsogenIDString(hashedSeed);

            currentWallet = {
                mnemonic: inputVal,
                score: rateGrammarPoetics(inputVal),
                ensogenId: idStr
            };

            displayWalletInfo(currentWallet);
        }

