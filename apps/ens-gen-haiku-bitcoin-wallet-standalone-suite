        // 38-bit Ensogen Number Packing & Unpacking
        function packEnsogen(vars) {
            let val = 0n;
            val |= BigInt(vars.inkLoad - 1);
            val <<= 1n; val |= BigInt(vars.direction === "Clockwise" ? 0 : 1);
            val <<= 4n; val |= BigInt(vars.paperHueIndex);
            val <<= 4n; val |= BigInt(vars.brushSize - 1);
            val <<= 4n; val |= BigInt(vars.inkDensity - 1);
            val <<= 1n; val |= BigInt(vars.xyStretch === "Equal" ? 0 : 1);
            val <<= 4n; val |= BigInt(vars.paperTexture - 1);
            val <<= 4n; val |= BigInt(vars.bristleDensity - 1);
            val <<= 2n; val |= BigInt(vars.signatureStyleIndex);
            val <<= 2n; val |= BigInt(vars.brushstrokeSizeIndex);
            val <<= 9n; val |= BigInt(vars.brushstrokeStart);
            return val;
        }

        function unpackEnsogen(val) {
            let brushstrokeStart = Number(val & 511n); val >>= 9n;
            let brushstrokeSizeIndex = Number(val & 3n); val >>= 2n;
            let signatureStyleIndex = Number(val & 3n); val >>= 2n;
            let bristleDensity = Number((val & 15n) + 1n); val >>= 4n;
            let paperTexture = Number((val & 15n) + 1n); val >>= 4n;
            let xyStretch = Number(val & 1n) === 0 ? "Equal" : "Unequal"; val >>= 1n;
            let inkDensity = Number((val & 15n) + 1n); val >>= 4n;
            let brushSize = Number((val & 15n) + 1n); val >>= 4n;
            let paperHueIndex = Number(val & 15n); val >>= 4n;
            let direction = Number(val & 1n) === 0 ? "Clockwise" : "Counter-Clockwise"; val >>= 1n;
            let inkLoad = Number((val & 15n) + 1n);
            return {
                inkLoad, direction, paperHueIndex, brushSize, inkDensity,
                xyStretch, paperTexture, bristleDensity, signatureStyleIndex,
                brushstrokeSizeIndex, brushstrokeStart
            };
        }

