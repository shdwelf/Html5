        // High fidelity Ensō Canvas rendering
        function drawEnso(ctx, vars, progress = 1.0) {
            const width = ctx.canvas.width;
            const height = ctx.canvas.height;
            ctx.clearRect(0, 0, width, height);

            const hue = PAPER_HUES[vars.paperHueIndex];
            
            // 1. Draw paper background
            ctx.fillStyle = hue.bg;
            ctx.fillRect(0, 0, width, height);

            // 2. Procedural Paper Fiber Textures
            ctx.strokeStyle = hue.fiber;
            ctx.lineWidth = 1;
            const seed = Number(vars.brushstrokeStart) + Number(vars.inkLoad);
            let tempRand = seed;
            function lcg() {
                tempRand = (tempRand * 1664525 + 1013904223) % 4294967296;
                return tempRand / 4294967296;
            }

            const fiberCount = Number(vars.paperTexture) * 30;
            for (let i = 0; i < fiberCount; i++) {
                const x = lcg() * width;
                const y = lcg() * height;
                const len = lcg() * 15 + 5;
                const angle = lcg() * Math.PI * 2;
                
                ctx.beginPath();
                ctx.moveTo(x, y);
                ctx.lineTo(x + Math.cos(angle) * len, y + Math.sin(angle) * len);
                ctx.stroke();
            }

            // Add fine granular noise
            const noiseDensity = Number(vars.paperTexture) * 200;
            ctx.fillStyle = hue.fiber;
            for (let i = 0; i < noiseDensity; i++) {
                const x = lcg() * width;
                const y = lcg() * height;
                ctx.fillRect(x, y, 1, 1);
            }

            // 3. Draw Ensō
            const cx = width / 2;
            const cy = height / 2;
            const baseRadius = 110 + vars.brushstrokeSizeIndex * 25;
            const rx = baseRadius;
            const ry = vars.xyStretch === "Unequal" ? baseRadius * 0.82 : baseRadius;

            // Set ink color (Charcoal paper uses light ink)
            const isDarkPaper = hue.name === "Charcoal";
            const baseInkColor = isDarkPaper ? "245,245,245" : "15,15,15";

            const bristleCount = vars.bristleDensity * 4 + 16;
            const baseBrushWidth = vars.brushSize * 4.5 + (vars.brushstrokeSizeIndex * 15 + 10);
            
            const startAngleRad = (vars.brushstrokeStart * Math.PI) / 180;
            const directionFactor = vars.direction === "Clockwise" ? 1 : -1;
            const totalSweepRad = Math.PI * 2 * progress * directionFactor;

            // Draw individual bristle paths
            for (let b = 0; b < bristleCount; b++) {
                // Determine bristle's offset from main path
                const offsetFrac = (b - bristleCount/2) / (bristleCount/2);
                const rOffset = offsetFrac * (baseBrushWidth / 2);
                
                // Add minor random variation to bristle paths
                const bristleSeed = seed + b * 17;
                let bristleRand = bristleSeed;
                function bristleLcg() {
                    bristleRand = (bristleRand * 1664525 + 1013904223) % 4294967296;
                    return bristleRand / 4294967296;
                }

                // Bristle length factor (ink running out)
                const runoutThreshold = 0.5 + bristleLcg() * 0.45 + (vars.inkLoad * 0.05);

                ctx.beginPath();
                
                const steps = 150;
                let first = true;
                for (let s = 0; s <= steps; s++) {
                    const t = s / steps;
                    if (t > progress) break;
                    
                    // Dry out check
                    if (t > runoutThreshold) break;

                    const curAngle = startAngleRad + totalSweepRad * t;
                    
                    // Procedural wave noise on bristles
                    const wave = Math.sin(t * Math.PI * 6 + bristleLcg() * Math.PI) * 1.5;
                    const rX = rx + rOffset + wave;
                    const rY = ry + rOffset + wave;

                    const px = cx + rX * Math.cos(curAngle);
                    const py = cy + rY * Math.sin(curAngle);

                    if (first) {
                        ctx.moveTo(px, py);
                        first = false;
                    } else {
                        ctx.lineTo(px, py);
                    }
                }

                // Compute opacity gradient based on ink density and load
                const alpha = (vars.inkDensity * 0.08) + 0.1;
                ctx.strokeStyle = "rgba(" + baseInkColor + "," + alpha + ")";
                ctx.lineWidth = 1.2;
                ctx.stroke();
            }

            // 4. Draw Signature Hanko Seal/Stamp
            if (vars.signatureStyleIndex > 0 && progress >= 0.95) {
                const stampStyle = SIGNATURE_STYLES[vars.signatureStyleIndex];
                let stampColor = "rgba(139, 0, 0, 0.9)"; // Dark Crimson default
                if (stampStyle === "Light") stampColor = "rgba(240, 128, 128, 0.9)";
                if (stampStyle === "Red") stampColor = "rgba(220, 20, 60, 0.9)";

                const sx = cx + rx * 0.7;
                const sy = cy + ry * 0.7;
                const sz = 35;

                ctx.fillStyle = stampColor;
                ctx.fillRect(sx, sy, sz, sz);

                // Add nice hand-carved subtle border
                ctx.strokeStyle = isDarkPaper ? "rgba(0,0,0,0.3)" : "rgba(255,255,255,0.3)";
                ctx.lineWidth = 1.5;
                ctx.strokeRect(sx + 2, sy + 2, sz - 4, sz - 4);

                // Draw Kanji / Seal Symbol Inside ("圓" - En / Circle)
                ctx.fillStyle = isDarkPaper ? "#111111" : "#ffffff";
                ctx.font = "bold 20px 'Courier New', monospace";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText("圓", sx + sz/2, sy + sz/2 + 1);
            }
        }

