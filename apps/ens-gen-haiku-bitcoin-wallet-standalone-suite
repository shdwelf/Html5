            }
            if (!password) {
                showToast("Please enter the decryption password!", true);
                return;
            }

            const file = fileInput.files[0];
            const reader = new FileReader();
            
            reader.onload = async function(e) {
                const encryptedText = e.target.result;
                try {
                    const decryptedText = await aesDecrypt256(encryptedText, password);
                    const imported = JSON.parse(decryptedText);
                    
                    if (!Array.isArray(imported)) {
                        showToast("Invalid vault data structure!", true);
                        return;
                    }

                    // Merge and avoid duplicates
                    let added = 0;
                    imported.forEach(item => {
