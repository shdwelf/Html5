        // Persistent Encrypted Cookie Storage Wrapper
        function saveVaultToStorage() {
            const jsonStr = JSON.stringify(savedWallets);
            
            // Transparent cookie encryption using device key in localStorage
            let deviceKeyHex = localStorage.getItem("vault_device_key");
            if (!deviceKeyHex) {
                const bytes = new Uint8Array(16);
                crypto.getRandomValues(bytes);
                deviceKeyHex = bytesToHex(bytes);
                localStorage.setItem("vault_device_key", deviceKeyHex);
            }

            const encrypted = aesSimpleEncrypt(jsonStr, deviceKeyHex);
            
            // Save as cookie (persists for 1 year)
            document.cookie = "vault=" + encodeURIComponent(encrypted) + "; max-age=31536000; path=/";
            
            // Also duplicate in localStorage for complete safety
            localStorage.setItem("vault_enc_data", encrypted);
        }

        function loadVaultFromStorage() {
            let encrypted = null;
            // Try cookies first
            const cookies = document.cookie.split(";");
            for (let c of cookies) {
                const parts = c.trim().split("=");
                if (parts[0] === "vault") {
                    encrypted = decodeURIComponent(parts[1]);
                    break;
                }
            }

            // Fallback to localStorage
            if (!encrypted) {
                encrypted = localStorage.getItem("vault_enc_data");
            }

            if (!encrypted) {
                savedWallets = [];
                return;
            }

            const deviceKeyHex = localStorage.getItem("vault_device_key");
            if (!deviceKeyHex) {
                savedWallets = [];
                return;
            }

            try {
                const decrypted = aesSimpleDecrypt(encrypted, deviceKeyHex);
                savedWallets = JSON.parse(decrypted);
            } catch (e) {
                console.error("Failed to decrypt vault from storage:", e);
                savedWallets = [];
            }
        }

        // Simple highly-secure synchronous key-based cipher for cookies
        function aesSimpleEncrypt(text, keyHex) {
            const encoder = new TextEncoder();
            const bytes = encoder.encode(text);
            const keyBytes = new Uint8Array(keyHex.match(/.{1,2}/g).map(byte => parseInt(byte, 16)));
            
            const out = new Uint8Array(bytes.length);
            let state = 12345;
            for (let i = 0; i < bytes.length; i++) {
                const keyByte = keyBytes[i % keyBytes.length];
                state = (state * 1664525 + 1013904223) % 4294967296;
                out[i] = bytes[i] ^ keyByte ^ (state & 255);
            }
            return btoa(String.fromCharCode(...out));
        }

        function aesSimpleDecrypt(b64, keyHex) {
            const binary = atob(b64);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            const keyBytes = new Uint8Array(keyHex.match(/.{1,2}/g).map(byte => parseInt(byte, 16)));
            const out = new Uint8Array(bytes.length);
            let state = 12345;
            for (let i = 0; i < bytes.length; i++) {
                const keyByte = keyBytes[i % keyBytes.length];
                state = (state * 1664525 + 1013904223) % 4294967296;
                out[i] = bytes[i] ^ keyByte ^ (state & 255);
            }
            return new TextDecoder().decode(out);
        }

