                    saveVaultToStorage();
                    renderVaultList();
                    closeImportModal();
                    showToast("Successfully imported " + added + " new wallets to vault!");
                } catch (err) {
                    console.error(err);
                    showToast("Decryption failed! Incorrect password or corrupted file.", true);
                }
            };

            reader.readAsText(file);
        }

        // Secure AES-256-GCM browser encryption using native Web Crypto API
        async function aesEncrypt256(plainText, password) {
            const encoder = new TextEncoder();
            const salt = crypto.getRandomValues(new Uint8Array(16));
            const iv = crypto.getRandomValues(new Uint8Array(12));

            const pbkdfKey = await crypto.subtle.importKey(
                "raw",
                encoder.encode(password),
                "PBKDF2",
                false,
                ["deriveKey"]
            );

            const aesKey = await crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: salt,
                    iterations: 100000,
                    hash: "SHA-256"
                },
                pbkdfKey,
                { name: "AES-GCM", length: 256 },
                false,
                ["encrypt"]
            );

            const cipherBuffer = await crypto.subtle.encrypt(
                {
                    name: "AES-GCM",
                    iv: iv
                },
                aesKey,
                encoder.encode(plainText)
            );

            // Package as salt (16b) + iv (12b) + ciphertext
            const packed = new Uint8Array(salt.length + iv.length + cipherBuffer.byteLength);
            packed.set(salt, 0);
            packed.set(iv, salt.length);
            packed.set(new Uint8Array(cipherBuffer), salt.length + iv.length);

            return btoa(String.fromCharCode(...packed));
        }

        async function aesDecrypt256(cipherTextB64, password) {
            const encoder = new TextEncoder();
            const packedChar = atob(cipherTextB64);
            const packed = new Uint8Array(packedChar.length);
            for (let i = 0; i < packedChar.length; i++) {
                packed[i] = packedChar.charCodeAt(i);
            }

            const salt = packed.slice(0, 16);
            const iv = packed.slice(16, 28);
            const ciphertext = packed.slice(28);

            const pbkdfKey = await crypto.subtle.importKey(
                "raw",
                encoder.encode(password),
                "PBKDF2",
                false,
                ["deriveKey"]
            );

            const aesKey = await crypto.subtle.deriveKey(
                {
                    name: "PBKDF2",
                    salt: salt,
                    iterations: 100000,
                    hash: "SHA-256"
                },
                pbkdfKey,
                { name: "AES-GCM", length: 256 },
                false,
                ["decrypt"]
            );

            const decryptedBuffer = await crypto.subtle.decrypt(
                {
                    name: "AES-GCM",
                    iv: iv
                },
                aesKey,
                ciphertext
            );

            return new TextDecoder().decode(decryptedBuffer);
        }

