<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EnsōGen & Haiku Bitcoin Wallet - Standalone Suite</title>
    <style>
        /* Modern CSS Design with Zen Minimalist/Oriental Calligraphy Vibes */
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-color: #e0e0e0;
            --text-muted: #888888;
            --accent-color: #009688; /* Teal/Cyan */
            --accent-glow: rgba(0, 150, 136, 0.2);
            --border-color: #333333;
            --btn-bg: #2d2d2d;
            --btn-hover: #3d3d3d;
            --red-stamp: #8b0000;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .app-container {
            width: 100%;
            max-width: 1200px;
            margin: 20px;
            background-color: #151515;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Header / Logo section */
        header {
            padding: 24px 32px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #181818, #121212);
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-section svg {
            width: 44px;
            height: 44px;
            stroke: var(--accent-color);
            fill: none;
            stroke-width: 2.5;
        }

        .logo-text h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 1.5px;
            font-family: Georgia, serif;
            color: #ffffff;
        }

        .logo-text p {
            margin: 2px 0 0 0;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2px;
        }}

        /* Navigation Tab Bar */
        .tabs {
            display: flex;
            background-color: #1a1a1a;
            border-bottom: 1px solid var(--border-color);
            padding: 0 16px;
        }

        .tab-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            padding: 16px 24px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            border-bottom: 3px solid transparent;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn:hover {
            color: #ffffff;
        }

        .tab-btn.active {
            color: var(--accent-color);
            border-bottom-color: var(--accent-color);
        }

        /* Content panels */
        .tab-content {
            display: none;
            padding: 32px;
            animation: fadeIn 0.3s ease-out;
            min-height: 550px;
        }

        .tab-content.active {
            display: block;
        }

        /* Grid Layouts */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }

        @media (max-width: 900px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        /* Left and Right column formatting */
        .panel-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            position: relative;
        }

        .panel-title {
            font-family: Georgia, serif;
            font-size: 18px;
            margin-top: 0;
            margin-bottom: 20px;
            border-bottom: 1px dashed var(--border-color);
            padding-bottom: 10px;
            color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Forms, inputs, sliders */
        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 6px;
            color: var(--text-muted);
        }

        .form-group label span {
            color: var(--accent-color);
            font-weight: 600;
        }

        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 5px;
            border-radius: 3px;
            background: #333333;
            outline: none;
            margin: 10px 0;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background: var(--accent-color);
            cursor: pointer;
            transition: transform 0.1s;
        }

        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.3);
        }

        select, input[type="text"], input[type="password"], textarea {
            width: 100%;
            background-color: #252525;
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        select:focus, input[type="text"]:focus, input[type="password"]:focus, textarea:focus {
            border-color: var(--accent-color);
        }

        /* Buttons styles */
        .btn {
            background-color: var(--btn-bg);
            color: var(--text-color);
            border: 1px solid var(--border-color);
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:hover {
            background-color: var(--btn-hover);
            color: #ffffff;
            border-color: var(--accent-color);
        }

        .btn-primary {
            background-color: var(--accent-color);
            color: #ffffff;
            border-color: var(--accent-color);
        }

        .btn-primary:hover {
            background-color: #00796b;
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .btn-danger {
            background-color: #4c1c1c;
            color: #ff9e9e;
            border-color: #7a2b2b;
        }

        .btn-danger:hover {
            background-color: #612222;
            border-color: #ff9e9e;
        }

        /* Canvas drawing area styles */
        .canvas-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        canvas {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 20px rgba(0,0,0,0.6);
            max-width: 100%;
        }

        .ensogen-tag {
            font-family: monospace;
            font-size: 16px;
            background-color: #252525;
            padding: 8px 16px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            color: var(--accent-color);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Haiku output area */
        .haiku-box {
            background: linear-gradient(180deg, #1f1f1f, #151515);
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--accent-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 24px;
            text-align: center;
            position: relative;
        }

        .haiku-line {
            font-family: Georgia, serif;
            font-size: 20px;
            font-style: italic;
            margin: 8px 0;
            letter-spacing: 0.5px;
            color: #ffffff;
            opacity: 0.9;
        }

        .haiku-syllable-count {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 15px;
        }

        /* Addresses styles */
        .address-item {
            margin-bottom: 16px;
            background-color: #1a1a1a;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 12px 16px;
        }

        .address-header {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .address-header span.coin-name {
            color: var(--accent-color);
            font-weight: 700;
        }

        .address-val {
            font-family: monospace;
            font-size: 13px;
            word-break: break-all;
            color: #ffffff;
            user-select: all;
        }

        .address-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 6px;
        }

        .small-link {
            font-size: 11px;
            color: var(--accent-color);
            text-decoration: none;
            cursor: pointer;
        }

        .small-link:hover {
            text-decoration: underline;
        }

        /* Vault / Saved list styles */
        .vault-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            margin-top: 15px;
        }

        .vault-table th, .vault-table td {
            text-align: left;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-color);
        }

        .vault-table th {
            background-color: #1e1e1e;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 11px;
        }

        .vault-table tr:hover {
            background-color: #1a1a1a;
        }

        /* Modal Overlay */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s ease-out;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background-color: #1e1e1e;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 32px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 24px;
        }

        /* Toggle checkbox styles */
        .toggle-container {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            user-select: none;
            margin-bottom: 15px;
        }

        .toggle-switch {
            width: 44px;
            height: 22px;
            background-color: #333333;
            border-radius: 11px;
            position: relative;
            transition: background-color 0.2s;
        }

        .toggle-switch::after {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 18px;
            height: 18px;
            background-color: #ffffff;
            border-radius: 50%;
            transition: left 0.2s;
        }

        input[type="checkbox"] {
            display: none;
        }

        input[type="checkbox"]:checked + .toggle-switch {
            background-color: var(--accent-color);
        }

        input[type="checkbox"]:checked + .toggle-switch::after {
            left: 24px;
        }

        /* Toast notifications */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background-color: #2e7d32;
            color: #ffffff;
            padding: 12px 24px;
            border-radius: 6px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            z-index: 2000;
            font-size: 14px;
            font-weight: 600;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toast.error {
            background-color: #c62828;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
        }

        /* Keyframes */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Multi Miner Queue Cards */
        .miner-queue-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            max-height: 450px;
            overflow-y: auto;
            padding-right: 10px;
            margin-top: 15px;
        }

        .miner-card {
            background-color: #1a1a1a;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            animation: fadeIn 0.3s ease-out;
        }

        .miner-card-left {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .miner-haiku-title {
            font-family: Georgia, serif;
            font-size: 15px;
            font-style: italic;
            color: #ffffff;
        }

        .miner-id-span {
            font-family: monospace;
            font-size: 11px;
            color: var(--accent-color);
        }

        .miner-score {
            font-size: 11px;
            color: var(--text-muted);
        }

        .miner-card-right {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        /* Forging Animation overlay screen on canvas */
        .forging-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            color: #ffffff;
            gap: 20px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .forging-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .fire-spinner {
            width: 60px;
            height: 60px;
            border: 3px dashed var(--accent-color);
            border-radius: 50%;
            animation: spin 2s linear infinite;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .forging-title {
            font-family: Georgia, serif;
            font-size: 20px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        /* Styled scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #121212;
        }
        ::-webkit-scrollbar-thumb {
            background: #333333;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-color);
        }
    </style>
</head>
<body>

    <div class="app-container">
        <header>
            <div class="logo-section">
                <!-- Zen Ensō SVG Emblem -->
                <svg viewBox="0 0 100 100">
                    <path d="M 50 15 A 35 35 0 1 1 20 35" stroke-linecap="round" />
                    <circle cx="50" cy="50" r="1.5" fill="var(--accent-color)" />
                </svg>
                <div class="logo-text">
                    <h1>EnsōGen & Haiku Wallet</h1>
                    <p>Procedural Collectibles & Poetic Cryptography</p>
                </div>
            </div>
            <div>
                <span class="ensogen-tag">
                    <span id="header-ensogen-id">ENSO-XXXX-XXXX</span>
                </span>
            </div>
        </header>

        <nav class="tabs">
            <button class="tab-btn active" onclick="switchTab('ensogen')">🏯 Ensō Generator</button>
            <button class="tab-btn" onclick="switchTab('haiku')">📜 Haiku Wallet</button>
            <button class="tab-btn" onclick="switchTab('miner')">⛏️ Multi-Miner</button>
            <button class="tab-btn" onclick="switchTab('vault')">🗝️ Vault & Storage</button>
        </nav>

        <!-- Tab Content: Ensogen -->
        <div id="ensogen" class="tab-content active">
            <div class="grid-2">
                <div class="panel-card">
                    <div class="panel-title">🖌️ Brush & Canvas Settings</div>
                    
                    <div class="form-group">
                        <label>Ensogen Number / Seed</label>
                        <div style="display:flex; gap:10px;">
                            <input type="text" id="ensogen-seed-input" placeholder="Type Ensogen ID (e.g. ENSO-3Z8F-4G9X)">
                            <button class="btn btn-primary" onclick="loadEnsogenFromInput()">Load</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Ink Load: <span id="val-inkLoad">4</span></label>
                        <input type="range" id="param-inkLoad" min="1" max="10" value="4" oninput="updateSliders()">
                    </div>

                    <div class="form-group">
                        <label>Brush Size: <span id="val-brushSize">6</span></label>
                        <input type="range" id="param-brushSize" min="1" max="10" value="6" oninput="updateSliders()">
                    </div>

                    <div class="form-group">
                        <label>Ink Density: <span id="val-inkDensity">3</span></label>
                        <input type="range" id="param-inkDensity" min="1" max="10" value="3" oninput="updateSliders()">
                    </div>

                    <div class="form-group">
                        <label>Bristle Density: <span id="val-bristleDensity">5</span></label>
                        <input type="range" id="param-bristleDensity" min="1" max="10" value="5" oninput="updateSliders()">
                    </div>

                    <div class="form-group">
                        <label>Paper Texture: <span id="val-paperTexture">4</span></label>
                        <input type="range" id="param-paperTexture" min="1" max="10" value="4" oninput="updateSliders()">
                    </div>

                    <div class="form-group">
                        <label>Brushstroke Start Angle: <span id="val-brushstrokeStart">216°</span></label>
                        <input type="range" id="param-brushstrokeStart" min="0" max="360" value="216" oninput="updateSliders()">
                    </div>

                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-top:15px;">
                        <div class="form-group">
                            <label>Direction</label>
                            <select id="param-direction" onchange="updateSliders()">
                                <option value="Clockwise">Clockwise</option>
                                <option value="Counter-Clockwise">Counter-Clockwise</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Paper Hue</label>
                            <select id="param-paperHue" onchange="updateSliders()">
                                <option value="Cyan">Cyan</option>
                                <option value="Magenta">Magenta</option>
                                <option value="Yellow">Yellow</option>
                                <option value="Charcoal">Charcoal</option>
                                <option value="Sepia">Sepia</option>
                                <option value="White">White</option>
                                <option value="Parchment">Parchment</option>
                                <option value="Jade">Jade</option>
                                <option value="Indigo">Indigo</option>
                            </select>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px;">
                        <div class="form-group">
                            <label>X/Y Stretch</label>
                            <select id="param-xyStretch" onchange="updateSliders()">
                                <option value="Unequal">Unequal</option>
                                <option value="Equal">Equal</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Signature Style</label>
                            <select id="param-signatureStyle" onchange="updateSliders()">
                                <option value="Dark">Dark</option>
                                <option value="Light">Light</option>
                                <option value="Red">Red</option>
                                <option value="None">None</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Brushstroke Size</label>
                        <select id="param-brushstrokeSize" onchange="updateSliders()">
                            <option value="Medium">Medium</option>
                            <option value="Small">Small</option>
                            <option value="Large">Large</option>
                        </select>
                    </div>

                    <div style="display:flex; gap:10px; margin-top:20px;">
                        <button class="btn btn-primary" onclick="randomizeEnsogen()">🎲 Randomize</button>
                        <button class="btn" onclick="triggerForgingAnimation()">🎭 Animate Ink</button>
                    </div>
                </div>

                <div class="panel-card canvas-container">
                    <div style="position:relative; width:450px; height:450px;">
                        <canvas id="ensoCanvas" width="450" height="450"></canvas>
                        <div class="forging-overlay" id="canvasForgingOverlay">
                            <div class="fire-spinner"></div>
                            <div class="forging-title" id="forgingOverlayTitle">Forging Zen Circle...</div>
                        </div>
                    </div>
                    
                    <div style="display:flex; gap:10px; width: 100%;">
                        <button class="btn btn-primary" style="flex:1;" onclick="downloadPng()">💾 Download PNG</button>
                        <button class="btn" style="flex:1;" onclick="applyEnsogenToHaiku()">🔗 Link to Wallet</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Content: Haiku Wallet -->
        <div id="haiku" class="tab-content">
            <div class="grid-2">
                <div class="panel-card">
                    <div class="panel-title">📜 Haiku Bitcoin Wallet Generator</div>
                    
                    <div class="toggle-container" onclick="togglePoeticFilter()">
                        <input type="checkbox" id="poetic-only-check" checked>
                        <div class="toggle-switch"></div>
                        <span style="font-size:13px; font-weight:600;">Strict Poetic Structure (Grammar filter)</span>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:15px; margin-bottom:20px;">
                        <button class="btn btn-primary" onclick="generateHaikuWallet()">🎲 Generate Poetic Haiku Wallet</button>
                    </div>

                    <div class="form-group">
                        <label>Manual Mnemonic Input (12-Word BIP39)</label>
                        <textarea id="manual-mnemonic-input" rows="3" placeholder="Enter 12 words to derive keys, check syllable structures, or validate checksum..."></textarea>
                        <div style="display:flex; justify-content:space-between; margin-top:6px;">
                            <span id="manual-check-status" style="font-size:11px; color:var(--text-muted);">Syllables count: -</span>
                            <button class="small-link" style="background:none; border:none; padding:0;" onclick="validateManualMnemonic()">Verify Mnemonic & Derive</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Optional Passphrase</label>
                        <input type="password" id="wallet-passphrase" placeholder="Passphrase (leave empty for default standard)">
                    </div>

                    <div style="display:flex; gap:10px; margin-top:20px;">
                        <button class="btn btn-primary" id="save-wallet-btn" disabled onclick="saveCurrentWallet()">⭐ Save Wallet to Vault</button>
                    </div>
                </div>

                <div class="panel-card">
                    <div class="panel-title">🎏 Poetry & Derived Addresses</div>

                    <div class="haiku-box">
                        <div class="haiku-line" id="haiku-line-1">Silence sweeps the hall</div>
                        <div class="haiku-line" id="haiku-line-2">Bamboo shadows dance softly</div>
                        <div class="haiku-line" id="haiku-line-3">Moonlight meets the ink</div>
