        autoSpinEnabled = true;
        btnToggleSpin.classList.add('active');
        updateCamera();
        
        showToast("Full Stacked Tower - Perspective View");
      } else {
        const targetGen = parseInt(gen, 10);
        
        blocks.forEach(b => {
          const g = parseInt(b.getAttribute('data-gen'), 10);
          if (g === targetGen) {
            b.classList.add('focused-tier');
            b.classList.remove('dimmed');
            
            const zVal = b.getAttribute('data-z');
            const angleVal = b.getAttribute('data-angle');
            b.style.transform = `translateZ(${zVal}px) rotateZ(${angleVal}deg) scale3d(1.08, 1.08, 1.08)`;
          } else {
            b.classList.add('dimmed');
            b.classList.remove('focused-tier');
            
            const zVal = b.getAttribute('data-z');
            const angleVal = b.getAttribute('data-angle');
            b.style.transform = `translateZ(${zVal}px) rotateZ(${angleVal}deg)`;
          }
        });
        
        // Tilt camera flat looking straight down through central empty doughnut core!
        rx = 0; 
        autoSpinEnabled = false;
        btnToggleSpin.classList.remove('active');
        updateCamera();
        
        showToast(`Doughnut View Gen ${targetGen} - Tap a Wedge!`);
      }
    }

