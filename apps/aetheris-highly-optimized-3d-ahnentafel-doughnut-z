    // ----------------------------------------------------
    // HIGH-PERFORMANCE GEDCOM TOKENIZER & PARSER
    // ----------------------------------------------------
    
    function parseGEDCOM(text) {
      const lines = text.split(/\r?\n/);
      const individuals = {};
      const families = {};
      
      let currentIndi = null;
      let currentFam = null;
      let currentSection = null; 
      let subLevelTag = null;

      function parseGEDCOMLine(lineStr) {
        const parts = lineStr.split(/\s+/);
        if (parts.length < 2) return null;
        const level = parseInt(parts[0], 10);
        if (isNaN(level)) return null;
        
        let id = null;
        let tag = null;
        let value = "";
        
        if (parts[1].startsWith('@') && parts[1].endsWith('@')) {
          id = parts[1];
          tag = parts[2];
          value = parts.slice(3).join(' ');
        } else {
          tag = parts[1];
          value = parts.slice(2).join(' ');
        }
        
        return { level, id, tag, value };
      }
      
      for (let line of lines) {
        line = line.trim();
        if (!line) continue;
        
        const parsedLine = parseGEDCOMLine(line);
        if (!parsedLine) continue;
        
        const { level, id, tag, value } = parsedLine;
        
        if (level === 0) {
          currentIndi = null;
          currentFam = null;
          currentSection = null;
          
          if (tag === 'INDI' && id) {
            currentIndi = { 
              id: id, 
              name: '', 
              sex: '', 
              bdate: '', 
              bplace: '', 
              ddate: '', 
              dplace: '', 
              famc: '', 
              fams: [] 
            };
            individuals[id] = currentIndi;
            currentSection = 'INDI';
          } else if (tag === 'FAM' && id) {
            currentFam = { 
              id: id, 
              husb: '', 
              wife: '', 
              chil: [] 
            };
            families[id] = currentFam;
            currentSection = 'FAM';
          }
        } else {
          if (currentSection === 'INDI' && currentIndi) {
            if (level === 1) {
              subLevelTag = tag;
              if (tag === 'NAME') {
                currentIndi.name = value.replace(/\//g, '').trim();
              } else if (tag === 'SEX') {
                currentIndi.sex = value.trim();
              } else if (tag === 'FAMC') {
                currentIndi.famc = value.trim();
              } else if (tag === 'FAMS') {
                currentIndi.fams.push(value.trim());
              }
            } else if (level === 2) {
              if (subLevelTag === 'BIRT') {
                if (tag === 'DATE') currentIndi.bdate = value.trim();
                if (tag === 'PLAC') currentIndi.bplace = value.trim();
              } else if (subLevelTag === 'DEAT') {
                if (tag === 'DATE') currentIndi.ddate = value.trim();
                if (tag === 'PLAC') currentIndi.dplace = value.trim();
              }
            }
          } else if (currentSection === 'FAM' && currentFam) {
            if (level === 1) {
              if (tag === 'HUSB') {
                currentFam.husb = value.trim();
              } else if (tag === 'WIFE') {
                currentFam.wife = value.trim();
              } else if (tag === 'CHIL') {
                currentFam.chil.push(value.trim());
              }
            }
          }
        }
      }
      return { individuals, families };
    }

    function buildAhnentafel(targetId, individuals, families) {
      const ahnentafel = {};
      const queue = [{ id: targetId, num: 1 }];
      
      while (queue.length > 0) {
        const { id, num } = queue.shift();
        if (num > 255) continue; 
        
        const indi = individuals[id];
        if (indi) {
          ahnentafel[num] = indi;
          
          if (indi.famc) {
            const fam = families[indi.famc];
            if (fam) {
              if (fam.husb) {
                queue.push({ id: fam.husb, num: num * 2 });
              }
              if (fam.wife) {
                queue.push({ id: fam.wife, num: num * 2 + 1 });
              }
            }
          }
        }
      }
      return ahnentafel;
    }

