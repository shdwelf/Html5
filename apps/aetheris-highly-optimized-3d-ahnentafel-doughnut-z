    function clearHUD() {
      floatingHUD.classList.remove('visible');
    }

    function updateDetailPanel(ahnNum) {
      const person = activeAhnentafel[ahnNum];
      if (!person) return;
      const theme = getColorByAhnentafel(ahnNum);
      const panel = document.querySelector('.details-card');
      panel.style.borderLeftColor = theme.color;
      document.getElementById('hudName').textContent = person.name; 
    }

    // Relation names mappings
    function getRelationLabel(ahnNum) {
      if (ahnNum === 1) return "Target Individual";
      if (ahnNum === 2) return "Father";
      if (ahnNum === 3) return "Mother";
      if (ahnNum === 4) return "Paternal Grandfather";
      if (ahnNum === 5) return "Paternal Grandmother";
      if (ahnNum === 6) return "Maternal Grandfather";
      if (ahnNum === 7) return "Maternal Grandmother";
      
      const gen = Math.floor(Math.log2(ahnNum)) + 1;
      const isFemale = (ahnNum % 2 !== 0);
      const prefix = "Great ".repeat(Math.max(0, gen - 3)) + (isFemale ? "Grandmother" : "Grandfather");
      return prefix;
    }

    function getColorByAhnentafel(ahnNum) {
      if (ahnNum === 1) return { color: 'var(--color-target)', glow: 'rgba(255, 183, 0, 0.5)' };
      if (ahnNum === 2) return { color: 'var(--color-pat-gf)', glow: 'rgba(0, 243, 255, 0.5)' };
      if (ahnNum === 3) return { color: 'var(--color-mat-gm)', glow: 'rgba(255, 0, 160, 0.5)' };
      
      let ancestorInGen3 = ahnNum;
      while (ancestorInGen3 >= 8) {
        ancestorInGen3 = Math.floor(ancestorInGen3 / 2);
      }
      
      if (ancestorInGen3 === 4) return { color: 'var(--color-pat-gf)', glow: 'rgba(0, 243, 255, 0.5)' };
      if (ancestorInGen3 === 5) return { color: 'var(--color-pat-gm)', glow: 'rgba(0, 245, 160, 0.5)' };
      if (ancestorInGen3 === 6) return { color: 'var(--color-mat-gf)', glow: 'rgba(160, 68, 255, 0.5)' };
      if (ancestorInGen3 === 7) return { color: 'var(--color-mat-gm)', glow: 'rgba(255, 0, 160, 0.5)' };
      
      return { color: 'var(--color-unknown)', glow: 'rgba(74, 85, 104, 0.5)' };
    }

    // ----------------------------------------------------
    // USER FILE IMPORTS & DRAG/TOUCH CAMERA EVENT DRIVERS
    // ----------------------------------------------------

    function loadGEDCOMData(text) {
      const parsed = parseGEDCOM(text);
      individuals = parsed.individuals;
      families = parsed.families;

      targetSelect.innerHTML = '';
      const sortedIndis = Object.values(individuals).sort((a,b) => a.name.localeCompare(b.name));

      if (sortedIndis.length === 0) {
        targetSelect.innerHTML = '<option value="">No individuals found</option>';
        return;
      }

      sortedIndis.forEach(indi => {
        const option = document.createElement('option');
        option.value = indi.id;
        option.textContent = `${indi.name} (${indi.id})`;
        targetSelect.appendChild(option);
      });

      const firstTarget = sortedIndis[0];
      targetSelect.value = firstTarget.id;
      changeTarget(firstTarget.id);
    }

    function changeTarget(targetId) {
      activeTargetId = targetId;
      activeAhnentafel = buildAhnentafel(targetId, individuals, families);

      renderTower();
      rebuildPedigreeSearchList();
      pipeWindow.style.display = 'none';
      nodeCountLabel.textContent = `${Object.keys(activeAhnentafel).length} Direct Ancestors`;
    }

    function rebuildPedigreeSearchList() {
      pedigreeList.innerHTML = '';
      const activeEntries = Object.entries(activeAhnentafel).sort((a, b) => parseInt(a[0]) - parseInt(b[0]));
      
      if (activeEntries.length === 0) {
        pedigreeList.innerHTML = `<div style="padding:16px; font-size:11px; text-align:center; color:var(--text-muted);">No data loaded.</div>`;
        return;
      }

      activeEntries.forEach(([numStr, person]) => {
        const num = parseInt(numStr, 10);
        const item = document.createElement('div');
        item.className = 'list-item';
        
        const relation = getRelationLabel(num);
        const theme = getColorByAhnentafel(num);
        const sexSymbol = person.sex === 'M' ? '♂' : '♀';
        
        item.innerHTML = `
          <div>
            <div class="list-item-name" style="color: ${theme.color}">
              <span style="font-weight:bold; margin-right:4px;">${sexSymbol}</span>${person.name}
            </div>
            <div style="font-size:10px; color: var(--text-muted);">${relation}</div>
          </div>
          <span class="list-item-num">#${num}</span>
        `;
        
        item.addEventListener('click', () => {
          selectNode(num);
        });
        
        pedigreeList.appendChild(item);
      });
    }

    // Drag-to-rotate mouse events
    scene.addEventListener('mousedown', (e) => {
      if (e.target.closest('.control-btn') || e.target.closest('.pipe-ancestor-dot') || e.target.closest('.wedge-block-3d')) return;
      isDragging = true;
      scene.style.cursor = 'grabbing';
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      startRx = rx;
      startRz = rz;
      
      if (autoSpinEnabled) {
        autoSpinEnabled = false;
        btnToggleSpin.classList.remove('active');
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      const dy = e.clientY - dragStartY;
      rz = startRz - dx * 0.35;
      rx = Math.max(15, Math.min(85, startRx + dy * 0.35));
      
      camTiltSlider.value = Math.round(rx);
      camTiltVal.textContent = `${Math.round(rx)}°`;
      updateCamera();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        scene.style.cursor = 'grab';
      }
    });

    // Touch Support for mobile finger-drag rotation
    scene.addEventListener('touchstart', (e) => {
      if (e.target.closest('.control-btn') || e.target.closest('.pipe-ancestor-dot') || e.target.closest('.wedge-block-3d')) return;
      isDragging = true;
      const touch = e.touches[0];
      dragStartX = touch.clientX;
      dragStartY = touch.clientY;
      startRx = rx;
      startRz = rz;
      
      if (autoSpinEnabled) {
        autoSpinEnabled = false;
        btnToggleSpin.classList.remove('active');
      }
    }, { passive: true });

    scene.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const touch = e.touches[0];
      const dx = touch.clientX - dragStartX;
      const dy = touch.clientY - dragStartY;
      rz = startRz - dx * 0.35;
      rx = Math.max(15, Math.min(85, startRx + dy * 0.35));
      
      camTiltSlider.value = Math.round(rx);
      camTiltVal.textContent = `${Math.round(rx)}°`;
      updateCamera();
    }, { passive: true });

    scene.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Zooming triggers
    scene.addEventListener('wheel', (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY * -0.0005;
      zoom = Math.max(0.3, Math.min(2.5, zoom + zoomFactor));
      
      camZoomSlider.value = Math.round(zoom * 100);
      camZoomVal.textContent = `${zoom.toFixed(2)}x`;
      updateCamera();
    }, { passive: false });

    // Inputs bindings
    targetSelect.addEventListener('change', (e) => {
      if (e.target.value) {
        changeTarget(e.target.value);
        showToast("Switched Target Individual");
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        loadGEDCOMData(evt.target.result);
        showToast("Parsed Custom GEDCOM Successfully!");
      };
      reader.readAsText(file);
    });

    btnLoadSample.addEventListener('click', () => {
      const sampleText = generateRoyalGEDCOM();
      loadGEDCOMData(sampleText);
      targetSelect.value = "@I1@";
      changeTarget("@I1@");
      showToast("Loaded 8-Generation British Royal Pedigree!");
    });

    searchNodes.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase();
      const items = pedigreeList.querySelectorAll('.list-item');
      
      items.forEach(item => {
        const name = item.querySelector('.list-item-name').textContent.toLowerCase();
        if (name.includes(query)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });

    // Cam Sliders inputs
    camTiltSlider.addEventListener('input', (e) => {
      rx = parseInt(e.target.value, 10);
      camTiltVal.textContent = `${rx}°`;
      autoSpinEnabled = false;
      btnToggleSpin.classList.remove('active');
      updateCamera();
    });

    camZoomSlider.addEventListener('input', (e) => {
      zoom = parseInt(e.target.value, 10) / 100;
      camZoomVal.textContent = `${zoom.toFixed(2)}x`;
      updateCamera();
    });

    maxPipeDepthSlider.addEventListener('input', (e) => {
      const val = e.target.value;
      pipeDepthVal.textContent = `${val} Gen`;
      const activeBlock = sunburstBase.querySelector('.wedge-block-3d.active');
      if (activeBlock) {
        const ahnNum = parseInt(activeBlock.getAttribute('data-ahn'), 10);
        selectNode(ahnNum);
      }
    });

    // Control buttons triggers
    btnToggleSpin.addEventListener('click', () => {
      autoSpinEnabled = !autoSpinEnabled;
      btnToggleSpin.classList.toggle('active', autoSpinEnabled);
      if (autoSpinEnabled) {
        rz = 0; 
      }
      updateCamera();
    });

    btnResetCam.addEventListener('click', () => {
      rx = 65;
      rz = 0;
      zoom = 0.95;
      autoSpinEnabled = true;
      
      btnToggleSpin.classList.add('active');
      camTiltSlider.value = rx;
      camTiltVal.textContent = `${rx}°`;
      camZoomSlider.value = Math.round(zoom * 100);
      camZoomVal.textContent = `${zoom}x`;
      
      updateCamera();
      showToast("Camera View Reset");
    });

    let isOrtho = false;
    btnToggleFlat.addEventListener('click', () => {
      isOrtho = !isOrtho;
      btnToggleFlat.classList.toggle('active', isOrtho);
      
      if (isOrtho) {
        rx = 15; 
        autoSpinEnabled = false;
        btnToggleSpin.classList.remove('active');
        btnToggleFlat.innerHTML = `<span style="font-size: 11px; font-weight: bold; font-family: monospace;">2D</span>`;
        showToast("Orthographic View");
      } else {
        rx = 65;
        autoSpinEnabled = true;
        btnToggleSpin.classList.add('active');
        btnToggleFlat.innerHTML = `<span style="font-size: 11px; font-weight: bold; font-family: monospace;">3D</span>`;
        showToast("Holographic 3D View");
      }
      
      camTiltSlider.value = rx;
      camTiltVal.textContent = `${rx}°`;
      updateCamera();
    });

    // Mobile Sidebar controls
    const mobileMenuTrigger = document.getElementById('mobileMenuTrigger');
    const mobileCloseBtn = document.getElementById('mobileCloseBtn');
    const sidebarBackdrop = document.getElementById('sidebarBackdrop');
    const sidebar = document.querySelector('.sidebar');

    function openSidebar() {
      sidebar.classList.add('open');
      sidebarBackdrop.classList.add('visible');
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      sidebarBackdrop.classList.remove('visible');
    }

    if (mobileMenuTrigger) mobileMenuTrigger.addEventListener('click', openSidebar);
    if (mobileCloseBtn) mobileCloseBtn.addEventListener('click', closeSidebar);
    if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeSidebar);

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('visible');
      setTimeout(() => {
        toast.classList.remove('visible');
      }, 3000);
    }

    function checkResponsiveScale() {
      if (window.innerWidth <= 768) {
        zoom = 0.58;
        camZoomSlider.value = 58;
        camZoomVal.textContent = "0.58x";
        
        towerSpacing = 24;
        tierSpacingSlider.value = 24;
        tierSpacingVal.textContent = "24px";
      }
    }

    // ----------------------------------------------------
    // INITIALIZATION
    // ----------------------------------------------------
    
    window.addEventListener('DOMContentLoaded', () => {
      checkResponsiveScale();
      btnLoadSample.click();
      updateCamera();
    });

  </script>
</body>
</html>
