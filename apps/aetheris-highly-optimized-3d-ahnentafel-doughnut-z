    function updateCamera() {
      treeContainer.style.setProperty('--rx', `${rx}deg`);
      treeContainer.style.setProperty('--rz', `${rz}deg`);
      
      if (autoSpinEnabled) {
        treeContainer.style.transform = `scale3d(${zoom}, ${zoom}, ${zoom})`;
        treeContainer.classList.add('auto-spin');
      } else {
        treeContainer.classList.remove('auto-spin');
        treeContainer.style.transform = `scale3d(${zoom}, ${zoom}, ${zoom}) rotateX(${rx}deg) rotateZ(${rz}deg)`;
      }
    }

    // ----------------------------------------------------
    // GEOMETRIC SOLID CHUNKY DOUGHNUT TOWER BUILDER
    // ----------------------------------------------------

    // Premium chunky dimensions
    const TOWER_THICKNESS = 30; // Premium thickness for extremely heavy solid look
    let towerSpacing = 45;      // Generous tier vertical spacing along the hollow core

    function renderTower() {
      // Clear existing blocks with highly optimized batch removal
      while (sunburstBase.firstChild) {
        sunburstBase.removeChild(sunburstBase.firstChild);
      }

      // Optimization: utilize a single DocumentFragment to trigger exactly ONE layout reflow!
      const fragment = document.createDocumentFragment();

      for (let g = 1; g <= 8; g++) {
        const totalSlices = Math.pow(2, g - 1);
        const Z_G = (8 - g) * towerSpacing; 
        const R_G = g * 28; 

        const alpha = 360 / totalSlices;
        const halfAlphaRad = (alpha / 2) * (Math.PI / 180);

        // Bypass mathematical singularities for G1 and G2
        let W_half;
        if (g === 1) {
          W_half = R_G; 
        } else if (g === 2) {
          W_half = R_G * 1.15; 
        } else {
          W_half = R_G * Math.tan(halfAlphaRad);
        }

        for (let i = 0; i < totalSlices; i++) {
          const ahnNum = totalSlices + i;
          const angle = alpha * i;

          const block = document.createElement('div');
          block.className = 'wedge-block-3d';
          block.setAttribute('data-ahn', ahnNum);
          block.setAttribute('data-gen', g);
          block.setAttribute('data-angle', angle);
          block.setAttribute('data-radius', R_G);
          block.setAttribute('data-z', Z_G);

          block.style.width = `${W_half * 2}px`;
          block.style.height = `${R_G}px`;
          block.style.left = `${250 - W_half}px`;
          block.style.top = `${250 - R_G}px`;
          block.style.transformOrigin = `50% 100%`;

          // Stacking height and local rotation
          block.style.setProperty('--default-transform', `translateZ(${Z_G}px) rotateZ(${angle}deg)`);
          block.style.transform = `translateZ(${Z_G}px) rotateZ(${angle}deg)`;

          const theme = getColorByAhnentafel(ahnNum);
          block.style.setProperty('--glow-color', theme.color);

          const person = activeAhnentafel[ahnNum];
          const hasPerson = !!person;

          let colorRGB = "110, 115, 130"; 
          if (hasPerson) {
            if (theme.color.includes('target')) colorRGB = "255, 183, 0";
            else if (theme.color.includes('pat-gf')) colorRGB = "0, 243, 255";
            else if (theme.color.includes('pat-gm')) colorRGB = "0, 245, 160";
            else if (theme.color.includes('mat-gf')) colorRGB = "160, 68, 255";
            else if (theme.color.includes('mat-gm')) colorRGB = "255, 0, 160";
          }
          block.style.setProperty('--color-rgb', colorRGB);

          // Face 1: Bottom Face
          const bottomFace = document.createElement('div');
          bottomFace.className = 'wedge-face bottom';
          bottomFace.style.width = '100%';
          bottomFace.style.height = '100%';
          if (g === 1) bottomFace.style.borderRadius = "50%";
          block.appendChild(bottomFace);

          // Face 2: Top Face
          const topFace = document.createElement('div');
          topFace.className = 'wedge-face top';
          topFace.style.width = '100%';
          topFace.style.height = '100%';
          topFace.style.transform = `translateZ(${TOWER_THICKNESS}px)`;
          if (g === 1) topFace.style.borderRadius = "50%";

          // Labels inside top faces
          if (hasPerson) {
            const label = document.createElement('div');
            label.className = 'hud-label';
            label.style.setProperty('--glow-color', theme.color);
            
            if (g <= 3) {
              label.textContent = person.name.split(' ')[0];
            } else if (g <= 5) {
              const parts = person.name.split(' ');
              const initials = parts.map(p => p[0]).join('').replace(/[^a-zA-Z]/g, '');
              label.textContent = initials.slice(0, 3);
            } else {
              label.textContent = ''; 
            }
            topFace.appendChild(label);
          }
          block.appendChild(topFace);

          // Face 3: Chunky Outer Wall (folded upright)
          if (g > 1) {
            const rim = document.createElement('div');
            rim.className = 'wedge-rim';
            rim.style.width = '100%';
            rim.style.height = `${TOWER_THICKNESS}px`;
            block.appendChild(rim);
          }

          block.addEventListener('click', (e) => {
            e.stopPropagation();
            selectWedge(block, ahnNum, R_G, Z_G, angle);
          });
          block.addEventListener('mouseenter', () => updateHUD(ahnNum));
          block.addEventListener('mouseleave', clearHUD);

          fragment.appendChild(block);
        }
      }

      sunburstBase.appendChild(fragment); // Render everything in exactly ONE reflow!
    }

    // ----------------------------------------------------
    // RADIAL FLY-OUT & NESTED ZPE PIP ACTIVATION
    // ----------------------------------------------------

    function selectNode(ahnNum) {
      const block = sunburstBase.querySelector(`.wedge-block-3d[data-ahn="${ahnNum}"]`);
      if (block) {
        const R_G = parseFloat(block.getAttribute('data-radius'));
        const Z_G = parseFloat(block.getAttribute('data-z'));
        const angle = parseFloat(block.getAttribute('data-angle'));
        selectWedge(block, ahnNum, R_G, Z_G, angle);
      }
    }

    function selectWedge(blockElement, ahnNum, R_G, Z_G, angle) {
      if (window.innerWidth <= 768) {
        closeSidebar();
      }

      // Reset the generation selection focus bar back to "All"
      const tierFocusBar = document.getElementById('tierFocusBar');
      if (tierFocusBar) {
        tierFocusBar.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active'));
        const btnAll = tierFocusBar.querySelector('.tier-btn[data-gen="all"]');
        if (btnAll) btnAll.classList.add('active');
      }

      // Animate camera back to 3D perspective to reveal vertical pipes
      rx = 62;
      autoSpinEnabled = false;
      btnToggleSpin.classList.remove('active');

      // Clear any dimmer/focused-tier classes to restore all levels back to perspective
      const allBlocks = sunburstBase.querySelectorAll('.wedge-block-3d');
      allBlocks.forEach(b => {
        b.classList.remove('dimmed', 'focused-tier');
        const originalZ = b.getAttribute('data-z');
        const originalAngle = b.getAttribute('data-angle');
        b.style.transform = `translateZ(${originalZ}px) rotateZ(${originalAngle}deg)`;
      });

      // Clear previous active states
      const activeBlocks = sunburstBase.querySelectorAll('.wedge-block-3d.active');
      activeBlocks.forEach(b => {
        b.classList.remove('active');
        const originalZ = b.getAttribute('data-z');
        const originalAngle = b.getAttribute('data-angle');
        b.style.transform = `translateZ(${originalZ}px) rotateZ(${originalAngle}deg)`;
      });

      // Add active state and trigger chunky radial fly-out drawer slide-out!
      blockElement.classList.add('active');
      const flyOutDistance = 45; 
      const liftHeight = 22;     
      blockElement.style.transform = `translateZ(${Z_G + liftHeight}px) rotateZ(${angle}deg) translateY(${-flyOutDistance}px)`;

      updateDetailPanel(ahnNum);
      updateHUD(ahnNum);

      // Append Pipe Window directly inside the clicked wedge block!
      blockElement.appendChild(pipeWindow);
      pipeWindow.style.display = 'block';
      
      // Pivot and shoot vertical ZPE conduits straight up from top face of flown-out drawer block
      pipeWindow.classList.remove('visible');
      pipeWindow.style.transform = `translateY(${-R_G / 2}px) translateZ(${TOWER_THICKNESS}px) rotateX(-90deg) scale3d(0.1, 0.1, 0.1)`;
      
      void pipeWindow.offsetWidth; // Force layout sync
      
      pipeWindow.classList.add('visible');
      pipeWindow.style.transform = `translateY(${-R_G / 2}px) translateZ(${TOWER_THICKNESS}px) rotateX(-90deg) scale3d(1, 1, 1)`;

      if (!isDragging) {
        autoSpinEnabled = false;
        btnToggleSpin.classList.remove('active');
        rz = -angle - 90;
        updateCamera();
      }

      const maxDepth = parseInt(maxPipeDepthSlider.value, 10);
      pipeWindow.innerHTML = ''; 

      buildBranchingTree(pipeWindow, ahnNum, 0, maxDepth, 0);
      showToast(`Chunky Radial Fly-Out for Ancestor #${ahnNum}`);
    }

    // ----------------------------------------------------
    // RECURSIVE HIERARCHICAL 3D BRANCH BUILDER
    // ----------------------------------------------------
    
    function buildBranchingTree(parentElement, ahnNum, currentDepth, maxDepth, cumulativeAngle) {
      if (currentDepth >= maxDepth) return;

      const person = activeAhnentafel[ahnNum];
      const hasPerson = !!person;
      const theme = getColorByAhnentafel(ahnNum);

      const segmentLength = Math.max(25, 95 * Math.pow(0.78, currentDepth));
      const segmentWidth = Math.max(1, 6 * Math.pow(0.72, currentDepth));
      const splitAngle = Math.max(5, 24 - currentDepth * 4); 

      const branchContainer = document.createElement('div');
      branchContainer.className = 'pipe-branch-node';
      branchContainer.style.height = `${segmentLength}px`;
      branchContainer.style.setProperty('--node-color', theme.color);

      let localAngle = 0;
      if (currentDepth > 0) {
        localAngle = (ahnNum % 2 === 0) ? -splitAngle : splitAngle;
      }
      
      branchContainer.style.setProperty('--local-angle', `${localAngle}deg`);
      branchContainer.style.setProperty('--delay', `${currentDepth * 0.16}s`);

      const connectorLine = document.createElement('div');
      connectorLine.className = 'pipe-connector-line';
      connectorLine.style.width = `${segmentWidth}px`;
      connectorLine.style.height = `${segmentLength}px`;
      connectorLine.style.setProperty('--line-color', theme.color);
      branchContainer.appendChild(connectorLine);

      // Orbital stabilizing collar
      const energyRing = document.createElement('div');
      energyRing.className = 'energy-ring';
      const ringSize = Math.max(18, 48 - currentDepth * 6); 
      energyRing.style.width = `${ringSize}px`;
      energyRing.style.height = `${ringSize}px`;
      energyRing.style.setProperty('--node-color', theme.color);
      branchContainer.appendChild(energyRing);

      const nodeDot = document.createElement('div');
      nodeDot.className = 'pipe-ancestor-dot';
      nodeDot.style.top = '0px'; 
      nodeDot.style.left = '50%';
      
      const label = document.createElement('div');
      label.className = 'pipe-branch-label';
      label.style.setProperty('--node-color', theme.color);
      label.textContent = hasPerson ? person.name.split(' ')[0] : `Unknown`;
      
      const parentTotAngle = cumulativeAngle + localAngle;
      label.style.transform = `rotateZ(${-parentTotAngle}deg)`;
      
      nodeDot.appendChild(label);
      branchContainer.appendChild(nodeDot);

      nodeDot.addEventListener('click', (e) => {
        e.stopPropagation();
        selectNode(ahnNum);
      });
      nodeDot.addEventListener('mouseenter', () => updateHUD(ahnNum));
      nodeDot.addEventListener('mouseleave', clearHUD);

      const childrenBox = document.createElement('div');
      childrenBox.className = 'pipe-children-container';
      childrenBox.style.transform = `translate3d(0, -${segmentLength}px, 0)`; 

      buildBranchingTree(childrenBox, ahnNum * 2, currentDepth + 1, maxDepth, parentTotAngle);
      buildBranchingTree(childrenBox, ahnNum * 2 + 1, currentDepth + 1, maxDepth, parentTotAngle);

      branchContainer.appendChild(childrenBox);
      parentElement.appendChild(branchContainer);
    }

    // ----------------------------------------------------
    // TIER DOUGHNUT FOCUS LOGIC & TILT TRANSITIONS
    // ----------------------------------------------------

    const tierFocusBar = document.getElementById('tierFocusBar');
    if (tierFocusBar) {
      tierFocusBar.addEventListener('click', (e) => {
        const btn = e.target.closest('.tier-btn');
