<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AETHERIS: Highly Optimized 3D Ahnentafel Doughnut & ZPE Module</title>
  <style>
    :root {
      --bg-color: #020205;
      --bg-gradient: radial-gradient(circle at center, #060612 0%, #010103 100%);
      --panel-bg: rgba(6, 8, 16, 0.82);
      --panel-border: rgba(0, 243, 255, 0.12);
      --text-main: #f0f4f8;
      --text-muted: #7e94b2;
      
      /* Lineage Quadrant Glowing Colors */
      --color-target: #ffb700;
      --color-pat-gf: #00f3ff; /* Paternal Grandfather - Electric Cyan */
      --color-pat-gm: #00f5a0; /* Paternal Grandmother - Neon Green/Teal */
      --color-mat-gf: #a044ff; /* Maternal Grandfather - Biotech Purple */
      --color-mat-gm: #ff00a0; /* Maternal Grandmother - Hot Pink */
      --color-unknown: #424a61;
      --color-active: #00ff66;
      
      --font-sans: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      background-image: var(--bg-gradient);
      color: var(--text-main);
      font-family: var(--font-sans);
      height: 100vh;
      overflow: hidden;
      display: flex;
    }

    /* ----------------------------------------------------
       LAYOUT: SIDEBAR CONTROL PANEL
       ---------------------------------------------------- */
    .sidebar {
      width: 420px;
      height: 100vh;
      background: var(--panel-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--panel-border);
      display: flex;
      flex-direction: column;
      z-index: 10;
      box-shadow: 10px 0 35px rgba(0, 0, 0, 0.6);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-header {
      padding: 24px;
      border-bottom: 1px solid var(--panel-border);
      position: relative;
    }

    .logo-container {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 6px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      stroke: var(--color-pat-gf);
      fill: none;
      filter: drop-shadow(0 0 8px var(--color-pat-gf));
    }

    h1 {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      background: linear-gradient(135deg, #fff 0%, var(--color-pat-gf) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 15px rgba(0, 243, 255, 0.25);
    }

    .subtitle {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .sidebar-content {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Webkit scrollbar optimizations */
    .sidebar-content::-webkit-scrollbar, .pedigree-list::-webkit-scrollbar {
      width: 5px;
    }
    .sidebar-content::-webkit-scrollbar-track, .pedigree-list::-webkit-scrollbar-track {
      background: rgba(0,0,0,0.1);
    }
    .sidebar-content::-webkit-scrollbar-thumb, .pedigree-list::-webkit-scrollbar-thumb {
      background: rgba(0, 243, 255, 0.15);
      border-radius: 3px;
    }
    .sidebar-content::-webkit-scrollbar-thumb:hover, .pedigree-list::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 243, 255, 0.3);
    }

    .panel-section {
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 12px;
      padding: 16px;
    }

    .section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--color-pat-gf);
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
    }

    .file-input-wrapper {
      position: relative;
      width: 100%;
      margin-bottom: 10px;
    }

    .file-input {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 16px;
      background: rgba(0, 243, 255, 0.05);
      border: 1px solid rgba(0, 243, 255, 0.2);
      border-radius: 8px;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .btn:hover {
      background: rgba(0, 243, 255, 0.12);
      border-color: rgba(0, 243, 255, 0.45);
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.18);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.18);
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-group:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    select, input[type="text"] {
      width: 100%;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      color: #fff;
      padding: 8px 12px;
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
    }

    select:focus, input[type="text"]:focus {
      border-color: var(--color-pat-gf);
    }

    input[type="range"] {
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      padding: 0;
      background: rgba(255, 255, 255, 0.08);
      border: none;
      border-radius: 3px;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-pat-gf);
      box-shadow: 0 0 8px var(--color-pat-gf);
      transition: transform 0.1s;
    }

    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.25);
    }

    .slider-container {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .slider-val {
      font-size: 11px;
      font-family: monospace;
      color: var(--text-muted);
      width: 38px;
      text-align: right;
    }

    /* ----------------------------------------------------
       UX FOCUS: DOUGHNUT TIER SELECTOR BAR
       ---------------------------------------------------- */
    .tier-focus-container {
      display: grid;
      grid-template-columns: repeat(9, 1fr);
      gap: 4px;
      margin-top: 6px;
    }

    .tier-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-muted);
      padding: 6px 0;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
    }

    .tier-btn:hover {
      background: rgba(0, 243, 255, 0.08);
      border-color: rgba(0, 243, 255, 0.25);
      color: #fff;
    }

    .tier-btn.active {
      background: rgba(0, 243, 255, 0.14);
      border-color: var(--color-pat-gf);
      color: #fff;
      box-shadow: 0 0 10px rgba(0, 243, 255, 0.22);
    }

    /* Color Legends */
    .legend-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .legend-color {
      width: 10px;
      height: 10px;
      border-radius: 3px;
    }

    /* Full Pedigree search lists */
    .pedigree-list {
      max-height: 220px;
      overflow-y: auto;
      border: 1px solid rgba(255, 255, 255, 0.04);
      background: rgba(0, 0, 0, 0.15);
      border-radius: 6px;
    }

    .list-item {
      padding: 8px 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.02);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.2s;
    }

    .list-item:hover {
      background: rgba(0, 243, 255, 0.04);
    }

    .list-item-name {
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 250px;
    }

    .list-item-num {
      font-family: monospace;
      font-size: 10px;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      padding: 1px 5px;
      border-radius: 4px;
    }

    /* ----------------------------------------------------
       3D VIEWPORT CANVAS SPACE
       ---------------------------------------------------- */
    .viewport {
      flex: 1;
      height: 100vh;
      position: relative;
      outline: none;
    }

    .scene {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1200px;
      overflow: hidden;
      cursor: grab;
    }

    .scene:active {
      cursor: grabbing;
    }

    /* Starry holographic floors */
    .grid-floor {
      position: absolute;
      width: 2600px;
      height: 2600px;
      top: 50%;
      left: 50%;
      margin-left: -1300px;
      margin-top: -1300px;
      background-image: 
        linear-gradient(rgba(0, 243, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 243, 255, 0.035) 1px, transparent 1px);
      background-size: 60px 60px;
      background-position: center;
      transform: rotateX(90deg) translateZ(-340px);
      transform-style: preserve-3d;
      pointer-events: none;
      mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 65%);
      -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 65%);
    }

    .radial-glow {
      position: absolute;
      width: 800px;
      height: 800px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 243, 255, 0.04) 0%, rgba(0,0,0,0) 70%);
      pointer-events: none;
      transform: translate3d(0, 0, -330px);
    }

    /* 3D Platform rotating container */
    .tree-container {
      position: relative;
      width: 500px;
      height: 500px;
      transform-style: preserve-3d;
      transform: rotateX(65deg) rotateZ(0deg);
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tree-container.auto-spin {
      animation: spinPlatform 45s linear infinite;
    }

    @keyframes spinPlatform {
      from { transform: rotateX(var(--rx, 65deg)) rotateZ(var(--rz, 0deg)); }
      to { transform: rotateX(var(--rx, 65deg)) rotateZ(calc(var(--rz, 0deg) + 360deg)); }
    }

    /* ----------------------------------------------------
       3D SOLID DOUGHNUT WEDGE GEOMETRY (PREMIUM CHUNKY)
       ---------------------------------------------------- */
    .wedge-block-3d {
      position: absolute;
      transform-style: preserve-3d;
      cursor: pointer;
      transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.15), filter 0.3s, opacity 0.4s ease;
      filter: brightness(0.7) drop-shadow(0 0 2px rgba(0,0,0,0.4));
    }

    .wedge-block-3d:hover {
      filter: brightness(1.25) drop-shadow(0 0 15px var(--glow-color));
    }

    /* Dimming of inactive tiers in doughnut focus mode */
    .wedge-block-3d.dimmed {
      opacity: 0.12 !important;
      filter: brightness(0.3) saturate(0.4) grayscale(0.5);
      pointer-events: none;
    }

    .wedge-block-3d.focused-tier {
      opacity: 1 !important;
      filter: brightness(1.3) drop-shadow(0 0 20px var(--glow-color));
    }

    /* Highly Optimized Frosted Neon Glass Prism Faces */
    .wedge-face {
      position: absolute;
      transform-style: preserve-3d;
      backface-visibility: hidden; /* Optimization: avoids redundant double render */
      
      /* Doughnut Wedge Tapered Trapezoid leaving a clean 35% center hole */
      clip-path: polygon(32.5% 65%, 0% 0%, 100% 0%, 67.5% 65%);
      background: radial-gradient(ellipse at bottom, 
        rgba(var(--color-rgb), 0.16) 0%, 
        rgba(var(--color-rgb), 0.45) 100%
      );
      border: 1.5px solid rgba(var(--color-rgb), 0.72);
      box-shadow: 
        0 0 10px rgba(var(--color-rgb), 0.25),
        inset 0 0 10px rgba(var(--color-rgb), 0.2);
    }

    .wedge-face.bottom {
      transform: translateZ(0px);
    }

    .wedge-face.top {
      /* translateZ is set dynamically to TOWER_THICKNESS in JS */
    }

    /* Outer cylindrical rim wall block connector */
    .wedge-rim {
      position: absolute;
      transform-style: preserve-3d;
      backface-visibility: hidden;
      background: linear-gradient(to top, 
        rgba(var(--color-rgb), 0.35) 0%, 
        rgba(var(--color-rgb), 0.7) 100%
      );
      border: 1.5px solid rgba(var(--color-rgb), 0.82);
      box-shadow: 
        0 0 12px rgba(var(--color-rgb), 0.3),
        inset 0 0 6px rgba(255, 255, 255, 0.22);
      transform-origin: 50% 0%;
      transform: rotateX(-90deg); /* Fold upright */
    }

    /* Active Highlight States during Radial Drawer Fly-Out */
    .wedge-block-3d.active .wedge-face {
      background: radial-gradient(ellipse at bottom, 
        rgba(0, 255, 102, 0.25) 0%, 
        rgba(0, 255, 102, 0.6) 100%
      ) !important;
      border-color: #00ff66 !important;
      box-shadow: 
        0 0 15px rgba(0, 255, 102, 0.5),
        inset 0 0 10px rgba(0, 255, 102, 0.4) !important;
    }

    .wedge-block-3d.active .wedge-rim {
      background: linear-gradient(to top, 
        rgba(0, 255, 102, 0.4) 0%, 
        rgba(0, 255, 102, 0.8) 100%
      ) !important;
      border-color: #00ff66 !important;
      box-shadow: 0 0 18px rgba(0, 255, 102, 0.6) !important;
    }

    /* Horizontal text labels positioned inside the doughnut wedge tops */
    .hud-label {
      position: absolute;
      color: #fff;
      font-weight: 700;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      pointer-events: none;
      text-align: center;
      width: 100%;
      bottom: 22px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.9), 0 0 5px var(--glow-color);
    }

    /* ----------------------------------------------------
       THE 3D ZERO POINT ENERGY MODULE (ZPE BRANCHES)
       ---------------------------------------------------- */
    .pipe-window {
      position: absolute;
      top: 100%; /* Centered radially relative to the center of the torus */
      left: 50%;
      transform-style: preserve-3d;
      pointer-events: none;
      display: none;
      opacity: 0;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
    }

    .pipe-window.visible {
      opacity: 1;
    }

    .pipe-branch-node {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform-origin: 50% 100%;
      transform-style: preserve-3d;
      pointer-events: auto;
      
      /* Staggered unfolding animation */
      animation: unfoldZPE 0.8s cubic-bezier(0.25, 1, 0.5, 1) both;
      animation-delay: var(--delay);
    }

    @keyframes unfoldZPE {
      0% {
        opacity: 0;
        transform: rotateZ(var(--local-angle)) scale3d(0, 0, 0);
        filter: brightness(3);
      }
      40% {
        opacity: 0.5;
        filter: brightness(2);
      }
      100% {
        opacity: 1;
        transform: rotateZ(var(--local-angle)) scale3d(1, 1, 1);
        filter: brightness(1);
      }
    }

    /* Glowing fiber-optic conduits */
    .pipe-connector-line {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      transform-style: preserve-3d;
      background: linear-gradient(to top, 
        rgba(255, 255, 255, 0.05) 0%, 
        rgba(255, 255, 255, 0.25) 20%, 
        var(--line-color) 50%, 
        rgba(255, 255, 255, 0.8) 85%, 
        #ffffff 100%
      );
      border-radius: 4px;
      box-shadow: 
        0 0 10px var(--line-color), 
        0 0 20px var(--line-color), 
        inset 0 0 4px #ffffff;
      opacity: 0.9;
    }

    .pipe-connector-line::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 35px;
      background: linear-gradient(to top, transparent, #ffffff 50%, transparent);
      bottom: 0;
      left: 0;
      opacity: 0.9;
      animation: pulseZPE 1.8s infinite linear;
      box-shadow: 0 0 15px #ffffff;
    }

    @keyframes pulseZPE {
      0% { bottom: -20%; opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { bottom: 110%; opacity: 0; }
    }

    /* Orbital ZPE magnetic stabilizing collars */
    .energy-ring {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translate3d(-50%, -50%, 0) rotateX(90deg); /* Lies flat horizontally! */
      transform-style: preserve-3d;
      border: 1.5px solid var(--node-color);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, rgba(0, 0, 0, 0.45) 100%);
      box-shadow: 
        0 0 12px var(--node-color), 
        inset 0 0 12px var(--node-color);
      pointer-events: none;
      animation: rotateRing 4s linear infinite, hoverRing 2s ease-in-out infinite alternate;
    }

    @keyframes rotateRing {
      0% { transform: translate3d(-50%, -50%, 0) rotateX(90deg) rotateZ(0deg); }
      100% { transform: translate3d(-50%, -50%, 0) rotateX(90deg) rotateZ(360deg); }
    }

    @keyframes hoverRing {
      0% { margin-top: -3px; filter: brightness(0.85); }
      100% { margin-top: 3px; filter: brightness(1.2); }
    }

    .pipe-ancestor-dot {
      position: absolute;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #000;
      border: 2px solid var(--node-color);
      transform: translate3d(-50%, -50%, 5px);
      cursor: pointer;
      box-shadow: 0 0 10px var(--node-color);
      transition: all 0.3s;
      z-index: 10;
    }

    .pipe-ancestor-dot:hover {
      width: 18px;
      height: 18px;
      background: var(--node-color);
      box-shadow: 0 0 20px #fff, 0 0 12px var(--node-color);
      transform: translate3d(-50%, -50%, 15px) scale(1.2);
    }

    .pipe-branch-label {
      position: absolute;
      left: 18px;
      top: -6px;
      white-space: nowrap;
      font-size: 10px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.95);
      background: rgba(4, 5, 12, 0.85);
      padding: 2px 8px;
      border-radius: 4px;
      border: 1px solid var(--node-color);
      pointer-events: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    }

    .pipe-children-container {
      position: absolute;
      top: 0;
      left: 50%;
      transform-style: preserve-3d;
      width: 0;
      height: 0;
    }

    /* ----------------------------------------------------
       HUD OVERLAYS & SCENE BUTTONS
       ---------------------------------------------------- */
    .viewport-controls {
      position: absolute;
      right: 24px;
      top: 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 8;
    }

    .control-btn {
      width: 44px;
      height: 44px;
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 10px;
      color: #fff;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.2s;
    }

    .control-btn:hover {
      background: rgba(0, 243, 255, 0.12);
      border-color: rgba(0, 243, 255, 0.4);
      color: var(--color-pat-gf);
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
    }

    .control-btn.active {
      background: rgba(0, 255, 102, 0.1);
      border-color: rgba(0, 255, 102, 0.4);
      color: #00ff66;
    }

    .floating-hud {
      position: absolute;
      bottom: 24px;
      right: 24px;
      width: 320px;
      background: var(--panel-bg);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      padding: 16px;
      z-index: 8;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      pointer-events: none;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .floating-hud.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .floating-hud-header {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--color-active);
      margin-bottom: 6px;
      font-weight: 700;
    }

    .details-card {
      border-left: 3px solid var(--color-pat-gf);
      padding-left: 12px;
    }

    .details-name {
      font-size: 16px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }

    .details-meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
      line-height: 1.4;
    }

    .details-stats {
      font-size: 11px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      background: rgba(0, 0, 0, 0.2);
      padding: 8px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .hidden {
      display: none !important;
    }

    .toast {
      position: absolute;
      top: 24px;
      left: calc(50% + 210px);
      transform: translateX(-50%) translateY(-50px);
      background: rgba(8, 12, 24, 0.92);
      border: 1px solid #00ff66;
      border-radius: 8px;
      padding: 12px 24px;
      color: #fff;
