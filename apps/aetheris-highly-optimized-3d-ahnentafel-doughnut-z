          if (baseDeathYear <= 2026) {
            ddate = `12 OCT ${baseDeathYear}`;
            dplace = locations[(n + 5) % locations.length];
          }
        }

        gedcomLines.push(`0 @I${n}@ INDI`);
        gedcomLines.push(`1 NAME ${name}`);
        gedcomLines.push(`1 SEX ${sex}`);
        gedcomLines.push("1 BIRT");
        gedcomLines.push(`2 DATE ${bdate}`);
        gedcomLines.push(`2 PLAC ${bplace}`);
        
        if (ddate) {
          gedcomLines.push("1 DEAT");
          gedcomLines.push(`2 DATE ${ddate}`);
          gedcomLines.push(`2 PLAC ${dplace}`);
        }
        
        if (n > 1) {
          const parentFamId = Math.floor(n / 2);
          gedcomLines.push(`1 FAMC @F${parentFamId}@`);
        }
      }

      for (let n = 1; n <= 127; n++) {
        gedcomLines.push(`0 @F${n}@ FAM`);
        gedcomLines.push(`1 HUSB @I${n * 2}@`);
        gedcomLines.push(`1 WIFE @I${n * 2 + 1}@`);
        gedcomLines.push(`1 CHIL @I${n}@`);
      }

      return gedcomLines.join("\n");
    }

    // ----------------------------------------------------
    // STATE & VIEWPORT CAMERA MANAGEMENT
