                mCtx.fillRect(0, 0, width, height);
                mCtx.strokeStyle = 'rgba(0, 255, 204, 0.1)';
                mCtx.lineWidth = 1;
                
                // Vertical lines
                for (let x = 0; x < width; x += 40) {
                    mCtx.beginPath();
                    mCtx.moveTo(x, 0);
                    mCtx.lineTo(x, height);
                    mCtx.stroke();
                }
                // Horizontal lines
                for (let y = 0; y < height; y += 40) {
                    mCtx.beginPath();
                    mCtx.moveTo(0, y);
                    mCtx.lineTo(width, y);
                    mCtx.stroke();
