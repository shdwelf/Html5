                pos: "noun",
                definition: "An early internet document search and retrieval protocol designed as an alternative to the World Wide Web.",
                origin: "University of Minnesota"
            }
        };
    }

    async lookup(word, protocol) {
        const clean = word.toLowerCase().trim();
        if (protocol === "Wikipedia API") {
            try {
                const res = await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(clean)}`);
                if (res.ok) {
                    const data = await res.json();
                    return {
