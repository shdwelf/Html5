// Enso Zen Art Canvas Generator
class EnsoGenerator {
    constructor(canvasId) {
        this.canvas = document.getElementById(canvasId);
        if (this.canvas) {
            this.ctx = this.canvas.getContext('2d');
        }
        // Core default parameters requested by user
        this.params = {
            inkLoad: 4,               // Out of 10
            direction: "Clockwise",   // "Clockwise" or "Counter-Clockwise"
            paperHue: "Cyan",         // Cyan, Monochrome, Sepia, Crimson
            brushSize: 6,             // Scale multiplier
            inkDensity: 3,            // Alpha density
            stretch: "Unequal",       // Equal (perfect circle) or Unequal (oval)
            paperTexture: 4,          // Noise level
            bristleDensity: 5,        // Splatter & hair line details
            signatureStyle: "Dark",   // Red/Dark Seal
            brushstrokeSize: "Medium",// Brush thickness range
            brushstrokeStartRot: 216  // Initial angle offset
        };
        this.seed = Math.floor(Math.random() * 1000000);
    }

    setParamsFromEnsogen(num) {
        // Deterministically decode a 10-digit ensogen ID number into exact variables
        const str = String(num).padStart(10, '0');
        this.params.inkLoad = parseInt(str[0]) || 4;
        this.params.direction = parseInt(str[1]) % 2 === 0 ? "Clockwise" : "Counter-Clockwise";
        const hues = ["Cyan", "Monochrome", "Sepia", "Crimson", "Emerald"];
        this.params.paperHue = hues[parseInt(str[2]) % hues.length] || "Cyan";
        this.params.brushSize = parseInt(str[3]) || 6;
        this.params.inkDensity = parseInt(str[4]) || 3;
        this.params.stretch = parseInt(str[5]) % 2 === 0 ? "Unequal" : "Equal";
        this.params.paperTexture = parseInt(str[6]) || 4;
        this.params.bristleDensity = parseInt(str[7]) || 5;
        this.params.signatureStyle = parseInt(str[8]) % 2 === 0 ? "Dark" : "Scarlet";
        this.params.brushstrokeStartRot = (parseInt(str[9]) * 36) || 216;
        this.seed = num;
    }

    generateEnsogen() {
        // Generate valid 10 digit ID
        let numStr = "";
        numStr += Math.floor(Math.random() * 9 + 1); // no leading zero
        for (let i = 0; i < 9; i++) {
            numStr += Math.floor(Math.random() * 10);
        }
        return parseInt(numStr);
    }

    // Custom deterministic randomizer using the seed
    random() {
        let x = Math.sin(this.seed++) * 10000;
        return x - Math.floor(x);
    }

    draw() {
        if (!this.canvas || !this.ctx) return;
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;
        ctx.clearRect(0, 0, w, h);

        // Draw Paper Texture Background
        let paperColor = "#121b22"; // Default Cyan hue
        if (this.params.paperHue === "Monochrome") paperColor = "#1a1a1a";
        else if (this.params.paperHue === "Sepia") paperColor = "#261e14";
        else if (this.params.paperHue === "Crimson") paperColor = "#240d12";
        else if (this.params.paperHue === "Emerald") paperColor = "#0d2218";

        ctx.fillStyle = paperColor;
        ctx.fillRect(0, 0, w, h);

        // Add Paper Texture Noise lines
        ctx.strokeStyle = "rgba(255,255,255,0.03)";
        ctx.lineWidth = 1;
        const textureLines = this.params.paperTexture * 15;
        for (let i = 0; i < textureLines; i++) {
            ctx.beginPath();
            const y = this.random() * h;
            ctx.moveTo(0, y);
            ctx.lineTo(w, y + (this.random() - 0.5) * 20);
            ctx.stroke();
        }

        // Draw the main Zen Circle (Ensō)
        const cx = w / 2;
        const cy = h / 2;
        const rX = 80 + this.params.brushSize * 6;
        const rY = this.params.stretch === "Unequal" ? rX * 0.82 : rX;

        ctx.lineCap = "round";
        const totalBristles = this.params.bristleDensity * 12;
        const startRad = (this.params.brushstrokeStartRot * Math.PI) / 180;
        const dirFactor = this.params.direction === "Clockwise" ? 1 : -1;

        // Draw multiple overlapping ink bristles paths
        for (let b = 0; b < totalBristles; b++) {
            const offsetDist = (this.random() - 0.5) * (this.params.brushSize * 3);
            const bristleOpacity = (this.params.inkDensity / 10) * (0.3 + this.random() * 0.4);
            ctx.strokeStyle = `rgba(0, 255, 204, ${bristleOpacity})`;
            if (this.params.paperHue === "Crimson") ctx.strokeStyle = `rgba(255, 0, 85, ${bristleOpacity})`;
            if (this.params.paperHue === "Sepia") ctx.strokeStyle = `rgba(244, 164, 96, ${bristleOpacity})`;
            ctx.lineWidth = 1 + this.random() * 2;

            ctx.beginPath();
            const startAngle = startRad + (this.random() - 0.5) * 0.2;
            const endAngle = startAngle + (Math.PI * 1.85 * dirFactor) + (this.random() - 0.5) * 0.3;

            const steps = 120;
            for (let s = 0; s <= steps; s++) {
                const t = s / steps;
                // Fade out ink as brush stroke progresses (Ink Load impact)
                const currentLoad = (1.0 - t) * (this.params.inkLoad / 5);
                if (currentLoad < 0.1 && this.random() > currentLoad) continue; // broken ink effect

                const angle = startAngle + (endAngle - startAngle) * t;
                const rx = rX + offsetDist + (this.random() - 0.5) * 3;
                const ry = rY + offsetDist + (this.random() - 0.5) * 3;
                const x = cx + Math.cos(angle) * rx;
                const y = cy + Math.sin(angle) * ry;

                if (s === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }

        // Add Splatters
        const splatters = this.params.inkLoad * 5;
        for (let i = 0; i < splatters; i++) {
            const angle = this.random() * Math.PI * 2;
            const dist = rX + (this.random() - 0.5) * 40;
            const x = cx + Math.cos(angle) * dist;
            const y = cy + Math.sin(angle) * dist;
            const size = this.random() * 3;

            ctx.fillStyle = this.params.paperHue === "Crimson" ? "rgba(255,0,85,0.4)" : "rgba(0,255,204,0.4)";
            ctx.beginPath();
            ctx.arc(x, y, size, 0, Math.PI * 2);
            ctx.fill();
        }

        // Draw Artist signature seal stamp
        const sealX = w - 60;
        const sealY = h - 60;
        ctx.fillStyle = this.params.signatureStyle === "Dark" ? "#1a080a" : "#ff0055";
        ctx.strokeStyle = "#ff0055";
        ctx.lineWidth = 2;
        ctx.fillRect(sealX, sealY, 30, 30);
        ctx.strokeRect(sealX, sealY, 30, 30);

        // Zen glyph inside stamp
        ctx.fillStyle = "#fff";
        ctx.font = "bold 14px monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("禅", sealX + 15, sealY + 15);
    }

    exportPNG() {
        return this.canvas.toDataURL("image/png");
    }

    exportSVG() {
        const w = this.canvas.width;
        const h = this.canvas.height;
        let paperColor = "#121b22";
        if (this.params.paperHue === "Monochrome") paperColor = "#1a1a1a";
        else if (this.params.paperHue === "Sepia") paperColor = "#261e14";
        else if (this.params.paperHue === "Crimson") paperColor = "#240d12";
        else if (this.params.paperHue === "Emerald") paperColor = "#0d2218";

        const strokeColor = this.params.paperHue === "Crimson" ? "#ff0055" : "#00ffcc";
        const svg = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}">
            <rect width="100%" height="100%" fill="${paperColor}"/>
            <circle cx="${w/2}" cy="${h/2}" r="${w/3.5}" stroke="${strokeColor}" stroke-width="${this.params.brushSize * 2}" fill="none" opacity="0.85" stroke-dasharray="400, 100"/>
            <rect x="${w - 60}" y="${h - 60}" width="30" height="30" fill="#ff0055" stroke="#fff" stroke-width="1"/>
            <text x="${w - 45}" y="${h - 40}" fill="#fff" font-family="monospace" font-size="12" text-anchor="middle">ZEN</text>
        </svg>
        `;
        return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
    }
}

window.EnsoGenerator = EnsoGenerator;

