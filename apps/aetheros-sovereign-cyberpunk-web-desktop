            });
        }

        // Populate Flying Chrome Toasters & Slices of Toast
        this.toasters = [];
        for (let i = 0; i < 8; i++) {
            this.toasters.push({
                x: Math.random() * w + w,
                y: Math.random() * h - 50,
                speed: Math.random() * 1.5 + 1.2,
                flapState: Math.floor(Math.random() * 4),
                size: Math.random() * 15 + 25
            });
        }

        this.toast = [];
        for (let i = 0; i < 6; i++) {
            this.toast.push({
                x: Math.random() * w + w,
                y: Math.random() * h - 50,
                speed: Math.random() * 1.2 + 0.8,
                size: Math.random() * 10 + 20,
                rot: Math.random() * Math.PI * 2,
                rotSpeed: (Math.random() - 0.5) * 0.05
            });
        }
    }

    draw() {
        if (!this.canvas || !this.ctx) return;
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;

        // Render black background
        ctx.fillStyle = "#000";
        ctx.fillRect(0, 0, w, h);

        // Draw background stars
        ctx.fillStyle = "#fff";
        this.stars.forEach(s => {
            ctx.fillRect(s.x, s.y, s.size, s.size);
            s.x -= s.speed;
            if (s.x < 0) s.x = w;
        });

        // Draw Slices of Toast (Brown squares rotating diagonally)
        this.toast.forEach(t => {
            ctx.save();
            ctx.translate(t.x, t.y);
            ctx.rotate(t.rot);

            // Toast body
            ctx.fillStyle = "#d2b48c"; // Tan
            ctx.fillRect(-t.size / 2, -t.size / 2, t.size, t.size);
            ctx.strokeStyle = "#8b4513"; // Brown outline
            ctx.lineWidth = 2;
            ctx.strokeRect(-t.size / 2, -t.size / 2, t.size, t.size);

            // Toast crust top hump
            ctx.fillStyle = "#8b4513";
            ctx.beginPath();
            ctx.arc(-t.size / 4, -t.size / 2, t.size / 3, Math.PI, 0);
            ctx.arc(t.size / 4, -t.size / 2, t.size / 3, Math.PI, 0);
            ctx.fill();

            ctx.restore();

            // Diagonal movement: top-right to bottom-left
            t.x -= t.speed;
            t.y += t.speed * 0.6;
            t.rot += t.rotSpeed;

            // Reset when off screen
            if (t.x < -40 || t.y > h + 40) {
                t.x = w + Math.random() * 100;
                t.y = Math.random() * h - 100;
            }
        });

        // Draw Chrome winged Toasters (White wings flapping)
        this.toasters.forEach(t => {
            ctx.save();
            ctx.translate(t.x, t.y);

            // Toaster Body
            ctx.fillStyle = "#c0c0c0"; // Silver body
            ctx.fillRect(-t.size / 2, -t.size / 3, t.size, t.size * 0.7);
            ctx.strokeStyle = "#fff";
            ctx.lineWidth = 1;
            ctx.strokeRect(-t.size / 2, -t.size / 3, t.size, t.size * 0.7);

            // Tiny bread slots
            ctx.fillStyle = "#404040";
            ctx.fillRect(-t.size / 3, -t.size / 3 - 2, t.size * 0.2, 3);
            ctx.fillRect(t.size / 10, -t.size / 3 - 2, t.size * 0.2, 3);

            // Tiny toaster lever handle
            ctx.fillStyle = "#808080";
            ctx.fillRect(t.size / 2, -5, 4, 6);

            // Wings flapping animation
            ctx.fillStyle = "rgba(255, 255, 255, 0.85)";
            ctx.strokeStyle = "#fff";
            ctx.beginPath();
            if (t.flapState === 0) {
                // Wings Up
                ctx.moveTo(-t.size / 5, -t.size / 3);
                ctx.quadraticCurveTo(-t.size * 0.8, -t.size, -t.size * 0.3, -t.size * 0.9);
                ctx.lineTo(-t.size / 5, -t.size / 3);
            } else if (t.flapState === 1) {
                // Wings horizontal
                ctx.moveTo(-t.size / 5, -t.size / 3);
                ctx.quadraticCurveTo(-t.size * 0.9, -t.size / 2, -t.size * 0.7, -t.size / 3);
                ctx.lineTo(-t.size / 5, -t.size / 3);
            } else if (t.flapState === 2) {
                // Wings Down
                ctx.moveTo(-t.size / 5, -t.size / 3);
                ctx.quadraticCurveTo(-t.size * 0.6, t.size * 0.4, -t.size * 0.3, t.size * 0.1);
                ctx.lineTo(-t.size / 5, -t.size / 3);
            } else {
                // Alternate frame
                ctx.moveTo(-t.size / 5, -t.size / 3);
                ctx.quadraticCurveTo(-t.size * 0.8, -t.size * 0.6, -t.size * 0.5, -t.size * 0.8);
                ctx.lineTo(-t.size / 5, -t.size / 3);
            }
            ctx.fill();
            ctx.stroke();

            ctx.restore();

            // Slide left and down
            t.x -= t.speed;
            t.y += t.speed * 0.5;

            // Simple Wing Flapping rate controller
            if (Math.random() < 0.15) {
                t.flapState = (t.flapState + 1) % 4;
            }

            // Reset when off screen
            if (t.x < -50 || t.y > h + 50) {
                t.x = w + Math.random() * 100;
                t.y = Math.random() * h - 100;
            }
        });
    }
}

