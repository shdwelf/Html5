// GEDCOM Genealogy file parser & Family Tree SVG Layout
class GedcomViewer {
    constructor() {
        this.individuals = {};
        this.families = {};
        this.events = [];
    }

    parse(gedcomText) {
        this.individuals = {};
        this.families = {};
        this.events = [];

        const lines = gedcomText.split("\n");
        let currentIndiId = null;
        let currentFamId = null;
        let currentEvent = null;

        for (let line of lines) {
            line = line.trim();
            if (!line) continue;

            const parts = line.split(" ");
            const level = parts[0];
            const tagOrId = parts[1];
            const value = parts.slice(2).join(" ");

            // Individual matching
            if (level === "0" && value === "INDI") {
                currentIndiId = tagOrId.replace(/@/g, "");
                currentFamId = null;
                this.individuals[currentIndiId] = { id: currentIndiId, name: "Unknown", gender: "M", birth: "", death: "", families: [] };
            } 
            // Family matching
            else if (level === "0" && value === "FAM") {
                currentFamId = tagOrId.replace(/@/g, "");
                currentIndiId = null;
                this.families[currentFamId] = { id: currentFamId, husband: null, wife: null, children: [] };
            } 
            // Attributes parsing
            else if (currentIndiId) {
                const person = this.individuals[currentIndiId];
                if (tagOrId === "NAME") {
                    person.name = value;
                } else if (tagOrId === "SEX") {
                    person.gender = value;
                } else if (tagOrId === "BIRT") {
                    currentEvent = { type: "Birth", personId: currentIndiId, date: "", place: "" };
                    this.events.push(currentEvent);
                } else if (tagOrId === "DEAT") {
                    currentEvent = { type: "Death", personId: currentIndiId, date: "", place: "" };
                    this.events.push(currentEvent);
                } else if (currentEvent && tagOrId === "DATE") {
                    currentEvent.date = value;
                    if (currentEvent.type === "Birth") person.birth = value;
                    if (currentEvent.type === "Death") person.death = value;
                } else if (currentEvent && tagOrId === "PLAC") {
                    currentEvent.place = value;
                }
            } 
            // Family details parsing
            else if (currentFamId) {
                const fam = this.families[currentFamId];
                if (tagOrId === "HUSB") {
                    fam.husband = value.replace(/@/g, "");
                } else if (tagOrId === "WIFE") {
                    fam.wife = value.replace(/@/g, "");
                } else if (tagOrId === "CHIL") {
                    fam.children.push(value.replace(/@/g, ""));
                } else if (tagOrId === "MARR") {
                    currentEvent = { type: "Marriage", familyId: currentFamId, date: "", place: "" };
                    this.events.push(currentEvent);
                } else if (currentEvent && tagOrId === "DATE") {
                    currentEvent.date = value;
                } else if (currentEvent && tagOrId === "PLAC") {
                    currentEvent.place = value;
                }
            }
        }

        // Hook families to individuals
        Object.keys(this.families).forEach(famId => {
            const fam = this.families[famId];
            if (fam.husband && this.individuals[fam.husband]) this.individuals[fam.husband].families.push(famId);
            if (fam.wife && this.individuals[fam.wife]) this.individuals[fam.wife].families.push(famId);
            fam.children.forEach(childId => {
                if (this.individuals[childId]) this.individuals[childId].families.push(famId);
            });
        });

        return {
            individualsCount: Object.keys(this.individuals).length,
            familiesCount: Object.keys(this.families).length,
            eventsCount: this.events.length
        };
    }

    calculateDNAHeredity(targetId) {
        const heredity = {};
        const calculate = (id, percent) => {
            if (!id || percent < 0.1) return;
            heredity[id] = (heredity[id] || 0) + percent;

            // Find parents through families
            const person = this.individuals[id];
            if (!person) return;
            
            // Loop through families to find biological parents
            Object.keys(this.families).forEach(famId => {
                const fam = this.families[famId];
                if (fam.children.includes(id)) {
                    calculate(fam.husband, percent / 2);
                    calculate(fam.wife, percent / 2);
                }
            });
        };

        calculate(targetId, 100);
        return heredity;
    }

    // Returns dynamic SVG hierarchy diagram colored by family display (Colored Pedigree Layout)
    generateSVGTree(targetId) {
        const ind = this.individuals[targetId];
        if (!ind) return `<text x="20" y="20" fill="white">Select a family member</text>`;

        const heredity = this.calculateDNAHeredity(targetId);

        // Render simple 3-generation pedigree diagram
        const boxes = [];
        const lines = [];

        // Center Box (Subject)
        boxes.push({ x: 220, y: 350, id: targetId, label: ind.name, role: "Subject", dna: 100, color: "#00ffcc" });

        // Level 1: Parents
        let fatherId = null;
        let motherId = null;

        Object.keys(this.families).forEach(famId => {
            const fam = this.families[famId];
            if (fam.children.includes(targetId)) {
                fatherId = fam.husband;
                motherId = fam.wife;
            }
        });

        if (fatherId && this.individuals[fatherId]) {
            boxes.push({ x: 100, y: 220, id: fatherId, label: this.individuals[fatherId].name, role: "Father", dna: 50, color: "#00a896" });
            lines.push({ x1: 270, y1: 350, x2: 150, y2: 270 });
        }
        if (motherId && this.individuals[motherId]) {
            boxes.push({ x: 340, y: 220, id: motherId, label: this.individuals[motherId].name, role: "Mother", dna: 50, color: "#ff0055" });
            lines.push({ x1: 270, y1: 350, x2: 390, y2: 270 });
        }

        const linesSVG = lines.map(l => `<line x1="${l.x1}" y1="${l.y1}" x2="${l.x2}" y2="${l.y2}" stroke="#94a3b8" stroke-width="2" />`).join("\n");
        const boxesSVG = boxes.map(b => `
            <g class="tree-node" cursor="pointer" onclick="selectGedcomMember('${b.id}')">
                <rect x="${b.x}" y="${b.y}" width="120" height="50" rx="4" fill="#14181f" stroke="${b.color}" stroke-width="2" />
                <text x="${b.x + 60}" y="${b.y + 20}" fill="#fff" font-family="monospace" font-size="10" text-anchor="middle" font-weight="bold">${b.label.split("/")[0]}</text>
                <text x="${b.x + 60}" y="${b.y + 35}" fill="#00ffcc" font-family="monospace" font-size="9" text-anchor="middle">DNA: ${b.dna}%</text>
            </g>
        `).join("\n");

        return `
        <svg viewBox="0 0 600 500" width="100%" height="100%">
            ${linesSVG}
            ${boxesSVG}
        </svg>
        `;
    }
}

window.GedcomViewer = GedcomViewer;

