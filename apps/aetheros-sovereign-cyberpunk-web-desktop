        function executeYubNubCommand() {
            const cmd = document.getElementById('yubnub-cmd').value.trim();
            if (!cmd) return;
            document.getElementById('yubnub-cmd').value = "";

            const parts = cmd.split(" ");
            const shortcut = parts[0].toLowerCase();
            const arg = parts.slice(1).join(" ");

            const out = document.getElementById('yubnub-output');
            out.innerHTML += `<div style="color:var(--text-dim); margin-top:8px;">&gt; ${cmd}</div>`;

            if (shortcut === 'ls') {
                out.innerHTML += `
                    <div class="accent" style="margin-top:8px; font-weight:bold;">Available Shortcuts:</div>
                    <div>- <b>g &lt;query&gt;</b>: Search Google</div>
                    <div>- <b>wp &lt;query&gt;</b>: Read Wikipedia</div>
                    <div>- <b>am &lt;query&gt;</b>: Browse Amazon</div>
                    <div>- <b>xe &lt;val&gt; &lt;from&gt; &lt;to&gt;</b>: Convert Currencies</div>
                    <div>- <b>random &lt;max&gt;</b>: Pick a random number</div>
                `;
            } else if (shortcut === 'g') {
                out.innerHTML += `<div class="accent">Redirecting Google Search for "${arg}"...</div>`;
                window.open('https://www.google.com/search?q=' + encodeURIComponent(arg), '_blank');
            } else if (shortcut === 'wp') {
                out.innerHTML += `<div class="accent">Redirecting Wikipedia for "${arg}"...</div>`;
                window.open('https://en.wikipedia.org/wiki/Special:Search?search=' + encodeURIComponent(arg), '_blank');
            } else if (shortcut === 'am') {
                out.innerHTML += `<div class="accent">Redirecting Amazon for "${arg}"...</div>`;
                window.open('https://www.amazon.com/s?k=' + encodeURIComponent(arg), '_blank');
            } else if (shortcut === 'random') {
                const max = parseInt(arg) || 100;
                const rand = Math.floor(Math.random() * max) + 1;
                out.innerHTML += `<div class="accent">Picked Random Number: ${rand}</div>`;
            } else if (shortcut === 'xe') {
                const val = parseFloat(parts[1]) || 1.0;
                const from = (parts[2] || "USD").toUpperCase();
                const to = (parts[3] || "EUR").toUpperCase();
                const rate = 0.92;
                out.innerHTML += `<div class="accent">${val} ${from} = ${(val * rate).toFixed(2)} ${to}</div>`;
            } else {
                out.innerHTML += `<div class="dim">Unknown shortcut command. Type 'ls' to see list of shortcuts.</div>`;
            }

            out.scrollTop = out.scrollHeight;
            synth.playTone(440, 0.08, 'sine');
        }

