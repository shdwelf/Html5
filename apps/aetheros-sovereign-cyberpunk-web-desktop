        function drawMonkeyAvatar(canvasId, traits) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            ctx.fillStyle = "#0c1015";
            ctx.fillRect(0, 0, w, h);

            ctx.fillStyle = "#eab308";
            ctx.beginPath(); ctx.arc(w/2 - 40, h/2 - 20, 20, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = "#fbc3a6";
            ctx.beginPath(); ctx.arc(w/2 - 40, h/2 - 20, 12, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = "#eab308";
            ctx.beginPath(); ctx.arc(w/2 + 40, h/2 - 20, 20, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = "#fbc3a6";
            ctx.beginPath(); ctx.arc(w/2 + 40, h/2 - 20, 12, 0, Math.PI*2); ctx.fill();

            ctx.fillStyle = "#eab308";
            ctx.beginPath(); ctx.arc(w/2, h/2, 45, 0, Math.PI*2); ctx.fill();

            ctx.fillStyle = "#fbc3a6";
            ctx.beginPath();
            ctx.arc(w/2 - 15, h/2 - 5, 20, 0, Math.PI*2);
            ctx.arc(w/2 + 15, h/2 - 5, 20, 0, Math.PI*2);
            ctx.arc(w/2, h/2 + 15, 25, 0, Math.PI*2);
            ctx.fill();

            ctx.fillStyle = "#000";
            ctx.beginPath(); ctx.arc(w/2 - 12, h/2 - 8, 4, 0, Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(w/2 + 12, h/2 - 8, 4, 0, Math.PI*2); ctx.fill();

            ctx.strokeStyle = "#8b4513";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(w/2, h/2 + 12, 8, 0, Math.PI);
            ctx.stroke();

            traits.forEach(t => {
                if (t.name === "Flamethrower") {
                    ctx.fillStyle = "#ff5500";
                    ctx.fillRect(w/2 + 30, h/2 + 10, 15, 30);
                    ctx.fillStyle = "#ffaa00";
                    ctx.beginPath();
                    ctx.moveTo(w/2 + 37, h/2 + 10);
                    ctx.lineTo(w/2 + 30, h/2 - 10);
                    ctx.lineTo(w/2 + 45, h/2 - 10);
                    ctx.closePath();
                    ctx.fill();
                } else if (t.name === "Laser Eyes") {
                    ctx.strokeStyle = "#ff0055";
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    ctx.moveTo(w/2 - 12, h/2 - 8); ctx.lineTo(0, h/2 + 50);
                    ctx.moveTo(w/2 + 12, h/2 - 8); ctx.lineTo(w, h/2 + 50);
                    ctx.stroke();
                } else if (t.name === "Crown") {
                    ctx.fillStyle = "#ffd700";
                    ctx.beginPath();
                    ctx.moveTo(w/2 - 25, h/2 - 40);
                    ctx.lineTo(w/2 - 20, h/2 - 60);
                    ctx.lineTo(w/2 - 5, h/2 - 50);
                    ctx.lineTo(w/2, h/2 - 70);
                    ctx.lineTo(w/2 + 5, h/2 - 50);
                    ctx.lineTo(w/2 + 20, h/2 - 60);
                    ctx.lineTo(w/2 + 25, h/2 - 40);
                    ctx.closePath();
                    ctx.fill();
                }
            });
        }

        function drawSBoxHexGrid() {
            const canvas = document.getElementById('sbox-hex-canvas');
            canvas.style.display = 'block';
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0,0,w,h);

            ctx.fillStyle = "#070a13";
            ctx.fillRect(0,0,w,h);

            const rows = 6;
            const cols = 12;
            const size = 13;
            const offset = 20;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const x = offset + c * (size * 1.75) + (r % 2 === 0 ? size * 0.85 : 0);
                    const y = offset + r * (size * 1.5);

                    const val = ((r * 12 + c) * 31) % 256;
                    const hexColor = `hsl(${val}, 80%, 50%)`;

                    ctx.fillStyle = hexColor;
                    ctx.beginPath();
                    for (let i = 0; i < 6; i++) {
                        const angle = (Math.PI / 3) * i;
                        const hx = x + Math.cos(angle) * size;
                        const hy = y + Math.sin(angle) * size;
                        if (i === 0) ctx.moveTo(hx, hy);
                        else ctx.lineTo(hx, hy);
                    }
                    ctx.closePath();
                    ctx.fill();

                    ctx.fillStyle = "#000";
                    ctx.font = "bold 8px monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.fillText(val.toString(16).toUpperCase().padStart(2, '0'), x, y);
                }
            }
            synth.playTone(550, 0.1, 'sine');
        }

