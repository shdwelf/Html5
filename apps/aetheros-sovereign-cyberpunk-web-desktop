                        <div class="recipe-ingredient" onclick="addChefOp('Base64 Decode')">Base64 Decode</div>
                        <div class="recipe-ingredient" onclick="addChefOp('S-Box hex-map')">S-Box hex-map</div>
                        <button class="app-btn margin-top" onclick="clearChefOp()">🧹 CLEAR RECIPE</button>
                    </div>
                    <div class="win-main-area">
                        <div class="recipe-stage-box" id="chef-recipe-stages">
                            <span class="dim">Add operations to construct recipe...</span>
                        </div>
                        <div class="margin-top">
                            <label class="dim">INPUT DATA</label>
                            <input type="text" id="chef-input" value="AetherOS" style="width:100%">
                        </div>
                        <button class="app-btn margin-top" onclick="executeCyberChefRecipe()">🍳 COOK DATA</button>
                        <div class="margin-top">
                            <label class="dim">OUTPUT DATA</label>
                            <textarea id="chef-output" style="width:100%; height:80px;"></textarea>
                        </div>
                    </div>
                </div>
            `;
            windowManager.createWindow('cyberchef-app', 'GCHQ CyberChef Standalone', html, 750, 480);
        }

        function addChefOp(name) {
            selectedCyberChefRecipe.push(name);
            updateChefStages();
        }

        function clearChefOp() {
            selectedCyberChefRecipe = [];
            updateChefStages();
        }

        function updateChefStages() {
            const stages = document.getElementById('chef-recipe-stages');
            stages.innerHTML = "";
            if (selectedCyberChefRecipe.length === 0) {
                stages.innerHTML = `<span class="dim">Add operations to construct recipe...</span>`;
                return;
            }
            selectedCyberChefRecipe.forEach((op, index) => {
                const item = document.createElement('div');
                item.className = "stage-item";
                item.innerHTML = `<span class="stage-title">${index + 1}. ${op}</span>`;
                stages.appendChild(item);
            });
        }

        function executeCyberChefRecipe() {
            const inp = document.getElementById('chef-input').value;
            const res = chef.process(inp, selectedCyberChefRecipe);
            document.getElementById('chef-output').value = res;
            synth.playSuccess();
        }

        // Application: French Maid & Quine SFX Exporter
        function openFrenchMaidApp() {
            const html = `
                <div class="win-sidebar-layout">
                    <div class="win-sidebar">
                        <label class="dim">EXPORT PREFERENCES</label>
                        <div style="margin-top:10px;">
                            <input type="checkbox" id="quine-history" checked> <span class="dim" style="font-size:11px;">Keep History</span>
                        </div>
                        <div style="margin-top:10px;">
                            <input type="checkbox" id="quine-strip"> <span class="dim" style="font-size:11px;">Remove Quine Code</span>
                        </div>
                        <button class="app-btn margin-top" onclick="triggerFrenchMaidClean()">🧹 DEEP CLEAN</button>
                    </div>
                    <div class="win-main-area">
                        <div class="enso-canvas-container" style="background:#0c0f13; border: 1px dashed var(--accent); min-height:180px;">
                            <div class="flex-col" style="text-align:center; padding:20px;">
                                <div class="accent bold" style="font-size:14px; text-transform:uppercase;">-- Quine / SFX Standalone Compiler --</div>
                                <div class="margin-top dim" style="font-size:12px;">Compile this entire running Web OS desktop environment into a single portable package.</div>
                                <div class="margin-top flex-row" style="justify-content:center;">
                                    <button class="app-btn" onclick="exportSingleFileQuine()">📥 DOWNLOAD HTML5 QUINE</button>
