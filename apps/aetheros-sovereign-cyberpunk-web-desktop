                        pos: "Wikipedia Abstract",
                        definition: data.extract,
                        origin: "Wikipedia Project"
                    };
                }
            } catch (e) {
                console.log("Wikipedia fetch error, falling back", e);
            }
        }

        // Default local / dictd emulator dictionary fallback
        const result = this.definitions[clean];
        if (result) {
            return result;
        }

        return {
            word: word,
            pos: "unknown",
            definition: `No definition found for "${word}" via ${protocol}. Try searching for "enso", "haiku", "quine", "cyberchef", or "gopher" for full dictionary layouts.`,
            origin: "Local fallback database"
        };
