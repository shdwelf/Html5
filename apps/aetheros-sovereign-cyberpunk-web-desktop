            ctx.fillStyle = "#161b22";
            ctx.fillRect(coord.x, coord.y, tileSize, tileSize);
            ctx.strokeStyle = "rgba(0, 255, 204, 0.3)";
            ctx.strokeRect(coord.x, coord.y, tileSize, tileSize);

