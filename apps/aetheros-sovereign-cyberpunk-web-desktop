        ctx.strokeStyle = "#00ffcc";
        ctx.lineWidth = 2;
        ctx.strokeRect(10, 10, w - 20, h - 20);

        // Render each block tile
        const tileSize = (w - 20) / 4;

        // Coordinates positions for 12 tiles in clockwise rectangular loop
        const tileCoords = [
            { x: 10, y: h - 10 - tileSize }, // 0: Genesis
            { x: 10, y: h - 10 - tileSize * 2 }, // 1: Doge
            { x: 10, y: h - 10 - tileSize * 3 }, // 2: Gas
            { x: 10, y: 10 }, // 3: Litecoin
            { x: 10 + tileSize, y: 10 }, // 4: Waves
            { x: 10 + tileSize * 2, y: 10 }, // 5: Banano
