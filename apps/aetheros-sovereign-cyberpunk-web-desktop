        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;
        ctx.clearRect(0, 0, w, h);

        const cx = w / 2;
        const cy = h / 2;
        const r = Math.min(w, h) / 3;

        // Draw deep space starry background
        ctx.fillStyle = "#020408";
        ctx.fillRect(0, 0, w, h);

        // Draw Globe background sphere
        const grad = ctx.createRadialGradient(cx, cy, r * 0.5, cx, cy, r);
        grad.addColorStop(0, '#0d1e2e');
        grad.addColorStop(1, '#030812');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fill();

        // Draw Globe Grid Latitude/Longitude rings
        ctx.strokeStyle = "rgba(0, 255, 204, 0.15)";
        ctx.lineWidth = 1;

        // Longitudes
        for (let i = 0; i < 6; i++) {
            ctx.beginPath();
            const lonAngle = this.angle + (i * Math.PI / 3);
            const rx = Math.cos(lonAngle) * r;
            if (Math.abs(rx) > 1) {
                // Symmetrical ellipse projection
                ctx.ellipse(cx, cy, Math.abs(rx), r, 0, 0, Math.PI * 2);
                ctx.stroke();
            }
        }

        // Latitudes
        for (let i = -2; i <= 2; i++) {
            const latY = cy + (i * r / 3);
            const latRad = Math.sqrt(r * r - (latY - cy) * (latY - cy));
            ctx.beginPath();
            ctx.arc(cx, latY, latRad, 0, Math.PI * 2);
            ctx.stroke();
        }

        // Globe outline halo
        ctx.strokeStyle = "rgba(0, 255, 204, 0.6)";
        ctx.lineWidth = 2;
        ctx.shadowColor = "rgba(0, 255, 204, 0.5)";
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
        ctx.shadowBlur = 0; // reset

