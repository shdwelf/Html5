                        <div class="margin-top dim" id="maid-status" style="font-size:11px; text-align:center;">French Maid service active. Ready to clean or compile.</div>
                    </div>
                </div>
            `;
            windowManager.createWindow('french-maid', 'French Maid Quine SFX', html, 680, 420);
        }

        function triggerFrenchMaidClean() {
            document.getElementById('maid-status').innerText = "Cleaning history, wiping cache, optimizing code layout...";
            synth.playTone(523.25, 0.5, 'triangle');
            setTimeout(() => {
                document.getElementById('maid-status').innerText = "Deep clean finished! All cache and temporary session states are sanitized.";
                synth.playSuccess();
            }, 1200);
        }

        function exportSingleFileQuine() {
            let pageSource = document.documentElement.outerHTML;

            if (document.getElementById('quine-strip').checked) {
                pageSource = pageSource.replace(/\/\/ Application: French Maid[\s\S]*?\/\/ End French Maid/g, '// Quine block stripped.');
            }

            if (!document.getElementById('quine-history').checked) {
                pageSource = pageSource.replace(/value="Satoshi"/g, 'value=""');
            }

            const blob = new Blob([pageSource], { type: 'text/html' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = "aetheros-standalone.html";
            link.click();
            synth.playSuccess();
        }

        function exportNativeSFXInstaller() {
            let pageSource = document.documentElement.outerHTML;

            const sfxPayload = `#!/bin/bash
# AetherOS Native Self-Extracting SFX Installer
echo "========================================="
echo "Installing AetherOS Desktop Environment..."
echo "========================================="

# Decode inlined payload block
cat << 'EOF' > aetheros-desktop.html
${pageSource}
EOF

echo "Extraction complete: 'aetheros-desktop.html' is ready."
echo "Opening in default browser..."
if which xdg-open > /dev/null; then
    xdg-open aetheros-desktop.html
elif which open > /dev/null; then
    open aetheros-desktop.html
fi
`;

            const blob = new Blob([sfxPayload], { type: 'application/x-sh' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = "install-aetheros.sh";
            link.click();
            synth.playSuccess();
        }

        // Mascot dialog speech interaction controller
        function triggerOsakaDialogue() {
            const bubble = document.getElementById('osaka-text');
            bubble.innerText = osaka.respondToInteraction("click");
            bubble.classList.add('show');
            synth.playTone(523.25, 0.15, 'sine');
            setTimeout(() => {
                bubble.classList.remove('show');
            }, 4000);
        }

        // Simple Drag and drop controller for Osaka assistant mascot
        let isMascotDragging = false;
        let mascotOffsetX = 0, mascotOffsetY = 0;

        function osakaDragStart(e) {
            isMascotDragging = true;
            const comp = document.getElementById('osaka-companion');
            const rect = comp.getBoundingClientRect();
            mascotOffsetX = e.clientX - rect.left;
            mascotOffsetY = e.clientY - rect.top;

            const drag = (event) => {
                if (!isMascotDragging) return;
                comp.style.left = `${event.clientX - mascotOffsetX}px`;
                comp.style.top = `${event.clientY - mascotOffsetY}px`;
            };

            const stopDrag = () => {
                isMascotDragging = false;
                document.removeEventListener('mousemove', drag);
                document.removeEventListener('mouseup', stopDrag);
                triggerOsakaDialogue();
            };

            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', stopDrag);
        }
    </script>
