    constructor() {
        this.alphabets = {
            "A=1, B=2, C=3 (Direct)": (char) => {
                const code = char.toUpperCase().charCodeAt(0);
                return (code >= 65 && code <= 90) ? code - 64 : null;
            },
            "A=26, B=25 (Reverse)": (char) => {
                const code = char.toUpperCase().charCodeAt(0);
                return (code >= 65 && code <= 90) ? 27 - (code - 64) : null;
            },
            "ASCII Decimal": (char) => char.charCodeAt(0)
        };
    }

    calculateAlphabetValue(text, formula) {
        const results = [];
        const func = this.alphabets[formula] || this.alphabets["A=1, B=2, C=3 (Direct)"];
        for (let char of text) {
            const val = func(char);
            if (val !== null) {
                results.push({ char, val });
            }
        }
        return results;
    }

    // Coordinates high precision Ellipsoid Waypoint Projection (Haversine/Vincenty simulation)
    projectWaypoint(lat, lon, bearing, distance) {
        const R = 6371000; // Earth radius in meters
        const d = parseFloat(distance); // distance in meters
        const brng = (parseFloat(bearing) * Math.PI) / 180;

        const lat1 = (parseFloat(lat) * Math.PI) / 180;
        const lon1 = (parseFloat(lon) * Math.PI) / 180;

        const lat2 = Math.asin(Math.sin(lat1) * Math.cos(d / R) +
                     Math.cos(lat1) * Math.sin(d / R) * Math.cos(brng));
        const lon2 = lon1 + Math.atan2(Math.sin(brng) * Math.sin(d / R) * Math.cos(lat1),
                     Math.cos(d / R) - Math.sin(lat1) * Math.sin(lat2));

        return {
            lat: (lat2 * 180) / Math.PI,
            lon: (lon2 * 180) / Math.PI
        };
    }
}

