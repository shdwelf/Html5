                            list.appendChild(artItem);
                        });
                        synth.playSuccess();
                    };
                    list.appendChild(item);
                }
            }

            alert(`Successfully imported ${count} RSS feed subscriptions from OPML list!`);
            synth.playSuccess();
        }

