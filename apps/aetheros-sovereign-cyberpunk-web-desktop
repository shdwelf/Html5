// Global Application Window Manager, Dock, Resizing & Dragging
class WindowManager {
    constructor() {
        this.windows = {};
        this.zIndex = 1000;
        this.activeWindowId = null;
        this.initOverlay();
    }

    initOverlay() {
        // Create global fixed cover overlay sheet to ensure extremely smooth dragging/resizing
        // across the entire screen without focus drops over nested canvases or layouts.
        this.overlay = document.createElement('div');
        this.overlay.id = 'drag-overlay';
        this.overlay.style.position = 'fixed'; // Must be fixed to cover full screen viewport!
        this.overlay.style.top = '0';
        this.overlay.style.left = '0';
        this.overlay.style.width = '100vw';
        this.overlay.style.height = '100vh';
        this.overlay.style.zIndex = '999999';
        this.overlay.style.display = 'none';
        this.overlay.style.pointerEvents = 'auto';
        this.overlay.style.background = 'transparent';
        document.body.appendChild(this.overlay);
    }

    createWindow(id, title, htmlContent, width = 750, height = 500) {
        if (this.windows[id]) {
            this.restoreWindow(id);
            return;
        }

        const desktopWidth = window.innerWidth;
        const desktopHeight = window.innerHeight - 48; // Subtract taskbar height

        // Responsive Auto-Fit Window bounds
        let finalWidth = Math.min(width, desktopWidth * 0.95);
        let finalHeight = Math.min(height, desktopHeight * 0.9);

        finalWidth = Math.max(300, finalWidth);
        finalHeight = Math.max(200, finalHeight);

        const win = document.createElement('div');
        win.id = `win-${id}`;
        win.className = 'win';
        win.style.width = `${finalWidth}px`;
        win.style.height = `${finalHeight}px`;

        // Safe initial positioning within boundaries
        const x = Math.max(10, Math.min((desktopWidth - finalWidth) / 2 + (Object.keys(this.windows).length * 15), desktopWidth - finalWidth - 10));
        const y = Math.max(10, Math.min((desktopHeight - finalHeight) / 2 + (Object.keys(this.windows).length * 15), desktopHeight - finalHeight - 10));

        win.style.left = `${x}px`;
        win.style.top = `${y}px`;
        win.style.zIndex = ++this.zIndex;

        // Structured window body with title bar, close buttons, resize handle and focus bubble
        win.innerHTML = `
            <div class="win-header" 
                 onmousedown="windowManager.dragStart(event, '${id}')" 
                 ontouchstart="windowManager.dragStart(event, '${id}')"
                 ondblclick="windowManager.toggleMaximize('${id}')">
                <div class="win-title-container">
                    <span class="win-title">${title}</span>
                </div>
                <div class="win-controls" onmousedown="event.stopPropagation()" ontouchstart="event.stopPropagation()">
                    <button class="win-btn win-btn-min" onclick="windowManager.minimizeWindow('${id}')"></button>
                    <button class="win-btn win-btn-max" onclick="windowManager.toggleMaximize('${id}')"></button>
                    <button class="win-btn win-btn-close" onclick="windowManager.closeWindow('${id}')"></button>
                </div>
            </div>
            <div class="win-content" style="overflow: auto; height: calc(100% - 37px);" onmousedown="windowManager.focusWindow('${id}')" ontouchstart="windowManager.focusWindow('${id}')">
                ${htmlContent}
            </div>
            <div class="win-resize-handle" onmousedown="windowManager.resizeStart(event, '${id}')" ontouchstart="windowManager.resizeStart(event, '${id}')"></div>
        `;

        document.getElementById('window-layer').appendChild(win);
        this.windows[id] = { id, title, width: finalWidth, height: finalHeight, x, y, isMaximized: false };
        this.focusWindow(id);

        this.addTaskbarTab(id, title);
    }

    focusWindow(id) {
        const winEl = document.getElementById(`win-${id}`);
        if (!winEl) return;
        winEl.style.zIndex = ++this.zIndex;
        this.activeWindowId = id;

        document.querySelectorAll('.win').forEach(el => el.classList.remove('active'));
        winEl.classList.add('active');

        document.querySelectorAll('.dock-app-tab').forEach(el => el.classList.remove('active'));
        const tab = document.getElementById(`tab-${id}`);
        if (tab) tab.classList.add('active');
    }

    // Mathematically perfect dragging utilizing direct style offsets
    dragStart(e, id) {
        const winEl = document.getElementById(`win-${id}`);
        if (!winEl) return;
        this.focusWindow(id);

        const isTouch = e.type.startsWith('touch');
        const clientX = isTouch ? e.touches[0].clientX : e.clientX;
        const clientY = isTouch ? e.touches[0].clientY : e.clientY;

        const startX = clientX;
        const startY = clientY;
        
        // Read style properties directly to guarantee complete coordinate consistency
        const left = parseFloat(winEl.style.left) || 0;
        const top = parseFloat(winEl.style.top) || 0;
        const winWidth = winEl.offsetWidth;

        this.overlay.style.display = 'block';
        this.overlay.style.cursor = 'move';

        const drag = (event) => {
            const currentX = isTouch ? event.touches[0].clientX : event.clientX;
            const currentY = isTouch ? event.touches[0].clientY : event.clientY;

            const dx = currentX - startX;
            const dy = currentY - startY;
            
            const desktopWidth = window.innerWidth;
            const desktopHeight = window.innerHeight - 48; // Taskbar offset

            // Clamp coordinates gracefully
            const newX = Math.min(Math.max(-winWidth + 100, left + dx), desktopWidth - 100);
            const newY = Math.min(Math.max(0, top + dy), desktopHeight - 20);

            winEl.style.left = `${newX}px`;
            winEl.style.top = `${newY}px`;
            this.windows[id].x = newX;
            this.windows[id].y = newY;
        };

        const stopDrag = () => {
            this.overlay.style.display = 'none';
            this.overlay.style.cursor = 'default';
            document.removeEventListener(isTouch ? 'touchmove' : 'mousemove', drag);
            document.removeEventListener(isTouch ? 'touchend' : 'mouseup', stopDrag);
        };

        document.addEventListener(isTouch ? 'touchmove' : 'mousemove', drag);
        document.addEventListener(isTouch ? 'touchend' : 'mouseup', stopDrag);
    }

    // Mathematically perfect resizing utilizing offset bounding
    resizeStart(e, id) {
        e.stopPropagation();
        e.preventDefault();
        const winEl = document.getElementById(`win-${id}`);
        if (!winEl) return;
        this.focusWindow(id);

        const isTouch = e.type.startsWith('touch');
        const clientX = isTouch ? e.touches[0].clientX : e.clientX;
        const clientY = isTouch ? e.touches[0].clientY : e.clientY;

        const startWidth = winEl.offsetWidth;
        const startHeight = winEl.offsetHeight;
        const startX = clientX;
        const startY = clientY;

        this.overlay.style.display = 'block';
        this.overlay.style.cursor = 'se-resize';

        const resize = (event) => {
            const currentX = isTouch ? event.touches[0].clientX : event.clientX;
            const currentY = isTouch ? event.touches[0].clientY : event.clientY;

            const dx = currentX - startX;
            const dy = currentY - startY;

            const newWidth = Math.max(300, startWidth + dx);
            const newHeight = Math.max(200, startHeight + dy);

            winEl.style.width = `${newWidth}px`;
            winEl.style.height = `${newHeight}px`;
            this.windows[id].width = newWidth;
            this.windows[id].height = newHeight;
        };

        const stopResize = () => {
            this.overlay.style.display = 'none';
            this.overlay.style.cursor = 'default';
            document.removeEventListener(isTouch ? 'touchmove' : 'mousemove', resize);
            document.removeEventListener(isTouch ? 'touchend' : 'mouseup', stopResize);
        };

        document.addEventListener(isTouch ? 'touchmove' : 'mousemove', resize);
        document.addEventListener(isTouch ? 'touchend' : 'mouseup', stopResize);
    }

    toggleMaximize(id) {
        const winEl = document.getElementById(`win-${id}`);
        if (!winEl) return;
        const win = this.windows[id];

        if (win.isMaximized) {
            winEl.style.width = `${win.width}px`;
            winEl.style.height = `${win.height}px`;
            winEl.style.left = `${win.x}px`;
            winEl.style.top = `${win.y}px`;
            win.isMaximized = false;
        } else {
            winEl.style.width = '100vw';
            winEl.style.height = 'calc(100vh - 48px)';
            winEl.style.left = '0px';
            winEl.style.top = '0px';
            win.isMaximized = true;
        }
    }

    closeWindow(id) {
        const winEl = document.getElementById(`win-${id}`);
        if (winEl) winEl.remove();
        delete this.windows[id];

        const tab = document.getElementById(`tab-${id}`);
        if (tab) tab.remove();
    }

    minimizeWindow(id) {
        const winEl = document.getElementById(`win-${id}`);
        if (winEl) winEl.style.display = 'none';
    }

    restoreWindow(id) {
        const winEl = document.getElementById(`win-${id}`);
        if (winEl) {
            winEl.style.display = 'flex';
            this.focusWindow(id);
        }
    }

    recenterAllWindows() {
        const desktopWidth = window.innerWidth;
        const desktopHeight = window.innerHeight - 48;
        let index = 0;

        Object.keys(this.windows).forEach(id => {
            const winEl = document.getElementById(`win-${id}`);
            if (!winEl) return;

            const win = this.windows[id];
            winEl.style.display = 'flex';

            const cx = Math.max(20, (desktopWidth - win.width) / 2 + (index * 25));
            const cy = Math.max(20, (desktopHeight - win.height) / 2 + (index * 25));

            winEl.style.left = `${cx}px`;
            winEl.style.top = `${cy}px`;
            win.x = cx;
            win.y = cy;
            
            index++;
        });
    }

    addTaskbarTab(id, title) {
        const tab = document.createElement('div');
        tab.id = `tab-${id}`;
        tab.className = 'dock-app-tab active';
        tab.innerText = title;
        tab.onclick = () => {
            const winEl = document.getElementById(`win-${id}`);
            if (winEl && winEl.style.display === 'none') {
                this.restoreWindow(id);
            } else {
                if (this.activeWindowId === id) {
                    this.minimizeWindow(id);
                } else {
                    this.focusWindow(id);
                }
            }
        };
        document.getElementById('dock-tabs').appendChild(tab);
    }
}

window.WindowManager = WindowManager;
