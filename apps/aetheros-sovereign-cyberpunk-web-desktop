        function parseOPMLFeeds() {
            const xmlText = document.getElementById('opml-input').value;
            if (!xmlText) return alert("Please paste OPML XML first.");

            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xmlText, "text/xml");
            const outlines = xmlDoc.getElementsByTagName("outline");

            if (outlines.length === 0) {
                alert("Invalid OPML structure or no outline nodes found.");
                return;
            }

            const list = document.getElementById('news-articles-list');
            list.innerHTML = "";
            let count = 0;

            for (let outline of outlines) {
                const title = outline.getAttribute("title") || outline.getAttribute("text");
                const xmlUrl = outline.getAttribute("xmlUrl");

                if (title && xmlUrl) {
                    const item = document.createElement('div');
                    item.className = "sidebar-btn";
                    item.innerHTML = `
                        <div class="accent bold" style="font-size:11px;">Feed ${++count}</div>
                        <div class="dim" style="font-size:10px; margin-top:4px;">${title}</div>
