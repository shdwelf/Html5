<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AetherOS - Sovereign Cyberpunk Web Desktop</title>
    <style>
/* AetherOS Cyberpunk/Retro Desktop Theme */

:root {
    --bg-primary: #05070a;
    --bg-secondary: #0a0d16;
    --accent: #00ffcc;
    --accent-glow: rgba(0, 255, 204, 0.4);
    --accent-dim: #00a896;
    --text-main: #f1f5f9;
    --text-dim: #94a3b8;
    --danger: #ff0055;
    --warning: #ffaa00;
    --win-bg: rgba(10, 14, 22, 0.96);
    --win-border: #00ffcc;
    --font-mono: 'Courier New', Courier, monospace, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-primary);
    font-family: var(--font-mono);
    color: var(--text-main);
}

/* Scrollbars */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
::-webkit-scrollbar-track {
    background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
    background: var(--accent-dim);
    border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
}

#bg-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
}

/* Login Screen */
#login-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #030509;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    transition: opacity 0.8s ease;
}

.login-box {
    background: rgba(10, 14, 22, 0.95);
    border: 2px solid var(--accent);
    box-shadow: 0 0 25px var(--accent-glow);
    padding: 40px;
    width: 450px;
    text-align: center;
    border-radius: 8px;
    position: relative;
}

.login-title {
    font-size: 28px;
    color: var(--accent);
    margin-bottom: 25px;
    text-shadow: 0 0 10px var(--accent-glow);
    letter-spacing: 2px;
}

.login-field {
    margin-bottom: 20px;
    text-align: left;
}

.login-field label {
    display: block;
    font-size: 11px;
    margin-bottom: 5px;
    color: var(--text-dim);
    text-transform: uppercase;
}

.login-field input {
    width: 100%;
    background: #000;
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    padding: 12px;
    font-family: var(--font-mono);
    font-size: 14px;
    border-radius: 4px;
    outline: none;
}

.login-field input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
}

.login-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 2px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 14px;
    cursor: pointer;
    text-transform: uppercase;
    font-weight: bold;
    margin-top: 10px;
    transition: all 0.3s ease;
}

.login-btn:hover {
    background: var(--accent);
    color: #000;
    box-shadow: 0 0 15px var(--accent);
}

#boot-progress-container {
    width: 100%;
    height: 4px;
    background: #000;
    border-radius: 2px;
    margin-top: 20px;
    overflow: hidden;
    display: none;
}

#boot-progress-bar {
    width: 0%;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    transition: width 0.1s linear;
}

/* Desktop */
#desktop {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 10;
    display: flex;
    flex-direction: column;
}

#desktop-icons {
    position: absolute;
    top: 20px;
    left: 80px;
    width: calc(100% - 100px);
    height: calc(100% - 80px);
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 15px;
    z-index: 15;
    pointer-events: none;
}

.desktop-icon {
    width: 90px;
    height: 95px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 4px;
    transition: all 0.2s ease;
    pointer-events: auto;
}

.desktop-icon:hover {
    background: rgba(0, 255, 204, 0.1);
    border-color: rgba(0, 255, 204, 0.3);
}

.desktop-icon .icon-img {
    font-size: 32px;
    margin-bottom: 8px;
    text-shadow: 0 0 10px var(--accent-glow);
}

.desktop-icon .icon-label {
    font-size: 11px;
    text-align: center;
    color: var(--text-main);
    word-break: break-word;
    text-shadow: 1px 1px 2px #000;
}

#window-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 20;
}

.win {
    position: absolute;
    width: 750px;
    height: 500px;
    background: var(--win-bg);
    border: 2px solid var(--win-border);
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    z-index: 100;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: box-shadow 0.2s ease;
}

.win.active {
    box-shadow: 0 0 20px var(--accent-glow);
    border-color: var(--accent);
}

.win-header {
    background: var(--bg-secondary);
    padding: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: move;
    border-bottom: 1px solid var(--win-border);
}

.win-title-container {
    display: flex;
    align-items: center;
    gap: 8px;
}

.win-title {
    font-size: 13px;
    font-weight: bold;
    color: var(--accent);
    text-shadow: 0 0 5px var(--accent-glow);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.win-controls {
    display: flex;
    gap: 6px;
}

.win-btn {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    outline: none;
}

.win-btn-close { background: var(--danger); }
.win-btn-max { background: var(--warning); }
.win-btn-min { background: var(--accent-dim); }

/* Standardized scrollbars for window contents */
.win-content {
    flex: 1;
    overflow: auto !important; /* Forces scroll bar if content overflows! */
    padding: 15px;
    color: var(--text-main);
    display: flex;
    flex-direction: column;
}

.win-resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 14px;
    height: 14px;
    cursor: se-resize;
    background: linear-gradient(135deg, transparent 45%, var(--accent-dim) 55%, transparent 70%, var(--accent) 80%);
    z-index: 1000;
}

/* Symmetrical Columns Sidebars with independent inner scrolls */
.win-sidebar-layout {
    display: flex;
    height: 100%;
    width: 100%;
    gap: 15px;
    overflow: hidden; /* Stop leakage! */
}

.win-sidebar {
    width: 200px;
    border-right: 1px solid rgba(0, 255, 204, 0.2);
    padding-right: 15px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow-y: auto !important; /* Vertical independent scrolling for menus */
}

.win-main-area {
    flex: 1;
    overflow-y: auto !important; /* Vertical independent scrolling for application bodies */
    display: flex;
    flex-direction: column;
    height: 100%;
}

.sidebar-btn {
    padding: 10px;
    text-align: left;
    background: transparent;
    border: 1px solid rgba(0, 255, 204, 0.2);
    color: var(--text-main);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: 4px;
}

.sidebar-btn:hover, .sidebar-btn.active {
    background: rgba(0, 255, 204, 0.1);
    border-color: var(--accent);
    color: var(--accent);
}

#desktop-controls {
    position: absolute;
    top: 15px;
    right: 20px;
    z-index: 20;
    display: flex;
    gap: 10px;
}

.action-btn {
    background: var(--bg-secondary);
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    padding: 8px 12px;
    font-size: 11px;
    cursor: pointer;
    font-family: var(--font-mono);
    border-radius: 4px;
}

.action-btn:hover {
    background: var(--accent);
    color: #000;
}

#taskbar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 48px;
    background: rgba(10, 14, 22, 0.9);
    border-top: 1px solid var(--accent-dim);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    z-index: 1000;
}

.dock-start-btn {
    padding: 6px 15px;
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-weight: bold;
    cursor: pointer;
    font-family: var(--font-mono);
    text-transform: uppercase;
    border-radius: 4px;
}

.dock-start-btn:hover {
    background: var(--accent);
    color: #000;
}

.dock-active-apps {
    display: flex;
    gap: 8px;
    flex: 1;
    margin: 0 20px;
}

.dock-app-tab {
    padding: 6px 12px;
    background: var(--bg-secondary);
    border: 1px solid rgba(0, 255, 204, 0.3);
    color: var(--text-dim);
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
    max-width: 150px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.dock-app-tab.active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0,255,204,0.1);
}

.dock-clock {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 1px;
}

#screensaver-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    background-color: black;
    display: none;
    cursor: none;
}

#start-menu {
    position: absolute;
    bottom: 50px;
    left: 20px;
    width: 250px;
    background: var(--bg-secondary);
    border: 2px solid var(--accent);
    border-radius: 6px;
    box-shadow: 0 0 20px rgba(0,255,204,0.3);
    z-index: 2000;
    display: none;
    padding: 10px;
}

.start-menu-item {
    padding: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border-radius: 4px;
}

.start-menu-item:hover {
    background: rgba(0, 255, 204, 0.1);
    color: var(--accent);
}

input[type="text"], input[type="password"], input[type="number"], select, textarea {
    background: #04060a;
    border: 1px solid var(--accent-dim);
    color: #f1f5f9;
    padding: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: 4px;
    outline: none;
}

input[type="text"]:focus, select:focus, textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 8px rgba(0, 255, 204, 0.3);
}

button.app-btn {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 6px 12px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: 4px;
    transition: all 0.2s ease;
}

button.app-btn:hover {
    background: var(--accent);
    color: #000;
}

#osaka-companion {
    position: absolute;
    bottom: 60px;
    right: 20px;
    width: 140px;
    height: 180px;
    z-index: 1000;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.osaka-bubble {
    position: absolute;
    bottom: 150px;
    right: -20px;
    background: #fff;
    color: #000;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 11px;
    width: 160px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.osaka-bubble.show {
    opacity: 1;
}

.osaka-sprite {
    width: 100px;
    height: 130px;
}

.enso-canvas-container {
    background: #06090e;
    border: 1px solid var(--accent-dim);
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 250px;
    position: relative;
}

.forge-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
}

.forge-overlay.active {
    opacity: 1;
    pointer-events: auto;
}

.forge-ring {
    width: 120px;
    height: 120px;
    border: 4px solid transparent;
    border-top: 4px solid var(--accent);
    border-radius: 50%;
    animation: spin 1.5s linear infinite;
    margin-bottom: 20px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.store-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 15px;
    padding: 10px 0;
}

.store-card {
    background: var(--bg-secondary);
    border: 1px solid rgba(0, 255, 204, 0.2);
    padding: 15px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    transition: all 0.2s ease;
}

.store-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(0, 255, 204, 0.15);
}

.store-icon {
    font-size: 28px;
    text-shadow: 0 0 8px var(--accent-glow);
}

.store-title {
    font-size: 12px;
    font-weight: bold;
    color: var(--accent);
}

.store-desc {
    font-size: 10px;
    color: var(--text-dim);
    height: 40px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Symmetrical Collapsible Left-hand System Sidebar */
#hamburger-menu-btn {
    position: absolute;
    top: 15px;
    left: 20px;
    z-index: 1001;
    width: 30px;
    height: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
}

#hamburger-menu-btn span {
    display: block;
    height: 3px;
    width: 100%;
    background-color: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    transition: all 0.3s ease;
    border-radius: 2px;
}

#hamburger-menu-btn.open span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
}

#hamburger-menu-btn.open span:nth-child(2) {
    opacity: 0;
}

#hamburger-menu-btn.open span:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
}

#system-sidebar {
    position: absolute;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100%;
    background: rgba(7, 9, 14, 0.98);
    border-right: 2px solid var(--accent);
    box-shadow: 10px 0 30px rgba(0,0,0,0.8);
    z-index: 1000;
    transition: left 0.4s cubic-bezier(0.1, 0.9, 0.2, 1);
    padding: 60px 20px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    backdrop-filter: blur(15px);
}

#system-sidebar.open {
    left: 0;
}

.sidebar-header {
    font-size: 18px;
    font-weight: bold;
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent-glow);
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(0, 255, 204, 0.2);
    padding-bottom: 10px;
}

.sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.section-title {
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.metric-bar-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.metric-bg {
    height: 6px;
    background: #000;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(0,255,204,0.2);
}

.metric-fill {
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    width: 0%;
    transition: width 0.5s ease;
}

.flex-row { display: flex; gap: 10px; }
.flex-col { display: flex; flex-direction: column; gap: 10px; }
.bold { font-weight: bold; }
.accent { color: var(--accent); }
.dim { color: var(--text-dim); }
.margin-top { margin-top: 15px; }

</style>
    
