        });

        // Draw Player Token circles on tiles
        this.players.forEach(p => {
            const coord = finalCoords[p.position];
            if (!coord) return;

            // Offset to prevent overlapping tokens
            const offset = p.id === 0 ? 10 : 25;

            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(coord.x + tileSize / 2 + (p.id === 0 ? -8 : 8), coord.y + tileSize - 15, 6, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#fff";
            ctx.stroke();
        });
    }

    rollDice() {
        const roll = Math.floor(Math.random() * 3) + 1; // 1-3 steps roll
        const p = this.players[this.activePlayer];
        p.position = (p.position + roll) % this.board.length;

        const tile = this.board[p.position];
        let actionMsg = `${p.name} rolled a ${roll} and landed on ${tile.name}!`;

        if (tile.cost > 0 && tile.owner === null) {
            // Option to buy
            if (p.balance >= tile.cost) {
                if (p.id === 0) {
                    // Prompt/Buy option handled via OS modal or instant purchase
                    tile.owner = p.id;
                    p.balance -= tile.cost;
                    actionMsg += ` Bought it for $${tile.cost}!`;
                } else {
                    // AI buys immediately
                    tile.owner = p.id;
                    p.balance -= tile.cost;
                    actionMsg += ` Vitalik bought it for $${tile.cost}!`;
                }
            }
        } else if (tile.cost > 0 && tile.owner !== null && tile.owner !== p.id) {
            // Rent calculation
            p.balance -= tile.rent;
            this.players[tile.owner].balance += tile.rent;
            actionMsg += ` Paid $${tile.rent} rent to ${this.players[tile.owner].name}.`;
        } else if (tile.name === "GAS TAX") {
            p.balance -= 200;
            actionMsg += " Paid $200 in gas transaction fees.";
        }

        // Toggle turns
        this.activePlayer = this.activePlayer === 0 ? 1 : 0;
        this.draw();

        return actionMsg;
    }
}

