            const radLon = (art.lon * Math.PI) / 180 + this.angle;

            // Compute visibility (only draw on the front half sphere)
            if (Math.cos(radLon) > 0) {
                const px = cx + Math.sin(radLon) * Math.cos(radLat) * r;
                const py = cy - Math.sin(radLat) * r;

                // Blinking effect
                const blink = Math.sin(Date.now() / 150) > 0;
                ctx.fillStyle = blink ? "#00ffcc" : "#ff0055";
                ctx.beginPath();
                ctx.arc(px, py, 6, 0, Math.PI * 2);
                ctx.fill();

                // Draw connecting label line
                ctx.strokeStyle = "rgba(255, 255, 255, 0.4)";
                ctx.beginPath();
                ctx.moveTo(px, py);
                ctx.lineTo(px + 20, py - 20);
                ctx.stroke();

                // Small city badge label
                ctx.fillStyle = "rgba(0,0,0,0.85)";
                ctx.fillRect(px + 20, py - 32, 110, 16);
                ctx.strokeStyle = "#00ffcc";
                ctx.strokeRect(px + 20, py - 32, 110, 16);

                ctx.fillStyle = "#fff";
                ctx.font = "8px monospace";
                ctx.fillText(art.place, px + 25, py - 22);
            }
        });
    }
}

