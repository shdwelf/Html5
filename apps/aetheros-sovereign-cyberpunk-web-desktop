        function drawMatrix() {
            if (wallpaperStyle === 'black') {
                mCtx.fillStyle = '#05070a';
                mCtx.fillRect(0, 0, width, height);
                return;
            }

            if (wallpaperStyle === 'grid') {
                // Retro Synthwave Vector Cyber Grid
