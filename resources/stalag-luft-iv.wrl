      appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } }
      geometry Cylinder { radius 0.08 height 3.5 }
    }
  ]
}

# ============================================================
# 1. VORLAGER (GERMAN ADMINISTRATION & HQ ZONE - NORTH)
# ============================================================
DEF VORLAGER Group {
  children [
    # German HQ / Kommandantur Building
    Transform {
      translation -120 0 -180
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.52 0.48 0.38 } }
          geometry Box { size 28 5 14 }
        }
        Transform {
          translation 0 3.8 0
          rotation 0 0 1 1.5708
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.25 0.2 0.18 } }
              geometry Cylinder { radius 7.2 height 28.2 }
            }
          ]
        }
      ]
    }
    # German Guard Barracks 1
    Transform {
      translation -70 0 -185
      children [ USE BARRACKS_HUT ]
    }
    # German Guard Barracks 2
    Transform {
      translation -20 0 -185
      children [ USE BARRACKS_HUT ]
    }
    # Infirmary / Revier Huts (Red Cross Medical Huts)
    Transform {
      translation 40 0 -185
      children [
        USE BARRACKS_HUT
        # Red Cross Sign on Roof
        Transform {
          translation 0 6 0
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.8 0.1 0.1 emissiveColor 0.5 0.0 0.0 } }
              geometry Box { size 3 0.2 1 }
            }
            Shape {
              appearance Appearance { material Material { diffuseColor 0.8 0.1 0.1 emissiveColor 0.5 0.0 0.0 } }
              geometry Box { size 1 0.2 3 }
            }
          ]
        }
      ]
    }
    Transform {
      translation 85 0 -185
      children [ USE BARRACKS_HUT ]
    }
    # Food & Red Cross Parcel Warehouses
    Transform {
      translation 135 0 -180
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.38 0.35 0.3 } }
          geometry Box { size 32 5.5 16 }
        }
      ]
    }
    # Main Entrance Gate & Checkpoint (Haupttor)
    Transform {
      translation -170 0 -140
      children [
        # Guard House
        Shape {
          appearance Appearance { material Material { diffuseColor 0.45 0.4 0.32 } }
          geometry Box { size 6 3.5 5 }
        }
        # Gate Wooden Gate Posts
        Transform {
          translation 6 2 0
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.3 0.2 0.1 } }
              geometry Box { size 0.6 4 0.6 }
            }
          ]
        }
        Transform {
          translation 14 2 0
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.3 0.2 0.1 } }
              geometry Box { size 0.6 4 0.6 }
            }
          ]
        }
        # Barrier Gate Arm
        Transform {
          translation 10 2.2 0
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.8 0.15 0.15 } }
              geometry Box { size 8 0.25 0.25 }
            }
          ]
        }
      ]
    }
  ]
}

