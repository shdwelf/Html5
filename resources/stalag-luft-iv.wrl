# Master Ground Terrain
Transform {
  translation 0 -0.5 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.28 0.32 0.18
          specularColor 0.05 0.05 0.05
        }
      }
      geometry Box { size 700 1 700 }
