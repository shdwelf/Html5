    Transform { translation 20 0 30 children [ USE PINE_TREE ] }
  ]
}

# Standard Reusable Barracks Hut Definition
DEF BARRACKS_HUT Transform {
  children [
    # Main Wooden Hut Body
    Transform {
      translation 0 2.25 0
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 0.42 0.32 0.22 }
          }
          geometry Box { size 34 4.5 10 }
        }
      ]
    }
    # Pitched Roof
    Transform {
      translation 0 5.25 0
      rotation 0 0 1 1.5708
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 0.22 0.18 0.15 }
          }
          geometry Cylinder { radius 5.2 height 34.2 }
        }
      ]
    }
    # Brick Chimney 1
    Transform {
      translation -8 5.5 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.5 0.2 0.15 } }
          geometry Box { size 1.2 3 1.2 }
        }
      ]
    }
    # Brick Chimney 2
    Transform {
      translation 8 5.5 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.5 0.2 0.15 } }
          geometry Box { size 1.2 3 1.2 }
        }
      ]
    }
    # Entrance Door
    Transform {
      translation 0 1.5 5.05
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.18 0.12 0.08 } }
          geometry Box { size 2 3 0.2 }
        }
      ]
    }
  ]
}

# Guard Watchtower Definition (Wachturm)
DEF GUARD_TOWER Transform {
  children [
    # 4 Timber Legs
    Transform {
      translation -1.4 5 -1.4
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.35 0.25 0.15 } }
          geometry Cylinder { radius 0.22 height 10 }
        }
      ]
    }
    Transform {
      translation 1.4 5 -1.4
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.35 0.25 0.15 } }
          geometry Cylinder { radius 0.22 height 10 }
        }
      ]
    }
    Transform {
      translation -1.4 5 1.4
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.35 0.25 0.15 } }
          geometry Cylinder { radius 0.22 height 10 }
        }
      ]
    }
    Transform {
      translation 1.4 5 1.4
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.35 0.25 0.15 } }
          geometry Cylinder { radius 0.22 height 10 }
        }
      ]
    }
    # Elevated Guard Platform Floor
    Transform {
      translation 0 10.1 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.3 0.2 0.12 } }
          geometry Box { size 3.6 0.3 3.6 }
        }
      ]
    }
    # Cabin Enclosure
    Transform {
      translation 0 11.5 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.4 0.3 0.2 } }
          geometry Box { size 3.2 2.4 3.2 }
        }
      ]
    }
    # Windows Band
    Transform {
      translation 0 11.8 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.6 0.75 0.85 transparency 0.4 } }
          geometry Box { size 3.25 1 3.25 }
        }
      ]
    }
    # Pyramid Roof
    Transform {
      translation 0 13.5 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.18 0.14 0.12 } }
          geometry Cone { bottomRadius 2.6 height 1.8 }
        }
      ]
    }
    # Searchlight
    Transform {
      translation 0 12.8 1.7
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.2 emissiveColor 0.4 0.4 0.1 } }
          geometry Sphere { radius 0.4 }
