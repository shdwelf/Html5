#VRML V2.0 utf8

WorldInfo {
  title "Stalag Luft IV - Gross Tychow, Pomerania (1944-1945)"
  info [
    "Kriegsgefangenen-Mannschafts-Stammlager Luft IV",
    "Location: Gross Tychow, Pomerania (now Tychowo, Poland) - 53 55 N, 16 15 E",
    "POW Camp for Allied Air Force NCOs (USAAF and RAF)",
    "301st Bomb Group / 15th Air Force Record Center",
    "Created for Html5 Repository Research Session 15"
  ]
}

