# Dense Surrounding Pine Forest Boundary (Decorative Blocks)
DEF PINE_TREE Transform {
  scale 1 1 1
  children [
    # Trunk
    Transform {
      translation 0 4 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.25 0.15 0.08 } }
          geometry Cylinder { radius 0.6 height 8 }
        }
      ]
    }
    # Foliage Tier 1
    Transform {
      translation 0 9 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.1 0.22 0.08 } }
          geometry Cone { bottomRadius 4 height 8 }
        }
      ]
    }
    # Foliage Tier 2
    Transform {
      translation 0 14 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.12 0.28 0.1 } }
          geometry Cone { bottomRadius 3 height 7 }
        }
      ]
    }
  ]
}

# Forest Clusters North / West / East / South
Transform {
  translation -280 0 -250
  children [
    USE PINE_TREE
    Transform { translation 15 0 20 children [ USE PINE_TREE ] }
    Transform { translation -20 0 40 children [ USE PINE_TREE ] }
    Transform { translation 35 0 -30 children [ USE PINE_TREE ] }
    Transform { translation -40 0 -15 children [ USE PINE_TREE ] }
  ]
}

Transform {
  translation 280 0 -250
