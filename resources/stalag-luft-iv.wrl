    Transform { translation -210 0 -210 children [ USE GUARD_TOWER ] }
    Transform { translation -120 0 -210 children [ USE GUARD_TOWER ] }
    Transform { translation -30 0 -210 children [ USE GUARD_TOWER ] }
    Transform { translation 60 0 -210 children [ USE GUARD_TOWER ] }
    Transform { translation 150 0 -210 children [ USE GUARD_TOWER ] }
    Transform { translation 210 0 -210 children [ USE GUARD_TOWER ] }

    # West Perimeter Towers
    Transform { translation -210 0 -100 children [ USE GUARD_TOWER ] }
    Transform { translation -210 0 10 children [ USE GUARD_TOWER ] }
    Transform { translation -210 0 120 children [ USE GUARD_TOWER ] }
    Transform { translation -210 0 210 children [ USE GUARD_TOWER ] }

    # East Perimeter Towers
    Transform { translation 210 0 -100 children [ USE GUARD_TOWER ] }
    Transform { translation 210 0 10 children [ USE GUARD_TOWER ] }
    Transform { translation 210 0 120 children [ USE GUARD_TOWER ] }
    Transform { translation 210 0 210 children [ USE GUARD_TOWER ] }

    # South Perimeter Towers
