# regenerable exporter output (node tools/check_ghs.mjs --write)
dist/
node_modules/
*.local
.DS_Store

# Arena relay cache (large binaries fetched via Actions)
.relay/
.arena-relay/run*

# Drive sync payload: 33-96 MB snapshot tarballs fetched by a runner.
# Only the manifests, diff reports and recovered files are committed.
.arena-drive/payload/
google_drive/
extracted_sg7/

# RTL simulation outputs (regenerable: python3 tools/verify_rtl.py)
sim/*.cc
sim/vchip_rtl
sim/*.log
sim/*.err
sim/build.ys
sim/formal.ys
sim/transcript.*.txt
sim/transcript.diff

__pycache__/
data/

# ECJ bootclasspath (58MB Java7 rt.jar); fetch with tools/java-compiler/fetch-rtjar.sh
tools/java-compiler/.rt/
