#VRML V2.0 utf8
# Sanborn restaurant study / XDC-02
# This is an original interpretive service-counter study, not an attributed Jim Sanborn artwork.
# Coordinates: metres. Y is up. The XDC_* comments are a deliberately small, source-readable
# manifest consumed by sanborn-restaurant-4dwm.html; the VRML below remains valid VRML97.

WorldInfo { title "Sanborn Restaurant Study — Blueprint / Wiremesh / Livelight" info [ "Original design study; research notes are source-checked separately" ] }
NavigationInfo { type [ "EXAMINE", "ANY" ] headlight FALSE }
Background { skyColor [ 0.012 0.025 0.031 ] }
Viewpoint { description "Axonometric" position 22 17 25 orientation -0.55 0.75 0.32 0.76 }
DirectionalLight { direction -0.4 -1 -0.6 intensity 0.55 color 0.72 0.84 0.86 }

