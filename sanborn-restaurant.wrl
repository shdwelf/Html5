# A valid, intentionally sparse VRML97 companion scene. The HTML5/XDC viewer reads
# the source manifest above to supply labels, wiremesh, blueprint, and animation.
PROTO BoxPart [
  field SFVec3f translation 0 0 0
  field SFVec3f size 1 1 1
  field SFColor color 0.5 0.5 0.5
] {
  Transform { translation IS translation children [
    Shape { appearance Appearance { material Material { diffuseColor IS color } }
      geometry Box { size IS size } }
  ] }
}
PROTO CylinderPart [
  field SFVec3f translation 0 0 0
  field SFFloat radius 0.5
  field SFFloat height 1
  field SFColor color 0.5 0.5 0.5
] {
  Transform { translation IS translation children [
    Shape { appearance Appearance { material Material { diffuseColor IS color } }
      geometry Cylinder { radius IS radius height IS height } }
  ] }
}
