// 
// The first line must be a comment to tell WinExplorer that this is JavaScript
//
function main()  // function main is called by WinExplorer to start the JavaScript Application
{
    Name = Sc.InputBox("Please Enter Your Name", "Name Input", "Default Name")
    
    Sc.Print("\nOk " + Name + ", lets read some card info & print it out");
    Sc.Print("\nUsing built in functions\n\n");

    Sc.Verbose = false;         // Turn off Read / Write echo

    Sc.Write("48 2A 00 00 80"); // Send 2B command
    Sc.Read(131);               // Read 131 bytes from the card

    //
    // Use the GetByte Function to retrieve the bytes just read
    //    
    for (X = 0; X <= 130; X++) {
        Tmp = Sc.GetByte(X);
        ThisByte = Tmp.toString(16);
         
        if (ThisByte.length == 1)
            ThisByte = "0" + ThisByte;
    
        if (X % 16 == 0)
            Sc.Print();
     
        Sc.Print(ThisByte + " ");
    }

    //
    // Do A Card Reset, Just because we can
    //
    Sc.Reset();

    Sc.Print("\n\nLets take a 1000 ms break");
    Sc.Delay(1000);         // Wait 1000 ms
    
    Sc.Print("\nOk " + Name + ", lets read the same info in verbose mode\n\n");

    Sc.Verbose = true;              // Turn on Read / Write echo
    
    Sc.Write("48 2A 00 00 80");     // Send 2B command
    Sc.Read(131);                   // Read 131 bytes from the card

    //
    // Message Box & SubRoutine call Demo
    // Call the Function GetUserInput & Print Result
    //
    Sc.Print("\n\nResult = " + GetUserInput() );
    Sc.Print();
}

function GetUserInput()
{
    return Sc.MsgBox("This is The End of The Demo, Enjoy using WinExplorer", 51, "Example MsgBox");
}