'
' The first line must be a comment to tell WinExplorer that this is VBScript
'
Sub Main()


    Sc.Verbose = true      'Turn on Read / Write echo

    Sc.Write("48 2A 00 00 80")  ' Send 2A command
    Sc.Delay(100)
    Sc.Print(vbcr & vbcr & "Bytes in buffer = " & Sc.BytesInBuffer)
    Sc.Read(131)     ' Read 131 bytes from the card
End Sub